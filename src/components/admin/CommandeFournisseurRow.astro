---
// Une ligne produit du simulateur de commande fournisseur (/admin/commande-fournisseur),
// réutilisée à l'identique dans les blocs "à commander" (groupés par fournisseur) et
// dans la section "à vérifier manuellement" — seule la mise en avant (bordure ambrée,
// case de validation) diffère selon `reviewMode`.
//
// Rendu pur : tout le calcul (classifyReorder, stockAtReceipt, disponible, PUMP…) est
// fait par la page appelante — voir constants.ts. Les attributs data-* portent ce dont
// le script de la page a besoin pour recalculer en direct (coefficient saisonnier),
// en import ANT les mêmes fonctions plutôt qu'en les réimplémentant.

export interface Props {
  p: {
    id: string;
    name: string;
    supplier: string;
    suggestedQty: number | null;
    vitesseVente: number;
    hasSales: boolean;
    stockDisponible: number;
    stockPhysique: number;
    stockReserve: number;
    pump: number | null;
    unitsPerCarton: number | null;
    transitQty: number;
    transitHasUnknownEta: boolean;
    transitLate: boolean;
    nextArrivalLabel: string | null;
    arrivals: { quantity: number; eta: string | null; status: string }[];
    missingDelai: boolean;
    missingPump: boolean;
    reliable: boolean;
    urgent: boolean;
    unreliableReason: string | null;
    covered: boolean;
    delai: { jours: number; source: string; fournisseur: string | null };
    aVerifierDelai: boolean;
    joursSecurite: number;
    couvertureCibleJours: number;
    trigger: { primary: string; margeInsuffisante: boolean; joursAvantCommande: number | null; dateCommandeConseillee: Date | null };
    manqueEngage: number;
    confiance: string;
    historyWeeks: number;
    reconstructionApplied: boolean;
    reconstructionUncertain: boolean;
    minCartons: number | null;
    multipleCartons: number | null;
  };
  /** N'affiche l'étiquette fournisseur sur la ligne que dans la section "à
   *  vérifier manuellement", qui n'est pas groupée par fournisseur — dans
   *  les blocs "à commander", le fournisseur est déjà l'en-tête du bloc. */
  showSupplierTag?: boolean;
  /** Ajoute la case "Valider cette ligne" qui fait réellement rejoindre la
   *  commande du fournisseur — seulement pertinent dans "à vérifier". */
  reviewMode?: boolean;
}

const { p, showSupplierTag = false, reviewMode = false } = Astro.props;

function formatPrice(n: number | null): string {
  if (n == null) return '—';
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
}

function fmtDate(d: Date | null): string | null {
  if (!d) return null;
  return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
}

const qty = p.suggestedQty ?? 0;
const cost = p.pump != null ? p.pump * qty : null;

const STATE_TEXT: Record<string, string> = {
  a_prevoir: p.trigger.dateCommandeConseillee ? `Commander avant le ${fmtDate(p.trigger.dateCommandeConseillee)}` : 'Commande à prévoir',
  commander_maintenant: p.trigger.margeInsuffisante ? '⚠ marge de sécurité insuffisante — commander maintenant' : 'Commander maintenant',
  rupture_avant_commande_normale: '⚠ rupture prévue avant qu’une commande normale n’arrive',
  couvert_par_arrivage: 'Couvert par un arrivage en cours',
  donnees_insuffisantes: 'Données insuffisantes',
};
const stateText = p.manqueEngage > 0
  ? `⚠ manque déjà engagé : ${p.manqueEngage} carton${p.manqueEngage > 1 ? 's' : ''}`
  : (STATE_TEXT[p.trigger.primary] ?? p.trigger.primary);

// Sérialisé tel quel (eta en ISO) pour que le script client reconstruise les
// mêmes ArrivalEvent que le serveur et appelle classifyReorder/stockAtReceipt
// avec des dates réelles, pas juste des libellés déjà formatés.
const arrivalsJson = JSON.stringify(p.arrivals.map((a, i) => ({
  shipmentId: `disp-${i}`, quantity: a.quantity, eta: a.eta, status: a.status,
})));
---
<div
  class={`pr ${!p.reliable ? 'pr--review' : ''} ${p.urgent ? 'pr--urgent' : ''}`}
  hidden={p.covered}
  data-role="product-row"
  data-id={p.id}
  data-supplier={p.supplier}
  data-name={p.name}
  data-pump={p.pump ?? ''}
  data-upc={p.unitsPerCarton ?? ''}
  data-vitesse={p.vitesseVente}
  data-delai-jours={p.delai.jours}
  data-securite-jours={p.joursSecurite}
  data-stock={p.stockDisponible}
  data-has-sales={p.hasSales ? '1' : '0'}
  data-transit-qty={p.transitQty}
  data-covered={p.covered ? '1' : '0'}
  data-manque={p.manqueEngage}
  data-min={p.minCartons ?? ''}
  data-multiple={p.multipleCartons ?? ''}
  data-arrivals={arrivalsJson}
>
  <div class="pr-top">
    <div class="pr-name-wrap">
      <span class="pr-name">{p.name}</span>
      {showSupplierTag && <span class="pr-supplier-tag">{p.supplier}</span>}
      {reviewMode && (
        <label class="pr-validate">
          <input type="checkbox" data-role="review-validate" />
          Valider cette ligne
        </label>
      )}
    </div>
    <div class="pr-qty-wrap">
      <input
        type="number"
        class={`pr-qty ${!p.reliable ? 'pr-qty--warn' : ''}`}
        min="0"
        step="1"
        value={qty}
        aria-label={`Quantité à commander pour ${p.name}`}
        data-role="qty-input"
      />
      <span class="pr-qty-warn" data-role="qty-warn" hidden>saisie invalide, ignorée</span>
    </div>
  </div>

  <p class="pr-state" data-role="state-text" data-state={p.trigger.primary}>{stateText}</p>

  <div class="pr-sub">
    <span
      class="pr-stock"
      title={`Disponible ${p.stockDisponible} = physique ${p.stockPhysique} − réservé ${p.stockReserve}`}
    >
      Stock dispo {p.stockDisponible}
    </span>
    <span class="pr-sep">·</span>
    <span class="pr-vitesse" data-role="vitesse-text">
      {p.hasSales ? `ventes ${p.vitesseVente.toFixed(1)}/sem.` : 'pas de ventes enregistrées'}
    </span>
    <span class={`pr-confiance pr-confiance--${p.confiance}`} title={`Fiabilité de la vitesse de vente, sur ${p.historyWeeks.toFixed(1)} sem. d'historique`}>
      confiance {p.confiance}
    </span>
    <span class="pr-cost" data-role="cost-text" title="PUMP historique — peut différer du prix du prochain achat">{cost == null ? '—' : formatPrice(cost)}</span>
  </div>

  {(!p.reliable || p.manqueEngage > 0 || p.transitQty > 0 || p.aVerifierDelai || p.missingDelai || p.missingPump || p.minCartons != null || p.multipleCartons != null || p.reconstructionApplied || p.reconstructionUncertain) && (
    <div class="pr-badges">
      {!p.reliable && (
        <span class="pr-badge pr-badge--warn" title="Calculée avec la même formule validée, mais sur des données moins sûres">
          ⚠ {p.unreliableReason} — quantité peu fiable
        </span>
      )}
      {p.reconstructionApplied && (
        <span class="pr-badge pr-badge--info" title="Une rupture a été reconstruite à partir des ventes et réceptions connues (pas d'historique de stock direct) et la vitesse a été corrigée en conséquence — c'est une estimation, pas une mesure directe">
          ~ vitesse ajustée pour rupture reconstruite (estimation)
        </span>
      )}
      {p.reconstructionUncertain && (
        <span class="pr-badge pr-badge--warn" title="Une rupture semble présente dans les données mais la correction qu'elle impliquerait est jugée trop importante pour être fiable (plus probablement un mouvement de stock non tracé) — la vitesse brute est utilisée à la place">
          ⚠ reconstruction de rupture peu fiable — vitesse brute utilisée
        </span>
      )}
      {p.transitQty > 0 && (
        <a
          href="/admin/transit"
          class="pr-badge pr-badge--info"
          title="Déjà commandé ou en transit — déduit de la quantité affichée (voir le détail ci-dessous pour chaque arrivage)"
        >
          🚢 {p.transitQty} carton{p.transitQty > 1 ? 's' : ''} déjà en route
          {p.nextArrivalLabel ? ` · prochain ~${p.nextArrivalLabel}` : ' · date inconnue'}
          {p.transitLate ? ' · en retard' : ''}
        </a>
      )}
      {p.aVerifierDelai && (
        <span class="pr-badge pr-badge--warn" title="Un délai est enregistré sur la fiche produit mais n'a jamais été confirmé comme exception — il n'est pas utilisé">
          délai produit à vérifier
        </span>
      )}
      {p.reliable && !p.aVerifierDelai && p.missingDelai && (
        <span class="pr-badge pr-badge--warn" title="Aucun délai réel connu pour ce fournisseur — calculé sur le délai par défaut. Réglez-le sur /admin/fournisseurs">
          ⚠ délai fournisseur non renseigné
        </span>
      )}
      {p.missingPump && (
        <span class="pr-badge pr-badge--warn" title="Aucun prix d'achat moyen connu pour ce produit — exclu du coût">
          ⚠ prix d'achat manquant
        </span>
      )}
      {(p.minCartons != null || p.multipleCartons != null) && (
        <span class="pr-badge pr-badge--info" title="Quantité déjà arrondie à ces contraintes d'achat">
          {p.minCartons != null && `min ${p.minCartons}`}
          {p.minCartons != null && p.multipleCartons != null && ' · '}
          {p.multipleCartons != null && `multiple de ${p.multipleCartons}`}
        </span>
      )}
    </div>
  )}

  <details class="pr-details">
    <summary>Détail du calcul</summary>
    <dl class="pr-detail-grid">
      <div><dt>Délai utilisé</dt><dd>{p.delai.jours} j · {p.delai.source === 'produit_override' ? 'exception produit' : p.delai.source === 'fournisseur' ? `fournisseur (${p.delai.fournisseur ?? p.supplier})` : 'défaut (non confirmé)'}</dd></div>
      <div><dt>Sécurité</dt><dd>{p.joursSecurite} j (réserve additionnelle)</dd></div>
      <div><dt>Couverture cible après réception</dt><dd>{p.couvertureCibleJours} j (ventes normales)</dd></div>
      <div><dt>Stock visé après réception</dt><dd data-role="cible-text">{Math.round((p.vitesseVente / 7) * (p.couvertureCibleJours + p.joursSecurite))} cartons</dd></div>
      <div><dt>Jours avant commande</dt><dd data-role="jac-text">{p.trigger.joursAvantCommande != null ? Math.round(p.trigger.joursAvantCommande) : '—'}</dd></div>
      {p.arrivals.length > 0 && (
        <div class="pr-detail-full">
          <dt>Arrivages en cours ({p.arrivals.length})</dt>
          <dd>
            <ul class="pr-arrival-list">
              {p.arrivals.map(a => (
                <li>{a.quantity} carton{a.quantity > 1 ? 's' : ''} — {a.eta ? `arrivée ~${fmtDate(new Date(a.eta))}` : 'date inconnue'} ({a.status})</li>
              ))}
            </ul>
          </dd>
        </div>
      )}
    </dl>
  </details>
</div>

<style>
.pr { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); }
.pr:last-child { border-bottom: none; }
.pr--review { background: oklch(0.985 0.012 60); }
.pr--urgent { background: oklch(0.98 0.015 25); }

.pr-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
.pr-name-wrap { display: flex; align-items: baseline; gap: var(--space-2); min-width: 0; flex-wrap: wrap; }
.pr-name { font-size: var(--text-base); font-weight: 600; color: var(--color-ink); }
.pr-supplier-tag { font-size: var(--text-xs); color: var(--color-muted); white-space: nowrap; }
.pr-validate {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: var(--text-xs); font-weight: 600; color: var(--color-primary-deep);
  cursor: pointer; white-space: nowrap;
}

.pr-qty-wrap { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
.pr-qty {
  width: 90px;
  padding: 0.4rem 0.55rem;
  font-family: var(--font-mono);
  font-size: 1.05rem;
  font-weight: 700;
  text-align: right;
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  outline: none;
}
.pr-qty:focus { border-color: var(--color-primary); }
.pr-qty--warn { border-color: oklch(0.68 0.15 55); background: oklch(0.97 0.05 60); }
.pr-qty--warn:focus { border-color: oklch(0.55 0.15 55); }
.pr-qty-warn { margin-top: 2px; font-size: 0.6875rem; color: oklch(0.50 0.19 25); font-weight: 600; }

.pr-state { margin: 6px 0 0; font-size: var(--text-sm); font-weight: 700; color: var(--color-ink); }
.pr-state[data-state="rupture_avant_commande_normale"],
.pr-state.is-urgent { color: oklch(0.46 0.18 25); }
.pr-state[data-state="couvert_par_arrivage"],
.pr-state[data-state="donnees_insuffisantes"] { color: var(--color-muted); font-weight: 500; }

.pr-sub {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 5px;
  margin-top: 3px;
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.pr-stock, .pr-vitesse { cursor: default; }
.pr-stock[title] { cursor: help; }
.pr-sep { opacity: 0.45; }
.pr-cost { margin-left: auto; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-ink); white-space: nowrap; cursor: help; }

.pr-confiance {
  padding: 0 6px;
  border-radius: var(--radius-sm);
  font-size: 0.6875rem;
  font-weight: 600;
  cursor: help;
}
.pr-confiance--haute { color: oklch(0.42 0.13 150); background: oklch(0.94 0.05 150); }
.pr-confiance--moyenne { color: oklch(0.42 0.14 60); background: oklch(0.95 0.05 60); }
.pr-confiance--faible, .pr-confiance--insuffisante { color: oklch(0.46 0.18 25); background: oklch(0.96 0.04 25); }

.pr-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
.pr-badge {
  display: inline-block;
  padding: 2px 8px;
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: 1px solid;
  text-decoration: none;
  white-space: nowrap;
}
.pr-badge[hidden] { display: none; }
.pr-badge--warn { color: oklch(0.34 0.14 45); background: oklch(0.93 0.09 60); border-color: oklch(0.72 0.14 55); }
.pr-badge--danger { color: oklch(0.40 0.16 25); background: oklch(0.95 0.05 25); border-color: oklch(0.78 0.12 25); }
.pr-badge--info { color: oklch(0.40 0.10 220); background: oklch(0.94 0.04 220); border-color: oklch(0.78 0.08 220); }
.pr-badge--info:hover { text-decoration: underline; }

.pr-details { margin-top: 8px; }
.pr-details summary {
  font-size: var(--text-xs); font-weight: 600; color: var(--color-muted); cursor: pointer; user-select: none;
}
.pr-detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 6px var(--space-4);
  margin: 6px 0 0;
  padding: var(--space-2) var(--space-3);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
}
.pr-detail-grid dt { color: var(--color-muted); }
.pr-detail-grid dd { margin: 0; font-weight: 600; color: var(--color-ink); }
.pr-detail-full { grid-column: 1 / -1; }
.pr-arrival-list { margin: 2px 0 0; padding-left: 1.1em; font-weight: 500; }
</style>
