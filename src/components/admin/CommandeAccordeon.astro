---
/**
 * Une commande fournisseur du Suivi des achats, en ACCORDÉON : repliée par défaut, elle n'affiche que l'essentiel (fournisseur, référence, statuts, cartons commandés / reçus / reste, arrivée prévue,
 * barre de progression discrète). Dépliée, elle montre exactement ce que montrait l'ancienne carte : actions existantes, route maritime, produits, quantités, prix, totaux, coût rendu.
 * PURE PRÉSENTATION : aucune donnée n'est lue ni écrite ici, aucune règle de calcul n'est changée (tout vient déjà calculé de la page). Natif <details> : sans JavaScript, accessible au clavier.
 */
import ShipRoute from './ShipRoute.astro';
import { SHIPMENT_STATUSES, SHIPMENT_STATUS_LABEL, type ShipmentStatus } from '../../lib/constants';
import { formatDateReunion } from '../../lib/datetime';
import { LIBELLE_RECEPTION } from '../../lib/achatsReception';
import { messageRapprochement, COMMANDES_A_RAPPROCHER } from '../../lib/achatsRapprochement';
import { nombre, fmtDate, fmtPrice, fmtEUR2, texteArrivee, resteAffiche } from '../../lib/achatsAffichage';

interface Props { s: any; ecritureOk: boolean }
const { s, ecritureOk } = Astro.props;
const reste = resteAffiche(s.etat, s.status);
const arrivee = texteArrivee({ status: s.status, eta: s.eta, late: s.progress?.late, daysLate: s.progress?.daysLate });
const peutRecevoir = ecritureOk && s.etat.statut !== 'integrale' && s.status !== 'annule' && s.items.length > 0 && !s.aRapprocher;
---
<details class={`cmd ${s.progress?.late ? 'cmd--late' : ''}`} data-commande={s.id} data-testid="commande">
  <summary class="cmd-resume">
    <span class="cmd-chevron" aria-hidden="true"></span>
    <span class="cmd-id">
      <strong class="cmd-fournisseur">{s.supplier_name}</strong>
      {s.reference && <span class="cmd-ref">{s.reference}</span>}
    </span>
    <span class="cmd-statuts" data-testid="reception-liste">
      <span class={`rec-badge rec-badge--${s.etat.statut}`} data-testid="statut-reception">{LIBELLE_RECEPTION[s.etat.statut as keyof typeof LIBELLE_RECEPTION]}</span>
      <span class="cmd-log" data-testid="statut-logistique-resume">{SHIPMENT_STATUS_LABEL[s.status as ShipmentStatus]}</span>
    </span>
    <span class="cmd-chiffres" data-testid="progression" aria-label="Cartons commandés, reçus et restant à recevoir">
      <span class="cmd-chiffre"><b data-col="commande">{nombre(s.etat.commande)}</b><i>commandés</i></span>
      <span class="cmd-chiffre"><b data-col="recu">{nombre(s.etat.recu)}</b><i>reçus</i></span>
      <span class={`cmd-chiffre ${reste ? 'cmd-chiffre--reste' : ''}`}><b data-col="reste">{reste === null ? '—' : nombre(reste)}</b><i>à recevoir</i></span>
    </span>
    <span class="cmd-arrivee" data-testid="arrivee">{arrivee}</span>
    <span class="cmd-barre" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={s.etat.pourcentage} aria-label="Progression de la réception"><span style={`width:${s.etat.pourcentage}%`}></span></span>
  </summary>

  <div class="cmd-corps">
    <div class="sh-actions">
      {(s.status === 'receptionne' || s.status === 'annule') ? (
        <span class="badge-log" data-testid="statut-logistique">{SHIPMENT_STATUS_LABEL[s.status as ShipmentStatus]}</span>
      ) : !ecritureOk ? (
        <span class="badge-log" data-testid="statut-logistique">{SHIPMENT_STATUS_LABEL[s.status as ShipmentStatus]}</span>
      ) : (
        <form method="post" class="status-form">
          <input type="hidden" name="action" value="set_status" />
          <input type="hidden" name="id" value={s.id} />
          <select name="status" onchange="this.form.submit()" aria-label={`Statut de l'expédition ${s.supplier_name}`}>
            {SHIPMENT_STATUSES.filter(st => st !== 'receptionne').map(st => (
              <option value={st} selected={st === s.status}>{SHIPMENT_STATUS_LABEL[st as ShipmentStatus]}</option>
            ))}
          </select>
        </form>
      )}
      <a href={`/admin/achats/${s.id}`} class="link-action">Détail et réceptions</a>
      <a href={`/admin/achats/${s.id}/edit`} class="link-action">Modifier</a>
      <a href={`/admin/achats/${s.id}/couts`} class="link-action">
        {s.landed.costsStatus === 'aucun' ? '+ Frais / coût rendu' : 'Voir détail coût rendu'}
      </a>
      {peutRecevoir && <a href={`/admin/achats/${s.id}/reception`} class="btn btn-primary btn-sm" data-testid="enregistrer-reception">Enregistrer une réception</a>}
    </div>
    {s.aRapprocher && <p class="cmd-rapprochement" role="status" data-testid="rapprochement">{messageRapprochement(COMMANDES_A_RAPPROCHER[s.id])}</p>}

    <ShipRoute
      percent={s.progress.percent}
      late={s.progress.late}
      arrived={s.progress.arrived}
      daysLate={s.progress.daysLate}
      departureLabel={fmtDate(s.departure_date)}
      etaLabel={fmtDate(s.eta)}
      cargo={s.cargo}
      seed={s.id}
    />

    <div class="sh-body">
      <table class="sh-items">
        <tbody>
          {s.items.map((it: any) => (
            <tr>
              <td class="it-name">
                {it.products?.name ?? 'Produit supprimé'}
                {it.dlc && <span class="it-dlc">DLC {formatDateReunion(it.dlc)}</span>}
              </td>
              <td class="it-qty">
                <span class="it-cartons">{nombre(it.cartons)} cartons</span>
                {(it.received_quantity ?? 0) > 0 && <span class="it-recu">dont {nombre(it.received_quantity ?? 0)} reçus{it.quantity - (it.received_quantity ?? 0) > 0 ? ` · reste ${nombre(it.quantity - (it.received_quantity ?? 0))}` : ''}</span>}
                {it.unitsPerCarton != null && (
                  <span class="it-pack">
                    {it.unitsPerCarton}/carton · {nombre(it.totalUnits!)} unités
                  </span>
                )}
              </td>
              <td class="it-cost">
                {it.pricePerCarton != null ? (
                  <>
                    {it.pricePerUnit != null && (
                      <span class="it-price-unit">{fmtEUR2(it.pricePerUnit)} / unité</span>
                    )}
                    <span class="it-price-carton">{fmtEUR2(it.pricePerCarton)} / carton</span>
                    <span class="it-price-total">{fmtEUR2(it.totalValue!)} total</span>
                  </>
                ) : <span class="muted">coût non renseigné</span>}
              </td>
            </tr>
          ))}
          {s.items.length === 0 && (
            <tr><td colspan="3" class="muted">Aucune ligne produit — <a href={`/admin/achats/${s.id}/edit`}>en ajouter</a></td></tr>
          )}
        </tbody>
      </table>

      <div class="sh-totals">
        <span class="t-qty">{nombre(s.totalQty)} cartons</span>
        <span class="t-cost">
          {s.totalCost > 0 ? fmtPrice(s.totalCost) : '—'}
          {s.anyMissingCost && s.totalCost > 0 && <span class="t-partial" title="Certaines lignes n'ont pas de coût unitaire">*</span>}
        </span>
        {s.notes && <p class="sh-notes">{s.notes}</p>}
      </div>
    </div>

    {s.items.length > 0 && (
      <div class="sh-landed">
        <span class="landed-stat">
          <span class="landed-label">Valeur fournisseur</span>
          <span class="landed-value">{fmtEUR2(s.landed.totalSupplierValue)}</span>
        </span>
        <span class="landed-stat">
          <span class="landed-label">Frais import</span>
          <span class="landed-value">{fmtEUR2(s.landed.totalImportFees)}</span>
        </span>
        <span class="landed-stat landed-stat--total">
          <span class="landed-label">Coût rendu total</span>
          <span class="landed-value">{fmtEUR2(s.landed.totalLanded)}</span>
          {s.landed.costsStatus === 'estime' && <span class="landed-flag" title="Frais encore estimés">estimé</span>}
        </span>
      </div>
    )}
  </div>
</details>

<style>
.cmd {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  transition: border-color 120ms ease, box-shadow 120ms ease;
}
.cmd:hover { border-color: var(--color-border-strong); }
.cmd[open] { border-color: var(--color-border-strong); box-shadow: 0 1px 6px oklch(0 0 0 / 0.05); }
.cmd--late { border-color: oklch(0.84 0.10 70); }
.cmd--late .cmd-arrivee { color: oklch(0.45 0.12 60); font-weight: 600; }

/* ── Ligne repliée : une seule ligne sur ordinateur, deux ou trois sur téléphone ─────────────────── */
.cmd-resume {
  list-style: none;
  cursor: pointer;
  display: grid;
  grid-template-columns: 1.25rem minmax(0, 1.5fr) auto minmax(0, 1.25fr) minmax(7.5rem, 0.9fr);
  grid-template-areas:
    "chev id statuts chiffres arrivee"
    "chev id statuts chiffres barre";
  column-gap: var(--space-4);
  row-gap: 2px;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  min-height: 56px;
  border-radius: var(--radius-md);
}
.cmd-resume::-webkit-details-marker { display: none; }
.cmd-resume:hover { background: var(--color-surface); }
.cmd-resume:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }

.cmd-chevron { grid-area: chev; width: 0.55rem; height: 0.55rem; border-right: 2px solid var(--color-muted); border-bottom: 2px solid var(--color-muted); transform: rotate(-45deg); transition: transform 140ms ease; justify-self: center; }
.cmd[open] > .cmd-resume .cmd-chevron { transform: rotate(45deg); }

.cmd-id { grid-area: id; display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
.cmd-fournisseur { font-size: var(--text-base); font-weight: 600; color: var(--color-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cmd-ref { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.cmd-statuts { grid-area: statuts; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
.cmd-log { font-size: var(--text-xs); color: var(--color-muted); white-space: nowrap; }

.cmd-chiffres { grid-area: chiffres; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); text-align: right; }
.cmd-chiffre { display: flex; flex-direction: column; line-height: 1.2; }
.cmd-chiffre b { font-family: var(--font-mono); font-size: var(--text-base); font-weight: 600; color: var(--color-ink); font-variant-numeric: tabular-nums; }
.cmd-chiffre i { font-style: normal; font-size: 0.6875rem; color: var(--color-muted); }
.cmd-chiffre--reste b { color: var(--color-primary-deep); }

.cmd-arrivee { grid-area: arrivee; font-size: var(--text-xs); color: var(--color-muted); text-align: right; white-space: nowrap; min-height: 1em; }
.cmd-barre { grid-area: barre; display: block; height: 4px; border-radius: var(--radius-full); background: var(--color-surface); overflow: hidden; }
.cmd-barre span { display: block; height: 100%; background: var(--color-primary); border-radius: var(--radius-full); opacity: 0.85; }

/* ── Contenu déplié (même contenu qu'avant, mis en retrait) ────────────────────────────────────── */
.cmd-corps { padding: var(--space-2) var(--space-4) var(--space-4) calc(var(--space-4) + 1.25rem + var(--space-4)); border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: var(--space-3); padding-top: var(--space-3); }
.cmd-rapprochement { margin: 0; padding: var(--space-3) var(--space-4); font-size: var(--text-sm); color: oklch(0.42 0.12 70); background: oklch(0.96 0.05 75); border: 1px solid oklch(0.88 0.09 75); border-radius: var(--radius-sm); }

.sh-actions { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.status-form select { padding: 0.3rem 0.5rem; font-family: var(--font-body); font-size: var(--text-xs); color: var(--color-ink); background: var(--color-bg); border: 1.5px solid var(--color-border-strong); border-radius: var(--radius-sm); outline: none; }
.status-form select:focus { border-color: var(--color-primary); }
.link-action { font-size: var(--text-sm); font-weight: 500; color: var(--color-primary-deep); text-decoration: none; display: inline-flex; align-items: center; min-height: 36px; }
.link-action:hover { text-decoration: underline; }
.btn-sm { padding: 0.45rem 0.9rem; font-size: var(--text-xs); }
.badge-log { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 700; background: var(--color-surface); border: 1px solid var(--color-border-strong); }
.rec-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 700; white-space: nowrap; }
.rec-badge--attente { background: oklch(0.95 0.02 60); color: oklch(0.42 0.08 60); }
.rec-badge--partielle { background: oklch(0.95 0.07 80); color: oklch(0.40 0.14 80); }
.rec-badge--integrale { background: oklch(0.93 0.07 150); color: oklch(0.32 0.12 150); }

.sh-body { display: flex; gap: var(--space-5); flex-wrap: wrap; align-items: flex-start; }
.sh-items { flex: 1 1 320px; border-collapse: collapse; font-size: var(--text-sm); }
.sh-items td { padding: var(--space-1) 0; border-bottom: 1px dashed var(--color-border); }
.sh-items tr:last-child td { border-bottom: none; }
.it-name { color: var(--color-ink); }
/* Vraies cellules de tableau (alignées d'une ligne à l'autre) ; les mentions s'empilent dans la cellule. */
.sh-items td { vertical-align: top; padding-top: var(--space-2); padding-bottom: var(--space-2); }
.it-qty, .it-cost { text-align: right; white-space: nowrap; padding-left: var(--space-5) !important; width: 1%; }
.it-qty > span, .it-cost > span { display: block; line-height: 1.35; }
.it-cartons { font-family: var(--font-mono); color: var(--color-ink); }
.it-dlc { display: block; font-size: var(--text-xs); color: var(--color-muted); font-family: var(--font-mono); }
.it-pack, .it-recu { font-size: var(--text-xs); color: var(--color-muted); }
.it-recu { display: block; }
.it-price-unit { font-size: var(--text-xs); color: var(--color-muted); font-family: var(--font-mono); }
.it-price-carton { font-family: var(--font-mono); font-weight: 600; color: var(--color-ink); }
.it-price-total { font-size: var(--text-xs); color: var(--color-muted); font-family: var(--font-mono); }
.muted { color: var(--color-muted); }
.muted a { color: var(--color-primary-deep); }

.sh-totals { flex: 0 0 auto; text-align: right; min-width: 140px; }
.t-qty { display: block; font-size: 1.05rem; font-weight: 700; color: var(--color-ink); font-variant-numeric: tabular-nums; }
.t-cost { display: block; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-muted); }
.t-partial { color: oklch(0.55 0.15 60); cursor: help; }
.sh-notes { margin: var(--space-2) 0 0; font-size: var(--text-xs); color: var(--color-muted); font-style: italic; max-width: 30ch; }

.sh-landed { display: flex; gap: var(--space-5); justify-content: flex-end; flex-wrap: wrap; padding-top: var(--space-3); border-top: 1px dashed var(--color-border); }
.landed-stat { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
.landed-label { font-size: var(--text-xs); color: var(--color-muted); }
.landed-value { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-ink); }
.landed-stat--total .landed-value { font-weight: 700; }
.landed-flag { font-size: 0.6875rem; font-weight: 600; color: oklch(0.50 0.13 70); background: oklch(0.95 0.06 75); padding: 0.05rem 0.4rem; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.02em; }

/* ── Écrans moyens, puis téléphone ─────────────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .cmd-resume {
    grid-template-columns: 1.25rem minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-areas:
      "chev id statuts"
      "chev chiffres chiffres"
      "chev arrivee barre";
    row-gap: var(--space-2);
  }
  .cmd-statuts { justify-content: flex-end; }
  .cmd-chiffres { text-align: left; max-width: 26rem; }
  .cmd-arrivee { text-align: left; }
  .cmd-barre { align-self: center; }
  .cmd-corps { padding-left: var(--space-4); }
}
@media (max-width: 520px) {
  .cmd-resume {
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-areas:
      "chev id"
      "chev statuts"
      "chev chiffres"
      "chev arrivee"
      "chev barre";
    padding: var(--space-3);
  }
  .cmd-statuts { justify-content: flex-start; }
  .cmd-chiffres { max-width: none; }
  .sh-body { flex-direction: column; }
  .sh-items { flex-basis: auto; width: 100%; }
  /* Produits : une carte par ligne (nom, puis quantités et prix côte à côte) au lieu d'un tableau qui déborde */
  .sh-items, .sh-items tbody { display: block; }
  .sh-items tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-4); row-gap: 2px; padding: var(--space-2) 0; border-bottom: 1px dashed var(--color-border); }
  .sh-items tr:last-child { border-bottom: none; }
  .sh-items td { border-bottom: none; padding: 0; }
  .sh-items .it-name { grid-column: 1 / -1; overflow-wrap: anywhere; }
  .sh-items td[colspan] { grid-column: 1 / -1; }
  .it-qty, .it-cost { text-align: left; white-space: normal; padding-left: 0 !important; width: auto; }
  .sh-totals { text-align: left; }
  .sh-landed { justify-content: flex-start; }
  .landed-stat { align-items: flex-start; }
}
</style>
