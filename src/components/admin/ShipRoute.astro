---
// Trajet d'une expédition : quai de départ à gauche, port d'arrivée à droite,
// bateau positionné selon l'avancement entre la date de départ et l'ETA.
interface Props {
  percent: number;
  late: boolean;
  daysLate: number;
  departureLabel: string;
  etaLabel: string;
}
const { percent, late, daysLate, departureLabel, etaLabel } = Astro.props;

// Borné pour que le bateau reste dans la piste même si les dates sont farfelues.
const pos = Math.min(100, Math.max(0, percent));
const arrived = pos >= 100;
---
<div class={`route ${late ? 'route--late' : ''}`}>
  <div class="route-track" role="img" aria-label={`Avancement : ${Math.round(pos)} %${late ? `, retard de ${daysLate} jour${daysLate > 1 ? 's' : ''}` : ''}`}>
    <div class="route-line"></div>
    <div class="route-done" style={`width: ${pos}%`}></div>

    <div class="route-boat" style={`left: ${pos}%`}>
      <svg width="26" height="20" viewBox="0 0 26 20" fill="none" aria-hidden="true">
        <path d="M4 13h18l-2.2 4.2a1 1 0 0 1-.9.55H7.1a1 1 0 0 1-.9-.55L4 13Z" fill="currentColor"/>
        <path d="M13 12V3.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M13.9 3.6 20 9.4h-6.1V3.6Z" fill="currentColor" opacity="0.75"/>
        <path d="M12.1 5.2 7.4 9.4h4.7V5.2Z" fill="currentColor" opacity="0.5"/>
      </svg>
    </div>

    <span class="route-port route-port--start" aria-hidden="true"></span>
    <span class={`route-port route-port--end ${arrived ? 'is-reached' : ''}`} aria-hidden="true"></span>
  </div>

  <div class="route-labels">
    <span class="route-label">Départ <span class="route-date">{departureLabel}</span></span>
    {late ? (
      <span class="route-late">Retard de {daysLate} jour{daysLate > 1 ? 's' : ''} · ETA {etaLabel}</span>
    ) : (
      <span class="route-label route-label--end">Arrivée estimée <span class="route-date">{etaLabel}</span></span>
    )}
  </div>
</div>

<style>
.route { margin: var(--space-3) 0 var(--space-2); }

.route-track {
  position: relative;
  height: 26px;
  margin: 0 4px;
}

.route-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: 2px;
  background: var(--color-border);
}

/* Portion parcourue */
.route-done {
  position: absolute;
  top: 50%;
  left: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: 2px;
  background: oklch(0.62 0.11 220);
  transition: width var(--dur-slow, 400ms) ease;
}
.route--late .route-done { background: oklch(0.70 0.14 70); }

/* Ports : quai de départ et port d'arrivée */
.route-port {
  position: absolute;
  top: 50%;
  width: 9px;
  height: 9px;
  margin-top: -4.5px;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2px solid var(--color-border-strong);
}
.route-port--start { left: -4px; }
.route-port--end   { right: -4px; }
.route-port--end.is-reached { border-color: oklch(0.62 0.11 220); background: oklch(0.62 0.11 220); }
.route--late .route-port--end.is-reached { border-color: oklch(0.70 0.14 70); background: oklch(0.70 0.14 70); }

/* Le bateau, centré sur sa position le long du trajet */
.route-boat {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  color: oklch(0.45 0.10 220);
  line-height: 0;
  will-change: transform;
  animation: boat-bob 3.2s ease-in-out infinite;
}
.route--late .route-boat { color: oklch(0.52 0.14 60); }

/* Tangage : léger, sur place — le déplacement horizontal reste porté par
   `left`, l'animation n'ajoute qu'un roulis. */
@keyframes boat-bob {
  0%, 100% { transform: translate(-50%, -50%) translateY(0)      rotate(-3deg); }
  50%      { transform: translate(-50%, -50%) translateY(-2.5px) rotate(3deg); }
}

.route-labels {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.route-label--end { text-align: right; }
.route-date { color: var(--color-ink); font-weight: 600; }
.route-late { color: oklch(0.45 0.15 60); font-weight: 700; text-align: right; }

/* Respect de la préférence système : plus aucun mouvement, le bateau garde
   sa position, qui est l'information utile. */
@media (prefers-reduced-motion: reduce) {
  .route-boat { animation: none; }
  .route-done { transition: none; }
}
</style>
