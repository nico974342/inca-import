---
// Trajet d'une expédition : quai de départ à gauche, port d'arrivée à droite,
// porte-conteneurs positionné par interpolation entre le départ et l'ETA.
interface Props {
  percent: number;
  late: boolean;
  daysLate: number;
  departureLabel: string;
  etaLabel: string;
  /** Sert à décaler la phase du tangage : deux navires côte à côte ne
   *  doivent pas rouler à l'unisson. */
  seed?: string;
}
const { percent, late, daysLate, departureLabel, etaLabel, seed = '' } = Astro.props;

const pos = Math.min(100, Math.max(0, percent));
const arrived = pos >= 100;

// Déphasage déterministe tiré de l'id : stable d'un rendu à l'autre, donc
// pas de saut visuel au rechargement.
let hash = 0;
for (let i = 0; i < seed.length; i++) hash = (hash * 31 + seed.charCodeAt(i)) % 997;
const phase = (hash % 60) / 10; // 0 → 5,9 s

// Identifiant des <defs> : dérivé de l'id d'expédition, car deux navires de
// même phase partageraient sinon le même gradient.
const uid = (seed || `s${hash}`).replace(/[^a-zA-Z0-9]/g, '').slice(0, 12) || `s${hash}`;

// Conteneurs aux couleurs des familles de produits — clin d'œil à ce que le
// navire transporte. Teintes reprises des badges catégorie, remontées en
// saturation pour rester lisibles à cette taille.
const C = {
  boissons:    'oklch(0.58 0.13 220)',
  snacks:      'oklch(0.68 0.14 60)',
  chips:       'oklch(0.58 0.11 180)',
  confiseries: 'oklch(0.60 0.14 330)',
  divers:      'oklch(0.55 0.13 275)',
};
// [x, y, couleur] — piles de hauteurs inégales, plus basses vers la proue.
const containers: [number, number, string][] = [
  [30.5, 15.1, C.boissons], [30.5, 12.7, C.snacks], [30.5, 10.3, C.confiseries],
  [35.3, 15.1, C.divers],   [35.3, 12.7, C.chips],
  [40.1, 15.1, C.snacks],   [40.1, 12.7, C.boissons], [40.1, 10.3, C.divers],
  [44.9, 15.1, C.confiseries], [44.9, 12.7, C.chips],
  [49.7, 15.1, C.boissons],
];
---
<div class={`route ${late ? 'route--late' : ''}`} style={`--phase: ${phase}`}>
  <div class="route-track" role="img" aria-label={`Avancement : ${Math.round(pos)} %${late ? `, retard de ${daysLate} jour${daysLate > 1 ? 's' : ''}` : ''}`}>
    <div class="route-line"></div>
    <div class="route-done" style={`width: ${pos}%`}></div>

    {/* Position calée pour que le navire reste entier dans la piste : à 0 %
        sa poupe touche le quai, à 100 % sa proue touche le port. Un simple
        left:% le ferait déborder d'une demi-longueur aux extrémités. */}
    <div class="route-boat" style={`left: calc(31px + (100% - 62px) * ${pos / 100})`}>
      <span class="boat-heave">
        <svg class="boat-svg" width="62" height="30" viewBox="0 0 62 30" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id={`wake-${uid}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="currentColor" stop-opacity="0"/>
              <stop offset="100%" stop-color="currentColor" stop-opacity="0.30"/>
            </linearGradient>
            {/* Masque plutôt que stroke dégradé : les vagues gardent ainsi
                leurs couleurs CSS, et currentColor dans un <defs> ne se
                résout pas de la même façon selon les navigateurs. */}
            <linearGradient id={`fade-${uid}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#fff" stop-opacity="0"/>
              <stop offset="20%"  stop-color="#fff" stop-opacity="1"/>
              <stop offset="80%"  stop-color="#fff" stop-opacity="1"/>
              <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
            </linearGradient>
            <mask id={`sea-${uid}`}>
              <rect x="-8" y="19" width="78" height="14" fill={`url(#fade-${uid})`}/>
            </mask>
          </defs>

          <!-- Sillage : traînée qui s'estompe derrière la poupe -->
          <path class="boat-wake" d="M0,21.6 C5,20.9 11,20.6 17,20.6 L17,22.9 C11,22.9 5,22.7 0,22.2 Z"
                fill={`url(#wake-${uid})`}/>

          <g class="boat-roll">
            <!-- Coque : longue et basse, proue inclinée vers l'avant -->
            <path class="hull" d="M17.5,17.4 H55 L60,18.8 L57,23 H20 Z"/>
            <!-- Liseré de franc-bord -->
            <path class="hull-line" d="M18.6,18.9 H56.4" stroke-width="0.9" stroke-linecap="round"/>

            <!-- Conteneurs -->
            {containers.map(([x, y, fill]) => (
              <g>
                <rect x={x} y={y} width="4.2" height="2.2" rx="0.3" fill={fill}/>
                <path d={`M${x + 0.7},${y} V${y + 2.2}`} stroke="rgba(255,255,255,0.28)" stroke-width="0.35"/>
                <path d={`M${x + 2.1},${y} V${y + 2.2}`} stroke="rgba(255,255,255,0.28)" stroke-width="0.35"/>
                <path d={`M${x + 3.5},${y} V${y + 2.2}`} stroke="rgba(255,255,255,0.28)" stroke-width="0.35"/>
              </g>
            ))}

            <!-- Château, vers l'arrière -->
            <rect class="hull" x="21" y="9.6" width="7.6" height="7.8" rx="0.5"/>
            <rect class="bridge" x="21.7" y="10.4" width="6.2" height="1.5" rx="0.3"/>
            <circle class="porthole" cx="23"   cy="13.6" r="0.55"/>
            <circle class="porthole" cx="24.8" cy="13.6" r="0.55"/>
            <circle class="porthole" cx="26.6" cy="13.6" r="0.55"/>
            <circle class="porthole" cx="23"   cy="15.6" r="0.55"/>
            <circle class="porthole" cx="24.8" cy="15.6" r="0.55"/>

            <!-- Cheminée, avec sa bande coral -->
            <path class="hull" d="M23.6,9.6 V6.1 h2.7 V9.6 Z"/>
            <rect class="funnel-band" x="23.6" y="6.6" width="2.7" height="1.1"/>
          </g>

          <!-- Deux vagues sous la coque, déphasées entre elles et par rapport
               au navire. Étendue calée sur le navire, extrémités fondues. -->
          <g mask={`url(#sea-${uid})`}>
            <path class="wave wave--1" d="M-2,25.2 q4,-1.5 8,0 t8,0 t8,0 t8,0 t8,0 t8,0 t8,0 t8,0"/>
            <path class="wave wave--2" d="M-4,27.3 q5,-1.2 10,0 t10,0 t10,0 t10,0 t10,0 t10,0 t10,0"/>
          </g>
        </svg>
      </span>
    </div>

    <span class="route-port route-port--start" aria-hidden="true"></span>
    <span class={`route-port route-port--end ${arrived ? 'is-reached' : ''}`} aria-hidden="true"></span>
  </div>

  <div class="route-labels">
    <span class="route-label">Départ <span class="route-date">{departureLabel}</span></span>
    {late ? (
      <span class="route-late">Retard de {daysLate} jour{daysLate > 1 ? 's' : ''} · ETA {etaLabel}</span>
    ) : (
      <span class="route-label route-label--end">Arrivée estimée <span class="route-date">{etaLabel}</span></span>
    )}
  </div>
</div>

<style>
.route { margin: var(--space-4) 0 var(--space-2); }

.route-track {
  position: relative;
  height: 34px;
  margin: 0 4px;
}

.route-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: 2px;
  background: var(--color-border);
}

.route-done {
  position: absolute;
  top: 50%;
  left: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: 2px;
  background: oklch(0.62 0.11 220);
  transition: width var(--dur-slow, 400ms) ease;
}
.route--late .route-done { background: oklch(0.70 0.14 70); }

.route-port {
  position: absolute;
  top: 50%;
  width: 9px;
  height: 9px;
  margin-top: -4.5px;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2px solid var(--color-border-strong);
  z-index: 1;
}
.route-port--start { left: -4px; }
.route-port--end   { right: -4px; }
.route-port--end.is-reached { border-color: oklch(0.62 0.11 220); background: oklch(0.62 0.11 220); }
.route--late .route-port--end.is-reached { border-color: oklch(0.70 0.14 70); background: oklch(0.70 0.14 70); }

/* Le navire : positionné le long du trajet, la coque assise sur la ligne. */
/* Largeur et hauteur explicites : sans elles, une boîte absolue en largeur
   auto est réduite en shrink-to-fit par le bord droit du conteneur. Près de
   100 %, elle tombait à 0 px et translate(-50%) ne décalait plus rien — le
   navire en retard sortait entièrement du cadre. */
.route-boat {
  position: absolute;
  top: 50%;
  width: 62px;
  height: 30px;
  transform: translate(-50%, -50%);
  line-height: 0;
  z-index: 2;
  pointer-events: none;
}
/* La teinte du sillage est portée par le <svg> : le currentColor des stops
   du gradient se résout depuis le <defs>, qui hérite de la racine SVG, et
   non depuis le <path> qui référence le gradient. */
.boat-svg { display: block; overflow: visible; color: oklch(0.55 0.06 240); }
.route--late .boat-svg { color: oklch(0.58 0.11 60); }

/* Coque en ink : silhouette sombre qui laisse ressortir les conteneurs. */
.hull        { fill: oklch(0.30 0.035 250); }
.hull-line   { stroke: oklch(0.52 0.05 250); }
.bridge      { fill: oklch(0.72 0.05 230); }
.porthole    { fill: oklch(0.86 0.06 230); }
.funnel-band { fill: var(--color-primary); }

.wave {
  fill: none;
  stroke: oklch(0.72 0.07 225);
  stroke-width: 1.1;
  stroke-linecap: round;
}
.wave--2 { stroke: oklch(0.80 0.05 225); stroke-width: 0.9; }

/* Mer agitée : tout passe en ambre quand le navire est en retard. */
.route--late .hull      { fill: oklch(0.36 0.07 60); }
.route--late .hull-line { stroke: oklch(0.58 0.10 60); }
.route--late .wave      { stroke: oklch(0.74 0.11 65); }
.route--late .wave--2   { stroke: oklch(0.82 0.08 65); }

/* ── Tangage ──────────────────────────────────────────────────────────
   Deux axes séparés, à des durées volontairement non multiples l'une de
   l'autre : la combinaison ne se referme jamais sur un cycle court, ce qui
   évite l'effet mécanique. Le déphasage --phase désynchronise les navires
   affichés ensemble. */
.boat-heave {
  display: inline-block;
  animation: boat-heave 5.5s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
  will-change: transform;
}
.boat-roll {
  transform-box: fill-box;
  transform-origin: 50% 80%;
  animation: boat-roll 4s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
  will-change: transform;
}

@keyframes boat-heave {
  0%, 100% { transform: translateY(0.9px); }
  50%      { transform: translateY(-1.6px); }
}
@keyframes boat-roll {
  0%, 100% { transform: rotate(-2.4deg); }
  50%      { transform: rotate(2.4deg); }
}

/* Vagues : périodes encore différentes, et décalage propre pour qu'elles
   n'accompagnent pas le navire en cadence. */
.wave--1 {
  animation: wave-1 4.7s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s - 0.8s);
}
.wave--2 {
  animation: wave-2 6.3s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s - 1.9s);
}
@keyframes wave-1 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-3px, -0.8px); }
}
@keyframes wave-2 {
  0%, 100% { transform: translate(0, 0.4px); }
  50%      { transform: translate(3px, -0.5px); }
}

.boat-wake {
  animation: wake-fade 5.5s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
}
@keyframes wake-fade {
  0%, 100% { opacity: 0.9; }
  50%      { opacity: 0.55; }
}

/* Mer agitée : plus ample et plus lent. */
.route--late .boat-heave { animation-duration: 8s;   animation-name: boat-heave-rough; }
.route--late .boat-roll  { animation-duration: 6.5s; animation-name: boat-roll-rough; }
@keyframes boat-heave-rough {
  0%, 100% { transform: translateY(1.8px); }
  50%      { transform: translateY(-2.8px); }
}
@keyframes boat-roll-rough {
  0%, 100% { transform: rotate(-4.2deg); }
  50%      { transform: rotate(4.2deg); }
}
.route--late .wave--1 { animation-duration: 6.5s; }
.route--late .wave--2 { animation-duration: 8.4s; }

.route-labels {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.route-label--end { text-align: right; }
.route-date { color: var(--color-ink); font-weight: 600; }
.route-late { color: oklch(0.45 0.15 60); font-weight: 700; text-align: right; }

/* Préférence système : tout est figé. Le navire garde sa position sur le
   trajet, qui est la seule information réellement portée par le visuel. */
/* Préférence système : tout est figé, y compris l'état « mer agitée ».
   Les sélecteurs sont préfixés par .route pour peser (0,2,0), à égalité avec
   les règles .route--late : une media query n'ajoute aucune spécificité, et
   sans ce préfixe les navires en retard continuaient de tanguer. */
@media (prefers-reduced-motion: reduce) {
  .route .boat-heave,
  .route .boat-roll,
  .route .wave,
  .route .boat-wake { animation: none; }
  .route .route-done { transition: none; }
}
</style>
