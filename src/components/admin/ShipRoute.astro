---
import { CATEGORY_CARGO_COLOR, CATEGORY_LABEL, CARGO_SLOTS } from '../../lib/constants';

// Ligne d'acheminement : quai de départ à gauche, port d'arrivée à droite.
// Le navire se place par interpolation entre la date de départ et l'ETA, et
// sa cargaison reprend la composition réelle de l'expédition.
interface Props {
  percent: number;
  late: boolean;
  arrived: boolean;
  daysLate: number;
  departureLabel: string;
  etaLabel: string;
  /** Catégories déjà réparties sur les emplacements du pont. */
  cargo?: string[];
  /** Décale la phase du tangage : deux navires ne roulent pas à l'unisson. */
  seed?: string;
}
const {
  percent, late, arrived, daysLate,
  departureLabel, etaLabel, cargo = [], seed = '',
} = Astro.props;

const pos = Math.min(100, Math.max(0, percent));

// Déphasage déterministe tiré de l'id : stable d'un rendu à l'autre.
let hash = 0;
for (let i = 0; i < seed.length; i++) hash = (hash * 31 + seed.charCodeAt(i)) % 997;
const phase = (hash % 60) / 10;
const uid = (seed || `s${hash}`).replace(/[^a-zA-Z0-9]/g, '').slice(0, 12) || `s${hash}`;

// ── Pont : 5 piles de hauteurs inégales, 12 emplacements, plus basses vers
//    la proue. L'ordre de remplissage est bas-en-haut puis bâbord-tribord,
//    donc la catégorie dominante forme le bloc de gauche. ──
const STACKS: { x: number; rows: number }[] = [
  { x: 35.0, rows: 3 }, { x: 41.5, rows: 2 }, { x: 48.0, rows: 3 },
  { x: 54.5, rows: 2 }, { x: 61.0, rows: 2 },
];
const ROW_Y = [17.4, 14.3, 11.2]; // bas → haut
const CW = 5.9, CH = 3.1;

const slots: { x: number; y: number; color: string; category: string }[] = [];
let i = 0;
for (const stack of STACKS) {
  for (let r = 0; r < stack.rows; r++) {
    const category = cargo[i++];
    if (!category) continue; // pont partiellement chargé : on laisse vide
    slots.push({
      x: stack.x, y: ROW_Y[r],
      color: CATEGORY_CARGO_COLOR[category] ?? CATEGORY_CARGO_COLOR.divers,
      category,
    });
  }
}
const empty = slots.length === 0;

// L'état de mer est l'état de l'expédition : calme à quai, agitée en retard.
const seaState = arrived ? 'arrived' : late ? 'rough' : 'sailing';

// La cargaison est encodée par la couleur : elle doit aussi se lire sans
// elle. Le décompte par famille part dans l'aria-label et l'infobulle.
const tally = new Map<string, number>();
for (const s of slots) tally.set(s.category, (tally.get(s.category) ?? 0) + 1);
const cargoSummary = [...tally.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([cat, n]) => `${n} ${CATEGORY_LABEL[cat] ?? cat}`)
  .join(', ');

const progressLabel =
  `Avancement : ${Math.round(pos)} %` +
  (arrived ? ', arrivé au port' : late ? `, retard de ${daysLate} jour${daysLate > 1 ? 's' : ''}` : '') +
  (empty
    ? ', aucune ligne produit'
    : ` — cargaison sur ${CARGO_SLOTS} emplacements : ${cargoSummary}`);
---
<div class={`route route--${seaState}`} style={`--phase: ${phase}`}>
  <div class="route-track" role="img" aria-label={progressLabel} title={progressLabel}>
    <div class="route-line"></div>
    <div class="route-done" style={`width: ${pos}%`}></div>

    {/* Position calée pour que le navire reste entier dans la piste : poupe au
        quai à 0 %, proue au port à 100 %. */}
    <div class="route-boat" style={`left: calc(38px + (100% - 76px) * ${pos / 100})`}>
      <span class="boat-heave">
        <svg class="boat-svg" width="76" height="36" viewBox="0 0 76 36" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id={`wake-${uid}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="currentColor" stop-opacity="0"/>
              <stop offset="100%" stop-color="currentColor" stop-opacity="0.32"/>
            </linearGradient>
            {/* Masque plutôt que stroke dégradé : les vagues gardent leurs
                couleurs CSS, et currentColor dans un <defs> ne se résout pas
                de la même façon selon les navigateurs. */}
            <linearGradient id={`fade-${uid}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#fff" stop-opacity="0"/>
              <stop offset="22%"  stop-color="#fff" stop-opacity="1"/>
              <stop offset="80%"  stop-color="#fff" stop-opacity="1"/>
              <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
            </linearGradient>
            <mask id={`sea-${uid}`}>
              <rect x="-8" y="24" width="94" height="14" fill={`url(#fade-${uid})`}/>
            </mask>
          </defs>

          <!-- Sillage : présent tant que le navire avance -->
          <path class="boat-wake" d="M0,24.4 C7,23.6 14,23.2 20,23.2 L20,26.6 C14,26.6 7,26.2 0,25.4 Z"
                fill={`url(#wake-${uid})`}/>

          <g class="boat-roll">
            <!-- Coque : longue et basse, proue inclinée, tonture marquée -->
            <path class="hull" d="M20.4,20.4 H66.5 L74,22.6 L69.6,27.6 H24.2 Z"/>
            <path class="hull-boot" d="M22,24.6 H68.2" stroke-width="1.05" stroke-linecap="round"/>

            <!-- Cargaison : une couleur par famille de produits -->
            {slots.map(s => (
              <g>
                <rect x={s.x} y={s.y} width={CW} height={CH} rx="0.4" fill={s.color}/>
                <path d={`M${s.x + 1.5},${s.y} V${s.y + CH}`} stroke="#fff" stroke-opacity="0.22" stroke-width="0.4"/>
                <path d={`M${s.x + 2.95},${s.y} V${s.y + CH}`} stroke="#fff" stroke-opacity="0.22" stroke-width="0.4"/>
                <path d={`M${s.x + 4.4},${s.y} V${s.y + CH}`} stroke="#fff" stroke-opacity="0.22" stroke-width="0.4"/>
              </g>
            ))}

            <!-- Château, vers l'arrière -->
            <path class="hull" d="M24,20.4 V11.6 h9 V20.4 Z"/>
            <rect class="bridge" x="24.9" y="12.5" width="7.2" height="1.8" rx="0.4"/>
            <circle class="porthole" cx="26.5" cy="16.4" r="0.62"/>
            <circle class="porthole" cx="28.5" cy="16.4" r="0.62"/>
            <circle class="porthole" cx="30.5" cy="16.4" r="0.62"/>
            <circle class="porthole" cx="26.5" cy="18.6" r="0.62"/>
            <circle class="porthole" cx="28.5" cy="18.6" r="0.62"/>

            <!-- Cheminée : la bande coral est la seule marque de marque -->
            <path class="hull" d="M27,11.6 V6.4 h3.2 V11.6 Z"/>
            <rect class="funnel-band" x="27" y="7.2" width="3.2" height="1.5"/>
          </g>

          <!-- Deux vagues sous la coque, déphasées entre elles et du navire -->
          <g mask={`url(#sea-${uid})`}>
            <path class="wave wave--1" d="M-2,29.6 q5,-1.7 10,0 t10,0 t10,0 t10,0 t10,0 t10,0 t10,0 t10,0"/>
            <path class="wave wave--2" d="M-6,32 q6,-1.4 12,0 t12,0 t12,0 t12,0 t12,0 t12,0 t12,0"/>
          </g>
        </svg>
      </span>
    </div>

    <span class="route-port route-port--start" aria-hidden="true"></span>
    <span class={`route-port route-port--end ${pos >= 100 ? 'is-reached' : ''}`} aria-hidden="true"></span>
  </div>

  <div class="route-labels">
    <span class="route-label">Départ <span class="route-date">{departureLabel}</span></span>
    {late ? (
      <span class="route-note route-note--late">Retard de {daysLate} jour{daysLate > 1 ? 's' : ''} · ETA {etaLabel}</span>
    ) : arrived ? (
      <span class="route-note route-note--arrived">À quai · ETA {etaLabel}</span>
    ) : (
      <span class="route-label route-label--end">Arrivée estimée <span class="route-date">{etaLabel}</span></span>
    )}
  </div>
</div>

<script>
  // Les boucles au repos s'arrêtent hors écran : sur une liste longue, une
  // dizaine de navires animés en permanence coûtent pour rien.
  const routes = document.querySelectorAll('.route');
  if (routes.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => e.target.classList.toggle('is-becalmed', !e.isIntersecting)),
      { rootMargin: '96px' },
    );
    routes.forEach(r => io.observe(r));
  }
</script>

<style>
.route { margin: var(--space-4) 0 var(--space-2); }

.route-track {
  position: relative;
  height: 40px;
  margin: 0 4px;
}

/* La voie : parcourue en accent océan, restante en simple séparateur. */
.route-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: var(--radius-full);
  background: var(--color-border);
}
.route-done {
  position: absolute;
  top: 50%;
  left: 0;
  height: 3px;
  margin-top: -1.5px;
  border-radius: var(--radius-full);
  background: oklch(0.52 0.088 210);
  transition: width var(--dur-slow) var(--ease-out-expo);
}
.route--rough .route-done { background: oklch(0.62 0.135 65); }

.route-port {
  position: absolute;
  top: 50%;
  width: 9px;
  height: 9px;
  margin-top: -4.5px;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2px solid var(--color-border-strong);
  z-index: 1;
}
.route-port--start { left: -4px; }
.route-port--end   { right: -4px; }
.route-port--end.is-reached {
  border-color: oklch(0.52 0.088 210);
  background: oklch(0.52 0.088 210);
}
.route--rough .route-port--end.is-reached {
  border-color: oklch(0.62 0.135 65);
  background: oklch(0.62 0.135 65);
}

/* Largeur et hauteur explicites : sans elles, une boîte absolue en largeur
   auto est réduite en shrink-to-fit par le bord droit du conteneur, et près
   de 100 % translate(-50%) ne décale plus rien. */
.route-boat {
  position: absolute;
  top: 50%;
  width: 76px;
  height: 36px;
  transform: translate(-50%, -50%);
  line-height: 0;
  z-index: 2;
  pointer-events: none;
}
/* La teinte du sillage est portée par le <svg> : le currentColor des stops
   se résout depuis le <defs>, qui hérite de la racine SVG. */
.boat-svg {
  display: block;
  overflow: visible;
  color: oklch(0.62 0.030 210);
}

/* Coque en ink système : la seule couleur saturée du navire est la bande
   coral de la cheminée, et les conteneurs, qui portent une donnée. */
.hull        { fill: var(--color-ink); }
.hull-boot   { stroke: oklch(0.42 0.055 210); }
.bridge      { fill: oklch(0.72 0.045 210); }
.porthole    { fill: oklch(0.86 0.050 210); }
.funnel-band { fill: var(--color-primary); }

.wave {
  fill: none;
  stroke: oklch(0.74 0.055 210);
  stroke-width: 1.2;
  stroke-linecap: round;
}
.wave--2 { stroke: oklch(0.83 0.038 210); stroke-width: 1; }

/* Mer agitée : la coque vire à l'ambre avec le reste de la ligne. */
.route--rough .hull      { fill: oklch(0.34 0.075 60); }
.route--rough .hull-boot { stroke: oklch(0.55 0.100 60); }
.route--rough .boat-svg  { color: oklch(0.62 0.090 60); }
.route--rough .wave      { stroke: oklch(0.76 0.100 65); }
.route--rough .wave--2   { stroke: oklch(0.84 0.070 65); }

/* ── Tangage ──────────────────────────────────────────────────────────
   Deux axes séparés, à des durées volontairement non multiples : la
   combinaison ne se referme jamais sur un cycle court. --phase
   désynchronise les navires affichés ensemble. */
.boat-heave {
  display: inline-block;
  animation: boat-heave 5.5s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
  will-change: transform;
}
.boat-roll {
  transform-box: fill-box;
  transform-origin: 50% 82%;
  animation: boat-roll 4s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
  will-change: transform;
}
@keyframes boat-heave {
  0%, 100% { transform: translateY(1px); }
  50%      { transform: translateY(-1.8px); }
}
@keyframes boat-roll {
  0%, 100% { transform: rotate(-2.4deg); }
  50%      { transform: rotate(2.4deg); }
}

.wave--1 {
  animation: wave-1 4.7s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s - 0.8s);
}
.wave--2 {
  animation: wave-2 6.3s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s - 1.9s);
}
@keyframes wave-1 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-3.5px, -0.9px); }
}
@keyframes wave-2 {
  0%, 100% { transform: translate(0, 0.4px); }
  50%      { transform: translate(3.5px, -0.6px); }
}
.boat-wake {
  animation: wake-fade 5.5s ease-in-out infinite;
  animation-delay: calc(var(--phase, 0) * -1s);
}
@keyframes wake-fade {
  0%, 100% { opacity: 0.95; }
  50%      { opacity: 0.55; }
}

/* Mer agitée : plus ample, plus lente. */
.route--rough .boat-heave { animation-duration: 8s;   animation-name: boat-heave-rough; }
.route--rough .boat-roll  { animation-duration: 6.5s; animation-name: boat-roll-rough; }
@keyframes boat-heave-rough {
  0%, 100% { transform: translateY(1.9px); }
  50%      { transform: translateY(-3px); }
}
@keyframes boat-roll-rough {
  0%, 100% { transform: rotate(-4.2deg); }
  50%      { transform: rotate(4.2deg); }
}
.route--rough .wave--1 { animation-duration: 6.5s; }
.route--rough .wave--2 { animation-duration: 8.4s; }

/* À quai : la mer se calme pour de bon. Plus de tangage, plus de houle, plus
   de sillage — le navire ne va nulle part, et le visuel le dit. */
.route--arrived .boat-heave,
.route--arrived .boat-roll,
.route--arrived .wave,
.route--arrived .boat-wake { animation: none; }
.route--arrived .boat-roll { transform: rotate(0deg); }
.route--arrived .boat-wake { opacity: 0; }
.route--arrived .wave    { stroke: oklch(0.82 0.030 210); }
.route--arrived .wave--2 { stroke: oklch(0.88 0.022 210); }

/* Hors écran : on suspend plutôt que de supprimer, la reprise est ainsi
   invisible quand la carte revient. */
.route.is-becalmed .boat-heave,
.route.is-becalmed .boat-roll,
.route.is-becalmed .wave,
.route.is-becalmed .boat-wake { animation-play-state: paused; }

.route-labels {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.route-label--end { text-align: right; }
.route-date { color: var(--color-ink); font-weight: 600; }
.route-note { font-weight: 700; text-align: right; }
.route-note--late    { color: oklch(0.45 0.150 60); }
.route-note--arrived { color: oklch(0.40 0.080 210); }

/* Préférence système : tout est figé, y compris « mer agitée ». Les
   sélecteurs sont préfixés par .route pour peser (0,2,0), à égalité avec les
   règles .route--rough — une media query n'ajoute aucune spécificité, et sans
   ce préfixe les navires en retard continuaient de tanguer. */
@media (prefers-reduced-motion: reduce) {
  .route .boat-heave,
  .route .boat-roll,
  .route .wave,
  .route .boat-wake { animation: none; }
  .route .route-done { transition: none; }
}
</style>
