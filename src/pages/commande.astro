---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { supabaseAdmin, createAuthClient } from '../lib/supabase';
import { Resend } from 'resend';
import { generateOrderPDF } from '../lib/pdf';
import { sanitizeText } from '../lib/sanitize';
import { normalizeEmail, findClientByEmail, fetchClientPriceOverrides, resolveClientPrice } from '../lib/clients';
import { createOrderChecked, createOrderIdempotent, idempotenceDisponible } from '../lib/stock';
import { COMPANY, RESEND_DEFAULT_FROM } from '../lib/constants';
import { todayReunion } from '../lib/datetime';
import { depotCommande } from '../lib/commandeSupabase';
import { etatPanier, retirerLigne, reduireLigne, apercuAjustement, confirmerAjustement, traiterEnvoi, panierDejaCommande, type CreateurCommande, type LigneBrute } from '../lib/commandeActions';
import { messageLigne, messageAjustement, signaturePanier, type EvaluationLigne } from '../lib/panier';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/connexion');

// Negotiated discount, if any — applied to every line at order time
const clientAccount = await findClientByEmail<{ remise: number | null; price_group_id: string | null; status: string | null }>(user.email, 'remise, price_group_id, status');
const remisePct = clientAccount?.remise ?? null;
const priceOverrides = await fetchClientPriceOverrides(clientAccount?.price_group_id ?? null);

// Faille 2 (audit externe) : un compte pas encore validé par un admin
// (en_attente, suspendu, ou une fiche prospect jamais convertie) ne doit pas
// pouvoir commander. C'est de la seule ergonomie ici — le rempart réel est
// dans order_create_checked (même vérification, dans la transaction), ce
// contrôle-ci sert seulement à ne pas laisser quelqu'un remplir un panier
// entier pour échouer uniquement au moment de valider.
const accountActive = clientAccount?.status === 'actif';
const resolvedPrice = (basePriceHt: number | null | undefined, productId: string) =>
  resolveClientPrice(productId, basePriceHt, priceOverrides, remisePct);

const CAT_LABEL: Record<string, string> = {
  boissons:    'Boissons',
  snacks:      'Snacks',
  chips:       'Chips',
  confiseries: 'Confiseries',
  divers:      'Divers',
};

const depot = depotCommande(user as any);
const estUuid = (s: unknown): s is string => typeof s === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(s);

// Message transmis d'une action à la page suivante (cookie court, lisible une seule fois) : jamais un changement du panier sans que le client le voie.
const FLASH = 'commande_flash';
const poserFlash = (lignes: string[], type: 'ok' | 'info' = 'ok') => {
  const gardees = lignes.slice(0, 12); if (lignes.length > 12) gardees.push(`… et ${lignes.length - 12} autre${lignes.length - 12 > 1 ? 's' : ''}`);
  Astro.cookies.set(FLASH, JSON.stringify({ type, lignes: gardees }), { path: '/commande', maxAge: 120, httpOnly: true, sameSite: 'lax' });
};

// ── POST ───────────────────────────────────────────────────────
if (Astro.request.method === 'POST') {
  if (!accountActive) return Astro.redirect('/commande?error=compte_non_actif');
  const form  = await Astro.request.formData();
  const action = String(form.get('action') ?? 'envoyer');

  // — Ajustements EXPLICITES du panier (chacun demandé par le client ; les quantités sont recalculées ici, jamais lues du formulaire) —
  if (action === 'retirer' || action === 'reduire') {
    const pid = form.get('product_id');
    if (!estUuid(pid)) return Astro.redirect('/commande');
    const r = action === 'retirer' ? await retirerLigne(depot, user.id, pid) : await reduireLigne(depot, user.id, pid);
    poserFlash([r.message], r.ok ? 'ok' : 'info');
    return Astro.redirect('/commande');
  }
  if (action === 'ajuster_apercu') return Astro.redirect('/commande?apercu=1');             // 1. aperçu : rien n'est écrit
  if (action === 'ajuster_confirmer') {                                                      // 2. confirmation du plan affiché
    const r = await confirmerAjustement(depot, user.id, String(form.get('signature') ?? ''));
    if (r.type === 'a_revoir') return Astro.redirect('/commande?apercu=1&revu=1');          // la disponibilité a encore changé : on remontre l'aperçu, rien n'est appliqué
    if (r.type === 'applique') poserFlash([`Panier ajusté : ${r.resume}.`, ...r.changements.map(messageAjustement)]);
    return Astro.redirect('/commande');
  }
  if (action === 'vider_commande_enregistree') {                                             // le vidage automatique a échoué alors que la commande existe
    const [{ lignes }, derniere] = await Promise.all([etatPanier(depot, user.id), depot.derniereCommande(user.id)]);
    if (panierDejaCommande(lignes, derniere)) await depot.viderPanier(user.id);
    return Astro.redirect(derniere ? `/commande?success=1&order=${derniere.id}` : '/catalogue');
  }

  // — Envoi de la commande —
  const notes = sanitizeText(form.get('notes') as string, 1000);
  const cleForm = form.get('cle');
  const cle = estUuid(cleForm) ? cleForm : crypto.randomUUID();
  const idem = await idempotenceDisponible();

  // Détail complet du panier (prix, TVA, PUMP) pour la commande, l'e-mail et le PDF : lu au moment de la création, et comparé au panier évalué (jamais deux versions).
  let items: any[] = [];
  const createur: CreateurCommande = {
    idempotent: idem,
    async creer(cleEnvoi, lignes: LigneBrute[]) {
      const { data } = await supabaseAdmin
        .from('cart_items')
        .select('product_id, quantity, products(id, name, category, unit, units_per_carton, price_ht, tva_rate, prix_achat_moyen_ht, stock_quantity)')
        .eq('user_id', user.id);
      items = data ?? [];
      if (signaturePanier(items.map((i: any) => ({ product_id: i.product_id, quantity: i.quantity }))) !== signaturePanier(lignes)) return { ok: false as const, error: 'PANIER_MODIFIE' };
      const lignesCmd = items.map(item => {
        const p = item.products as any;
        return {
          product_id:        p?.id,
          product_name:      p?.name ?? 'Produit inconnu',
          quantity:          item.quantity,
          unit:              p?.unit ?? null,
          // le prix intègre la remise négociée du client ; le PUMP reste le
          // coût réel, pour que la marge de la commande ne s'en trouve pas faussée
          price_ht_snapshot: resolvedPrice(p?.price_ht ?? null, p?.id),
          tva_rate_snapshot: p?.tva_rate ?? null,
          pump_snapshot:     p?.prix_achat_moyen_ht ?? null,
        };
      });
      const entete = { user_id: user.id, nom: user.user_metadata?.nom ?? '', societe: user.user_metadata?.societe ?? '', telephone: user.user_metadata?.telephone ?? '', email: normalizeEmail(user.email), notes: notes || null };
      // Création contrôlée : le disponible (physique − réservé) est revérifié dans la même transaction que l'insertion, verrous posés sur les produits.
      // Contrôler ici en JS ne protégerait de rien. Avec l'idempotence, la même clé ne crée jamais deux commandes.
      return idem ? createOrderIdempotent(cleEnvoi, entete, lignesCmd) : createOrderChecked(entete, lignesCmd);
    },
  };

  const res = await traiterEnvoi({ depot, userId: user.id, cle, createur });

  if (res.type === 'panier_vide') return Astro.redirect('/catalogue');
  if (res.type === 'deja_enregistree') return Astro.redirect(`/commande?success=1&order=${res.orderId}`);       // double clic / nouvel essai : la commande existe déjà, rien n'est recréé
  // Le panier est CONSERVÉ dans tous les cas de refus : la page recalcule la disponibilité réelle et propose les ajustements ligne par ligne.
  if (res.type === 'conflits') return Astro.redirect('/commande?error=stock');
  if (res.type === 'erreur') {
    if (res.code === 'COMPTE_NON_ACTIF') return Astro.redirect('/commande?error=compte_non_actif');
    if (res.code === 'PANIER_MODIFIE') return Astro.redirect('/commande?error=panier_modifie');
    return Astro.redirect('/commande?error=1');
  }

  const order = { id: res.orderId };
  // Commande déjà créée par un envoi précédent (même clé) : pas de nouvel e-mail, pas de nouveau PDF.
  if (res.deja) return Astro.redirect(`/commande?success=1&order=${order.id}`);
  // Le panier est vidé par traiterEnvoi, APRÈS la création confirmée ; s'il n'a pas pu l'être, la page le dit au client (voir plus bas).

  // Build email/PDF data (use items captured before cart was cleared)
  const nom            = user.user_metadata?.nom ?? user.email ?? '';
  const societe        = user.user_metadata?.societe ?? '';
  const tel            = user.user_metadata?.telephone ?? '';
  const points_de_vente = user.user_metadata?.points_de_vente ?? null;
  const orderTotalHT = items.reduce(
    (s, item) => s + item.quantity * Number(resolvedPrice((item.products as any)?.price_ht ?? null, (item.products as any)?.id) ?? 0), 0
  );

  // Generate PDF — non-blocking on error
  let pdfBuffer: Buffer | null = null;
  try {
    pdfBuffer = await generateOrderPDF({
      id: order.id,
      nom,
      societe,
      email: user.email ?? '',
      telephone: tel,
      points_de_vente,
      notes,
      items: items.map(item => {
        const p = item.products as any;
        return { product_name: p?.name ?? '?', quantity: item.quantity, unit: p?.unit, price_ht: resolvedPrice(p?.price_ht ?? null, p?.id), tva_rate: p?.tva_rate };
      }),
      totalHT: orderTotalHT,
      date: todayReunion(),
    });
  } catch (pdfErr) {
    console.error('[PDF] Error:', pdfErr);
  }

  // Send notification email — non-blocking
  try {
    const resend = new Resend(import.meta.env.RESEND_API_KEY);
    const lignes = items.map(item => {
      const p      = item.products as any;
      const unit   = p?.unit ? ` (${p.unit})` : '';
      const lineHT = (item.quantity * Number(resolvedPrice(p?.price_ht ?? null, p?.id) ?? 0)).toFixed(2).replace('.', ',');
      return `• ${p?.name ?? '?'} × ${item.quantity}${unit} — ${lineHT} € HT`;
    }).join('\n');

    const emailPayload: Parameters<typeof resend.emails.send>[0] = {
      from:    (import.meta.env.RESEND_FROM as string | undefined) ?? RESEND_DEFAULT_FROM,
      to:      COMPANY.contactEmail,
      subject: `Nouvelle commande — ${nom}${societe ? ` (${societe})` : ''}`,
      text: [
        '=== Nouvelle commande Inca Import ===',
        '',
        `Client    : ${nom}`,
        `Société   : ${societe || '—'}`,
        `Email     : ${user.email}`,
        `Téléphone : ${tel || '—'}`,
        '',
        'Articles commandés :',
        lignes,
        '',
        `Total HT  : ${orderTotalHT.toFixed(2).replace('.', ',')} €`,
        ...(notes ? ['', `Notes : ${notes}`] : []),
        '',
        `Référence : ${order.id}`,
      ].join('\n'),
      ...(pdfBuffer ? { attachments: [{ filename: `commande_${order.id.slice(0, 8)}.pdf`, content: pdfBuffer }] } : {}),
    };

    console.log('[Resend] Sending email:', JSON.stringify({ from: emailPayload.from, to: emailPayload.to, subject: emailPayload.subject }));
    const { data: emailData, error: emailError } = await resend.emails.send(emailPayload);
    if (emailError) console.error('[Resend] API error:', JSON.stringify(emailError));
    else console.log('[Resend] Success:', JSON.stringify(emailData));
  } catch (emailErr) {
    console.error('[Resend] Exception:', emailErr);
  }

  return Astro.redirect(`/commande?success=1&order=${order.id}`);
}

// ── GET: show cart ─────────────────────────────────────────────
const success    = !!Astro.url.searchParams.get('success');
const errorParam = Astro.url.searchParams.get('error');
const hasError   = !!errorParam && !['stock', 'compte_non_actif', 'panier_modifie'].includes(errorParam);
const stockError = errorParam === 'stock';
const panierModifie = errorParam === 'panier_modifie';
const orderIdRaw = Astro.url.searchParams.get('order');
const orderId    = estUuid(orderIdRaw) ? orderIdRaw : null;
const apercuDemande = Astro.url.searchParams.get('apercu') === '1';
const apercuRevu    = Astro.url.searchParams.get('revu') === '1';
const maintenantISO = new Date().toISOString();
const cleEnvoi      = crypto.randomUUID();                          // une clé par affichage : le même formulaire renvoyé ne crée jamais deux commandes

// Message laissé par l'action précédente (lu une seule fois).
let flash: { type: 'ok' | 'info'; lignes: string[] } | null = null;
try { const c = Astro.cookies.get(FLASH)?.value; if (c) { const j = JSON.parse(c); if (Array.isArray(j?.lignes)) flash = { type: j.type === 'info' ? 'info' : 'ok', lignes: j.lignes.map(String).slice(0, 14) }; } } catch { /* ignoré */ }
if (flash) Astro.cookies.delete(FLASH, { path: '/commande' });

type SuccessItem = { product_name: string; quantity: number; unit: string | null };
let successItems: SuccessItem[] = [];
let successTotalHT = 0;

if (success && orderId) {
  // Seulement MES commandes : un identifiant deviné ne montre rien.
  const { data: mienne } = await supabaseAdmin.from('orders').select('id').eq('id', orderId).eq('user_id', user.id).maybeSingle();
  const { data: orderItems } = mienne ? await supabaseAdmin
    .from('order_items')
    .select('product_name, quantity, unit, price_ht_snapshot')
    .eq('order_id', orderId) : { data: [] as any[] };

  successItems = (orderItems ?? []).map(it => ({
    product_name: it.product_name,
    quantity: it.quantity,
    unit: it.unit,
  }));
  successTotalHT = (orderItems ?? []).reduce(
    (s, it) => s + it.quantity * Number(it.price_ht_snapshot ?? 0), 0
  );
}

type CartItem = {
  quantity: number;
  products: { id: string; name: string; category: string; unit: string | null; units_per_carton: number | null; price_ht: number | null; tva_rate: number | null; stock_quantity: number | null } | null
};

let cartItems: CartItem[] = [];
let etat: Awaited<ReturnType<typeof etatPanier>> | null = null;
let evalParId = new Map<string, EvaluationLigne>();
let commandeDejaPassee: { id: string; secondes: number } | null = null;
if (!success) {
  const { data } = await supabaseAdmin
    .from('cart_items')
    .select('quantity, products(id, name, category, unit, units_per_carton, price_ht, tva_rate, stock_quantity)')
    .eq('user_id', user.id)
    .order('updated_at', { ascending: true });

  cartItems = (data ?? []) as CartItem[];
  if (cartItems.length === 0) {
    // Panier vide : AVANT de renvoyer au catalogue, on vérifie qu'une commande ne vient pas d'être enregistrée (double clic, réponse perdue) pour ne pas laisser recommander.
    const derniere = await depot.derniereCommande(user.id);
    if (derniere && derniere.secondes <= 600) return Astro.redirect(`/commande?success=1&order=${derniere.id}`);
    return Astro.redirect('/catalogue');
  }
  // Disponibilité RÉELLE (physique − réservé) à chaque affichage : c'est ce que vérifie la base à la création, pas le stock physique.
  etat = await etatPanier(depot, user.id);
  evalParId = new Map(etat.evaluations.map(e => [e.product_id, e]));
  const derniere = await depot.derniereCommande(user.id);
  if (derniere && panierDejaCommande(etat.lignes, derniere)) commandeDejaPassee = { id: derniere.id, secondes: derniere.secondes };
}
const nbProblemes = etat ? etat.evaluations.filter(e => e.statut !== 'ok').length : 0;
const apercu = apercuDemande && etat && etat.plan.length > 0 ? await apercuAjustement(depot, user.id) : null;
const envoiBloque = nbProblemes > 0 || !!commandeDejaPassee;

const nom     = user.user_metadata?.nom ?? user.email ?? '';
const societe = user.user_metadata?.societe ?? '';
const totalQty = cartItems.reduce((s, i) => s + i.quantity, 0);
const totalHT  = cartItems.reduce((s, i) => s + i.quantity * Number(resolvedPrice(i.products?.price_ht ?? null, i.products?.id ?? '') ?? 0), 0);
const totalTVA = cartItems.reduce(
  (s, i) => s + i.quantity * Number(resolvedPrice(i.products?.price_ht ?? null, i.products?.id ?? '') ?? 0) * Number(i.products?.tva_rate ?? 0.085), 0
);
const totalTTC = totalHT + totalTVA;
const fmtHT    = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
---
<Base
  title="Votre commande — Inca Import"
  description="Récapitulatif de votre commande Inca Import."
>
  <Nav user={user} />
  <main>

    <!-- Page header -->
    <section class="order-header">
      <div class="container">
        <h1 class="order-title">
          {success ? 'Commande envoyée' : 'Votre commande'}
        </h1>
        {!success && (
          <p class="order-meta">
            {nom}{societe ? ` · ${societe}` : ''} · {totalQty} article{totalQty > 1 ? 's' : ''}
          </p>
        )}
      </div>
    </section>

    <div class="container order-body">

      {/* ── Success state ──────────────────────────── */}
      {success && (
        <div class="success-card">
          <div class="success-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
              <circle cx="24" cy="24" r="22" stroke="oklch(0.52 0.17 145)" stroke-width="2"/>
              <path d="M14 24l7 7 13-13" stroke="oklch(0.52 0.17 145)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 class="success-title">Commande bien reçue !</h2>
          {orderId && (
            <p class="success-order-number">Commande n° {orderId.slice(0, 8).toUpperCase()}</p>
          )}
          <p class="success-body">
            L'équipe Inca Import a été notifiée et vous contactera rapidement
            pour confirmer et organiser la livraison.
            Vous recevrez un email de confirmation à chaque mise à jour du statut de votre commande.
          </p>

          {successItems.length > 0 && (
            <div class="success-summary">
              <h3 class="success-summary-title">Récapitulatif</h3>
              <ul class="success-summary-list">
                {successItems.map(item => (
                  <li>
                    <span>{item.quantity} × {item.product_name}{item.unit ? ` (${item.unit})` : ''}</span>
                  </li>
                ))}
              </ul>
              <div class="success-summary-total">
                <span>Total HT</span>
                <span>{fmtHT(successTotalHT)}</span>
              </div>
            </div>
          )}

          <a href="/catalogue" class="btn btn-primary">Retour au catalogue</a>
        </div>
      )}

      {/* ── Messages ──────────────────────────── */}
      {flash && !success && (
        <div class={`order-flash order-flash--${flash.type}`} role="status" data-testid="flash">
          <ul>{flash.lignes.map(l => <li>{l}</li>)}</ul>
        </div>
      )}
      {!accountActive && !success && (
        <p class="order-error" role="alert">
          Votre compte est en attente de validation par notre équipe — vous ne pouvez pas encore passer commande.
          Vous serez notifié par email dès son activation.
        </p>
      )}
      {hasError && !success && (
        <p class="order-error" role="alert" data-testid="erreur-generique">
          Votre commande n'a pas pu être envoyée. <strong>Votre panier est conservé</strong> : vérifiez-le ci-dessous puis réessayez.
          Si le problème persiste, consultez <a href="/mes-commandes">vos commandes</a> avant de renvoyer, pour ne pas la passer deux fois.
        </p>
      )}
      {panierModifie && !success && (
        <p class="order-error" role="alert" data-testid="panier-modifie">
          Votre panier a changé pendant l'envoi (par exemple depuis un autre onglet). Rien n'a été envoyé : vérifiez-le ci-dessous puis confirmez.
        </p>
      )}
      {commandeDejaPassee && !success && (
        <div class="order-flash order-flash--info" role="status" data-testid="deja-commandee">
          <p>Votre commande n° <strong>{commandeDejaPassee.id.slice(0, 8).toUpperCase()}</strong> a bien été enregistrée il y a {Math.max(1, Math.round(commandeDejaPassee.secondes / 60))} min.
            Votre panier affiche encore les mêmes produits : <strong>ne la renvoyez pas</strong>.</p>
          <form method="POST" class="stock-actions">
            <input type="hidden" name="action" value="vider_commande_enregistree" />
            <button type="submit" class="btn btn-primary btn-sm">Voir ma commande et vider le panier</button>
            <a href="/mes-commandes" class="btn btn-secondary btn-sm">Mes commandes</a>
          </form>
        </div>
      )}

      {/* ── Produits à ajuster : le panier est conservé, rien n'est modifié sans accord ── */}
      {!success && etat && !apercu && nbProblemes > 0 && (
        <section class="stock-panel" role="alert" data-testid="panneau-ruptures">
          <h2 class="stock-panel-titre">{nbProblemes} produit{nbProblemes > 1 ? 's' : ''} à ajuster avant d'envoyer</h2>
          <p class="stock-panel-texte">
            {stockError ? 'Le stock a changé pendant la validation. ' : ''}
            <strong>Votre panier est conservé</strong> : les {etat.evaluations.length - nbProblemes} autres produit{etat.evaluations.length - nbProblemes > 1 ? 's' : ''} et leurs quantités ne bougent pas.
            Rien n'est modifié sans votre accord.
          </p>
          <ul class="stock-panel-liste">
            {etat.evaluations.filter(e => e.statut !== 'ok').map(e => (
              <li data-statut={e.statut}><strong>{e.nom}</strong><span>{messageLigne(e)}</span></li>
            ))}
          </ul>
          <form method="POST" class="stock-actions">
            <input type="hidden" name="action" value="ajuster_apercu" />
            <button type="submit" class="btn btn-primary" data-testid="continuer-disponibles">Continuer avec les produits disponibles</button>
          </form>
          <p class="stock-panel-aide">Vous verrez le détail des changements <strong>avant</strong> de confirmer. Vous pouvez aussi ajuster ligne par ligne dans le tableau.</p>
        </section>
      )}

      {/* ── Aperçu des ajustements, à confirmer ── */}
      {!success && apercu && (
        <section class="stock-panel stock-panel--apercu" role="alert" data-testid="apercu-ajustement">
          <h2 class="stock-panel-titre">Confirmez ces ajustements</h2>
          {apercuRevu && <p class="stock-panel-texte">La disponibilité a encore changé depuis l'affichage précédent : voici la liste à jour. <strong>Rien n'a été modifié.</strong></p>}
          <ul class="stock-panel-liste stock-panel-liste--apercu">
            {apercu.lignes.map(l => <li>{l}</li>)}
          </ul>
          <p class="stock-panel-texte"><strong>{apercu.resume}.</strong> Les {etat!.evaluations.length - apercu.etat.plan.length} autre{etat!.evaluations.length - apercu.etat.plan.length > 1 ? 's' : ''} produit{etat!.evaluations.length - apercu.etat.plan.length > 1 ? 's' : ''} restent inchangés.</p>
          <form method="POST" class="stock-actions">
            <input type="hidden" name="action" value="ajuster_confirmer" />
            <input type="hidden" name="signature" value={apercu.etat.signature} />
            <button type="submit" class="btn btn-primary" data-testid="confirmer-ajustements">Confirmer les ajustements</button>
            <a href="/commande" class="btn btn-secondary" data-testid="annuler-ajustements">Annuler, ne rien changer</a>
          </form>
        </section>
      )}

      {/* ── Cart recap + confirm ──────────────────── */}
      {!success && (
        <div class="order-layout">
          <div class="order-main">
            <div class="order-card">
              <h2 class="section-label">Articles commandés</h2>
              <div class="order-table-wrap">
                <table class="order-table">
                  <thead>
                    <tr>
                      <th class="col-product">Produit</th>
                      <th class="col-cat">Catégorie</th>
                      <th class="col-qty">Quantité</th>
                      <th class="col-price">Prix HT</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cartItems.map(item => {
                      const p          = item.products;
                      const lineHT     = item.quantity * Number(resolvedPrice(p?.price_ht ?? null, p?.id ?? '') ?? 0);
                      const unit       = p?.unit ?? 'carton';
                      const upc        = p?.units_per_carton;
                      const totalUnits = upc ? item.quantity * upc : null;
                      const pid        = p?.id ?? '';
                      const ev         = evalParId.get(pid);
                      const probleme   = !!ev && ev.statut !== 'ok';
                      return (
                        <>
                          <tr
                            class={`order-row${probleme ? ' row--stock-error' : ''}`}
                            data-product-id={pid}
                            data-statut={ev?.statut ?? 'ok'}
                          >
                            <td class="col-product product-name-cell" data-label="Produit">{p?.name ?? '—'}</td>
                            <td class="col-cat" data-label="Catégorie">
                              {p?.category && (
                                <span class={`cat-badge cat-badge--${p.category}`}>
                                  {CAT_LABEL[p.category] ?? p.category}
                                </span>
                              )}
                            </td>
                            <td class="col-qty qty-cell" data-label="Quantité">
                              <span class="qty-primary">{item.quantity} {item.quantity === 1 ? unit : `${unit}s`}</span>
                              {totalUnits && (
                                <span class="qty-units">= {totalUnits} unités</span>
                              )}
                            </td>
                            <td class="col-price price-cell" data-label="Prix HT">{fmtHT(lineHT)}</td>
                          </tr>
                          {probleme && ev && (
                            <tr class="stock-alert-row" id={`stock-row-${pid}`} data-testid={`ligne-probleme-${pid}`}>
                              <td colspan="4" class="stock-alert-cell">
                                <span class="stock-icon" aria-hidden="true">
                                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                    <path d="M7 1.5L12.5 12H1.5L7 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                    <line x1="7" y1="6" x2="7" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                    <circle cx="7" cy="10.25" r="0.6" fill="currentColor"/>
                                  </svg>
                                </span>
                                <span class="stock-alert-text">{messageLigne(ev)}</span>
                                <span class="stock-alert-actions">
                                  {ev.statut === 'reduire' && (
                                    <form method="POST" class="stock-inline">
                                      <input type="hidden" name="action" value="reduire" />
                                      <input type="hidden" name="product_id" value={pid} />
                                      <button type="submit" class="btn-adjust" data-testid={`reduire-${pid}`}>Réduire à <strong>{ev.cible}</strong></button>
                                    </form>
                                  )}
                                  <form method="POST" class="stock-inline">
                                    <input type="hidden" name="action" value="retirer" />
                                    <input type="hidden" name="product_id" value={pid} />
                                    <button type="submit" class="btn-adjust btn-adjust--retirer" data-testid={`retirer-${pid}`}>Retirer ce produit</button>
                                  </form>
                                </span>
                              </td>
                            </tr>
                          )}
                        </>
                      );
                    })}
                  </tbody>
                  <tfoot>
                    <tr class="total-row">
                      <td colspan="3" class="total-label-cell">Total HT</td>
                      <td class="col-price price-cell total-price-cell">{fmtHT(totalHT)}</td>
                    </tr>
                    <tr class="tva-row">
                      <td colspan="3" class="tva-label-cell">TVA</td>
                      <td class="col-price tva-price-cell">+&nbsp;{fmtHT(totalTVA)}</td>
                    </tr>
                    <tr class="ttc-row">
                      <td colspan="3" class="ttc-label-cell">Total TTC</td>
                      <td class="col-price ttc-price-cell">{fmtHT(totalTTC)}</td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>

            <div class="order-card">
              <h2 class="section-label">Informations client</h2>
              <dl class="client-dl">
                <div class="dl-row">
                  <dt>Nom</dt>
                  <dd>{nom}</dd>
                </div>
                {societe && (
                  <div class="dl-row">
                    <dt>Société</dt>
                    <dd>{societe}</dd>
                  </div>
                )}
                <div class="dl-row">
                  <dt>Email</dt>
                  <dd>{user.email}</dd>
                </div>
                {user.user_metadata?.telephone && (
                  <div class="dl-row">
                    <dt>Téléphone</dt>
                    <dd>{user.user_metadata.telephone}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>

          <aside class="order-aside">
            <div class="confirm-card">
              <h2 class="section-label">Confirmer la commande</h2>

              <div class="aside-total">
                <div class="aside-ht-row">
                  <span class="aside-total-label">Total HT</span>
                  <span class="aside-total-amount">{fmtHT(totalHT)}</span>
                </div>
                <div class="aside-ttc-block">
                  <span class="aside-ttc-label">Total TTC</span>
                  <span class="aside-ttc-amount">{fmtHT(totalTTC)}</span>
                </div>
              </div>

              <p class="confirm-info">
                En confirmant, vous envoyez votre commande à l'équipe Inca Import.
                Aucun paiement en ligne — un devis vous sera transmis.
              </p>

              {envoiBloque && !commandeDejaPassee && (
                <p id="stock-block-msg" class="stock-block-msg" role="status" data-testid="envoi-bloque">
                  {nbProblemes} produit{nbProblemes > 1 ? 's' : ''} à ajuster avant d'envoyer — voir « Continuer avec les produits disponibles » en haut de page.
                </p>
              )}

              {accountActive ? (
                <form method="POST" id="form-envoi" data-cle={cleEnvoi} data-depuis={maintenantISO}>
                  <input type="hidden" name="action" value="envoyer" />
                  <input type="hidden" name="cle" value={cleEnvoi} />
                  <div class="field">
                    <label for="notes">Notes ou précisions</label>
                    <textarea
                      id="notes"
                      name="notes"
                      rows="4"
                      placeholder="Contraintes de livraison, quantités à ajuster…"
                    ></textarea>
                  </div>
                  <button type="submit" class="btn btn-primary confirm-btn" id="btn-envoi" disabled={envoiBloque} data-bloque={envoiBloque ? '1' : '0'} data-testid="envoyer">
                    Envoyer ma commande →
                  </button>
                  <p class="envoi-etat" id="envoi-etat" role="status" aria-live="polite" hidden></p>
                </form>
              ) : (
                <p class="stock-block-msg" role="alert">
                  Compte en attente de validation — impossible de commander pour l'instant.
                </p>
              )}

              <p class="confirm-back">
                <a href="/catalogue">← Modifier le panier</a>
              </p>
            </div>
          </aside>
        </div>
      )}

    </div>
  </main>
  <Footer />
</Base>

<style>
