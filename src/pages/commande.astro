.stock-panel-liste { list-style: none; margin: var(--space-3) 0; padding: 0; }
.stock-panel-liste li { display: flex; flex-direction: column; gap: 2px; padding: var(--space-2) 0; border-top: 1px solid var(--color-border); font-size: var(--text-sm); }
.stock-panel-liste li span { color: var(--color-danger); }
.stock-panel-liste--apercu li { color: var(--color-ink); }
.stock-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-top: var(--space-4); }
.stock-actions .btn { min-height: 44px; }
.stock-actions .btn-secondary { display: inline-flex; align-items: center; justify-content: center; padding: 0 var(--space-4); background: var(--color-bg, #fff); border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-ink); text-decoration: none; font-weight: 600; }
.stock-alert-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-left: auto; }
