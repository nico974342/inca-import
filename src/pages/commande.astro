.btn-adjust { min-height: 36px; padding: 6px 12px; }
.btn-adjust--retirer { background: transparent; }
.confirm-btn:disabled { opacity: 0.55; cursor: not-allowed; }
.envoi-etat { margin: var(--space-3) 0 0; font-size: var(--text-sm); color: var(--color-muted); }
.envoi-etat--erreur { color: var(--color-danger); font-weight: 600; }

/* Téléphone : chaque ligne devient une fiche lisible, boutons faciles à toucher */
@media (max-width: 640px) {
  .order-table thead { display: none; }
  .order-table, .order-table tbody, .order-table tfoot { display: block; }
  .order-table .order-row { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
  .order-table .order-row td { display: block; padding: 0; border: 0; width: auto; background: transparent; }
  .order-table .order-row .col-cat { display: none; }
  .order-table .order-row .col-product { grid-column: 1; font-weight: 600; }
  .order-table .order-row .col-price { grid-column: 2; grid-row: 1; text-align: right; white-space: nowrap; }
  .order-table .order-row .col-qty { grid-column: 1 / -1; }
  .order-table .order-row.row--stock-error { border-bottom: none; padding-bottom: var(--space-2); }
  .order-table .stock-alert-row, .order-table .stock-alert-row td { display: block; }
  .order-table .stock-alert-row td { padding: 0 0 var(--space-3); }
  .stock-alert-cell { align-items: flex-start; }
  .stock-alert-actions { width: 100%; margin-left: 0; }
  .stock-inline { flex: 1 1 100%; }
  .stock-inline .btn-adjust { width: 100%; min-height: 44px; }
  .order-table tfoot tr { display: flex; justify-content: space-between; padding: var(--space-2) 0; }
  .order-table tfoot td { display: block; padding: 0; border: 0; }
  .stock-actions .btn { flex: 1 1 100%; justify-content: center; text-align: center; }
}
</style>

<script>
  // Envoi protégé : un seul envoi à la fois (double clic ignoré), la même clé est renvoyée en cas de nouvel essai, et après une coupure réseau on VÉRIFIE
  // si la commande a été enregistrée avant de laisser recommencer. Sans JavaScript, le formulaire s'envoie normalement et le serveur applique les mêmes protections.
  const form = document.getElementById('form-envoi') as HTMLFormElement | null;
  const btn  = document.getElementById('btn-envoi') as HTMLButtonElement | null;
  const etat = document.getElementById('envoi-etat');
  const libelle = btn?.textContent ?? '';
  let enCours = false;

  const message = (texte: string, erreur = false) => {
    if (!etat) return;
    etat.textContent = texte; etat.hidden = !texte; etat.classList.toggle('envoi-etat--erreur', erreur);
  };
  const deverrouiller = () => { enCours = false; if (btn) { btn.disabled = btn.dataset.bloque === '1'; btn.textContent = libelle; } };
  window.addEventListener('pageshow', e => { if ((e as PageTransitionEvent).persisted) deverrouiller(); });      // retour arrière du navigateur : le formulaire se rouvre

  async function verifier(cle: string, depuis: string): Promise<{ enregistree: boolean; orderId?: string } | null> {
    for (let i = 0; i < 4; i++) {
      try {
        const r = await fetch(`/api/commande/statut?cle=${encodeURIComponent(cle)}&depuis=${encodeURIComponent(depuis)}`, { credentials: 'same-origin', cache: 'no-store' });
        if (r.ok) return await r.json();
      } catch { /* réseau toujours coupé : on réessaie */ }
      await new Promise(res => setTimeout(res, 1500));
    }
    return null;
  }

  form?.addEventListener('submit', async e => {
    if (!btn) return;
    e.preventDefault();
    if (enCours || btn.disabled) return;                                                                      // double clic : ignoré
    enCours = true; btn.disabled = true; btn.textContent = 'Envoi en cours…';
    message('Envoi de votre commande… ne fermez pas cette page.');
    try {
      const r = await fetch(form.action || location.href, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
      if (!r.ok) throw new Error('réponse ' + r.status);
      location.href = r.redirected ? r.url : location.href;                                                   // le serveur a répondu : on affiche sa réponse (succès, ajustements…)
    } catch {
      message('Connexion interrompue — vérification de votre commande…');
      const v = await verifier(form.dataset.cle ?? '', form.dataset.depuis ?? '');
      if (v?.enregistree && v.orderId) { location.href = `/commande?success=1&order=${encodeURIComponent(v.orderId)}`; return; }
      if (v && !v.enregistree) { message("Votre commande n'a pas été enregistrée. Votre panier est conservé : vous pouvez réessayer.", true); deverrouiller(); return; }
      message("Impossible de vérifier pour l'instant. Ne renvoyez pas tout de suite : consultez « Mes commandes ». Votre panier est conservé.", true);
      setTimeout(deverrouiller, 10_000);
    }
  });
</script>
