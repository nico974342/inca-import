  <!-- ══════════════════════════ Prévisionnel ══════════════════════════ -->
  <details class="section-panel" id="previsionnel" open={coefRaw != null}>
    <summary class="section-summary">
      Prévisionnel — {MONTHS_AHEAD_FOR_PROJECTION} prochains mois
      <span class="section-summary-hint">
        {projection.moisSeuilDurable != null
          ? `Point mort durable dès ${projection.months[projection.moisSeuilDurable - 1].label}`
          : historicalMonthMargins.length === 0
            ? 'Pas assez d\'historique'
