</AdminLayout>

<script define:vars={{ todayISO, sizeWarningChars: EXPORT_SIZE_WARNING_CHARS, exportCoef: coefPct }}>
  const debutInput  = document.getElementById('exportDebut');
  const finInput    = document.getElementById('exportFin');
  const errorEl     = document.getElementById('exportError');
  const statusEl    = document.getElementById('exportStatus');
  const btnDownload = document.getElementById('exportDownload');
  const btnCopy     = document.getElementById('exportCopy');

  // Bornes par défaut : mois en cours — un point de départ raisonnable
  // avant d'ajuster ou d'utiliser un raccourci.
  finInput.value   = todayISO;
  debutInput.value = firstOfMonth(todayISO);

  function firstOfMonth(dateStr) {
    const [y, m] = dateStr.split('-');
    return `${y}-${m}-01`;
  }

  function lastOfMonth(dateStr) {
    const [y, m] = dateStr.split('-').map(Number);
    const last = new Date(y, m, 0).getDate();
    return `${y}-${String(m).padStart(2, '0')}-${String(last).padStart(2, '0')}`;
  }

  // Arithmétique calendaire pure (pas de conversion de fuseau horaire) :
  // sûr pour décaler une date de N mois sans risquer le bug de fuseau déjà
  // rencontré ailleurs sur ce projet avec new Date().toISOString().
  function shiftMonths(dateStr, delta) {
    let [y, m, d] = dateStr.split('-').map(Number);
    const total = y * 12 + (m - 1) + delta;
    y = Math.floor(total / 12);
    m = (total % 12) + 1;
    const daysInMonth = new Date(y, m, 0).getDate();
    if (d > daysInMonth) d = daysInMonth;
    return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      if (preset === 'mois_courant') {
        debutInput.value = firstOfMonth(todayISO);
        finInput.value = todayISO;
      } else if (preset === 'mois_dernier') {
        const prev = shiftMonths(todayISO, -1);
        debutInput.value = firstOfMonth(prev);
        finInput.value = lastOfMonth(prev);
      } else if (preset === '3_mois') {
        debutInput.value = shiftMonths(todayISO, -3);
        finInput.value = todayISO;
      } else if (preset === '12_mois') {
        debutInput.value = shiftMonths(todayISO, -12);
        finInput.value = todayISO;
      }
    });
  });

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
    statusEl.hidden = true;
  }

  function clearError() {
    errorEl.hidden = true;
  }

  function setBusy(busy) {
    btnDownload.disabled = busy;
    btnCopy.disabled = busy;
    btnDownload.textContent = busy ? 'Génération…' : 'Télécharger';
    btnCopy.textContent = busy ? 'Génération…' : 'Copier';
  }

  function reportSize(chars) {
    const tokensApprox = Math.round(chars / 4);
    const big = chars > sizeWarningChars;
    statusEl.hidden = false;
    statusEl.classList.toggle('export-status--warning', big);
    statusEl.textContent = big
      ? `⚠ Export volumineux : ${chars.toLocaleString('fr-FR')} caractères (~${tokensApprox.toLocaleString('fr-FR')} tokens estimés) — envisagez une période plus courte si votre conversation IA a une limite de taille.`
      : `Export généré : ${chars.toLocaleString('fr-FR')} caractères (~${tokensApprox.toLocaleString('fr-FR')} tokens estimés).`;
  }

  async function fetchExport() {
    const debut = debutInput.value;
    const fin = finInput.value;
    if (!debut || !fin) {
      showError('Choisissez une date de début et une date de fin.');
      return null;
    }
    if (debut > fin) {
      showError('La date de début doit précéder la date de fin.');
      return null;
    }
    clearError();
    setBusy(true);
    try {
      const res = await fetch(`/api/admin/marges/export?debut=${debut}&fin=${fin}&coef=${exportCoef}`);
      const text = await res.text();
      if (!res.ok) {
        showError(text || 'Erreur pendant la génération de l\'export.');
        return null;
      }
      reportSize(text.length);
      return text;
    } catch (e) {
      showError('Erreur réseau pendant la génération de l\'export.');
      return null;
    } finally {
      setBusy(false);
    }
  }

  btnDownload.addEventListener('click', async () => {
    const text = await fetchExport();
    if (text == null) return;
    const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `export-marges-inca-import_${debutInput.value}_${finInput.value}.md`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  btnCopy.addEventListener('click', async () => {
    const text = await fetchExport();
    if (text == null) return;
    try {
      await navigator.clipboard.writeText(text);
      btnCopy.dataset.copied = '1';
      const original = 'Copier';
      btnCopy.textContent = 'Copié ✓';
      setTimeout(() => { btnCopy.textContent = original; btnCopy.dataset.copied = '0'; }, 2000);
    } catch (e) {
      showError('Copie automatique impossible sur ce navigateur — utilisez Télécharger.');
    }
  });
</script>

