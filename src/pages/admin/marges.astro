---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { marginColorClass } from '../../lib/constants';
import { formatDateReunion, reunionMonthStart, todayReunionISO } from '../../lib/datetime';
import { isAdmin } from '../../lib/roles';
import { EXPORT_SIZE_WARNING_CHARS } from '../../lib/margesExport';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

// Last 12 months (full calendar months, oldest first) — bornes ancrées sur
// le calendrier de La Réunion, voir reunionMonthStart().
const months: { label: string; start: string; end: string }[] = [];
for (let i = 11; i >= 0; i--) {
  const d = reunionMonthStart(i);
  const start = d.toISOString();
  const end   = reunionMonthStart(i - 1).toISOString();
  const label = formatDateReunion(d, { day: undefined, month: 'long' });
  months.push({ label: label.charAt(0).toUpperCase() + label.slice(1), start, end });
}

const rangeStart = months[0].start;

// One query for all orders in the 12-month window
const { data: orders } = await supabaseAdmin
  .from('orders')
  .select('id, created_at, order_items(quantity, price_ht_snapshot, pump_snapshot)')
  .in('status', ['confirmee', 'en_preparation', 'expediee', 'livree'])
  .gte('created_at', rangeStart);

// Aggregate by month index
type MonthRow = {
  label:        string;
  caHt:         number;
  costHt:       number;
  margeHt:      number;
  pct:          number | null;
  orderCount:   number;
  hasFullPump:  boolean;
};

const rows: MonthRow[] = months.map(m => ({
  label:       m.label,
  caHt:        0,
  costHt:      0,
  margeHt:     0,
  pct:         null,
  orderCount:  0,
  hasFullPump: true,
}));

for (const order of (orders ?? [])) {
  const ts = new Date(order.created_at).getTime();
  const mi = months.findIndex(m => ts >= new Date(m.start).getTime() && ts < new Date(m.end).getTime());
  if (mi === -1) continue;

  rows[mi].orderCount++;

  for (const item of ((order as any).order_items ?? [])) {
    const qty  = item.quantity ?? 0;
    const prix = item.price_ht_snapshot != null ? Number(item.price_ht_snapshot) : null;
    const pump = item.pump_snapshot != null ? Number(item.pump_snapshot) : null;
    if (prix == null) continue;
    rows[mi].caHt += prix * qty;
    if (pump != null) {
      rows[mi].costHt  += pump * qty;
      rows[mi].margeHt += (prix - pump) * qty;
    } else {
      rows[mi].hasFullPump = false;
    }
  }
}

// Compute pct after aggregation
for (const row of rows) {
  if (row.caHt > 0 && row.margeHt !== 0) {
    row.pct = (row.margeHt / row.caHt) * 100;
  }
}

// Totals across all 12 months
const totals = rows.reduce(
  (acc, r) => ({
    caHt:       acc.caHt   + r.caHt,
    costHt:     acc.costHt + r.costHt,
    margeHt:    acc.margeHt + r.margeHt,
    orderCount: acc.orderCount + r.orderCount,
  }),
  { caHt: 0, costHt: 0, margeHt: 0, orderCount: 0 },
);
const totalPct = totals.caHt > 0 ? (totals.margeHt / totals.caHt) * 100 : null;

function fmtEur(n: number) {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 });
}

// This page's CSS keys the null case as "muted" (not the shared "none")
function margeClass(pct: number | null): string {
  const cls = marginColorClass(pct);
  return cls === 'none' ? 'muted' : cls;
}
---
<AdminLayout title="Historique des marges" activeNav="marges">

  <div class="page-head">
    <h1 class="page-title">Historique des marges</h1>
    <p class="page-desc">12 derniers mois — commandes confirmées / livrées</p>
  </div>

  <!-- Totals row -->
  <div class="totals-grid">
    <div class="total-card">
      <span class="total-label">CA total HT</span>
      <span class="total-value">{fmtEur(totals.caHt)}</span>
    </div>
    <div class="total-card">
      <span class="total-label">Coût total HT</span>
      <span class="total-value total-value--cost">{fmtEur(totals.costHt)}</span>
    </div>
    <div class="total-card">
      <span class="total-label">Marge totale HT</span>
      <span class="total-value total-value--marge">{fmtEur(totals.margeHt)}</span>
    </div>
    <div class={`total-card total-card--pct total-card--${margeClass(totalPct)}`}>
      <span class="total-label">Taux de marge moyen</span>
      <span class="total-value">{totalPct != null ? totalPct.toFixed(1) + ' %' : '—'}</span>
    </div>
  </div>

  <!-- Monthly table -->
  <div class="table-wrap">
    <table class="marge-table">
      <thead>
        <tr>
          <th class="col-month">Mois</th>
          <th class="col-num">Commandes</th>
          <th class="col-num">CA HT</th>
          <th class="col-num">Coût HT</th>
          <th class="col-num">Marge HT</th>
          <th class="col-num">Marge %</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => {
          const cls = margeClass(r.pct);
          const isCurrent = r.label === months[11].label;
          return (
            <tr class={`${isCurrent ? 'row--current' : ''}`}>
              <td class="col-month">
                <span class="month-label">{r.label}</span>
                {!r.hasFullPump && r.caHt > 0 && (
                  <span class="partial-badge" title="Certains produits sans PUMP — marge partielle">~</span>
                )}
                {isCurrent && <span class="current-badge">Mois en cours</span>}
              </td>
              <td class="col-num td-muted">{r.orderCount > 0 ? r.orderCount : '—'}</td>
              <td class="col-num td-mono">{r.caHt > 0 ? fmtEur(r.caHt) : '—'}</td>
              <td class="col-num td-mono td-muted">{r.costHt > 0 ? fmtEur(r.costHt) : '—'}</td>
              <td class="col-num td-mono td-bold">{r.margeHt !== 0 ? fmtEur(r.margeHt) : r.caHt > 0 ? '—' : ''}</td>
              <td class="col-num">
                {r.pct != null ? (
                  <span class={`pct-chip pct-chip--${cls}`}>{r.pct.toFixed(1)} %</span>
                ) : r.caHt > 0 ? (
                  <span class="pct-chip pct-chip--none">PUMP ?</span>
                ) : (
                  <span class="td-muted">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
      <tfoot>
        <tr class="row--total">
          <td class="col-month"><strong>Total 12 mois</strong></td>
          <td class="col-num td-muted">{totals.orderCount}</td>
          <td class="col-num td-mono"><strong>{fmtEur(totals.caHt)}</strong></td>
          <td class="col-num td-mono td-muted">{fmtEur(totals.costHt)}</td>
          <td class="col-num td-mono"><strong>{fmtEur(totals.margeHt)}</strong></td>
          <td class="col-num">
            {totalPct != null ? (
              <span class={`pct-chip pct-chip--${margeClass(totalPct)}`}><strong>{totalPct.toFixed(1)} %</strong></span>
            ) : <span class="td-muted">—</span>}
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <p class="footnote">
    Marge HT = CA HT − coût PUMP. Les lignes marquées ~ incluent des produits sans PUMP — la marge est sous-estimée.
    Configurez les coûts via <a href="/admin/reception/new">Réception stock</a>.
  </p>

  <!-- Export brut pour analyse IA -->
  <details class="export-panel">
    <summary class="export-summary">Export (analyse IA)</summary>

    <div class="export-body">
      <p class="export-desc">
        Choisissez une période, puis téléchargez ou copiez toutes les données brutes de vente, marge, stock et
        réceptions sur cette période — au format texte, prêt à coller dans une conversation avec une IA.
      </p>

      <div class="export-controls">
        <div class="export-dates">
          <label>
            Début
            <input type="date" id="exportDebut" />
          </label>
          <label>
            Fin
            <input type="date" id="exportFin" />
          </label>
        </div>

        <div class="export-presets">
          <button type="button" class="btn-preset" data-preset="mois_courant">Ce mois</button>
          <button type="button" class="btn-preset" data-preset="mois_dernier">Mois dernier</button>
          <button type="button" class="btn-preset" data-preset="3_mois">3 derniers mois</button>
          <button type="button" class="btn-preset" data-preset="12_mois">12 derniers mois</button>
        </div>

        <div class="export-actions">
          <button type="button" id="exportDownload" class="btn btn-secondary">Télécharger</button>
          <button type="button" id="exportCopy" class="btn btn-primary">Copier</button>
        </div>
      </div>

      <p id="exportError" class="export-error" hidden></p>
      <p id="exportStatus" class="export-status" hidden></p>
    </div>
  </details>

</AdminLayout>

<script define:vars={{ todayISO: todayReunionISO(), sizeWarningChars: EXPORT_SIZE_WARNING_CHARS }}>
  const debutInput  = document.getElementById('exportDebut');
  const finInput    = document.getElementById('exportFin');
  const errorEl     = document.getElementById('exportError');
  const statusEl    = document.getElementById('exportStatus');
  const btnDownload = document.getElementById('exportDownload');
  const btnCopy     = document.getElementById('exportCopy');

  // Bornes par défaut : mois en cours — un point de départ raisonnable
  // avant d'ajuster ou d'utiliser un raccourci.
  finInput.value   = todayISO;
  debutInput.value = firstOfMonth(todayISO);

  function firstOfMonth(dateStr) {
    const [y, m] = dateStr.split('-');
    return `${y}-${m}-01`;
  }

  function lastOfMonth(dateStr) {
    const [y, m] = dateStr.split('-').map(Number);
    const last = new Date(y, m, 0).getDate();
    return `${y}-${String(m).padStart(2, '0')}-${String(last).padStart(2, '0')}`;
  }

  // Arithmétique calendaire pure (pas de conversion de fuseau horaire) :
  // sûr pour décaler une date de N mois sans risquer le bug de fuseau déjà
  // rencontré ailleurs sur ce projet avec new Date().toISOString().
  function shiftMonths(dateStr, delta) {
    let [y, m, d] = dateStr.split('-').map(Number);
    const total = y * 12 + (m - 1) + delta;
    y = Math.floor(total / 12);
    m = (total % 12) + 1;
    const daysInMonth = new Date(y, m, 0).getDate();
    if (d > daysInMonth) d = daysInMonth;
    return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      if (preset === 'mois_courant') {
        debutInput.value = firstOfMonth(todayISO);
        finInput.value = todayISO;
      } else if (preset === 'mois_dernier') {
        const prev = shiftMonths(todayISO, -1);
        debutInput.value = firstOfMonth(prev);
        finInput.value = lastOfMonth(prev);
      } else if (preset === '3_mois') {
        debutInput.value = shiftMonths(todayISO, -3);
        finInput.value = todayISO;
      } else if (preset === '12_mois') {
        debutInput.value = shiftMonths(todayISO, -12);
        finInput.value = todayISO;
      }
    });
  });

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
    statusEl.hidden = true;
  }

  function clearError() {
    errorEl.hidden = true;
  }

  function setBusy(busy) {
    btnDownload.disabled = busy;
    btnCopy.disabled = busy;
    btnDownload.textContent = busy ? 'Génération…' : 'Télécharger';
    btnCopy.textContent = busy ? 'Génération…' : 'Copier';
  }

  function reportSize(chars) {
    const tokensApprox = Math.round(chars / 4);
    const big = chars > sizeWarningChars;
    statusEl.hidden = false;
    statusEl.classList.toggle('export-status--warning', big);
    statusEl.textContent = big
      ? `⚠ Export volumineux : ${chars.toLocaleString('fr-FR')} caractères (~${tokensApprox.toLocaleString('fr-FR')} tokens estimés) — envisagez une période plus courte si votre conversation IA a une limite de taille.`
      : `Export généré : ${chars.toLocaleString('fr-FR')} caractères (~${tokensApprox.toLocaleString('fr-FR')} tokens estimés).`;
  }

  async function fetchExport() {
    const debut = debutInput.value;
    const fin = finInput.value;
    if (!debut || !fin) {
      showError('Choisissez une date de début et une date de fin.');
      return null;
    }
    if (debut > fin) {
      showError('La date de début doit précéder la date de fin.');
      return null;
    }
    clearError();
    setBusy(true);
    try {
      const res = await fetch(`/api/admin/marges/export?debut=${debut}&fin=${fin}`);
      const text = await res.text();
      if (!res.ok) {
        showError(text || 'Erreur pendant la génération de l\'export.');
        return null;
      }
      reportSize(text.length);
      return text;
    } catch (e) {
      showError('Erreur réseau pendant la génération de l\'export.');
      return null;
    } finally {
      setBusy(false);
    }
  }

  btnDownload.addEventListener('click', async () => {
    const text = await fetchExport();
    if (text == null) return;
    const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `export-marges-inca-import_${debutInput.value}_${finInput.value}.md`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  btnCopy.addEventListener('click', async () => {
    const text = await fetchExport();
    if (text == null) return;
    try {
      await navigator.clipboard.writeText(text);
      btnCopy.dataset.copied = '1';
      const original = 'Copier';
      btnCopy.textContent = 'Copié ✓';
      setTimeout(() => { btnCopy.textContent = original; btnCopy.dataset.copied = '0'; }, 2000);
    } catch (e) {
      showError('Copie automatique impossible sur ce navigateur — utilisez Télécharger.');
    }
  });
</script>

<style>
.page-head { margin-bottom: var(--space-6); }
.page-title { font-size: var(--text-xl); font-weight: 700; color: var(--color-ink); margin: 0 0 var(--space-1); }
.page-desc  { font-size: var(--text-sm); color: var(--color-muted); margin: 0; }

/* Totals */
.totals-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.total-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4) var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.total-label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-muted);
}

.total-value {
  font-size: 1.5rem;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--color-ink);
  letter-spacing: -0.02em;
}

.total-value--cost  { color: oklch(0.42 0.06 220); }
.total-value--marge { color: oklch(0.38 0.12 145); }

.total-card--pct .total-value { font-size: 1.75rem; }
.total-card--green { border-color: oklch(0.80 0.12 145); background: oklch(0.96 0.04 145); }
.total-card--green .total-value { color: oklch(0.32 0.14 145); }
.total-card--amber { border-color: oklch(0.84 0.10 70); background: oklch(0.97 0.04 70); }
.total-card--amber .total-value { color: oklch(0.38 0.15 55); }
.total-card--red   { border-color: oklch(0.84 0.08 25); background: oklch(0.97 0.03 25); }
.total-card--red   .total-value { color: oklch(0.46 0.18 25); }
.total-card--muted { border-color: var(--color-border); }
.total-card--muted .total-value { color: var(--color-muted); }

/* Table */
.table-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  overflow-x: auto;
  margin-bottom: var(--space-4);
}

.marge-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}

.marge-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  background: var(--color-surface);
  border-bottom: 2px solid var(--color-border);
  white-space: nowrap;
}

.marge-table tbody td,
.marge-table tfoot td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}

.marge-table tbody tr:last-child td { border-bottom: none; }
.marge-table tbody tr:hover td { background: var(--color-surface); }

.row--current td { background: oklch(0.97 0.02 220); }
.row--current:hover td { background: oklch(0.95 0.03 220) !important; }

.row--total td {
  background: var(--color-surface);
  border-top: 2px solid var(--color-border);
  border-bottom: none;
}

.col-month { width: 26%; }
.col-num   { text-align: right; white-space: nowrap; }

.month-label { font-weight: 500; color: var(--color-ink); }

.partial-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  background: oklch(0.95 0.07 60);
  color: oklch(0.38 0.14 60);
  border-radius: var(--radius-full);
  font-size: 10px;
  font-weight: 700;
  margin-left: var(--space-2);
  cursor: help;
}

.current-badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: 500;
  color: oklch(0.38 0.12 220);
  background: oklch(0.93 0.05 220);
  padding: 1px 7px;
  border-radius: var(--radius-full);
  margin-left: var(--space-2);
}

.td-mono  { font-family: var(--font-mono); text-align: right; }
.td-muted { color: var(--color-muted); }
.td-bold  { font-weight: 600; }

.pct-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}
.pct-chip--green { background: oklch(0.92 0.08 145); color: oklch(0.32 0.14 145); }
.pct-chip--amber { background: oklch(0.95 0.07 60);  color: oklch(0.38 0.15 55);  }
.pct-chip--red   { background: oklch(0.95 0.04 25);  color: oklch(0.46 0.18 25);  }
.pct-chip--none  { background: var(--color-surface-2); color: var(--color-muted); font-weight: 400; }

.footnote {
  font-size: var(--text-xs);
  color: var(--color-muted);
  margin: 0;
  line-height: 1.6;
}
.footnote a { color: var(--color-primary-deep); }

@media (max-width: 768px) {
  .totals-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .totals-grid { grid-template-columns: 1fr; }
}

/* Export panel */
.export-panel {
  margin-top: var(--space-6);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4) var(--space-5);
}

.export-summary {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
  cursor: pointer;
  user-select: none;
}
.export-summary:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

.export-body { margin-top: var(--space-4); }

.export-desc {
  font-size: var(--text-sm);
  color: var(--color-muted);
  line-height: 1.6;
  margin: 0 0 var(--space-4);
  max-width: 68ch;
}

.export-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.export-dates {
  display: flex;
  gap: var(--space-3);
}
.export-dates label {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-muted);
}
.export-dates input[type="date"] {
  padding: 0.5rem 0.75rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  min-height: 40px;
}
.export-dates input[type="date"]:focus { outline: none; border-color: var(--color-primary); }

.export-presets {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.btn-preset {
  padding: 0.5rem 0.875rem;
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--dur-fast), border-color var(--dur-fast);
}
.btn-preset:hover { background: var(--color-surface-2); border-color: var(--color-border-strong); }

.export-actions {
  display: flex;
  gap: var(--space-3);
  margin-left: auto;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 0.8125rem 1.625rem;
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  cursor: pointer;
  min-height: 44px;
  transition: background var(--dur-fast), border-color var(--dur-fast);
}
.btn-secondary:hover { background: var(--color-surface); }
