---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { marginColorClass, MONTHLY_MARGIN_BREAKEVEN_FALLBACK } from '../../lib/constants';
import { formatDateReunion, reunionMonthStart, todayReunionISO } from '../../lib/datetime';
import { isAdmin } from '../../lib/roles';
import { EXPORT_SIZE_WARNING_CHARS } from '../../lib/margesExport';
import { sanitizeText } from '../../lib/sanitize';
import { logAdminAction } from '../../lib/audit';
import {
  fetchCharges, computeMonthlyChargesTotal, groupActiveChargesByCategory,
  chargeMonthlyEquivalent, projectCharges,
  CHARGE_CATEGORIES, CHARGE_CATEGORY_LABEL, CHARGE_PERIODICITES, CHARGE_PERIODICITE_LABEL,
  MONTHS_HISTORY_FOR_PROJECTION, MONTHS_AHEAD_FOR_PROJECTION,
} from '../../lib/charges';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

const adminEmail = (Astro.locals as any).user?.email ?? 'inconnu';
const todayISO = todayReunionISO();

// ── POST : créer ou modifier une charge (jamais de suppression — on
//    clôture en renseignant date_fin, pour ne pas fausser l'historique) ────
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action') as string;

  if (action === 'save_charge') {
    const id = ((form.get('id') as string | null) ?? '').trim() || null;
    const libelle = sanitizeText(form.get('libelle') as string, 120);
    const categorie = form.get('categorie') as string;
    const periodicite = form.get('periodicite') as string;
    const montantRaw = ((form.get('montant_ht') as string | null) ?? '').trim();
    const montant_ht = parseFloat(montantRaw.replace(',', '.'));
    const date_debut = ((form.get('date_debut') as string | null) ?? '').trim();
    const date_finRaw = ((form.get('date_fin') as string | null) ?? '').trim();
    const date_fin = date_finRaw || null;
    const notes = sanitizeText(form.get('notes') as string, 500) || null;

    const categorieValide = (CHARGE_CATEGORIES as readonly string[]).includes(categorie);
    const periodiciteValide = (CHARGE_PERIODICITES as readonly string[]).includes(periodicite);
    const dateDebutValide = /^\d{4}-\d{2}-\d{2}$/.test(date_debut);
    const dateFinValide = date_fin == null || /^\d{4}-\d{2}-\d{2}$/.test(date_fin);

    if (!libelle || !categorieValide || !periodiciteValide || !dateDebutValide) {
      return Astro.redirect('/admin/marges?charges_err=champs_manquants#charges');
    }
    if (!Number.isFinite(montant_ht) || montant_ht < 0) {
      return Astro.redirect('/admin/marges?charges_err=montant_invalide#charges');
    }
    if (!dateFinValide || (date_fin != null && date_fin < date_debut)) {
      return Astro.redirect('/admin/marges?charges_err=dates_invalides#charges');
    }

    const payload = {
      libelle, categorie, periodicite, notes,
      montant_ht: Math.round(montant_ht * 100) / 100,
      date_debut, date_fin,
    };

    if (id) {
      const { error } = await supabaseAdmin.from('charges').update(payload).eq('id', id);
      if (error) return Astro.redirect('/admin/marges?charges_err=erreur#charges');
      await logAdminAction({
        adminEmail, action: 'charges.modification',
        targetType: 'charge', targetId: id, targetLabel: libelle, details: payload,
      });
    } else {
      const { data: inserted, error } = await supabaseAdmin.from('charges').insert(payload).select('id').single();
      if (error) return Astro.redirect('/admin/marges?charges_err=erreur#charges');
      await logAdminAction({
        adminEmail, action: 'charges.creation',
        targetType: 'charge', targetId: inserted?.id, targetLabel: libelle, details: payload,
      });
    }

    return Astro.redirect('/admin/marges?charges_saved=1#charges');
  }
}

const chargesSaved = Astro.url.searchParams.get('charges_saved') === '1';
const chargesErr = Astro.url.searchParams.get('charges_err');
const CHARGES_ERR_LABEL: Record<string, string> = {
  champs_manquants: 'Libellé, catégorie, périodicité et date de début sont obligatoires.',
  montant_invalide: 'Le montant HT doit être un nombre positif.',
  dates_invalides: 'La date de fin doit être postérieure ou égale à la date de début.',
  erreur: "Erreur lors de l'enregistrement — réessayez.",
};

const coefRaw = Astro.url.searchParams.get('coef');
const coefPct = coefRaw != null && Number.isFinite(Number(coefRaw)) && Number(coefRaw) >= 0 ? Number(coefRaw) : 100;

// ── Données ────────────────────────────────────────────────────────────
const charges = await fetchCharges();

// 12 derniers mois (calendrier complet, le plus ancien en premier) — bornes
// ancrées sur le calendrier de La Réunion, voir reunionMonthStart().
const months: { label: string; start: Date; end: Date }[] = [];
for (let i = 11; i >= 0; i--) {
  const d = reunionMonthStart(i);
  const end = reunionMonthStart(i - 1);
  const label = formatDateReunion(d, { day: undefined, month: 'long' });
  months.push({ label: label.charAt(0).toUpperCase() + label.slice(1), start: d, end });
}

const rangeStart = months[0].start.toISOString();

const { data: orders } = await supabaseAdmin
  .from('orders')
  .select('id, created_at, order_items(product_id, quantity, price_ht_snapshot, pump_snapshot)')
  .in('status', ['confirmee', 'en_preparation', 'expediee', 'livree'])
  .gte('created_at', rangeStart);

type MonthRow = {
  label: string; start: Date; end: Date;
  caHt: number; costHt: number; margeHt: number; pct: number | null; orderCount: number; hasFullPump: boolean;
  chargesHt: number; resultatNet: number; resultatPct: number | null; hasNoCharges: boolean;
};

const rows: MonthRow[] = months.map(m => ({
  label: m.label, start: m.start, end: m.end,
  caHt: 0, costHt: 0, margeHt: 0, pct: null, orderCount: 0, hasFullPump: true,
  chargesHt: 0, resultatNet: 0, resultatPct: null, hasNoCharges: true,
}));

const productsSoldIds = new Set<string>();
const productsWithoutCostIds = new Set<string>();

for (const order of (orders ?? [])) {
  const ts = new Date(order.created_at).getTime();
  const mi = months.findIndex(m => ts >= m.start.getTime() && ts < m.end.getTime());
  if (mi === -1) continue;

  rows[mi].orderCount++;

  for (const item of ((order as any).order_items ?? [])) {
    const qty  = item.quantity ?? 0;
    const prix = item.price_ht_snapshot != null ? Number(item.price_ht_snapshot) : null;
    const pump = item.pump_snapshot != null ? Number(item.pump_snapshot) : null;
    if (prix == null) continue;

    if (item.product_id) productsSoldIds.add(item.product_id);

    rows[mi].caHt += prix * qty;
    if (pump != null) {
      rows[mi].costHt  += pump * qty;
      rows[mi].margeHt += (prix - pump) * qty;
    } else {
      rows[mi].hasFullPump = false;
      if (item.product_id) productsWithoutCostIds.add(item.product_id);
    }
  }
}

const produitsSansCoutCount = productsWithoutCostIds.size;
const produitsVendusCount = productsSoldIds.size;

// Charges / résultat net par mois, puis pourcentages (après agrégation)
for (const row of rows) {
  row.chargesHt = computeMonthlyChargesTotal(charges, row.start, row.end);
  row.hasNoCharges = row.chargesHt === 0;
  row.resultatNet = row.margeHt - row.chargesHt;
  if (row.caHt > 0 && row.margeHt !== 0) row.pct = (row.margeHt / row.caHt) * 100;
  if (row.caHt > 0) row.resultatPct = (row.resultatNet / row.caHt) * 100;
}

const totals = rows.reduce(
  (acc, r) => ({
    caHt: acc.caHt + r.caHt, costHt: acc.costHt + r.costHt, margeHt: acc.margeHt + r.margeHt,
    orderCount: acc.orderCount + r.orderCount, chargesHt: acc.chargesHt + r.chargesHt, resultatNet: acc.resultatNet + r.resultatNet,
  }),
  { caHt: 0, costHt: 0, margeHt: 0, orderCount: 0, chargesHt: 0, resultatNet: 0 },
);
const totalPct = totals.caHt > 0 ? (totals.margeHt / totals.caHt) * 100 : null;
const totalResultatPct = totals.caHt > 0 ? (totals.resultatNet / totals.caHt) * 100 : null;
const anyMonthMissingCharges = rows.some(r => r.hasNoCharges && r.caHt > 0);

function fmtEur(n: number) {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
function fmtEur2(n: number) {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
// Cette page utilise "muted" pour le cas nul (pas "none" comme le partagé)
function margeClass(pct: number | null): string {
  const cls = marginColorClass(pct);
  return cls === 'none' ? 'muted' : cls;
}
// Résultat net : positif ou négatif, pas de palier intermédiaire comme la marge.
function resultatClass(pct: number | null): string {
  if (pct == null) return 'muted';
  return pct >= 0 ? 'green' : 'red';
}

// ── Charges : regroupement par catégorie sur le mois en cours ─────────────
const currentMonthStart = months[11].start;
const currentMonthEnd = months[11].end;
const chargesByCategory = groupActiveChargesByCategory(charges, currentMonthStart, currentMonthEnd);
const totalChargesActuelles = chargesByCategory.reduce((s, g) => s + g.total, 0);

const chargesSorted = [...charges].sort((a, b) => {
  const aOuverte = a.date_fin == null || a.date_fin >= todayISO;
  const bOuverte = b.date_fin == null || b.date_fin >= todayISO;
  if (aOuverte !== bOuverte) return aOuverte ? -1 : 1;
  return a.categorie.localeCompare(b.categorie) || a.libelle.localeCompare(b.libelle);
});

// ── Prévisionnel : 6 prochains mois ────────────────────────────────────────
// Marge moyenne des N derniers mois COMPLETS (avant le mois en cours) ayant
// eu au moins une commande — un mois antérieur au démarrage de l'activité
// est omis plutôt que compté comme un zéro qui tirerait la moyenne vers le bas.
const preCurrentRows = rows.slice(11 - MONTHS_HISTORY_FOR_PROJECTION, 11);
const historicalMonthMargins = preCurrentRows.filter(r => r.orderCount > 0).map(r => r.margeHt);
const projection = projectCharges(charges, historicalMonthMargins, coefPct, MONTHS_AHEAD_FOR_PROJECTION);

// ── Graphique prévisionnel (SVG statique, même esprit que le graphique du
//    tableau de bord mais sans interactivité — "simple" comme demandé) ─────
const PJ_W = 640, PJ_H = 180;
const PJ_PAD_L = 8, PJ_PAD_R = 76, PJ_PAD_T = 14, PJ_PAD_B = 24;
const pjPlotW = PJ_W - PJ_PAD_L - PJ_PAD_R;
const pjPlotH = PJ_H - PJ_PAD_T - PJ_PAD_B;

function pjNiceMax(v: number): number {
  if (v <= 0) return 100;
  const exp  = Math.pow(10, Math.floor(Math.log10(v)));
  const norm = v / exp;
  const step = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10;
  return step * exp;
}
const pjMaxVal = Math.max(1, projection.margePrevisionnelleMensuelle, ...projection.months.map(m => m.chargesPrevisionnelles));
const pjYMax = pjNiceMax(pjMaxVal * 1.2);
const pjXAt = (i: number) => PJ_PAD_L + (i / Math.max(1, projection.months.length - 1)) * pjPlotW;
const pjYAt = (v: number) => PJ_PAD_T + pjPlotH - (Math.max(0, v) / pjYMax) * pjPlotH;

const pjPoints = projection.months.map((m, i) => ({
  label: m.label, x: pjXAt(i), margeY: pjYAt(m.margePrevisionnelle), chargesY: pjYAt(m.chargesPrevisionnelles),
  marge: m.margePrevisionnelle, charges: m.chargesPrevisionnelles,
}));
const pjMargeLinePath = pjPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.margeY.toFixed(1)}`).join(' ');
const pjChargesLinePath = pjPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.chargesY.toFixed(1)}`).join(' ');
const pjBaselineY = (PJ_PAD_T + pjPlotH).toFixed(1);
const pjMargeAreaPath = pjPoints.length > 0
  ? `${pjMargeLinePath} L${pjXAt(projection.months.length - 1).toFixed(1)},${pjBaselineY} L${pjXAt(0).toFixed(1)},${pjBaselineY} Z`
  : '';
const pjGridLines = [0, pjYMax / 2, pjYMax].map(v => ({ v, y: pjYAt(v) }));
const pjLastPoint = pjPoints[pjPoints.length - 1];
---
<AdminLayout title="Historique des marges" activeNav="marges">

  <div class="page-head">
    <h1 class="page-title">Historique des marges</h1>
    <p class="page-desc">12 derniers mois — commandes confirmées / livrées</p>
  </div>

  <!-- Totals row -->
  <div class="totals-grid">
    <div class="total-card">
      <span class="total-label">CA total HT</span>
      <span class="total-value">{fmtEur(totals.caHt)}</span>
    </div>
    <div class="total-card">
      <span class="total-label">Coût total HT</span>
      <span class="total-value total-value--cost">{fmtEur(totals.costHt)}</span>
    </div>
    <div class="total-card">
      <span class="total-label">Marge totale HT</span>
      <span class="total-value total-value--marge">{fmtEur(totals.margeHt)}</span>
    </div>
    <div class="total-card">
      <span class="total-label">Charges totales</span>
      <span class="total-value total-value--charges">{fmtEur(totals.chargesHt)}</span>
    </div>
    <div class={`total-card total-card--pct total-card--${resultatClass(totalResultatPct)}`}>
      <span class="total-label">Résultat net</span>
      <span class="total-value">{fmtEur(totals.resultatNet)}</span>
    </div>
    <div class={`total-card total-card--pct total-card--${margeClass(totalPct)}`}>
      <span class="total-label">Taux de marge moyen</span>
      <span class="total-value">{totalPct != null ? totalPct.toFixed(1) + ' %' : '—'}</span>
    </div>
  </div>

  {anyMonthMissingCharges && (
    <p class="warning-banner">
      ⚠ Certains mois ci-dessous n'ont aucune charge saisie pour leur période — leur résultat net affiché est alors
      identique à la marge brute, ce qui ne reflète pas un résultat réel. Renseignez vos charges dans la section
      « Charges fixes » ci-dessous pour un résultat net exact sur toute la période.
    </p>
  )}

  <!-- Monthly table -->
  <div class="table-wrap">
    <table class="marge-table">
      <thead>
        <tr>
          <th class="col-month">Mois</th>
          <th class="col-num">Commandes</th>
          <th class="col-num">CA HT</th>
          <th class="col-num">Coût HT</th>
          <th class="col-num">Marge HT</th>
          <th class="col-num">Marge %</th>
          <th class="col-num">Charges</th>
          <th class="col-num">Résultat net</th>
          <th class="col-num">Résultat %</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => {
          const cls = margeClass(r.pct);
          const isCurrent = r.label === months[11].label;
          const showNoChargesWarning = r.hasNoCharges && r.caHt > 0;
          return (
            <tr class={`${isCurrent ? 'row--current' : ''}`}>
              <td class="col-month">
                <span class="month-label">{r.label}</span>
                {!r.hasFullPump && r.caHt > 0 && (
                  <span class="partial-badge" title="Certains produits sans coût d'achat renseigné — marge partielle">~</span>
                )}
                {isCurrent && <span class="current-badge">Mois en cours</span>}
              </td>
              <td class="col-num td-muted">{r.orderCount > 0 ? r.orderCount : '—'}</td>
              <td class="col-num td-mono">{r.caHt > 0 ? fmtEur(r.caHt) : '—'}</td>
              <td class="col-num td-mono td-muted">{r.costHt > 0 ? fmtEur(r.costHt) : '—'}</td>
              <td class="col-num td-mono td-bold">{r.margeHt !== 0 ? fmtEur(r.margeHt) : r.caHt > 0 ? '—' : ''}</td>
              <td class="col-num">
                {r.pct != null ? (
                  <span class={`pct-chip pct-chip--${cls}`}>{r.pct.toFixed(1)} %</span>
                ) : r.caHt > 0 ? (
                  <span class="pct-chip pct-chip--none">Coût ?</span>
                ) : (
                  <span class="td-muted">—</span>
                )}
              </td>
              <td class="col-num td-mono td-muted">{r.chargesHt > 0 ? fmtEur(r.chargesHt) : '—'}</td>
              <td class="col-num td-mono td-bold">
                {r.caHt > 0 ? fmtEur(r.resultatNet) : ''}
                {showNoChargesWarning && (
                  <span class="warn-badge" title="Aucune charge saisie pour ce mois — résultat net = marge brute, pas un résultat réel.">!</span>
                )}
              </td>
              <td class="col-num">
                {r.resultatPct != null ? (
                  <span class={`pct-chip pct-chip--${resultatClass(r.resultatPct)}`}>{r.resultatPct.toFixed(1)} %</span>
                ) : (
                  <span class="td-muted">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
      <tfoot>
        <tr class="row--total">
          <td class="col-month"><strong>Total 12 mois</strong></td>
          <td class="col-num td-muted">{totals.orderCount}</td>
          <td class="col-num td-mono"><strong>{fmtEur(totals.caHt)}</strong></td>
          <td class="col-num td-mono td-muted">{fmtEur(totals.costHt)}</td>
          <td class="col-num td-mono"><strong>{fmtEur(totals.margeHt)}</strong></td>
          <td class="col-num">
            {totalPct != null ? (
              <span class={`pct-chip pct-chip--${margeClass(totalPct)}`}><strong>{totalPct.toFixed(1)} %</strong></span>
            ) : <span class="td-muted">—</span>}
          </td>
          <td class="col-num td-mono td-muted">{fmtEur(totals.chargesHt)}</td>
          <td class="col-num td-mono"><strong>{fmtEur(totals.resultatNet)}</strong></td>
          <td class="col-num">
            {totalResultatPct != null ? (
              <span class={`pct-chip pct-chip--${resultatClass(totalResultatPct)}`}><strong>{totalResultatPct.toFixed(1)} %</strong></span>
            ) : <span class="td-muted">—</span>}
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <p class="footnote">
    Marge HT = CA HT − coût d'achat. Résultat net = Marge HT − Charges. Les lignes marquées ~ incluent des produits
    sans coût d'achat renseigné — la marge est sous-estimée. Configurez les coûts via <a href="/admin/reception/new">Réception stock</a>.
    {produitsVendusCount > 0 && (
      <> Sur les {produitsVendusCount} produits vendus sur ces 12 mois, {produitsSansCoutCount} n'{produitsSansCoutCount === 1 ? 'a' : 'ont'} pas de coût d'achat renseigné et {produitsSansCoutCount === 1 ? 'est' : 'sont'} exclu{produitsSansCoutCount > 1 ? 's' : ''} des calculs de marge.</>
    )}
  </p>

  <!-- ══════════════════════════ Charges fixes ══════════════════════════ -->
  <details class="section-panel" id="charges" open={chargesSaved || !!chargesErr}>
    <summary class="section-summary">
      Charges fixes
      <span class="section-summary-hint">
        {chargesByCategory.length > 0
          ? `${chargesByCategory.reduce((s, g) => s + g.charges.length, 0)} active${chargesByCategory.reduce((s, g) => s + g.charges.length, 0) > 1 ? 's' : ''} — ${fmtEur(totalChargesActuelles)} / mois`
          : 'Aucune charge saisie'}
      </span>
    </summary>

    <div class="section-body">
      <p class="section-desc">
        Loyer, assurance, emprunt, salaires… Une charge n'est jamais supprimée : pour y mettre fin, renseignez sa
        date de fin dans le formulaire de modification — l'historique des mois passés reste ainsi exact.
        Les charges trimestrielles et annuelles sont ramenées à un équivalent mensuel pour tous les calculs.
      </p>
      <p class="section-desc">
        <strong>Pour un emprunt :</strong> catégorie « Remboursement emprunt », périodicité « Mensuelle »,
        Montant HT = la mensualité, Début = date de première échéance, Fin = date de dernière échéance
        (laissez vide tant qu'il n'est pas soldé).
      </p>

      {chargesSaved && <div class="alert alert--ok" role="status">Charge enregistrée.</div>}
      {chargesErr && <div class="alert alert--error" role="alert">{CHARGES_ERR_LABEL[chargesErr] ?? 'Erreur.'}</div>}

      {chargesByCategory.length > 0 ? (
        <div class="charges-summary">
          <table class="charges-summary-table">
            <thead>
              <tr><th>Catégorie</th><th class="th-r">Équiv. mensuel</th></tr>
            </thead>
            <tbody>
              {chargesByCategory.map(g => (
                <tr>
                  <td>{g.label}</td>
                  <td class="th-r td-mono">{fmtEur2(g.total)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="row--total">
                <td><strong>Total (mois en cours)</strong></td>
                <td class="th-r td-mono"><strong>{fmtEur2(totalChargesActuelles)}</strong></td>
              </tr>
            </tfoot>
          </table>
          <p class="charges-summary-note">Ce total est utilisé comme point mort sur le tableau de bord.</p>
        </div>
      ) : (
        <p class="charges-summary-note">
          Aucune charge saisie : le point mort du tableau de bord utilise la valeur fixée manuellement
          ({fmtEur(MONTHLY_MARGIN_BREAKEVEN_FALLBACK)}).
        </p>
      )}

      <h3 class="subsection-title">Toutes les charges</h3>
      {chargesSorted.length === 0 ? (
        <p class="panel-empty-inline">Aucune charge enregistrée pour le moment.</p>
      ) : (
        <ul class="charge-list">
          {chargesSorted.map(c => {
            const isOuverte = c.date_fin == null || c.date_fin >= todayISO;
            const equiv = chargeMonthlyEquivalent(c);
            return (
              <li class="charge-card">
                <details class="charge-details">
                  <summary class="charge-summary">
                    <span class="charge-libelle">{c.libelle}</span>
                    <span class="charge-cat">{CHARGE_CATEGORY_LABEL[c.categorie]}</span>
                    <span class="charge-montant td-mono">{fmtEur2(c.montant_ht)} <span class="td-muted">/ {CHARGE_PERIODICITE_LABEL[c.periodicite].toLowerCase()}</span></span>
                    <span class="charge-equiv td-mono">{fmtEur2(equiv)}/mois éq.</span>
                    <span class="charge-dates">
