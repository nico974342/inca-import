---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';

const currentEmail = (Astro.locals as any).user?.email ?? '';

const ADMIN_NAMES: Record<string, string> = {
  'nicolas.incana@groupe-incana.com': 'Nico',
  'arnaud.incana@groupe-incana.com': 'Arnaud',
};
function displayName(email: string): string {
  return ADMIN_NAMES[email] ?? (email.split('@')[0] || 'Admin');
}
function initial(email: string): string {
  return displayName(email).charAt(0).toUpperCase();
}
function formatTime(iso: string): string {
  return new Date(iso).toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
}

const { data: messagesRaw } = await supabaseAdmin
  .from('admin_messages')
  .select('id, sender_email, content, created_at')
  .order('created_at', { ascending: false })
  .limit(200);

const messages = (messagesRaw ?? []).reverse();
const lastCreatedAt = messages.length ? messages[messages.length - 1].created_at : null;

const ADMIN_NAMES_JSON     = JSON.stringify(ADMIN_NAMES);
const CURRENT_EMAIL_JSON   = JSON.stringify(currentEmail);
const LAST_CREATED_AT_JSON = JSON.stringify(lastCreatedAt);
---
<AdminLayout title="Chat interne" activeNav="chat">
  <div class="chat-panel">
    <div id="chatMessages" class="chat-messages">
      {messages.length === 0 ? (
        <p class="chat-empty" id="chatEmpty">Aucun message pour l'instant. Dites bonjour !</p>
      ) : (
        messages.map(m => (
          <div class={`chat-msg ${m.sender_email === currentEmail ? 'chat-msg--mine' : ''}`} data-id={m.id}>
            <span class="chat-avatar">{initial(m.sender_email)}</span>
            <div class="chat-msg-body">
              <div class="chat-msg-meta">
                <span class="chat-msg-name">{displayName(m.sender_email)}</span>
                <span class="chat-msg-time">{formatTime(m.created_at)}</span>
              </div>
              <div class="chat-bubble">{m.content}</div>
            </div>
          </div>
        ))
      )}
    </div>

    <form id="chatForm" class="chat-input-row">
      <input type="text" id="chatInput" class="chat-input" placeholder="Écrire un message…" maxlength="2000" autocomplete="off" required />
      <button type="submit" class="chat-send-btn">Envoyer</button>
    </form>
  </div>
</AdminLayout>

<script define:vars={{ ADMIN_NAMES_JSON, CURRENT_EMAIL_JSON, LAST_CREATED_AT_JSON }}>
  const ADMIN_NAMES    = JSON.parse(ADMIN_NAMES_JSON);
  const CURRENT_EMAIL  = JSON.parse(CURRENT_EMAIL_JSON);
  let lastCreatedAt     = JSON.parse(LAST_CREATED_AT_JSON);

  const messagesEl = document.getElementById('chatMessages');
  const emptyEl     = document.getElementById('chatEmpty');
  const form        = document.getElementById('chatForm');
  const input       = document.getElementById('chatInput');
  const sendBtn     = form?.querySelector('.chat-send-btn');

  function displayName(email) {
    return ADMIN_NAMES[email] || (email.split('@')[0] || 'Admin');
  }
  function initial(email) {
    return displayName(email).charAt(0).toUpperCase();
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function formatTime(iso) {
    return new Date(iso).toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
  }
  function isScrolledToBottom() {
    return messagesEl.scrollHeight - messagesEl.scrollTop - messagesEl.clientHeight < 60;
  }

  function appendMessage(m) {
    emptyEl?.remove();
    const wasAtBottom = isScrolledToBottom();

    const div = document.createElement('div');
    div.className = 'chat-msg' + (m.sender_email === CURRENT_EMAIL ? ' chat-msg--mine' : '');
    div.dataset.id = m.id;
    div.innerHTML =
      '<span class="chat-avatar">' + escapeHtml(initial(m.sender_email)) + '</span>' +
      '<div class="chat-msg-body">' +
        '<div class="chat-msg-meta">' +
          '<span class="chat-msg-name">' + escapeHtml(displayName(m.sender_email)) + '</span>' +
          '<span class="chat-msg-time">' + formatTime(m.created_at) + '</span>' +
        '</div>' +
        '<div class="chat-bubble">' + escapeHtml(m.content) + '</div>' +
      '</div>';
    messagesEl.appendChild(div);
    if (wasAtBottom) messagesEl.scrollTop = messagesEl.scrollHeight;

    lastCreatedAt = m.created_at;
    localStorage.setItem('chat_last_seen', m.created_at);
  }

  async function poll() {
    try {
      const res = await fetch('/api/admin/chat/messages');
      if (!res.ok) return;
      const { messages } = await res.json();
      const fresh = lastCreatedAt ? messages.filter(m => m.created_at > lastCreatedAt) : messages;
      fresh.forEach(appendMessage);
      if (!lastCreatedAt) localStorage.setItem('chat_last_seen', new Date().toISOString());
    } catch { /* silent — next tick retries */ }
  }

  // Initial state: scroll to latest, mark caught-up as of now.
  messagesEl.scrollTop = messagesEl.scrollHeight;
  localStorage.setItem('chat_last_seen', lastCreatedAt || new Date().toISOString());

  setInterval(poll, 7000);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content) return;

    input.value = '';
    input.disabled = true;
    if (sendBtn) sendBtn.disabled = true;

    try {
      const res = await fetch('/api/admin/chat/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });
      if (res.ok) {
        const { message } = await res.json();
        appendMessage(message);
      } else {
        input.value = content; // give it back so nothing is lost
      }
    } catch {
      input.value = content;
    } finally {
      input.disabled = false;
      if (sendBtn) sendBtn.disabled = false;
      input.focus();
    }
  });
</script>

<style>
.chat-panel {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: 0 1px 3px oklch(0.148 0.020 45.9 / 0.04);
  display: flex;
  flex-direction: column;
  height: 65vh;
  min-height: 380px;
  max-height: 640px;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.chat-empty {
  margin: auto;
  color: var(--color-muted);
  font-size: var(--text-sm);
  text-align: center;
}

/* Messages beyond the first poll are appended via innerHTML, so these never
   get Astro's scope attribute — every rule here must be :global(). */
:global(.chat-msg) {
  display: flex;
  gap: var(--space-3);
  max-width: 70%;
}
:global(.chat-msg--mine) {
  align-self: flex-end;
  flex-direction: row-reverse;
}

:global(.chat-avatar) {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-surface-2);
  color: var(--color-primary-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-xs);
  font-weight: 700;
  flex-shrink: 0;
}
:global(.chat-msg--mine .chat-avatar) {
  background: var(--color-primary);
  color: white;
}

:global(.chat-msg-body) {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
:global(.chat-msg--mine .chat-msg-body) { align-items: flex-end; }

:global(.chat-msg-meta) {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  font-size: var(--text-xs);
}
:global(.chat-msg-name) { font-weight: 600; color: var(--color-ink); }
:global(.chat-msg-time) { color: var(--color-muted); }

:global(.chat-bubble) {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-ink);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}
:global(.chat-msg--mine .chat-bubble) {
  background: oklch(0.568 0.149 45.9 / 0.12);
  border-color: oklch(0.568 0.149 45.9 / 0.25);
}

.chat-input-row {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid var(--color-border);
}

.chat-input {
  flex: 1;
  min-width: 0;
  padding: 10px 14px;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  outline: none;
  transition: border-color var(--dur-fast);
}
.chat-input:focus { border-color: var(--color-primary); }

.chat-send-btn {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  color: white;
  background: var(--color-primary);
  border: none;
  border-radius: var(--radius-full);
  padding: 0 var(--space-6);
  cursor: pointer;
  white-space: nowrap;
  transition: opacity var(--dur-fast);
}
.chat-send-btn:hover { opacity: 0.88; }
.chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

@media (max-width: 640px) {
  :global(.chat-msg) { max-width: 88%; }
}
</style>
