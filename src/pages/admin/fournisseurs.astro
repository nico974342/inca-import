---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { sanitizeText } from '../../lib/sanitize';
import { DELAI_LIVRAISON_DEFAUT_JOURS, COUVERTURE_CIBLE_DEFAUT_JOURS, matchSupplierName } from '../../lib/constants';
import { isAdmin } from '../../lib/roles';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

// jours_securite, cycle_commande_jours et couverture_cible_jours peuvent
// chacun ne pas encore exister selon que leur migration respective a été
// lancée — trois sondes indépendantes (plutôt qu'un seul essai/repli) pour
// rester correct quelle que soit la combinaison, sans planter toute la page.
// Hoisté avant le handler POST : les deux chemins (écriture et lecture) en
// ont besoin.
let securiteColumnMissing = false;
let cycleColumnMissing = false;
let couvertureColumnMissing = false;
{
  const probeSecurite = await supabaseAdmin.from('suppliers').select('jours_securite').limit(1);
  securiteColumnMissing = probeSecurite.error?.code === '42703';
  const probeCycle = await supabaseAdmin.from('suppliers').select('cycle_commande_jours').limit(1);
  cycleColumnMissing = probeCycle.error?.code === '42703';
  const probeCouverture = await supabaseAdmin.from('suppliers').select('couverture_cible_jours').limit(1);
  couvertureColumnMissing = probeCouverture.error?.code === '42703';
}

if (Astro.request.method === 'POST') {
  const data   = await Astro.request.formData();
  const action = data.get('action') as string;

  /** Empty means "unknown" — stored as NULL so the default takes over,
   *  which is different from a supplier that genuinely delivers in 0 days. */
  const parseDelai = (raw: FormDataEntryValue | null): number | null => {
    const s = (raw as string ?? '').trim();
    if (s === '') return null;
    const n = Number(s);
    if (!Number.isFinite(n) || n < 0) return null;
    return Math.round(n);
  };

  // Même règle que le délai : vide = inconnu (NULL, le défaut/repli prend le
  // relais), distinct d'un fournisseur qui a réellement 0 j de sécurité.
  const parseSecurite = (raw: FormDataEntryValue | null): number | null => {
    const s = (raw as string ?? '').trim();
    if (s === '') return null;
    const n = Number(s);
    if (!Number.isFinite(n) || n < 0) return null;
    return Math.round(n);
  };

  // Le cycle, lui, rejette aussi 0 (pas seulement vide/négatif) : un cycle de
  // commande de 0 jour n'a pas de sens, contrairement à une sécurité de 0 j
  // qui est une valeur légitime. 0 tapé ici est traité comme "vide" — retombe
  // sur le délai — plutôt que de rejeter tout le formulaire ; la contrainte
  // CHECK cycle_commande_jours > 0 en base reste le garde-fou final.
  const parseCycle = (raw: FormDataEntryValue | null): number | null => {
    const s = (raw as string ?? '').trim();
    if (s === '') return null;
    const n = Number(s);
    if (!Number.isFinite(n) || n <= 0) return null;
    return Math.round(n);
  };

  // Même règle que le cycle : vide OU 0 = non réglé (NULL), la page de
  // simulation retombe sur COUVERTURE_CIBLE_DEFAUT_JOURS ou la simulation
  // globale. Un fournisseur avec une couverture de 0 jour n'a pas de sens.
  const parseCouverture = (raw: FormDataEntryValue | null): number | null => {
    const s = (raw as string ?? '').trim();
    if (s === '') return null;
    const n = Number(s);
    if (!Number.isFinite(n) || n <= 0) return null;
    return Math.round(n);
  };

  if (action === 'add') {
    const name = sanitizeText(data.get('name') as string, 120)?.trim();
    if (name) {
      const insert: Record<string, unknown> = { name, delai_livraison_jours: parseDelai(data.get('delai')) };
      if (!securiteColumnMissing) insert.jours_securite = parseSecurite(data.get('securite'));
      if (!cycleColumnMissing) insert.cycle_commande_jours = parseCycle(data.get('cycle'));
      if (!couvertureColumnMissing) insert.couverture_cible_jours = parseCouverture(data.get('couverture'));
      const { error } = await supabaseAdmin.from('suppliers').insert(insert);
      if (error) {
        const reason = error.code === '23505' ? 'nom_existe' : 'erreur';
        return Astro.redirect(`/admin/fournisseurs?err=${reason}`);
      }
    }
  } else if (action === 'update') {
    const id = data.get('id') as string;
    if (id) {
      const update: Record<string, unknown> = { delai_livraison_jours: parseDelai(data.get('delai')) };
      if (!securiteColumnMissing) update.jours_securite = parseSecurite(data.get('securite'));
      if (!cycleColumnMissing) update.cycle_commande_jours = parseCycle(data.get('cycle'));
      if (!couvertureColumnMissing) update.couverture_cible_jours = parseCouverture(data.get('couverture'));
      const { error } = await supabaseAdmin.from('suppliers').update(update).eq('id', id);
      if (error) return Astro.redirect('/admin/fournisseurs?err=erreur');
    }
  } else if (action === 'link_supplier_name') {
    // Rapprochement manuel et explicite : jamais automatique (voir
    // matchSupplierName) — l'admin choisit lui-même le fournisseur pour un
    // texte ambigu ou inconnu. Ne touche que les lignes dont supplier_id est
    // encore NULL, avec ce texte exact — un texte déjà lié à un autre
    // fournisseur n'est jamais réécrit ici.
    const rawName = (data.get('raw_name') as string ?? '').trim();
    const targetSupplierId = (data.get('supplier_id') as string ?? '').trim();
    if (rawName && targetSupplierId) {
      await supabaseAdmin.from('stock_receptions').update({ supplier_id: targetSupplierId })
        .eq('supplier_name', rawName).is('supplier_id', null);
      await supabaseAdmin.from('shipments').update({ supplier_id: targetSupplierId })
        .eq('supplier_name', rawName).is('supplier_id', null);
    }
    return Astro.redirect('/admin/fournisseurs?ok=rapproche');
  }
  return Astro.redirect('/admin/fournisseurs?ok=1');
}

let suppliers: any[] | null = null;
let loadErr: { code?: string } | null = null;
{
  const cols = ['id', 'name', 'delai_livraison_jours', 'created_at'];
  if (!securiteColumnMissing) cols.push('jours_securite');
  if (!cycleColumnMissing) cols.push('cycle_commande_jours');
  if (!couvertureColumnMissing) cols.push('couverture_cible_jours');
  const res = await supabaseAdmin.from('suppliers').select(cols.join(', ')).order('name', { ascending: true });
  suppliers = (res.data ?? []).map((s: any) => ({
    ...s,
    jours_securite: securiteColumnMissing ? null : s.jours_securite,
    cycle_commande_jours: cycleColumnMissing ? null : s.cycle_commande_jours,
    couverture_cible_jours: couvertureColumnMissing ? null : s.couverture_cible_jours,
  }));
  loadErr = res.error;
}


// ── Rapprochement fournisseur : identifiant stable d'abord, rapprochement en
//    direct par nom normalisé sinon — même logique que /admin/commande-
//    fournisseur (voir matchSupplierName). Alimente à la fois le nombre de
//    produits par fournisseur ci-dessous et le panneau "à rapprocher". ──
const probeReceptionSupplierId = await supabaseAdmin.from('stock_receptions').select('supplier_id').limit(1);
const receptionSupplierIdMissing = probeReceptionSupplierId.error?.code === '42703';
const receptionCols = receptionSupplierIdMissing
  ? 'stock_receptions(supplier_name)'
  : 'stock_receptions(supplier_name, supplier_id)';

const { data: receptionRows } = await supabaseAdmin
  .from('stock_reception_items')
  .select(`product_id, created_at, ${receptionCols}`)
  .order('created_at', { ascending: false });

const suppliersForMatch = (suppliers ?? []).map((s: any) => ({ id: s.id, name: s.name }));
const suppliersById = new Map((suppliers ?? []).map((s: any) => [s.id, s]));

const supplierByProduct = new Map<string, string>(); // display name, for the product-count column
const unresolvedCounts = new Map<string, { count: number; status: 'ambiguous' | 'unmatched' }>();

function trackResolution(rawName: string | null | undefined, storedSupplierId: string | null | undefined) {
  if (!rawName) return null;
  if (storedSupplierId && suppliersById.has(storedSupplierId)) {
    return suppliersById.get(storedSupplierId)!.name as string;
  }
  const m = matchSupplierName(rawName, suppliersForMatch);
  if (m.status === 'matched') return suppliersById.get(m.supplierId!)!.name as string;
  const cur = unresolvedCounts.get(rawName);
  unresolvedCounts.set(rawName, { count: (cur?.count ?? 0) + 1, status: m.status });
  return rawName;
}

for (const row of (receptionRows ?? [])) {
  if (!row.product_id || supplierByProduct.has(row.product_id)) continue;
  const rec = (row as any).stock_receptions;
  const resolvedName = trackResolution(rec?.supplier_name, receptionSupplierIdMissing ? null : rec?.supplier_id);
  if (resolvedName) supplierByProduct.set(row.product_id, resolvedName);
}

// Les expéditions en transit (shipments) ne comptent pas de produits ici
// (comptage produit = réceptions), mais leurs noms non rapprochés doivent
// remonter dans le même panneau — sinon "Big Brand" resterait invisible tant
// qu'aucune réception ne le porte.
const probeShipmentSupplierId = await supabaseAdmin.from('shipments').select('supplier_id').limit(1);
const shipmentSupplierIdMissing = probeShipmentSupplierId.error?.code === '42703';
const { data: shipmentRows } = await supabaseAdmin
  .from('shipments')
  .select(shipmentSupplierIdMissing ? 'supplier_name' : 'supplier_name, supplier_id');
for (const s of (shipmentRows ?? []) as any[]) {
  trackResolution(s.supplier_name, shipmentSupplierIdMissing ? null : s.supplier_id);
}

const unresolvedNames = [...unresolvedCounts.entries()]
  .map(([name, v]) => ({ name, ...v }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'fr'));

const productCountBySupplier = new Map<string, number>();
for (const s of supplierByProduct.values()) {
  productCountBySupplier.set(s, (productCountBySupplier.get(s) ?? 0) + 1);
}

const rows = (suppliers ?? []).map(s => ({
  ...s,
  productCount: productCountBySupplier.get(s.name) ?? 0,
}));
const missingDelai = rows.filter(r => r.delai_livraison_jours == null).length;

const ok  = !!Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const ERR_MSG: Record<string, string> = {
  nom_existe: 'Un fournisseur porte déjà ce nom.',
  erreur:     "L'enregistrement a échoué. Veuillez réessayer.",
};

// PostgREST reports an unknown table as PGRST205 ("not in the schema cache"),
// not the raw Postgres 42P01 — accept both.
const tableMissing = loadErr?.code === 'PGRST205' || loadErr?.code === '42P01';
---
<AdminLayout title="Fournisseurs" activeNav="fournisseurs">
  <p class="intro">
    Délai d'acheminement, sécurité et couverture cible par fournisseur, utilisés par le
    <a href="/admin/commande-fournisseur">simulateur de commande</a> pour savoir combien de temps
    couvrir et quel stock viser après réception. Un fournisseur sans délai renseigné retombe sur
    {DELAI_LIVRAISON_DEFAUT_JOURS} jours par défaut, sans couverture renseignée sur {COUVERTURE_CIBLE_DEFAUT_JOURS} jours.
  </p>

  {tableMissing ? (
    <div class="alert alert--error" role="alert">
      La table <code>suppliers</code> n'existe pas encore. Lancez la migration
      <code>supabase/migrations/suppliers_table.sql</code> dans Supabase, puis rechargez cette page.
    </div>
  ) : (
    <>
      {securiteColumnMissing && (
        <div class="alert alert--warn" role="status">
          La colonne <code>jours_securite</code> n'existe pas encore. Lancez
          <code>supabase/migrations/suppliers_jours_securite.sql</code> pour pouvoir la renseigner —
          en attendant, le stock de sécurité est traité comme nul partout.
        </div>
      )}
      {cycleColumnMissing && (
        <div class="alert alert--warn" role="status">
          La colonne <code>cycle_commande_jours</code> n'existe pas encore. Lancez
          <code>supabase/migrations/suppliers_cycle_commande.sql</code> pour pouvoir la renseigner —
          en attendant, le cycle de commande retombe sur le délai d'acheminement pour tous les fournisseurs.
        </div>
      )}
      {couvertureColumnMissing && (
        <div class="alert alert--warn" role="status">
          La colonne <code>couverture_cible_jours</code> n'existe pas encore. Lancez
          <code>supabase/migrations/suppliers_couverture_cible.sql</code> pour pouvoir la renseigner —
          en attendant, tous les fournisseurs utilisent {COUVERTURE_CIBLE_DEFAUT_JOURS} jours par défaut
          (ou la simulation globale, si activée sur le simulateur).
        </div>
      )}
      {ok  && <div class="alert alert--ok" role="status">Enregistré.</div>}
      {err && <div class="alert alert--error" role="alert">{ERR_MSG[err] ?? ERR_MSG.erreur}</div>}
      {missingDelai > 0 && (
        <div class="alert alert--warn" role="status">
          {missingDelai} fournisseur{missingDelai > 1 ? 's' : ''} sans délai renseigné —
          leurs produits sont calculés sur {DELAI_LIVRAISON_DEFAUT_JOURS} j par défaut.
        </div>
      )}

      <form method="post" class="add-form">
        <input type="hidden" name="action" value="add" />
        <div class="field">
          <label class="field-label" for="sf-name">Nouveau fournisseur</label>
          <input type="text" id="sf-name" name="name" required maxlength="120" placeholder="Nom du fournisseur" autocomplete="off" />
        </div>
        <div class="field field--narrow">
          <label class="field-label" for="sf-delai">Délai (jours)</label>
          <input type="number" id="sf-delai" name="delai" min="0" step="1" placeholder="—" />
        </div>
        <div class="field field--narrow">
          <label class="field-label" for="sf-securite">Sécurité (jours)</label>
          <input type="number" id="sf-securite" name="securite" min="0" step="1" placeholder="0" disabled={securiteColumnMissing} />
        </div>
        <div class="field field--narrow">
          <label class="field-label" for="sf-cycle">Cycle (jours)</label>
          <input
            type="number"
            id="sf-cycle"
            name="cycle"
            min="1"
            step="1"
            placeholder="= délai"
            disabled={cycleColumnMissing}
            title="Rythme réel de commande chez ce fournisseur — vide = retombe sur le délai"
          />
        </div>
        <div class="field field--narrow">
          <label class="field-label" for="sf-couverture">Couverture cible (jours)</label>
          <input
            type="number"
            id="sf-couverture"
            name="couverture"
            min="1"
            step="1"
            placeholder={String(COUVERTURE_CIBLE_DEFAUT_JOURS)}
            disabled={couvertureColumnMissing}
            title="Stock (ventes normales) à viser après réception chez ce fournisseur — vide = retombe sur le défaut"
          />
        </div>
        <button type="submit" class="btn btn-primary">Ajouter</button>
      </form>

      {rows.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">Aucun fournisseur.</p>
          <p class="empty-body">Ajoutez-en un ci-dessus, ou lancez la migration pour importer ceux déjà présents dans vos réceptions.</p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Fournisseur</th>
                <th class="th-num">Produits</th>
                <th class="th-num">Délai d'acheminement</th>
                <th class="th-num">Cycle de commande</th>
                <th class="th-num">Sécurité</th>
                <th class="th-num">Couverture cible après réception</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {rows.map(s => (
                <tr class={s.delai_livraison_jours == null ? 'row--missing' : ''}>
                  <td class="td-strong">{s.name}</td>
                  <td class="th-num td-muted">{s.productCount || '—'}</td>
                  <td class="th-num">
                    <form method="post" class="inline-form" id={`sup-form-${s.id}`}>
                      <input type="hidden" name="action" value="update" />
                      <input type="hidden" name="id" value={s.id} />
                      <input
                        type="number"
                        name="delai"
                        class="delai-input"
                        min="0"
                        step="1"
                        value={s.delai_livraison_jours ?? ''}
                        placeholder={String(DELAI_LIVRAISON_DEFAUT_JOURS)}
                        aria-label={`Délai en jours pour ${s.name}`}
                      />
                      <span class="unit">j</span>
                    </form>
                  </td>
                  <td class="th-num">
                    <input
                      type="number"
                      name="cycle"
                      form={`sup-form-${s.id}`}
                      class="delai-input"
                      min="1"
                      step="1"
                      value={s.cycle_commande_jours ?? ''}
                      placeholder={String(s.delai_livraison_jours ?? DELAI_LIVRAISON_DEFAUT_JOURS)}
                      disabled={cycleColumnMissing}
                      aria-label={`Cycle de commande en jours pour ${s.name}`}
                      title="Rythme réel de commande chez ce fournisseur — vide = retombe sur le délai"
                    />
                    <span class="unit">j</span>
                  </td>
                  <td class="th-num">
                    <input
                      type="number"
                      name="securite"
                      form={`sup-form-${s.id}`}
                      class="delai-input"
                      min="0"
                      step="1"
                      value={s.jours_securite ?? ''}
                      placeholder="0"
                      disabled={securiteColumnMissing}
                      aria-label={`Stock de sécurité en jours pour ${s.name}`}
                      title="Stock de sécurité, en jours de vente au rythme ajusté"
                    />
                    <span class="unit">j</span>
                  </td>
                  <td class="th-num">
                    <input
                      type="number"
                      name="couverture"
                      form={`sup-form-${s.id}`}
                      class="delai-input"
                      min="1"
                      step="1"
                      value={s.couverture_cible_jours ?? ''}
                      placeholder={String(COUVERTURE_CIBLE_DEFAUT_JOURS)}
                      disabled={couvertureColumnMissing}
                      aria-label={`Couverture cible en jours pour ${s.name}`}
                      title="Stock (ventes normales) à viser après réception — vide = retombe sur le défaut ou la simulation globale"
                    />
                    <span class="unit">j</span>
                    <button type="submit" form={`sup-form-${s.id}`} class="save-btn" aria-label="Enregistrer">✓</button>
                  </td>
                  <td class="td-note">
                    {s.delai_livraison_jours == null && (
                      <span class="badge-default">défaut {DELAI_LIVRAISON_DEFAUT_JOURS} j</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {unresolvedNames.length > 0 && (
        <section class="reconcile-section">
          <h2 class="reconcile-title">À rapprocher ({unresolvedNames.length})</h2>
          <p class="reconcile-intro">
            Ces noms, saisis sur une réception ou une expédition, ne correspondent avec certitude à aucun
            fournisseur ci-dessus — jamais fusionnés automatiquement. Choisissez le bon fournisseur pour lier
            les entrées existantes portant exactement ce texte, ou créez le fournisseur manquant ci-dessus
            puis revenez ici.
          </p>
          <div class="reconcile-list">
            {unresolvedNames.map(u => (
              <div class="reconcile-row">
                <div class="reconcile-name-wrap">
                  <span class="reconcile-name">{u.name}</span>
                  <span class={`reconcile-badge reconcile-badge--${u.status}`}>
                    {u.status === 'ambiguous' ? 'plusieurs correspondances' : 'aucune correspondance'}
                  </span>
                  <span class="reconcile-count">{u.count} référence{u.count > 1 ? 's' : ''}</span>
                </div>
                <form method="post" class="reconcile-form">
                  <input type="hidden" name="action" value="link_supplier_name" />
                  <input type="hidden" name="raw_name" value={u.name} />
                  <select name="supplier_id" class="reconcile-select" required>
                    <option value="" disabled selected>— Lier à —</option>
                    {(suppliers ?? []).map((s: any) => <option value={s.id}>{s.name}</option>)}
                  </select>
                  <button type="submit" class="btn btn-ghost">Lier</button>
                </form>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</AdminLayout>

<style>
.intro {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin-bottom: var(--space-5);
  max-width: 74ch;
}
.intro a { color: var(--color-primary-deep); }

.alert {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid;
}
.alert code { font-family: var(--font-mono); font-size: 0.9em; }
.alert--ok    { color: oklch(0.40 0.12 150); background: oklch(0.96 0.04 150); border-color: oklch(0.86 0.08 150); }
.alert--error { color: oklch(0.46 0.18 25);  background: oklch(0.97 0.03 25);  border-color: oklch(0.88 0.07 25); }
.alert--warn  { color: oklch(0.42 0.14 60);  background: oklch(0.96 0.05 60);  border-color: oklch(0.87 0.09 60); }

.add-form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--space-3);
  padding: var(--space-4);
  margin-bottom: var(--space-5);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.field { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 200px; }
.field--narrow { flex: 0 0 140px; min-width: 140px; }
.field-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.field input {
  padding: 0.5rem 0.75rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  min-height: 40px;
  outline: none;
}
.field input:focus { border-color: var(--color-primary); }

.table-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow-x: auto;
}
.data-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.data-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.th-num { text-align: right; }
.data-table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.td-strong { font-weight: 500; color: var(--color-ink); }
.td-muted  { color: var(--color-muted); }
.td-note   { text-align: right; white-space: nowrap; }

.row--missing td { background: oklch(0.985 0.012 60); }

.inline-form {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
}
.delai-input {
  width: 90px;
