---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';

// ── "Actions de la semaine" — add/toggle handled inline, like other admin
//    pages in this app (no separate API route for a widget this small). ──
if (Astro.request.method === 'POST') {
  const data   = await Astro.request.formData();
  const action = data.get('action') as string;

  if (action === 'add') {
    const content = (data.get('content') as string)?.trim().slice(0, 200);
    if (content) await supabaseAdmin.from('weekly_tasks').insert({ content });
  } else if (action === 'toggle') {
    const id   = data.get('id') as string;
    const done = data.get('done') === 'true';
    if (id) {
      await supabaseAdmin
        .from('weekly_tasks')
        .update({ done, done_at: done ? new Date().toISOString() : null })
        .eq('id', id);
    }
  }

  return Astro.redirect('/admin/taches');
}

// Pending tasks stay visible no matter how old; done ones self-clear after
// 14 days so the widget doesn't accumulate stale checked-off clutter.
const taskFreshnessCutoff = new Date(Date.now() - 14 * 24 * 60 * 60 * 1000).toISOString();

const { data: weeklyTasksRaw } = await supabaseAdmin
  .from('weekly_tasks')
  .select('id, content, done, created_at, done_at')
  .or(`done.eq.false,and(done.eq.true,done_at.gte.${taskFreshnessCutoff})`)
  .order('created_at', { ascending: true });

const pendingTasks = (weeklyTasksRaw ?? []).filter(t => !t.done);
const doneTasks = (weeklyTasksRaw ?? [])
  .filter(t => t.done)
  .sort((a, b) => new Date(b.done_at ?? b.created_at).getTime() - new Date(a.done_at ?? a.created_at).getTime());
---
<AdminLayout title="Tâches" activeNav="taches">
  <div class="tasks-page-shell">
    <div class="panel tasks-panel">
      <div class="panel-header">
        <h2 class="panel-title">Actions de la semaine</h2>
      </div>
      <div class="tasks-body">
        <form method="post" class="task-add-form">
          <input type="hidden" name="action" value="add" />
          <input type="text" name="content" class="task-add-input" placeholder="Ajouter une tâche…" maxlength="200" required autocomplete="off" />
          <button type="submit" class="task-add-btn">Ajouter</button>
        </form>

        {pendingTasks.length === 0 && doneTasks.length === 0 ? (
          <p class="panel-empty">Aucune tâche pour l'instant.</p>
        ) : (
          <ul class="task-list">
            {pendingTasks.map(t => (
              <li class="task-item">
                <form method="post" class="task-toggle-form">
                  <input type="hidden" name="action" value="toggle" />
                  <input type="hidden" name="id" value={t.id} />
                  <input type="hidden" name="done" value="true" />
                  <label class="task-label">
                    <input type="checkbox" class="task-checkbox" />
                    <span class="task-text">{t.content}</span>
                  </label>
                </form>
              </li>
            ))}
            {doneTasks.map(t => (
              <li class="task-item task-item--done">
                <form method="post" class="task-toggle-form">
                  <input type="hidden" name="action" value="toggle" />
                  <input type="hidden" name="id" value={t.id} />
                  <input type="hidden" name="done" value="false" />
                  <label class="task-label">
                    <input type="checkbox" class="task-checkbox" checked />
                    <span class="task-text task-text--done">{t.content}</span>
                  </label>
                </form>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Checking/unchecking a task submits its (already-flipped) hidden "done"
  // value — the form is the toggle, the checkbox is just its visible face.
  document.querySelectorAll<HTMLInputElement>('.task-toggle-form .task-checkbox').forEach(cb => {
    cb.addEventListener('change', () => {
      (cb.closest('form') as HTMLFormElement | null)?.requestSubmit();
    });
  });
</script>

<style>
.tasks-page-shell { max-width: 720px; }

.panel {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 1px 3px oklch(0.148 0.020 45.9 / 0.04);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--color-border);
  flex-wrap: wrap;
}

.panel-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
}

.panel-empty {
  padding: var(--space-6) var(--space-5);
  font-size: var(--text-sm);
  color: var(--color-muted);
  text-align: center;
}

.tasks-body { padding: var(--space-4) var(--space-5) var(--space-5); }

.task-add-form {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}
.task-add-input {
  flex: 1;
  min-width: 0;
  padding: 8px 12px;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color var(--dur-fast);
}
.task-add-input:focus { border-color: var(--color-primary); }
.task-add-btn {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  color: white;
  background: var(--color-primary);
  border: none;
  border-radius: var(--radius-sm);
  padding: 0 var(--space-5);
  cursor: pointer;
  white-space: nowrap;
  transition: opacity var(--dur-fast);
}
.task-add-btn:hover { opacity: 0.88; }

.task-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.task-item {
  border-bottom: 1px solid var(--color-border);
}
.task-item:last-child { border-bottom: none; }
.task-toggle-form { display: contents; }

.task-label {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) 0;
  cursor: pointer;
}
.task-checkbox {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  accent-color: var(--color-primary);
  cursor: pointer;
}
.task-text {
  font-size: var(--text-sm);
  color: var(--color-ink);
}
.task-text--done {
  color: var(--color-muted);
  text-decoration: line-through;
}
</style>
