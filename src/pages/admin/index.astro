---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { ORDER_STATUS_LABEL, ORDER_STATUS_COLOR, CONTACT_STATUS_LABEL, CONTACT_STATUS_COLOR, computeGmroi, gmroiColorClass, computeStockRotation, rotationColorClass, MONTHLY_MARGIN_BREAKEVEN_FALLBACK } from '../../lib/constants';
import { formatDateReunion, reunionMonthStart } from '../../lib/datetime';
import { isAdmin } from '../../lib/roles';
import { fetchCharges, resolveBreakEven } from '../../lib/charges';

// Marge, valeur de stock, produits à surveiller : ce tableau de bord est
// admin uniquement. Un commercial voit une version allégée à la place.
if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin/tableau-de-bord');

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'] as const;

// ── 6 calendar months (oldest first, current month last), for the chart ──
// Bornes ancrées sur le calendrier de La Réunion, pas celui du serveur
// (UTC) — sinon une commande passée juste après minuit heure réunionnaise
// tombe dans le mauvais mois tant que le serveur n'a pas encore basculé.
const MONTHS_BACK = 6;
const monthDefs: { label: string; start: Date; end: Date }[] = [];
for (let i = MONTHS_BACK - 1; i >= 0; i--) {
  const start = reunionMonthStart(i);
  const end   = reunionMonthStart(i - 1);
  const label = formatDateReunion(start, { day: undefined, year: undefined, month: 'short' }).replace('.', '');
  monthDefs.push({ label: label.charAt(0).toUpperCase() + label.slice(1), start, end });
}

// Order data is fetched 12 months back (for GMROI) in one query; the chart
// simply ignores rows older than its own 6-month window (idx === -1 below).
const marginWindowStart = reunionMonthStart(12).toISOString();

const [
  { count: commandesEnAttente },
  { count: livraisonsEnAttente },
  { count: clientsEnAttente },
  { data: recentOrders },
  { data: recentContacts },
  { data: twelveMonthOrders },
  { data: allProductsRaw },
  charges,
] = await Promise.all([
  supabaseAdmin.from('orders').select('*', { count: 'exact', head: true }).eq('status', 'en_attente'),
  supabaseAdmin.from('orders').select('*', { count: 'exact', head: true }).in('status', ['confirmee', 'en_preparation', 'expediee']),
  supabaseAdmin.from('client_accounts').select('*', { count: 'exact', head: true }).eq('status', 'en_attente'),
  supabaseAdmin.from('orders').select('id, nom, societe, status, created_at').order('created_at', { ascending: false }).limit(5),
  supabaseAdmin.from('contact_requests').select('id, nom, societe, status, created_at').order('created_at', { ascending: false }).limit(5),
  supabaseAdmin
    .from('orders')
    .select('id, created_at, status, order_items(product_id, product_name, quantity, unit, price_ht_snapshot, pump_snapshot, products(category))')
    .in('status', REVENUE_STATUSES)
    .gte('created_at', marginWindowStart),
  supabaseAdmin.from('products').select('id, name, stock_quantity, prix_achat_moyen_ht, price_ht'),
  fetchCharges(),
]);

// ── Bucket the order set by month for the 6-month chart, aggregate
//    current-month products/categories, AND sum 12-month margin per
//    product for GMROI — all in one pass over one query's data. ──────────
type MonthBucket = { label: string; caHt: number; margeHt: number; hasPump: boolean; orderCount: number };
const buckets: MonthBucket[] = monthDefs.map(m => ({ label: m.label, caHt: 0, margeHt: 0, hasPump: false, orderCount: 0 }));

const productAgg = new Map<string, { productId: string | null; name: string; unit: string | null; qty: number; ca: number; marge: number; hasPump: boolean }>();
const categoryAgg = new Map<string, number>();
const categoryMargeAgg = new Map<string, number>();
const categoryMargePartial = new Set<string>();
const margin12moByProduct = new Map<string, number>();
const cogs12moByProduct = new Map<string, number>();
const CURRENT_IDX = MONTHS_BACK - 1;

// Mois en cours seulement : part déjà livrée (acquise) vs part encore sur
// des commandes confirmées/en préparation/expédiées (pas encore acquise —
// une commande non livrée peut encore être annulée ou modifiée). Sommées
// avec les mêmes filtres que buckets[].caHt/margeHt (prix non nul pour le
// CA, prix ET pump non nuls pour la marge) — livrée + en cours doit donc
// toujours reconstituer exactement le total du mois.
let caMonthLivree = 0, caMonthEnCours = 0;
let margeMonthLivree = 0, margeMonthEnCours = 0;

for (const order of (twelveMonthOrders ?? [])) {
  const ts = new Date(order.created_at).getTime();
  const idx = monthDefs.findIndex(m => ts >= m.start.getTime() && ts < m.end.getTime());
  const isCurrentMonth = idx === CURRENT_IDX;
  if (idx !== -1) buckets[idx].orderCount++;
  const isLivree = (order as any).status === 'livree';

  for (const item of ((order as any).order_items ?? [])) {
    const qty  = item.quantity ?? 0;
    const prix = item.price_ht_snapshot != null ? Number(item.price_ht_snapshot) : null;
    const pump = item.pump_snapshot != null ? Number(item.pump_snapshot) : null;
    if (prix == null) continue;

    if (item.product_id != null && pump != null) {
      margin12moByProduct.set(item.product_id, (margin12moByProduct.get(item.product_id) ?? 0) + (prix - pump) * qty);
      cogs12moByProduct.set(item.product_id, (cogs12moByProduct.get(item.product_id) ?? 0) + pump * qty);
    }

    if (idx === -1) continue; // outside the 6-month chart window

    buckets[idx].caHt += prix * qty;
    if (pump != null) {
      buckets[idx].margeHt += (prix - pump) * qty;
      buckets[idx].hasPump = true;
    }

    if (isCurrentMonth) {
      if (isLivree) caMonthLivree += prix * qty; else caMonthEnCours += prix * qty;
      if (pump != null) {
        const margeLigne = (prix - pump) * qty;
        if (isLivree) margeMonthLivree += margeLigne; else margeMonthEnCours += margeLigne;
      }

      const key  = item.product_id ?? item.product_name ?? 'inconnu';
      const prev = productAgg.get(key) ?? { productId: item.product_id ?? null, name: item.product_name ?? 'Produit', unit: item.unit ?? null, qty: 0, ca: 0, marge: 0, hasPump: false };
      prev.qty += qty;
      prev.ca  += prix * qty;
      if (pump != null) {
        prev.marge += (prix - pump) * qty;
        prev.hasPump = true;
      }
      productAgg.set(key, prev);

      const cat = (item as any).products?.category ?? null;
      if (cat) {
        categoryAgg.set(cat, (categoryAgg.get(cat) ?? 0) + prix * qty);
        if (pump != null) {
          categoryMargeAgg.set(cat, (categoryMargeAgg.get(cat) ?? 0) + (prix - pump) * qty);
        } else {
          categoryMargePartial.add(cat);
        }
      }
    }
  }
}

// ── GMROI per product + "produits à surveiller" (worst performers) ───────
const allProducts = allProductsRaw ?? [];
const productGmroiList = allProducts.map(p => ({
  id: p.id,
  name: p.name,
  stock: p.stock_quantity ?? 0,
  gmroi: computeGmroi(p.stock_quantity, p.prix_achat_moyen_ht, margin12moByProduct.get(p.id) ?? null),
}));

const produitsASurveiller = productGmroiList
  .filter(p => p.gmroi != null && p.gmroi < 1 && p.stock > 0)
  .sort((a, b) => (a.gmroi ?? 0) - (b.gmroi ?? 0))
  .slice(0, 5);

const gmroiById = new Map(productGmroiList.map(p => [p.id, p.gmroi]));

// ── Taux de rotation moyen (weighted by stock value, not a plain average of
//    each product's own ratio — a product with a large stock investment
//    should move the needle more than a marginal one). Products with no
//    stock or no PUMP are excluded from both sums (can't value their stock
//    at all); a product that IS valued but never sold correctly drags the
//    average down since its stock value still counts in the denominator. ──
let totalCogs12mo = 0;
let totalStockValue = 0;
// Sell-side stock value + the "some products missing PUMP" flag ride along
// in the same pass — the sell sum only counts products that also cleared
// the PUMP gate above, so "marge potentielle" compares like for like
// instead of overstating it with cost-unknown lines.
let stockValueSell = 0;
let hasIncompleteStockValue = false;
for (const p of allProducts) {
  if (!p.stock_quantity || p.stock_quantity <= 0) continue;
  if (p.prix_achat_moyen_ht == null || p.prix_achat_moyen_ht <= 0) {
    hasIncompleteStockValue = true;
    continue;
  }
  totalStockValue += p.stock_quantity * p.prix_achat_moyen_ht;
  totalCogs12mo += cogs12moByProduct.get(p.id) ?? 0;
  if (p.price_ht != null) {
    stockValueSell += p.stock_quantity * p.price_ht;
  } else {
    hasIncompleteStockValue = true;
  }
}
const avgRotation = totalStockValue > 0 ? totalCogs12mo / totalStockValue : null;
const stockValueCost = totalStockValue;
const stockMargePotentielle = stockValueSell - stockValueCost;

const caMonth         = buckets[CURRENT_IDX].caHt;
const margeMonthHt     = buckets[CURRENT_IDX].margeHt;
const margeMonthPct    = buckets[CURRENT_IDX].hasPump && caMonth > 0 ? (margeMonthHt / caMonth) * 100 : null;
const orderCountMonth  = buckets[CURRENT_IDX].orderCount;
const panierMoyen      = orderCountMonth > 0 ? caMonth / orderCountMonth : 0;

const caPrev           = buckets[CURRENT_IDX - 1].caHt;
const margePrevPct     = buckets[CURRENT_IDX - 1].hasPump && caPrev > 0 ? (buckets[CURRENT_IDX - 1].margeHt / caPrev) * 100 : null;
const orderCountPrev   = buckets[CURRENT_IDX - 1].orderCount;
const panierMoyenPrev  = orderCountPrev > 0 ? caPrev / orderCountPrev : 0;

const missingPumpSomeMonth = buckets.some(b => b.caHt > 0 && !b.hasPump);

// ── Trend helper: direction + % change vs the prior month ────────────────
type Trend = { dir: 'up' | 'down' | 'flat' | 'none'; pct: number | null };

function trend(curr: number, prev: number): Trend {
  if (!prev) return { dir: curr > 0 ? 'up' : 'none', pct: null };
  const pct = ((curr - prev) / prev) * 100;
  if (Math.abs(pct) < 0.5) return { dir: 'flat', pct: 0 };
  return { dir: pct > 0 ? 'up' : 'down', pct };
}

function trendLabel(t: Trend, suffix = '%'): string {
  if (t.pct == null) return t.dir === 'up' ? 'Nouveau' : '—';
  const sign = t.pct > 0 ? '+' : '';
  return `${sign}${t.pct.toFixed(1)}${suffix}`;
}

const caTrend     = trend(caMonth, caPrev);
const orderTrend  = trend(orderCountMonth, orderCountPrev);
const panierTrend = trend(panierMoyen, panierMoyenPrev);

// Margin trend compares the € amount vs last month (not the margin rate) —
// a "point mort" is measured in euros, so the headline delta should be too.
const margePrevHt = buckets[CURRENT_IDX - 1].margeHt;
const margeDiffHt = margeMonthHt - margePrevHt;
const margeTrend: Trend = Math.abs(margeDiffHt) < 0.5
  ? { dir: 'flat', pct: 0 }
  : { dir: margeDiffHt > 0 ? 'up' : 'down', pct: margeDiffHt };

// ── Point mort (break-even) progress for the current month ───────────────
// Calculé sur les charges fixes réellement saisies ; repli sur la constante
// manuelle tant qu'aucune charge n'existe (voir lib/charges.ts).
const currentMonthStart = reunionMonthStart(0);
const currentMonthEndExclusive = reunionMonthStart(-1);
const breakEven = resolveBreakEven(charges, currentMonthStart, currentMonthEndExclusive, MONTHLY_MARGIN_BREAKEVEN_FALLBACK);
const breakEvenValue = breakEven.value;

const breakEvenPct: number = breakEvenValue > 0 ? (margeMonthHt / breakEvenValue) * 100 : 0;
const breakEvenColor: 'red' | 'amber' | 'green' = breakEvenPct >= 100 ? 'green' : breakEvenPct >= 50 ? 'amber' : 'red';
const breakEvenSurplus = margeMonthHt - breakEvenValue;

// Barre en deux segments : la part livrée (acquise, couleur de statut
// habituelle) puis la part encore en cours (pas acquise — commande
// confirmée/en préparation/expédiée, donc annulable ou modifiable — dans
// une couleur neutre distincte). Le total des deux segments reste plafonné
// à 100 % de la barre comme avant ; le surplus au-delà du point mort continue
// à être annoncé en texte plutôt qu'en dépassant la barre.
const breakEvenTotalWidth  = Math.min(100, Math.max(0, breakEvenPct));
const breakEvenLivreeWidth = Math.min(breakEvenTotalWidth, Math.max(0, breakEvenValue > 0 ? (margeMonthLivree / breakEvenValue) * 100 : 0));
const breakEvenEnCoursWidth = Math.max(0, breakEvenTotalWidth - breakEvenLivreeWidth);

// ── Top 5 products this month, by margin HT generated ──────────────────────
const top5Products = Array.from(productAgg.values())
  .sort((a, b) => b.marge - a.marge)
  .slice(0, 5);

// ── Category split this month ──────────────────────────────────────────
const CAT_ORDER = ['boissons', 'snacks', 'chips', 'confiseries', 'divers'] as const;
const CAT_LABEL: Record<string, string> = {
  boissons: 'Boissons', snacks: 'Snacks', chips: 'Chips', confiseries: 'Confiseries', divers: 'Divers',
};
// Chart-strength steps of the same hues used by the category badges elsewhere
// in the app (boissons/snacks/confiseries/divers = 220/60/330/275), re-stepped
// for CVD separation as solid marks (validated: adjacent ΔE 7.9, normal ΔE 16.6).
// "chips" (180, teal) was added later — at the other four's own lightness/chroma
// it clashed with confiseries under every CVD simulation tried, so it sits at a
// lighter L (0.75 vs ~0.50-0.68) to buy back separation; re-validated as a full
// 5-color set (all pairs, not just adjacent) via the dataviz skill's validator.
const CAT_COLOR: Record<string, string> = {
  boissons:    'oklch(0.60 0.14 220)',
  snacks:      'oklch(0.68 0.15 55)',
  chips:       'oklch(0.75 0.14 180)',
  confiseries: 'oklch(0.60 0.16 350)',
  divers:      'oklch(0.50 0.13 285)',
};
const categoryTotal = Array.from(categoryAgg.values()).reduce((s, v) => s + v, 0);
const categorySplit = CAT_ORDER
  .map(cat => ({ cat, label: CAT_LABEL[cat], color: CAT_COLOR[cat], ca: categoryAgg.get(cat) ?? 0 }))
  .filter(c => c.ca > 0)
  .map(c => ({ ...c, pct: categoryTotal > 0 ? (c.ca / categoryTotal) * 100 : 0 }));

// ── Margin split this month — same categories/colors, but marge HT instead
//    of CA. Lines with no PUMP recorded are excluded from the sum (can't
//    know their margin), flagged with a "*" rather than silently ignored. ──
const categoryMargeTotal = Array.from(categoryMargeAgg.values()).reduce((s, v) => s + v, 0);
const categoryMargeSplit = CAT_ORDER
  .map(cat => ({ cat, label: CAT_LABEL[cat], color: CAT_COLOR[cat], marge: categoryMargeAgg.get(cat) ?? 0, partial: categoryMargePartial.has(cat) }))
  .filter(c => c.marge > 0)
  .map(c => ({ ...c, pct: categoryMargeTotal > 0 ? (c.marge / categoryMargeTotal) * 100 : 0 }));
const categoryMargeHasPartial = categoryMargeSplit.some(c => c.partial);

// ── Trend chart geometry (plain SVG, computed server-side) ────────────────
const CHART_W = 640, CHART_H = 200;
const PAD_L = 8, PAD_R = 66, PAD_T = 14, PAD_B = 24;
const plotW = CHART_W - PAD_L - PAD_R;
const plotH = CHART_H - PAD_T - PAD_B;

function niceMax(v: number): number {
  if (v <= 0) return 100;
  const exp  = Math.pow(10, Math.floor(Math.log10(v)));
  const norm = v / exp;
  const step = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10;
  return step * exp;
}
const maxCa = Math.max(1, ...buckets.map(b => b.caHt));
const yMax  = niceMax(maxCa * 1.2);

const xAt = (i: number) => PAD_L + (i / (MONTHS_BACK - 1)) * plotW;
const yAt = (v: number) => PAD_T + plotH - (Math.max(0, v) / yMax) * plotH;

const chartPoints = buckets.map((b, i) => ({
  label: b.label, x: xAt(i), caY: yAt(b.caHt), margeY: yAt(b.margeHt),
  ca: b.caHt, marge: b.margeHt, hasPump: b.hasPump,
}));

const caLinePath    = chartPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.caY.toFixed(1)}`).join(' ');
const margeLinePath = chartPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.margeY.toFixed(1)}`).join(' ');
const baselineY = (PAD_T + plotH).toFixed(1);
const caAreaPath = `${caLinePath} L${xAt(MONTHS_BACK - 1).toFixed(1)},${baselineY} L${xAt(0).toFixed(1)},${baselineY} Z`;

const gridLines = [0, yMax / 2, yMax].map(v => ({ v, y: yAt(v) }));
const hitBandW = plotW / MONTHS_BACK;

const lastPoint = chartPoints[CURRENT_IDX];
const CHART_JSON = JSON.stringify({ points: chartPoints, width: CHART_W });

function formatDate(iso: string) {
  return formatDateReunion(iso, { year: '2-digit' });
}

function formatCA(amount: number): string {
  return new Intl.NumberFormat('fr-FR', {
    style: 'currency', currency: 'EUR',
    minimumFractionDigits: 0, maximumFractionDigits: 0,
  }).format(amount);
}

const CONTACT_LABEL = CONTACT_STATUS_LABEL;
const CONTACT_COLOR = CONTACT_STATUS_COLOR;

const hasPendingDelivery = (livraisonsEnAttente ?? 0) > 0;
const hasPendingClients  = (clientsEnAttente ?? 0) > 0;
const hasPendingOrders   = (commandesEnAttente ?? 0) > 0;
---
<AdminLayout title="Tableau de bord" activeNav="dashboard">

  <!-- ── KPI row ─────────────────────────────────────── -->
  <div class="kpi-grid">

    <div class="kpi-card">
      <div class="kpi-icon kpi-icon--green">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 13L6 9l3 3 4-5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="kpi-label">CA du mois (HT)</span>
      <span class="kpi-value">{formatCA(caMonth)}</span>
      {caMonth > 0 && (
        <span class="kpi-breakdown">
          dont <span class="kpi-breakdown--livree">{formatCA(caMonthLivree)} livrés</span>, <span class="kpi-breakdown--encours">{formatCA(caMonthEnCours)} en cours</span>
        </span>
      )}
      <span class={`kpi-trend kpi-trend--${caTrend.dir}`}>
        <span class="kpi-trend-arrow">{caTrend.dir === 'up' ? '▲' : caTrend.dir === 'down' ? '▼' : '–'}</span>
        {trendLabel(caTrend)}
        <span class="kpi-trend-caption">vs mois dernier</span>
      </span>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon kpi-icon--coral">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="5.5" cy="12.5" r="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="12.5" cy="5.5" r="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 4 5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="kpi-label">Marge du mois (HT)</span>
      <span class="kpi-value">
        {formatCA(margeMonthHt)}
        {margeMonthPct != null && <span class="kpi-value-sub">{margeMonthPct.toFixed(1)} %</span>}
      </span>
      {margeMonthHt !== 0 && (
        <span class="kpi-breakdown">
          dont <span class="kpi-breakdown--livree">{formatCA(margeMonthLivree)} livrés</span>, <span class="kpi-breakdown--encours">{formatCA(margeMonthEnCours)} en cours</span>
        </span>
      )}
      <span class={`kpi-trend kpi-trend--${margeTrend.dir}`}>
        <span class="kpi-trend-arrow">{margeTrend.dir === 'up' ? '▲' : margeTrend.dir === 'down' ? '▼' : '–'}</span>
        {margeTrend.pct == null ? '—' : `${margeTrend.pct > 0 ? '+' : margeTrend.pct < 0 ? '-' : ''}${formatCA(Math.abs(margeTrend.pct))}`}
        <span class="kpi-trend-caption">vs mois dernier</span>
      </span>
      <div class="breakeven">
        <div class="breakeven-bar">
          <div
            class={`breakeven-fill breakeven-fill--${breakEvenColor}`}
            style={`width:${breakEvenLivreeWidth}%`}
            title={`Livré : ${formatCA(margeMonthLivree)}`}
          ></div>
          <div
            class="breakeven-fill breakeven-fill--encours"
            style={`width:${breakEvenEnCoursWidth}%`}
            title={`En cours (pas encore livré) : ${formatCA(margeMonthEnCours)}`}
          ></div>
        </div>
        <div class="breakeven-label">
          <span>
            {formatCA(margeMonthHt)} / {formatCA(breakEvenValue)} <span class="breakeven-caption">point mort</span>
            <span
              class="breakeven-source"
              title={breakEven.source === 'calcule'
                ? 'Somme de vos charges fixes actives ce mois-ci (/admin/marges).'
                : `Aucune charge saisie — valeur fixée manuellement (${formatCA(MONTHLY_MARGIN_BREAKEVEN_FALLBACK)}). Configurez vos charges sur /admin/marges pour un point mort réel.`}
            >
              {breakEven.source === 'calcule' ? 'calculé sur vos charges' : 'valeur fixée manuellement'}
            </span>
          </span>
          {breakEvenPct >= 100 && <span class="breakeven-surplus">+{formatCA(breakEvenSurplus)} au-dessus du point mort</span>}
        </div>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon kpi-icon--blue">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4 5h10M4 9h10M4 13h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="kpi-label">Commandes ce mois</span>
      <span class="kpi-value">{orderCountMonth}</span>
      <span class={`kpi-trend kpi-trend--${orderTrend.dir}`}>
        <span class="kpi-trend-arrow">{orderTrend.dir === 'up' ? '▲' : orderTrend.dir === 'down' ? '▼' : '–'}</span>
        {trendLabel(orderTrend)}
        <span class="kpi-trend-caption">vs mois dernier</span>
      </span>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon kpi-icon--amber">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 6h12l-1.2 8.5a1.5 1.5 0 0 1-1.5 1.3H5.7a1.5 1.5 0 0 1-1.5-1.3L3 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M6.5 6 8 2.5M11.5 6 10 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="kpi-label">Panier moyen (HT)</span>
      <span class="kpi-value">{formatCA(panierMoyen)}</span>
      <span class={`kpi-trend kpi-trend--${panierTrend.dir}`}>
        <span class="kpi-trend-arrow">{panierTrend.dir === 'up' ? '▲' : panierTrend.dir === 'down' ? '▼' : '–'}</span>
        {trendLabel(panierTrend)}
        <span class="kpi-trend-caption">vs mois dernier</span>
      </span>
    </div>

    <div class="kpi-card">
      <div class={`kpi-icon kpi-icon--${rotationColorClass(avgRotation)}`}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 9a6 6 0 0 1 10.5-3.9M15 9a6 6 0 0 1-10.5 3.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M13.5 3v3h-3M4.5 15v-3h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="kpi-label">
        Rotation moyenne du stock
        <span
          class="help-icon"
          tabindex="0"
          title="Combien de fois votre stock se renouvelle par an, en moyenne pondérée par la valeur immobilisée. Rotation = coût des ventes sur 12 mois ÷ valeur du stock actuel. > 6x/an = excellent, 3-6x/an = correct, < 3x/an = stock qui tourne lentement."
        >?</span>
      </span>
      <span class="kpi-value">{avgRotation != null ? avgRotation.toFixed(1) + 'x/an' : '—'}</span>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon kpi-icon--violet">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5.5 9 2l7 3.5v7L9 16l-7-3.5v-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M2 5.5 9 9l7-3.5M9 9v7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="kpi-label">Valeur du stock (coût)</span>
      <span class="kpi-value">{formatCA(stockValueCost)}</span>
      <span class="kpi-extra-line">{formatCA(stockValueSell)} en prix de vente</span>
      <span class="kpi-extra-line kpi-extra-line--accent">Marge potentielle en stock : {formatCA(stockMargePotentielle)}</span>
      {hasIncompleteStockValue && (
        <p class="chart-footnote">* Valeur partielle — PUMP non défini pour certains produits.</p>
      )}
    </div>

  </div>

  <!-- ── 6-month trend chart ───────────────────────────── -->
  <div class="panel chart-panel">
      <div class="panel-header">
        <h2 class="panel-title">CA &amp; Marge — 6 derniers mois</h2>
        <div class="chart-legend">
          <span class="legend-item"><span class="legend-swatch legend-swatch--ca"></span>CA HT</span>
          <span class="legend-item"><span class="legend-swatch legend-swatch--marge"></span>Marge HT</span>
        </div>
      </div>
      <div class="chart-body">
        <div class="chart-wrap" id="chartWrap">
          <svg id="trendChart" viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Évolution du chiffre d'affaires et de la marge sur les 6 derniers mois">
            {gridLines.map(g => (
              <line x1={PAD_L} x2={PAD_L + plotW} y1={g.y} y2={g.y} class="chart-grid" />
            ))}
            <text x={PAD_L} y={yAt(0) + 12} class="chart-axis-label">0 €</text>
            <text x={PAD_L} y={yAt(yMax) - 3} class="chart-axis-label">{formatCA(yMax)}</text>

            <path d={caAreaPath} class="chart-area chart-area--ca" />
            <path d={margeLinePath} class="chart-line chart-line--marge" />
            <path d={caLinePath} class="chart-line chart-line--ca" />

            {/* End-of-line emphasis + direct labels for the current month */}
            <circle cx={lastPoint.x} cy={lastPoint.caY} r="5" class="chart-dot-ring" />
            <circle cx={lastPoint.x} cy={lastPoint.caY} r="3.5" class="chart-dot chart-dot--ca" />
            <circle cx={lastPoint.x} cy={lastPoint.margeY} r="5" class="chart-dot-ring" />
            <circle cx={lastPoint.x} cy={lastPoint.margeY} r="3.5" class="chart-dot chart-dot--marge" />
            <text x={lastPoint.x + 9} y={lastPoint.caY + 4} class="chart-end-label">{formatCA(lastPoint.ca)}</text>
            <text x={lastPoint.x + 9} y={lastPoint.margeY + 4} class="chart-end-label chart-end-label--muted">{formatCA(lastPoint.marge)}</text>

            {chartPoints.map(p => (
              <text x={p.x} y={CHART_H - 4} class="chart-x-label">{p.label}</text>
            ))}

            {/* Hover layer */}
            <line id="crosshairLine" x1="0" x2="0" y1={PAD_T} y2={PAD_T + plotH} class="chart-crosshair" />
