            <path d="M2 13c0-2.5 2.24-4.5 5-4.5s5 2 5 4.5M12 3.5a2 2 0 0 1 0 4M14 12c.9.3 1.5 1 1.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>
            <strong>{clientsEnAttente}</strong>
