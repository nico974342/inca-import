.kpi-label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-muted);
}

.kpi-value {
  font-size: 1.625rem;
  font-weight: 700;
  line-height: 1.15;
  color: var(--color-ink);
  letter-spacing: -0.02em;
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.kpi-value-sub {
  font-size: var(--text-sm);
  font-weight: 600;
