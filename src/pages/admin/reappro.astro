---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import {
  REAPPRO_WEEKS_LOOKBACK, computeVitesseVente, computeJoursAvantRupture,
  computeSuggestedReorderQty, isAtOrBelowSeuil,
} from '../../lib/constants';

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'];

const CAT_LABEL: Record<string, string> = {
  boissons: 'Boissons',
  snacks: 'Snacks',
  chips: 'Chips',
  confiseries: 'Confiseries',
  divers: 'Divers',
};

const { data: trackedProducts } = await supabaseAdmin
  .from('products')
  .select('id, name, sku, category, unit, stock_quantity, seuil_reappro, delai_livraison_jours')
  .not('seuil_reappro', 'is', null)
  .order('name', { ascending: true });

const atRiskProducts = (trackedProducts ?? []).filter(p => isAtOrBelowSeuil(p.stock_quantity, p.seuil_reappro));
const productIds = atRiskProducts.map(p => p.id);

// ── Sales velocity over the lookback window, for at-risk products only ──
const salesQtyByProduct = new Map<string, number>();
if (productIds.length > 0) {
  const lookbackIso = new Date(Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000).toISOString();
  const { data: salesRows } = await supabaseAdmin
    .from('order_items')
    .select('product_id, quantity, orders!inner(status, created_at)')
    .in('product_id', productIds)
    .in('orders.status', REVENUE_STATUSES)
    .gte('orders.created_at', lookbackIso);
  for (const row of (salesRows ?? [])) {
    if (!row.product_id) continue;
    salesQtyByProduct.set(row.product_id, (salesQtyByProduct.get(row.product_id) ?? 0) + row.quantity);
  }
}

// ── Usual supplier per product, inferred from the most recent reception
//    that included it — no per-product supplier field exists, so this is
//    the best available signal for grouping. ──
const supplierByProduct = new Map<string, string>();
if (productIds.length > 0) {
  const { data: receptionRows } = await supabaseAdmin
    .from('stock_reception_items')
    .select('product_id, created_at, stock_receptions(supplier_name)')
    .in('product_id', productIds)
    .order('created_at', { ascending: false });
  for (const row of (receptionRows ?? [])) {
    if (!row.product_id || supplierByProduct.has(row.product_id)) continue;
    const supplier = (row as any).stock_receptions?.supplier_name;
    if (supplier) supplierByProduct.set(row.product_id, supplier);
  }
}

const UNGROUPED_LABEL = 'Fournisseur non renseigné';

const rows = atRiskProducts.map(p => {
  const vitesseVente = computeVitesseVente(salesQtyByProduct.get(p.id) ?? 0);
  const joursAvantRupture = computeJoursAvantRupture(p.stock_quantity, vitesseVente);
  const suggestedQty = computeSuggestedReorderQty(vitesseVente, p.delai_livraison_jours, p.stock_quantity);
  return {
    ...p,
    vitesseVente,
    joursAvantRupture,
    suggestedQty,
    supplier: supplierByProduct.get(p.id) ?? UNGROUPED_LABEL,
  };
});

// Urgency: soonest rupture first. No-data rows (never sold in the window)
// carry no urgency signal, so they sort after everything that does.
rows.sort((a, b) => {
  if (a.joursAvantRupture == null && b.joursAvantRupture == null) return 0;
  if (a.joursAvantRupture == null) return 1;
  if (b.joursAvantRupture == null) return -1;
  return a.joursAvantRupture - b.joursAvantRupture;
});

const groups = new Map<string, typeof rows>();
for (const r of rows) {
  if (!groups.has(r.supplier)) groups.set(r.supplier, []);
  groups.get(r.supplier)!.push(r);
}
// Named supplier groups first (by their most urgent product), ungrouped last.
const groupEntries = [...groups.entries()].sort((a, b) => {
  if (a[0] === UNGROUPED_LABEL) return 1;
  if (b[0] === UNGROUPED_LABEL) return -1;
  return (a[1][0]?.joursAvantRupture ?? Infinity) - (b[1][0]?.joursAvantRupture ?? Infinity);
});

function urgencyClass(jours: number | null): string {
  if (jours == null) return '';
  if (jours <= 7) return 'urgency--critical';
  if (jours <= 14) return 'urgency--warn';
  return '';
}
---
<AdminLayout title="Réassort" activeNav="reappro">
  <p class="intro">
    Produits dont le stock est au seuil de réapprovisionnement ou en-dessous, triés par urgence.
    La vitesse de vente est calculée sur les {REAPPRO_WEEKS_LOOKBACK} dernières semaines (commandes confirmées ou livrées).
    Pour chiffrer une commande complète sur plusieurs mois, utilisez le
    <a href="/admin/commande-fournisseur">simulateur de commande fournisseur →</a>
  </p>

  {rows.length === 0 ? (
    <div class="empty-state">
      <p class="empty-title">Aucun produit ne nécessite de réassort actuellement.</p>
      <p class="empty-body">
        Les produits apparaissent ici quand leur stock atteint le seuil de réapprovisionnement défini sur leur fiche.
        <a href="/admin/produits">Configurer les seuils →</a>
      </p>
    </div>
  ) : (
    <div class="groups">
      {groupEntries.map(([supplier, groupRows]) => (
        <section class="group">
          <h2 class="group-title">
            {supplier}
            <span class="group-count">{groupRows.length}</span>
          </h2>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Produit</th>
                  <th class="th-num">Stock actuel</th>
                  <th class="th-num">Vitesse de vente</th>
                  <th class="th-num">Jours avant rupture</th>
                  <th class="th-num">Suggestion</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {groupRows.map(p => (
                  <tr>
                    <td>
                      <span class="td-strong">{p.name}</span>
                      <div class="td-sub-row">
                        <span class={`cat-badge cat-badge--${p.category}`}>{CAT_LABEL[p.category] ?? p.category}</span>
                        {p.sku && <span class="td-sub">{p.sku}</span>}
                      </div>
                    </td>
                    <td class="th-num td-mono">
                      {p.stock_quantity} <span class="td-sub">/ seuil {p.seuil_reappro}</span>
                    </td>
                    <td class="th-num td-mono">
                      {p.vitesseVente > 0 ? `${p.vitesseVente.toFixed(1)} /sem.` : <span class="td-muted">—</span>}
                    </td>
                    <td class={`th-num td-mono ${urgencyClass(p.joursAvantRupture)}`}>
                      {p.joursAvantRupture != null ? `${Math.round(p.joursAvantRupture)} j` : <span class="td-muted">Non estimable</span>}
                    </td>
                    <td class="th-num td-mono">
                      {p.suggestedQty != null && p.suggestedQty > 0 ? (
                        <span class="suggestion-chip">Commander {p.suggestedQty} {p.unit ?? 'cartons'}</span>
                      ) : p.suggestedQty === 0 ? (
                        <span class="td-muted">Couvert par le stock</span>
                      ) : (
                        <span class="td-muted">—</span>
                      )}
                    </td>
                    <td class="td-actions">
                      <a href={`/admin/reception/new?product=${p.id}`} class="action-link">+ Réception</a>
                      <a href={`/admin/produits/${p.id}/edit`} class="action-link">Modifier</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  )}
</AdminLayout>

<style>
.intro {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin-bottom: var(--space-6);
  max-width: 68ch;
}
.intro a { color: var(--color-primary-deep); }

.groups {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.group-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: var(--space-3);
}

.group-count {
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-muted);
  background: var(--color-surface);
  padding: 1px 7px;
  border-radius: 99px;
  border: 1px solid var(--color-border);
}

.table-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}

.data-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.th-num { text-align: right; }

.data-table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr:hover td { background: var(--color-surface); }

.td-strong { font-weight: 500; color: var(--color-ink); }
.td-muted  { color: var(--color-muted); }
.td-mono   { font-family: var(--font-mono); color: var(--color-ink); white-space: nowrap; }
.td-sub    { font-size: var(--text-xs); color: var(--color-muted); }
.td-sub-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: 2px;
}

.cat-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 500;
  white-space: nowrap;
}
.cat-badge--boissons    { background: oklch(0.93 0.05 220); color: oklch(0.35 0.10 220); }
.cat-badge--snacks      { background: oklch(0.94 0.05 60);  color: oklch(0.40 0.12 60);  }
.cat-badge--chips       { background: oklch(0.93 0.05 180); color: oklch(0.35 0.10 180); }
.cat-badge--confiseries { background: oklch(0.93 0.06 330); color: oklch(0.40 0.12 330); }
.cat-badge--divers      { background: oklch(0.93 0.05 275); color: oklch(0.40 0.12 275); }

.urgency--warn     { color: oklch(0.42 0.14 60); font-weight: 700; }
.urgency--critical { color: oklch(0.46 0.18 25); font-weight: 700; }

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: oklch(0.95 0.07 60);
  color: oklch(0.38 0.15 55);
  white-space: nowrap;
}

.td-actions {
  white-space: nowrap;
  text-align: right;
}
.action-link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary-deep);
  text-decoration: none;
  margin-left: var(--space-4);
}
.action-link:first-child { margin-left: 0; }
.action-link:hover { text-decoration: underline; }

.empty-state {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-16) var(--space-8);
  text-align: center;
}
.empty-title { font-weight: 600; color: var(--color-ink); margin-bottom: var(--space-2); }
.empty-body  { color: var(--color-muted); }
.empty-body a { color: var(--color-primary-deep); }
</style>
