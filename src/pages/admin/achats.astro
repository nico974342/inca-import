---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { sanitizeText } from '../../lib/sanitize';
import { logAdminAction } from '../../lib/audit';
import CommandeAccordeon from '../../components/admin/CommandeAccordeon.astro';
import {
  SHIPMENT_STATUSES, SHIPMENT_STATUS_LABEL, SHIPMENT_ACTIVE_STATUSES,
  computeShipmentProgress, allocateCargoSlots, matchSupplierName, computeLandedCosts,
  type ShipmentStatus, type ShipmentCostItem, type ShipmentCostLine,
} from '../../lib/constants';
import { todayReunionISO } from '../../lib/datetime';
import { parseDlc } from '../../lib/dlc';
import { isAdmin } from '../../lib/roles';
import { etatTransition, ecritureAutorisee, MESSAGE_TRANSITION } from '../../lib/achatsTransition';
import { rapprochementRequis } from '../../lib/achatsRapprochement';
import { etatReception, FILTRES_ACHATS, LIBELLE_FILTRE_ACHATS, parseFiltreAchats, correspondFiltre } from '../../lib/achatsReception';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');
const transition = await etatTransition();
const ecritureOk = ecritureAutorisee(transition);

// ── Écritures : uniquement sur shipments / shipment_items. Ni products,
//    ni stock, ni PUMP — le transit est du suivi, pas du mouvement. ──
if (Astro.request.method === 'POST') {
  const data   = await Astro.request.formData();
  const action = data.get('action') as string;
  const adminEmail = (Astro.locals as any).user?.email ?? 'inconnu';

  if (action === 'create') {
    const supplierName = sanitizeText(data.get('supplier_name') as string, 120).trim();
    const reference    = sanitizeText(data.get('reference') as string, 80).trim() || null;
    const departure    = (data.get('departure_date') as string)?.trim() || null;
    const eta          = (data.get('eta') as string)?.trim() || null;
    const notes        = sanitizeText(data.get('notes') as string, 500).trim() || null;
    const statusRaw    = data.get('status') as string;
    const status: ShipmentStatus = (SHIPMENT_STATUSES as readonly string[]).includes(statusRaw)
      ? (statusRaw as ShipmentStatus) : 'commande';

    if (!supplierName) return Astro.redirect('/admin/achats?err=fournisseur_requis');

    // Identifiant fournisseur stable — voir matchSupplierName. Un texte
    // ambigu ou inconnu n'empêche pas l'enregistrement de l'expédition,
    // mais reste sans supplier_id, signalé sur /admin/fournisseurs.
    const { data: suppliersForMatch } = await supabaseAdmin.from('suppliers').select('id, name');
    const supplierMatch = matchSupplierName(supplierName, suppliersForMatch ?? []);

    const { data: created, error: insErr } = await supabaseAdmin
      .from('shipments')
      .insert({ supplier_name: supplierName, supplier_id: supplierMatch.supplierId, reference, departure_date: departure, eta, status, notes })
      .select('id')
      .single();

    if (insErr || !created) {
      console.error('[transit] création expédition:', insErr?.message);
      return Astro.redirect('/admin/achats?err=creation');
    }

    const productIds = data.getAll('product_id[]') as string[];
    const quantities = data.getAll('quantity[]') as string[];
    const costs      = data.getAll('unit_cost_ht[]') as string[];
    const dlcs       = data.getAll('dlc[]') as string[];

    const items: { shipment_id: string; product_id: string; quantity: number; unit_cost_ht: number | null; dlc: string | null }[] = [];
    for (let i = 0; i < productIds.length; i++) {
      const pid = productIds[i]?.trim();
      const qty = parseInt(quantities[i] ?? '0', 10);
      const cost = costs[i]?.trim() === '' ? null : parseFloat(costs[i] ?? '0');
      if (!pid || !Number.isFinite(qty) || qty <= 0) continue;
      items.push({ shipment_id: created.id, product_id: pid, quantity: qty, unit_cost_ht: cost != null && Number.isFinite(cost) ? cost : null, dlc: parseDlc(dlcs[i]) });
    }

    if (items.length > 0) {
      const { error: itemsErr } = await supabaseAdmin.from('shipment_items').insert(items);
      if (itemsErr) {
        // Header without lines is worse than nothing: undo it so the admin
        // doesn't end up tracking an empty shipment they didn't notice.
        console.error('[transit] lignes expédition:', itemsErr.message);
        await supabaseAdmin.from('shipments').delete().eq('id', created.id);
        return Astro.redirect('/admin/achats?err=lignes');
      }
    }

    await logAdminAction({
      adminEmail, action: 'transit.creation', targetType: 'shipment',
      targetId: created.id, targetLabel: supplierName,
      details: { reference, eta, lignes: items.length },
    });
    return Astro.redirect('/admin/achats?ok=cree');
  }

  // Garde SERVEUR : changer le statut ou supprimer une commande existante n'est possible que dans l'état « actif » ; la création d'une NOUVELLE commande reste possible (aucune réception).
  if ((action === 'set_status' || action === 'delete') && !ecritureOk) return Astro.redirect('/admin/achats?err=transition');

  if (action === 'set_status') {
    const id = data.get('id') as string;
    const statusRaw = data.get('status') as string;
    if (!id || !(SHIPMENT_STATUSES as readonly string[]).includes(statusRaw)) {
      return Astro.redirect('/admin/achats?err=statut');
    }
    // 'receptionne' n'est jamais posé à la main : il découle de la validation
    // d'une réception, seule opération qui touche au stock.
    if (statusRaw === 'receptionne') return Astro.redirect('/admin/achats?err=receptionner');

    const { error } = await supabaseAdmin.from('shipments').update({ status: statusRaw }).eq('id', id);
    if (error) return Astro.redirect('/admin/achats?err=statut');
    return Astro.redirect('/admin/achats?ok=statut');
  }

  if (action === 'delete') {
    const id = data.get('id') as string;
    if (id) {
      // shipment_items part en cascade (FK ON DELETE CASCADE).
      // Une commande qui a reçu de la marchandise ne se supprime pas (historique à conserver) : la base la protège, on l'explique.
      const { error } = await supabaseAdmin.from('shipments').delete().eq('id', id);
      if (error) return Astro.redirect(`/admin/achats?err=${String(error.message).includes('COMMANDE_RECUE_NON_SUPPRIMABLE') ? 'recue' : 'suppression'}`);
      await logAdminAction({ adminEmail, action: 'transit.suppression', targetType: 'shipment', targetId: id });
    }
    return Astro.redirect('/admin/achats?ok=supprime');
  }
}

const vue = parseFiltreAchats(Astro.url.searchParams.get('vue'));
const { data: shipmentsRaw, error: loadErr } = await supabaseAdmin
  .from('shipments')
  .select(`
    id, supplier_name, reference, departure_date, eta, status, notes, created_at,
    shipment_items(id, quantity, received_quantity, unit_cost_ht, dlc, products(id, name, sku, unit, category, units_per_carton)),
    shipment_costs(id, product_id, amount_ht, is_estimated)
  `)
  // « En cours », « Reste à recevoir » et « Partiellement réceptionnées » : commandes encore actives ; « Toutes » : tout l'historique (réceptionnées et annulées comprises)
  .in('status', (vue === 'toutes' ? SHIPMENT_STATUSES : SHIPMENT_ACTIVE_STATUSES) as readonly string[])
  .order('eta', { ascending: true, nullsFirst: false });

const tableMissing = loadErr?.code === 'PGRST205' || loadErr?.code === '42P01';

const { data: products } = await supabaseAdmin
  .from('products')
  .select('id, name, sku, prix_achat_moyen_ht, units_per_carton, duree_conservation_mois')
  .order('name');

const { data: supplierRows } = await supabaseAdmin.from('suppliers').select('name').order('name');
const supplierNames = (supplierRows ?? []).map(s => s.name);

const now = new Date();
const shipmentsTous = (shipmentsRaw ?? []).map(s => {
  // shipment_items.quantity est en CARTONS, unit_cost_ht en € / CARTON —
  // comme stock_quantity et le PUMP (voir products.units_per_carton). Le
  // détail /unité n'existe que si le conditionnement est renseigné sur la
  // fiche produit ; sinon on n'affiche que le carton, jamais une valeur
  // devinée.
  const rawItems = ((s as any).shipment_items ?? []) as any[];
  const items = rawItems.map(it => {
    const cartons = it.quantity ?? 0;
    const unitsPerCarton = it.products?.units_per_carton ?? null;
    const totalUnits = unitsPerCarton != null ? cartons * unitsPerCarton : null;
    const pricePerCarton = it.unit_cost_ht != null ? Number(it.unit_cost_ht) : null;
    const pricePerUnit = pricePerCarton != null && unitsPerCarton ? pricePerCarton / unitsPerCarton : null;
    const totalValue = pricePerCarton != null ? pricePerCarton * cartons : null;
    return { ...it, cartons, unitsPerCarton, totalUnits, pricePerCarton, pricePerUnit, totalValue };
  });
  const totalQty  = items.reduce((n, it) => n + (it.quantity ?? 0), 0);
  const totalCost = items.reduce((n, it) => n + (it.unit_cost_ht != null ? Number(it.unit_cost_ht) * it.quantity : 0), 0);
  const anyMissingCost = items.some(it => it.unit_cost_ht == null);

  // Coût rendu = prix fournisseur + frais d'import répartis (voir
  // computeLandedCosts) — affiché en résumé sur la carte, détaillé sur
  // /admin/achats/[id]/couts.
  const costLines: ShipmentCostLine[] = ((s as any).shipment_costs ?? []).map((c: any) => ({
    product_id: c.product_id,
    amount_ht: Number(c.amount_ht),
    is_estimated: c.is_estimated,
  }));
  const landedItems: ShipmentCostItem[] = items.map(it => ({
    product_id: it.product_id, quantity: it.quantity, unit_cost_ht: it.pricePerCarton,
  }));
  const landed = computeLandedCosts(landedItems, costLines);

  // Statut de RÉCEPTION : calculé à partir des quantités réelles (jamais saisi à la main), indépendant du statut logistique.
  const etat = etatReception(rawItems.map(it => ({ quantity: it.quantity ?? 0, received_quantity: it.received_quantity ?? null })), s.status);

  return {
    ...s,
    items,
    totalQty,
    totalCost,
    anyMissingCost,
    landed,
    etat,
    // Commande déjà réceptionnée par l'ancien parcours et pas encore rapprochée (FA/1) : AUCUN bouton de réception (le serveur refuse de toute façon).
    aRapprocher: rapprochementRequis((s as any).id, etat, 0),
    progress: computeShipmentProgress(s.departure_date, s.eta, s.status, now),
    // La cargaison dessinée sur le pont est la composition réelle de
    // l'expédition, pas une décoration.
    cargo: allocateCargoSlots(items.map(it => ({
      category: it.products?.category ?? null,
      quantity: it.quantity ?? 0,
    }))),
  };
});

const shipments = shipmentsTous.filter(s => correspondFiltre(vue, s.etat, s.status));
const compteurs = Object.fromEntries(FILTRES_ACHATS.map(f => [f, shipmentsTous.filter(s => correspondFiltre(f, s.etat, s.status)).length])) as Record<(typeof FILTRES_ACHATS)[number], number>;
// cartons réellement encore à recevoir (le déjà-reçu n'est plus « en transit »)
const totalEnTransit = shipments.reduce((n, s) => n + (s.status === 'receptionne' || s.status === 'annule' ? 0 : s.etat.reste), 0);

const ok  = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const OK_MSG: Record<string, string> = {
  cree: 'Expédition enregistrée.', statut: 'Statut mis à jour.',
  supprime: 'Expédition supprimée.', modifie: 'Expédition modifiée.',
  receptionne: "Réception validée — l'expédition est passée en « Réceptionné » et sort du suivi.",
};
const ERR_MSG: Record<string, string> = {
  transition: MESSAGE_TRANSITION[transition] || 'Opération suspendue pendant la mise en service.',
  fournisseur_requis: 'Le nom du fournisseur est obligatoire.',
  creation: "L'expédition n'a pas pu être créée.",
  lignes: "Les lignes produits n'ont pas pu être enregistrées — l'expédition a été annulée.",
  statut: 'Le changement de statut a échoué.',
  receptionner: "Le statut « Réceptionné » se pose en validant une réception, pas à la main.",
  suppression: 'La suppression a échoué.',
  introuvable: 'Expédition introuvable.',
  recue: 'Cette commande a déjà des réceptions : elle ne se supprime pas (historique à conserver). Passez-la au statut annulé si besoin.',
};

const today = todayReunionISO();
---
<AdminLayout title="Suivi des achats" activeNav="achats">
  <p class="intro">
    Achats et expéditions en cours : marchandises commandées ou parties de chez le fournisseur, et pas encore arrivées.
    <strong>Ce suivi ne touche ni au stock ni au PUMP</strong> : ils ne bougent qu'à la réception réelle,
    en cliquant « Enregistrer une réception » à chaque livraison (partielle ou totale).
  </p>

  {tableMissing ? (
    <div class="alert alert--error" role="alert">
      Les tables <code>shipments</code> / <code>shipment_items</code> n'existent pas encore.
      Lancez <code>supabase/migrations/shipments_table.sql</code> dans Supabase, puis rechargez.
    </div>
  ) : (
    <>
      {ok  && <div class="alert alert--ok"    role="status">{OK_MSG[ok] ?? 'Enregistré.'}</div>}
      {err && <div class="alert alert--error" role="alert">{ERR_MSG[err] ?? 'Une erreur est survenue.'}</div>}
      {!ecritureOk && <div class="alert alert--error" role="status" data-testid="transition" data-etat={transition}>{MESSAGE_TRANSITION[transition]}</div>}

      <details class="create-panel">
        <summary class="create-summary">+ Nouvelle expédition</summary>
        <form method="post" class="create-form">
          <input type="hidden" name="action" value="create" />
          <div class="form-grid">
            <div class="field">
              <label class="label" for="sh-supplier">Fournisseur <span class="req">*</span></label>
              <input type="text" id="sh-supplier" name="supplier_name" required maxlength="120" list="supplierList" autocomplete="off" placeholder="Nom du fournisseur" />
              <datalist id="supplierList">{supplierNames.map(n => <option value={n}></option>)}</datalist>
            </div>
            <div class="field">
              <label class="label" for="sh-ref">Référence <span class="opt">(conteneur / BL)</span></label>
              <input type="text" id="sh-ref" name="reference" maxlength="80" autocomplete="off" placeholder="MSCU1234567" />
            </div>
            <div class="field">
              <label class="label" for="sh-dep">Date de départ</label>
              <input type="date" id="sh-dep" name="departure_date" value={today} />
            </div>
            <div class="field">
              <label class="label" for="sh-eta">Arrivée estimée (ETA)</label>
              <input type="date" id="sh-eta" name="eta" />
            </div>
            <div class="field">
              <label class="label" for="sh-status">Statut</label>
              <select id="sh-status" name="status">
                {SHIPMENT_STATUSES.filter(s => s !== 'receptionne').map(s => (
                  <option value={s} selected={s === 'en_transit'}>{SHIPMENT_STATUS_LABEL[s]}</option>
                ))}
              </select>
            </div>
            <div class="field field--full">
              <label class="label" for="sh-notes">Notes</label>
              <input type="text" id="sh-notes" name="notes" maxlength="500" placeholder="Transitaire, incoterm, remarques…" />
            </div>
          </div>

          <div class="items-head">
            <h3 class="items-title">Produits expédiés</h3>
            <button type="button" id="addRowBtn" class="btn btn-ghost">+ Ajouter un produit</button>
          </div>
          <div class="items-wrap">
            <table class="items-table">
              <thead>
                <tr>
                  <th>Produit</th>
                  <th class="num">Quantité</th>
                  <th class="num">Prix fournisseur / carton HT</th>
                  <th class="num">DLC <span class="th-sub">(prévue)</span></th>
                  <th class="num">Total</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="itemsBody"></tbody>
            </table>
          </div>
          <p class="items-hint" id="itemsHint">Ajoutez au moins un produit.</p>
          <p class="items-hint">
            <strong>DLC</strong> : prévisionnelle, pré-remplie depuis l'ETA et la durée de conservation du produit.
            Elle sera reprise à la réception (modifiable) et ne déclenche aucune alerte avant l'arrivée.
          </p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Enregistrer l'expédition</button>
          </div>
        </form>
      </details>

      <nav class="filtres" aria-label="Filtrer les commandes" data-testid="filtres-achats">
        {FILTRES_ACHATS.map(f => (
          <a class={`filtre ${vue === f ? 'filtre--on' : ''}`} href={f === 'en_cours' ? '/admin/achats' : `/admin/achats?vue=${f}`} aria-current={vue === f ? 'page' : undefined}>{LIBELLE_FILTRE_ACHATS[f]} <span class="filtre-n">{compteurs[f]}</span></a>
        ))}
      </nav>

      {shipments.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">{vue === 'en_cours' ? 'Aucune expédition en cours.' : 'Aucune commande dans cette vue.'}</p>
          <p class="empty-body">{vue === 'en_cours' ? "Les marchandises en route apparaissent ici jusqu'à leur réception." : 'Changez de filtre pour voir les autres commandes.'}</p>
        </div>
      ) : (
        <>
          <p class="summary-line">
            {shipments.length} commande{shipments.length > 1 ? 's' : ''} ·
            {' '}{totalEnTransit.toLocaleString('fr-FR')} cartons restant à recevoir
          </p>

          <div class="shipments" data-testid="commandes">
            {shipments.map(s => <CommandeAccordeon s={s} ecritureOk={ecritureOk} />)}
          </div>
        </>
      )}
    </>
  )}
</AdminLayout>

<script define:vars={{ products }}>
  const PRODUCTS = products ?? [];
  const body = document.getElementById('itemsBody');
  const hint = document.getElementById('itemsHint');

  function usedIds() {
    const s = new Set();
    document.querySelectorAll('[data-product-select]').forEach(sel => { if (sel.value) s.add(sel.value); });
    return s;
  }

  function refreshSelects() {
    const used = usedIds();
    document.querySelectorAll('[data-product-select]').forEach(sel => {
      Array.from(sel.options).forEach(o => {
        if (!o.value) return;
        o.disabled = used.has(o.value) && o.value !== sel.value;
      });
    });
  }

  function updateRowTotal(tr) {
    const qty  = parseFloat(tr.querySelector('[name="quantity[]"]')?.value) || 0;
    const cost = parseFloat(tr.querySelector('[name="unit_cost_ht[]"]')?.value) || 0;
    const cell = tr.querySelector('[data-total]');
    if (cell) cell.textContent = qty && cost
      ? (qty * cost).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })
      : '—';

    // Coût saisi = prix / CARTON (comme le PUMP) : ce rappel évite qu'il soit
    // relu plus tard comme un prix / unité.
    const p = PRODUCTS.find(x => x.id === tr.querySelector('[data-product-select]')?.value);
    const hint = tr.querySelector('[data-cost-hint]');
    if (hint) {
      hint.textContent = (cost && p && p.units_per_carton)
        ? `soit ${(cost / p.units_per_carton).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 })} / unité`
        : '';
    }
  }

  // DLC prévisionnelle = ETA + durée de conservation type du produit (la
  // marchandise n'existera qu'à l'arrivée). Pré-remplissage seulement : une
  // valeur saisie à la main (data-touched) n'est plus écrasée ; sans ETA ou
  // sans durée connue, le champ reste vide.
  function addMonthsISO(iso, months) {
    const [y, m, d] = iso.split('-').map(Number);
    const total = y * 12 + (m - 1) + months;
    const ty = Math.floor(total / 12), tm = total % 12;
    const last = new Date(Date.UTC(ty, tm + 1, 0)).getUTCDate();
    return ty + '-' + String(tm + 1).padStart(2, '0') + '-' + String(Math.min(d, last)).padStart(2, '0');
  }
  function suggestDlc(tr) {
    const input = tr.querySelector('[name="dlc[]"]');
    if (!input || input.dataset.touched === '1') return;
    const prod = PRODUCTS.find(x => x.id === tr.querySelector('[data-product-select]')?.value);
    const eta = document.getElementById('sh-eta')?.value;
    input.value = prod && prod.duree_conservation_mois && eta
      ? addMonthsISO(eta, Number(prod.duree_conservation_mois))
      : '';
  }

  function addRow() {
    if (!body) return;
    const tr = document.createElement('tr');
    const opts = PRODUCTS.map(p => `<option value="${p.id}">${p.name}${p.sku ? ' (' + p.sku + ')' : ''}${p.units_per_carton ? ' — ' + p.units_per_carton + '/carton' : ''}</option>`).join('');
    tr.innerHTML = `
      <td><select name="product_id[]" data-product-select required>
        <option value="">— Choisir un produit —</option>${opts}
      </select></td>
      <td class="num"><input type="number" name="quantity[]" min="1" step="1" placeholder="0" required /></td>
      <td class="num">
        <input type="number" name="unit_cost_ht[]" min="0" step="0.01" placeholder="—" />
        <span class="cost-hint" data-cost-hint></span>
      </td>
      <td class="num"><input type="date" name="dlc[]" /></td>
      <td class="num" data-total>—</td>
      <td class="num"><button type="button" class="remove-btn" title="Retirer">×</button></td>
    `;
    body.appendChild(tr);
    const dlcIn = tr.querySelector('[name="dlc[]"]');
    dlcIn.addEventListener('input', () => { dlcIn.dataset.touched = '1'; });

    tr.querySelector('[data-product-select]').addEventListener('change', () => {
      const p = PRODUCTS.find(x => x.id === tr.querySelector('[data-product-select]').value);
      const costIn = tr.querySelector('[name="unit_cost_ht[]"]');
      // Pre-fill with the known average cost as a starting point; the real
      // invoice figure usually differs and stays editable.
      if (p && p.prix_achat_moyen_ht != null && !costIn.value) costIn.value = Number(p.prix_achat_moyen_ht).toFixed(2);
      suggestDlc(tr);
      refreshSelects();
      updateRowTotal(tr);
    });
    tr.querySelectorAll('input').forEach(i => i.addEventListener('input', () => updateRowTotal(tr)));
    tr.querySelector('.remove-btn').addEventListener('click', () => { tr.remove(); refreshSelects(); toggleHint(); });

    refreshSelects();
    toggleHint();
  }

  function toggleHint() {
    if (hint) hint.hidden = (body?.children.length ?? 0) > 0;
  }

  document.getElementById('addRowBtn')?.addEventListener('click', addRow);
  document.getElementById('sh-eta')?.addEventListener('change', () => document.querySelectorAll('#itemsBody tr').forEach(suggestDlc));
  toggleHint();
</script>

<style>
.intro {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin-bottom: var(--space-5);
  max-width: 80ch;
}
.intro strong { color: var(--color-ink); }

.alert {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid;
}
.alert code { font-family: var(--font-mono); font-size: 0.9em; }
.alert--ok    { color: oklch(0.40 0.12 150); background: oklch(0.96 0.04 150); border-color: oklch(0.86 0.08 150); }
.alert--error { color: oklch(0.46 0.18 25);  background: oklch(0.97 0.03 25);  border-color: oklch(0.88 0.07 25); }

/* ── Formulaire de création ── */
.create-panel {
  margin-bottom: var(--space-5);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
