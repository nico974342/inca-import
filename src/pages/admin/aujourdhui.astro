---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { acteurDepuisSession, portefeuille } from '../../lib/portefeuille';
import { estUuid, lienTelephone } from '../../lib/crm';
import { dateCourte, etatRelance, libelleEcheance } from '../../lib/crmVue';
import { calculerSuggestions, reporterJusqua, type RegleSuggestion, type Suggestion } from '../../lib/crmSuggestions';
import { todayReunionISO } from '../../lib/datetime';

/**
 * « Aujourd'hui » : ce que le commercial doit faire maintenant, sur téléphone. Deux familles STRICTEMENT séparées :
 *  - les TÂCHES programmées à la main (relances en retard et du jour, rendez-vous) : elles ne disparaissent jamais toutes seules ;
 *  - les SUGGESTIONS automatiques (comptes à activer, clients sans commande, prospects sans suivi, réassort, opportunités) : recalculées
 *    à chaque affichage, chacune explique pourquoi elle apparaît ; on peut les reporter ou les ignorer, jamais une relance programmée.
 * Le commercial voit son portefeuille ; l'administrateur voit tout ou un commercial choisi. Aucun coût ni marge n'est lu ici.
 */
const acteur = acteurDepuisSession((Astro.locals as any).user);
if (!acteur) return Astro.redirect('/admin');
const admin = acteur.role === 'admin';
const aujourdhui = todayReunionISO();
const q = Astro.url.searchParams;
const groupe = q.get('groupe') === 'interne' || q.get('groupe') === 'externe' ? (q.get('groupe') as 'interne' | 'externe') : 'tous';
const respParam = q.get('resp');
// commercial : toujours lui-même ; administrateur : tout le monde (par défaut) ou un commercial choisi
const cible: string | null = admin ? (respParam && estUuid(respParam) ? respParam : null) : acteur.id;
const personnel = admin ? await portefeuille.personnel().catch(() => []) : [];

const [{ data: clientsBruts }, { data: commandes }, { data: echanges }, { data: relancesBrutes }, { data: masquees }] = await Promise.all([
  supabaseAdmin.from('client_accounts').select('id, nom, societe, email, telephone, status, created_at, responsable_id, rattachement_groupe').limit(5000),
  supabaseAdmin.from('orders').select('client_id, email, created_at, status').limit(20000),
  supabaseAdmin.from('client_interactions').select('client_id, occurred_at, resultat, annulee_le').limit(20000),
  supabaseAdmin.from('weekly_tasks').select('id, content, type, client_id, client_libelle, echeance, heure, assigne_a, assigne_email, reports').neq('type', 'tache').eq('statut', 'a_faire').order('echeance', { ascending: true }).limit(2000),
  supabaseAdmin.from('crm_suggestions_masquees').select('client_id, regle, jusqu_au').eq('par_id', acteur.id).gt('jusqu_au', aujourdhui),
]);
const clients = (clientsBruts ?? []) as any[];
const parId = new Map(clients.map(c => [c.id, c]));
const dansGroupe = (clientId: string | null) => groupe === 'tous' || (clientId ? parId.get(clientId)?.rattachement_groupe === groupe : false);

// ── Tâches programmées (jamais fermées automatiquement) ──
const mesRelances = ((relancesBrutes ?? []) as any[]).filter(r => (cible ? r.assigne_a === cible : true) && dansGroupe(r.client_id));
const enRetardOuDuJour = mesRelances.filter(r => r.type === 'relance' ? r.echeance <= aujourdhui : r.echeance < aujourdhui);
const rendezVous = mesRelances.filter(r => r.type === 'rendez_vous' && r.echeance >= aujourdhui).sort((a, b) => a.echeance.localeCompare(b.echeance) || (a.heure ?? '').localeCompare(b.heure ?? ''));
const nbRetard = enRetardOuDuJour.filter(r => r.echeance < aujourdhui).length;

// ── Suggestions automatiques (périmètre : clients du commercial, ou tous / un commercial choisi pour l'administrateur) ──
const clientsSuggestion = clients.filter(c => (cible ? c.responsable_id === cible : true) && dansGroupe(c.id));
const sections = calculerSuggestions({
  clients: clientsSuggestion, commandes: (commandes ?? []) as any[], interactions: (echanges ?? []) as any[],
  clientsAvecRelance: new Set(((relancesBrutes ?? []) as any[]).map(r => r.client_id).filter(Boolean)), masquees: (masquees ?? []) as any[], aujourdhui,
});

const SUGGESTIONS: { regle: RegleSuggestion; n: number; titre: string; aide: string }[] = [
  { regle: 'compte_en_attente', n: 3, titre: 'Comptes en attente d\'activation', aide: 'Ces clients ont demandé un compte : un appel permet de les activer.' },
  { regle: 'actif_sans_commande', n: 4, titre: 'Clients actifs n\'ayant jamais commandé', aide: 'Compte ouvert, mais aucune commande : à accompagner.' },
  { regle: 'prospect_sans_suivi', n: 5, titre: 'Prospects sans suivi récent', aide: 'Aucun échange depuis 30 jours et aucune relance prévue.' },
  { regle: 'reassort', n: 6, titre: 'Suggestions de réassort', aide: 'Seulement pour les clients dont le rythme de commande est fiable (au moins 3 commandes).' },
  { regle: 'opportunite', n: 7, titre: 'Opportunités commerciales', aide: 'Une commande était envisagée ou un rendez-vous pris, sans commande depuis. Une commande envisagée n\'est pas une commande.' },
];
const total = (r: RegleSuggestion) => sections[r].length;
const MAX_PAR_SECTION = 15;

const adresse = (o: Record<string, string | null>) => {
  const p = new URLSearchParams(); const v = { groupe: groupe === 'tous' ? null : groupe, resp: admin && cible ? cible : null, ...o } as Record<string, string | null>;
  for (const [k, x] of Object.entries(v)) if (x) p.set(k, x); const s = p.toString(); return `/admin/aujourdhui${s ? `?${s}` : ''}`;
};
const retour = adresse({});
const ok = q.get('ok'); const err = q.get('err');
const nomClient = (id: string | null, repli: string | null) => (id && (parId.get(id)?.societe || parId.get(id)?.nom)) || repli || 'Client';
const telClient = (id: string | null) => (id ? lienTelephone(parId.get(id)?.telephone) : null);
const mail = (e: string) => e.split('@')[0];
const groupeLibelle = (g: string | null) => (g === 'interne' ? 'Groupe Incana' : g === 'externe' ? 'Externe' : null);
---
<AdminLayout title="Aujourd'hui" activeNav="aujourdhui">
  <div class="aj" data-testid="aujourdhui">
    <header class="aj-tete">
      <h1 class="aj-h1">Aujourd'hui</h1>
      <p class="aj-sub">{nbRetard > 0 ? `${nbRetard} relance${nbRetard > 1 ? 's' : ''} en retard · ` : ''}{enRetardOuDuJour.length - nbRetard} du jour · {rendezVous.length} rendez-vous</p>
    </header>

    <nav class="aj-filtres" aria-label="Filtres">
      <div class="aj-chips" role="group" aria-label="Groupe">
        <a class={`aj-chip ${groupe === 'tous' ? 'aj-chip--on' : ''}`} href={adresse({ groupe: null })}>Tous</a>
        <a class={`aj-chip ${groupe === 'interne' ? 'aj-chip--on' : ''}`} href={adresse({ groupe: 'interne' })}>Groupe Incana</a>
        <a class={`aj-chip ${groupe === 'externe' ? 'aj-chip--on' : ''}`} href={adresse({ groupe: 'externe' })}>Clients externes</a>
      </div>
      {admin && personnel.length > 0 && (
        <form method="get" class="aj-resp">
          {groupe !== 'tous' && <input type="hidden" name="groupe" value={groupe} />}
          <label for="resp" class="aj-lib">Commercial</label>
          <select id="resp" name="resp" onchange="this.form.submit()">
            <option value="">Tous</option>
            {personnel.map(p => <option value={p.id} selected={cible === p.id}>{p.email}</option>)}
          </select>
        </form>
      )}
    </nav>

    {ok && <p class="aj-flash aj-flash--ok" role="status">{ok}</p>}
    {err && <p class="aj-flash aj-flash--err" role="alert">{err}</p>}

    <section class="aj-section" data-testid="section-retard" aria-labelledby="t1">
      <h2 id="t1" class="aj-titre"><span class="aj-num">1</span> Relances en retard et du jour <span class="aj-compte">{enRetardOuDuJour.length}</span></h2>
      {enRetardOuDuJour.length === 0 ? <p class="aj-vide">Rien en retard, rien pour aujourd'hui.</p> : (
        <ul class="aj-liste">
          {enRetardOuDuJour.map(r => {
            const tel = telClient(r.client_id); const etat = etatRelance(r.echeance, aujourdhui);
            return (
              <li class={`aj-carte aj-carte--${etat}`} data-relance={r.id}>
                <div class="aj-ligne"><a class="aj-client" href={r.client_id ? `/admin/clients/${r.client_id}` : '#'}>{nomClient(r.client_id, r.client_libelle)}</a><span class="aj-etat">{libelleEcheance(r.echeance, aujourdhui)}</span></div>
                <p class="aj-quoi">{r.content}{r.type === 'rendez_vous' ? ' (rendez-vous)' : ''}{admin && !cible ? ` · ${mail(r.assigne_email)}` : ''}{r.reports > 0 ? ` · reportée ${r.reports} fois` : ''}</p>
                <div class="aj-actions">
                  {tel && <a class="aj-btn aj-btn--p" href={tel} data-appel={r.client_id} data-nom={nomClient(r.client_id, r.client_libelle)}>📞 Appeler</a>}
                  {r.client_id && <a class="aj-btn" href={`/admin/clients/${r.client_id}/noter?type=appel&relance=${r.id}`}>Noter l'appel</a>}
                  <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="cloturer" /><input type="hidden" name="statut" value="faite" /><input type="hidden" name="relance_id" value={r.id} /><input type="hidden" name="client_id" value={r.client_id ?? ''} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">Terminer</button></form>
                  <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="reporter" /><input type="hidden" name="delai" value="demain" /><input type="hidden" name="relance_id" value={r.id} /><input type="hidden" name="client_id" value={r.client_id ?? ''} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">Demain</button></form>
                  <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="reporter" /><input type="hidden" name="delai" value="3j" /><input type="hidden" name="relance_id" value={r.id} /><input type="hidden" name="client_id" value={r.client_id ?? ''} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">+3 jours</button></form>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section class="aj-section" data-testid="section-rdv" aria-labelledby="t2">
      <h2 id="t2" class="aj-titre"><span class="aj-num">2</span> Rendez-vous programmés <span class="aj-compte">{rendezVous.length}</span></h2>
      {rendezVous.length === 0 ? <p class="aj-vide">Aucun rendez-vous programmé.</p> : (
        <ul class="aj-liste">
          {rendezVous.map(r => (
            <li class="aj-carte" data-relance={r.id}>
              <div class="aj-ligne"><a class="aj-client" href={r.client_id ? `/admin/clients/${r.client_id}` : '#'}>{nomClient(r.client_id, r.client_libelle)}</a><span class="aj-etat">{libelleEcheance(r.echeance, aujourdhui)} · {dateCourte(r.echeance)}{r.heure ? ` à ${r.heure.slice(0, 5)}` : ''}</span></div>
              <p class="aj-quoi">{r.content}{admin && !cible ? ` · ${mail(r.assigne_email)}` : ''}</p>
              <div class="aj-actions">
                {r.client_id && <a class="aj-btn" href={`/admin/clients/${r.client_id}/noter?type=visite&relance=${r.id}`}>Noter la visite</a>}
                <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="cloturer" /><input type="hidden" name="statut" value="faite" /><input type="hidden" name="relance_id" value={r.id} /><input type="hidden" name="client_id" value={r.client_id ?? ''} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">Terminer</button></form>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <p class="aj-separation" data-testid="separation-suggestions">Suggestions automatiques — ce ne sont pas des tâches : elles sont recalculées à chaque affichage et vous pouvez les reporter ou les ignorer.</p>

    {SUGGESTIONS.map(s => {
      const liste: Suggestion[] = sections[s.regle];
      return (
        <section class="aj-section aj-section--sugg" data-testid={`section-${s.regle}`} aria-labelledby={`t${s.n}`}>
          <h2 id={`t${s.n}`} class="aj-titre"><span class="aj-num">{s.n}</span> {s.titre} <span class="aj-compte">{liste.length}</span></h2>
          <p class="aj-aide">{s.aide}</p>
          {liste.length === 0 ? <p class="aj-vide">Aucune suggestion.</p> : (
            <ul class="aj-liste">
              {liste.slice(0, MAX_PAR_SECTION).map(x => {
                const tel = telClient(x.clientId);
                return (
                  <li class="aj-carte aj-carte--sugg" data-suggestion={`${x.regle}:${x.clientId}`}>
                    <div class="aj-ligne"><a class="aj-client" href={`/admin/clients/${x.clientId}`}>{x.libelle}</a>{groupeLibelle(x.groupe) && <span class="aj-groupe">{groupeLibelle(x.groupe)}</span>}</div>
                    <p class="aj-quoi" data-testid="pourquoi">{x.pourquoi}</p>
                    <div class="aj-actions">
                      {tel && <a class="aj-btn aj-btn--p" href={tel} data-appel={x.clientId} data-nom={x.libelle}>📞 Appeler</a>}
                      <a class="aj-btn" href={`/admin/clients/${x.clientId}/noter?type=appel`}>Noter un appel</a>
                      <a class="aj-btn" href={`/admin/clients/${x.clientId}/noter?type=relance`}>Programmer</a>
                      <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="masquer" /><input type="hidden" name="regle" value={x.regle} /><input type="hidden" name="delai" value="7j" /><input type="hidden" name="client_id" value={x.clientId} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">Plus tard (7 j)</button></form>
                      <form method="post" action="/api/admin/crm/action"><input type="hidden" name="operation" value="masquer" /><input type="hidden" name="regle" value={x.regle} /><input type="hidden" name="delai" value="14j" /><input type="hidden" name="client_id" value={x.clientId} /><input type="hidden" name="retour" value={retour} /><button class="aj-btn" type="submit">Ignorer (14 j)</button></form>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          {liste.length > MAX_PAR_SECTION && <p class="aj-aide">+ {liste.length - MAX_PAR_SECTION} autres dans cette liste.</p>}
        </section>
      );
    })}
    <p class="aj-pied"><a href="/admin/tableau-de-bord">Commandes récentes, demandes de contact et alertes DLC →</a></p>
  </div>
</AdminLayout>

<style>
.aj { max-width: 720px; margin: 0 auto; padding-bottom: 5rem; display: flex; flex-direction: column; gap: var(--space-4); }
.aj-h1 { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; margin: 0; color: var(--color-ink); }
.aj-sub { margin: 2px 0 0; font-size: var(--text-sm); color: var(--color-muted); }
.aj-filtres { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; justify-content: space-between; }
.aj-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.aj-chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border: 1.5px solid var(--color-border-strong); border-radius: var(--radius-full); font-size: var(--text-sm); font-weight: 500; color: var(--color-ink); text-decoration: none; }
.aj-chip--on { background: var(--color-primary); border-color: var(--color-primary); color: #fff; font-weight: 700; }
.aj-resp { display: flex; gap: var(--space-2); align-items: center; }
.aj-lib { font-size: var(--text-xs); color: var(--color-muted); }
.aj-resp select { min-height: 44px; padding: 0 var(--space-3); font-size: 16px; border: 1.5px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-bg); }
.aj-flash { margin: 0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-size: var(--text-sm); }
.aj-flash--ok { background: oklch(0.95 0.06 150); color: oklch(0.32 0.12 150); border: 1px solid oklch(0.85 0.09 150); }
.aj-flash--err { background: oklch(0.97 0.04 25); color: oklch(0.50 0.19 25); border: 1px solid oklch(0.88 0.07 25); }
.aj-section { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); }
.aj-section--sugg { background: var(--color-surface); border-style: dashed; }
.aj-titre { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3); font-size: var(--text-base); font-weight: 700; color: var(--color-ink); }
.aj-num { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--color-primary); color: #fff; font-size: var(--text-xs); }
.aj-compte { margin-left: auto; font-size: var(--text-sm); color: var(--color-muted); font-weight: 600; }
.aj-separation { margin: var(--space-2) 0 0; padding: var(--space-2) var(--space-3); font-size: var(--text-xs); color: var(--color-muted); background: var(--color-surface); border-radius: var(--radius-sm); }
.aj-aide { margin: 0 0 var(--space-3); font-size: var(--text-xs); color: var(--color-muted); }
.aj-vide { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
.aj-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aj-carte { padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); }
.aj-carte--en_retard { border-color: oklch(0.80 0.12 25); background: oklch(0.98 0.02 25); }
.aj-carte--aujourdhui { border-color: oklch(0.82 0.10 80); background: oklch(0.98 0.03 80); }
.aj-ligne { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; justify-content: space-between; }
.aj-client { font-weight: 700; color: var(--color-ink); text-decoration: none; overflow-wrap: anywhere; }
.aj-etat { font-size: var(--text-xs); font-weight: 600; color: oklch(0.50 0.19 25); }
.aj-carte:not(.aj-carte--en_retard) .aj-etat { color: var(--color-muted); }
.aj-groupe { font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-full); background: var(--color-surface); color: var(--color-muted); }
.aj-quoi { margin: 2px 0 0; font-size: var(--text-sm); color: var(--color-ink); overflow-wrap: anywhere; }
.aj-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
.aj-actions form { margin: 0; }
.aj-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 var(--space-4); border-radius: var(--radius-full); border: 1.5px solid var(--color-border-strong); background: var(--color-bg); color: var(--color-ink); font: 600 var(--text-xs)/1 var(--font-body); text-decoration: none; cursor: pointer; }
.aj-pied { margin: 0; font-size: var(--text-sm); text-align: center; }
.aj-pied a { color: var(--color-muted); display: inline-flex; align-items: center; min-height: 44px; }
.aj-btn--p { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
</style>
