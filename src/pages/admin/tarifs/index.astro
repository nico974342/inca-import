---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { sanitizeText } from '../../../lib/sanitize';
import { logAdminAction } from '../../../lib/audit';

const adminEmail = (Astro.locals as any).user?.email ?? 'inconnu';

if (Astro.request.method === 'POST') {
  const data   = await Astro.request.formData();
  const action = data.get('action') as string;

  if (action === 'create_group') {
    const name = sanitizeText(data.get('name') as string, 80)?.trim();
    if (name) {
      const { data: inserted, error } = await supabaseAdmin
        .from('price_groups')
        .insert({ name })
        .select('id')
        .single();
      if (error) {
        const reason = error.code === '23505' ? 'nom_existe' : 'erreur';
        return Astro.redirect(`/admin/tarifs?err=${reason}`);
      }
      await logAdminAction({
        adminEmail, action: 'tarifs.groupe_creation',
        targetType: 'price_group', targetId: inserted?.id, targetLabel: name,
      });
    }
  } else if (action === 'set_default') {
    const id = data.get('id') as string;
    if (id) {
      const [{ data: prevDefault }, { data: newGroup }] = await Promise.all([
        supabaseAdmin.from('price_groups').select('name').eq('is_default', true).maybeSingle(),
        supabaseAdmin.from('price_groups').select('name').eq('id', id).single(),
      ]);
      const { error } = await supabaseAdmin.rpc('price_group_set_default', { p_id: id });
      if (!error) {
        await logAdminAction({
          adminEmail, action: 'tarifs.groupe_defaut',
          targetType: 'price_group', targetId: id, targetLabel: newGroup?.name ?? id,
          details: { ancien: prevDefault?.name ?? 'Aucune grille par défaut', nouveau: newGroup?.name ?? id },
        });
      }
    }
  }
  return Astro.redirect('/admin/tarifs?ok=1');
}

const { data: groupsRaw, error: loadErr } = await supabaseAdmin
  .from('price_groups')
  .select('id, name, is_default, created_at')
  .order('created_at', { ascending: true });

// PostgREST reports an unknown table as PGRST205 ("not in the schema cache"),
// not the raw Postgres 42P01 — accept both, same probe as fournisseurs.astro.
const tableMissing = loadErr?.code === 'PGRST205' || loadErr?.code === '42P01';
const groups = groupsRaw ?? [];

const itemCountByGroup   = new Map<string, number>();
const clientCountByGroup = new Map<string, number>();
if (!tableMissing && groups.length > 0) {
  const groupIds = groups.map(g => g.id);
  const [{ data: itemsRaw }, { data: clientsRaw }] = await Promise.all([
    supabaseAdmin.from('price_group_items').select('price_group_id').in('price_group_id', groupIds),
    supabaseAdmin.from('client_accounts').select('price_group_id').in('price_group_id', groupIds),
  ]);
  for (const row of itemsRaw ?? []) {
    itemCountByGroup.set(row.price_group_id, (itemCountByGroup.get(row.price_group_id) ?? 0) + 1);
  }
  for (const row of clientsRaw ?? []) {
    const gid = (row as any).price_group_id;
    clientCountByGroup.set(gid, (clientCountByGroup.get(gid) ?? 0) + 1);
  }
}

const hasDefaultGroup = groups.some(g => g.is_default);

const ok  = !!Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const ERR_MSG: Record<string, string> = {
  nom_existe: 'Un groupe porte déjà ce nom.',
  erreur:     "L'enregistrement a échoué. Veuillez réessayer.",
};
---
<AdminLayout title="Tarifs" activeNav="tarifs">
  <p class="intro">
    Chaque groupe tarifaire ne contient que les produits dont le prix diffère du prix de base —
    un produit absent d'un groupe retombe automatiquement sur son <a href="/admin/produits">prix catalogue</a>.
    Le groupe marqué <strong>par défaut</strong> s'applique à tout client sans groupe assigné explicitement
    sur sa fiche.
  </p>

  {tableMissing ? (
    <div class="alert alert--error" role="alert">
      Les tables <code>price_groups</code> / <code>price_group_items</code> n'existent pas encore.
      Lancez la migration <code>supabase/migrations/price_groups.sql</code> dans Supabase, puis rechargez cette page.
    </div>
  ) : (
    <>
      {ok  && <div class="alert alert--ok" role="status">Enregistré.</div>}
      {err && <div class="alert alert--error" role="alert">{ERR_MSG[err] ?? ERR_MSG.erreur}</div>}
      {!hasDefaultGroup && groups.length > 0 && (
        <div class="alert alert--warn" role="status">
          Aucune grille n'est définie par défaut — tout client sans groupe assigné voit le prix catalogue de base.
          Cliquez sur « Définir par défaut » sur la grille de votre choix ci-dessous pour changer cela.
        </div>
      )}

      <form method="post" class="add-form">
        <input type="hidden" name="action" value="create_group" />
        <div class="field">
          <label class="field-label" for="pg-name">Nouveau groupe tarifaire</label>
          <input type="text" id="pg-name" name="name" required maxlength="80" placeholder="Ex. Stations Incana" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary">Créer</button>
      </form>

      {groups.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">Aucun groupe tarifaire.</p>
          <p class="empty-body">Créez-en un ci-dessus. Tant qu'aucun groupe n'existe, tous les clients voient le prix catalogue.</p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Groupe</th>
                <th class="th-num">Produits en écart</th>
                <th class="th-num">Clients assignés</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {groups.map(g => (
                <tr class={g.is_default ? 'row--default' : ''}>
                  <td class="td-strong">
                    <div class="group-name-row">
                      <span>{g.name}</span>
                      {g.is_default && (
                        <span class="badge-default">
                          <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                          Par défaut
                        </span>
                      )}
                    </div>
                    {g.is_default && (
                      <p class="default-explain">
                        Cette grille s'applique à tout client sans groupe assigné, y compris les nouveaux inscrits.
                      </p>
                    )}
                  </td>
                  <td class="th-num td-muted">{itemCountByGroup.get(g.id) ?? 0}</td>
                  <td class="th-num td-muted">{clientCountByGroup.get(g.id) ?? 0}</td>
                  <td class="td-note">
                    {!g.is_default && (
                      <form method="post" onsubmit={`return confirm('Faire de « ${g.name.replace(/'/g, "\\'")} » la grille par défaut ?\\nTout client sans groupe assigné basculera sur ces prix.')`}>
                        <input type="hidden" name="action" value="set_default" />
                        <input type="hidden" name="id" value={g.id} />
                        <button type="submit" class="set-default-btn">Définir par défaut</button>
                      </form>
                    )}
                  </td>
                  <td class="td-note">
                    <a href={`/admin/tarifs/${g.id}`} class="edit-link">Modifier les prix →</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  )}
</AdminLayout>

<style>
.intro {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin-bottom: var(--space-5);
  max-width: 74ch;
  line-height: 1.6;
}
.intro a { color: var(--color-primary-deep); }

.alert {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid;
}
.alert code { font-family: var(--font-mono); font-size: 0.9em; }
.alert--ok    { color: oklch(0.40 0.12 150); background: oklch(0.96 0.04 150); border-color: oklch(0.86 0.08 150); }
.alert--error { color: oklch(0.46 0.18 25);  background: oklch(0.97 0.03 25);  border-color: oklch(0.88 0.07 25); }
.alert--warn  { color: oklch(0.42 0.14 60);  background: oklch(0.96 0.05 60);  border-color: oklch(0.87 0.09 60); }

.add-form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--space-3);
  padding: var(--space-4);
  margin-bottom: var(--space-5);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.field { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 240px; }
.field-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.field input {
  padding: 0.5rem 0.75rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  min-height: 40px;
  outline: none;
}
.field input:focus { border-color: var(--color-primary); }

.table-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow-x: auto;
}
.data-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.data-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.th-num { text-align: right; }
.data-table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.td-strong { font-weight: 500; color: var(--color-ink); }
.td-muted  { color: var(--color-muted); }
.td-note   { text-align: right; white-space: nowrap; }

.row--default { background: oklch(0.98 0.015 150); }
.row--default:hover { background: oklch(0.98 0.015 150); }

.group-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.badge-default {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.01em;
  color: oklch(0.98 0 0);
  background: oklch(0.48 0.14 150);
  white-space: nowrap;
}

.default-explain {
  margin: var(--space-1) 0 0;
  font-size: var(--text-xs);
  color: var(--color-muted);
  font-weight: 400;
  max-width: 46ch;
  line-height: 1.4;
}

.set-default-btn {
  padding: 0.4rem 0.85rem;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--dur-fast), border-color var(--dur-fast);
}
.set-default-btn:hover { background: var(--color-surface-2); border-color: var(--color-primary); }

.edit-link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary-deep);
  text-decoration: none;
  white-space: nowrap;
}
.edit-link:hover { text-decoration: underline; }

.empty-state {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-16) var(--space-8);
  text-align: center;
}
.empty-title { font-weight: 600; color: var(--color-ink); margin-bottom: var(--space-2); }
.empty-body  { color: var(--color-muted); }
</style>
