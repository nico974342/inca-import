---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CommandeFournisseurRow from '../../components/admin/CommandeFournisseurRow.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { fetchAvailability } from '../../lib/stock';
import {
  REAPPRO_WEEKS_LOOKBACK,
  effectiveHistoryWeeks, VITESSE_SHORT_HISTORY_WEEKS,
  reconstructSellableDays, computeAdjustedVitesse, detecteVenteExceptionnelle, computeConfianceVentes,
  SHIPMENT_ACTIVE_STATUSES, computeShipmentProgress,
  DELAI_LIVRAISON_DEFAUT_JOURS, resolveDelaiLivraison, delaiAVerifier,
  COUVERTURE_CIBLE_DEFAUT_JOURS, resolveCouvertureCible,
  matchSupplierName, type SupplierMatchStatus,
  classifyReorder, computeReorderQtyWithBridge, applyMoqAndMultiple, classifyUrgencyState,
  engagementNonCouvert,
  type ArrivalEvent, type ConfianceVentes,
} from '../../lib/constants';
import { isAdmin } from '../../lib/roles';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'];

// ── Couverture cible après réception : réglée PAR FOURNISSEUR sur
//    /admin/fournisseurs (voir resolveCouvertureCible) — chaque produit
//    utilise la valeur de son propre fournisseur, pas un réglage unique pour
//    toute la page. Le réglage global ci-dessous n'est qu'une simulation
//    facultative (désactivée par défaut) : quand elle est active, elle
//    remplace la valeur de TOUS les fournisseurs pour explorer une
//    hypothèse — elle n'écrase jamais leurs réglages enregistrés. ──
const simulateCouverture = Astro.url.searchParams.get('simulate_couverture') === '1';
const couvertureParam = Number(Astro.url.searchParams.get('couverture'));
const couvertureSimulationJours = Number.isFinite(couvertureParam) && couvertureParam > 0
  ? couvertureParam
  : COUVERTURE_CIBLE_DEFAUT_JOURS;

// ── Jours de sécurité additionnels réglables globalement, en plus de ceux
//    déjà définis par fournisseur (jours_securite) — 0 par défaut : aucun
//    changement de comportement tant que l'utilisateur ne monte pas cette
//    valeur (ex. avant une période à risque de retard). Les deux s'ADDITIONNENT :
//    la marge par fournisseur reste, celle-ci vient en plus. ──
const securiteExtraParam = Number(Astro.url.searchParams.get('securite_extra'));
const securiteExtraJours = Number.isFinite(securiteExtraParam) && securiteExtraParam >= 0 ? securiteExtraParam : 0;

const { data: products, error: productsErr } = await supabaseAdmin
  .from('products')
  .select(`
    id, name, sku, category, unit, units_per_carton, stock_quantity,
    prix_achat_moyen_ht, delai_livraison_jours, delai_livraison_override,
    commande_min_cartons, commande_multiple_cartons, created_at
  `)
  .order('name', { ascending: true });

const allProducts = products ?? [];
const productIds = allProducts.map(p => p.id);

// ── Stock disponible (physique − réservé). Seule figure de stock utilisée
//    partout ensuite — jamais retranché une seconde fois. ──
const availability = await fetchAvailability(allProducts);

// ── Ventes : lignes brutes (PAS pré-agrégées) sur toute la fenêtre de
//    référence, pour pouvoir ensuite filtrer par produit sur SA PROPRE date
//    de mise en vente (sellableSince) — sinon le numérateur (quantité
//    vendue) et le dénominateur (semaines d'historique) ne couvrent pas
//    exactement la même période, ce qui gonfle artificiellement la vitesse
//    d'un produit reçu après sa création. Conserver aussi order_id (compter
//    les commandes distinctes) et la date (reconstruction du stock et
//    détection d'une grosse commande isolée). ──
type SaleRow = { product_id: string; quantity: number; order_id: string; created_at: string };
let salesByProduct = new Map<string, SaleRow[]>();
let salesDataError = false;
if (productIds.length > 0) {
  const lookbackDate = new Date(Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000);
  const { data: salesRows, error: salesErr } = await supabaseAdmin
    .from('order_items')
    .select('product_id, quantity, order_id, orders!inner(status, created_at)')
    .in('orders.status', REVENUE_STATUSES)
    .gte('orders.created_at', lookbackDate.toISOString());

  if (salesErr) {
    // Une erreur de lecture ne doit jamais devenir silencieusement "0
    // vente" — voir computeConfianceVentes(dataError).
    console.error('[commande-fournisseur] lecture des ventes échouée:', salesErr.message);
    salesDataError = true;
  } else {
    for (const row of (salesRows ?? [])) {
      if (!row.product_id) continue;
      const createdAt = (row as any).orders?.created_at ?? null;
      if (!createdAt) continue;
      const list = salesByProduct.get(row.product_id) ?? [];
      list.push({ product_id: row.product_id, quantity: row.quantity, order_id: row.order_id, created_at: createdAt });
      salesByProduct.set(row.product_id, list);
    }
  }
}

// ── Fournisseurs : chargés en premier, id compris — délai/sécurité/
//    couverture sont désormais résolus PAR IDENTIFIANT (voir plus bas), plus
//    par correspondance de nom. Le cycle_commande_jours n'est plus consulté
//    ici : la couverture cible le remplace, pour ne plus imposer une cadence
//    de commande calquée sur le fournisseur. ──
type SupplierRow = { id: string; name: string; delai: number | null; securite: number | null; couverture: number | null };
let allSuppliers: SupplierRow[] = [];
let suppliersTableMissing = false;
let securiteColumnMissing = false;
let couvertureColumnMissing = false;
{
  const probe = await supabaseAdmin.from('suppliers').select('id').limit(1);
  if (probe.error?.code === 'PGRST205' || probe.error?.code === '42P01') {
    suppliersTableMissing = true;
  } else {
    const probeSecurite = await supabaseAdmin.from('suppliers').select('jours_securite').limit(1);
    securiteColumnMissing = probeSecurite.error?.code === '42703';
    const probeCouverture = await supabaseAdmin.from('suppliers').select('couverture_cible_jours').limit(1);
    couvertureColumnMissing = probeCouverture.error?.code === '42703';
    const cols = ['id', 'name', 'delai_livraison_jours'];
    if (!securiteColumnMissing) cols.push('jours_securite');
    if (!couvertureColumnMissing) cols.push('couverture_cible_jours');
    const res = await supabaseAdmin.from('suppliers').select(cols.join(', '));
    allSuppliers = ((res.data ?? []) as any[]).map(s => ({
      id: s.id,
      name: s.name,
      delai: s.delai_livraison_jours,
      securite: securiteColumnMissing ? null : s.jours_securite,
      couverture: couvertureColumnMissing ? null : s.couverture_cible_jours,
    }));
  }
}
const suppliersById = new Map(allSuppliers.map(s => [s.id, s]));
const suppliersForMatch = allSuppliers.map(s => ({ id: s.id, name: s.name }));

// ── Fournisseur + date de première réception + mouvements de stock (pour la
//    reconstruction des périodes de rupture) — une ligne de réception est un
//    mouvement positif à sa date. Identifiant stable (supplier_id) prioritaire
//    quand présent ; sinon rapprochement en direct par nom normalisé (casse +
//    espaces) via matchSupplierName — même filet de sécurité qu'avant la
//    migration qui persiste ce lien, donc aucune régression si la migration
//    n'est pas encore appliquée, et aucune casse silencieuse si un nom
//    ressaisi diffère de la casse enregistrée. Toute correspondance ambiguë
//    ou introuvable est signalée (voir supplierMatchStatus plus bas), jamais
//    fusionnée automatiquement. ──
const supplierByProduct = new Map<string, { supplierId: string | null; rawName: string }>();
const firstReceptionByProduct = new Map<string, string>();
const receptionMovementsByProduct = new Map<string, { date: Date; delta: number }[]>();
if (productIds.length > 0) {
  const probeReceptionSupplierId = await supabaseAdmin.from('stock_receptions').select('supplier_id').limit(1);
  const receptionSupplierIdMissing = probeReceptionSupplierId.error?.code === '42703';
  const receptionCols = receptionSupplierIdMissing
    ? 'stock_receptions(supplier_name, received_at)'
    : 'stock_receptions(supplier_name, supplier_id, received_at)';
  const { data: receptionRows } = await supabaseAdmin
    .from('stock_reception_items')
    .select(`product_id, quantity, created_at, ${receptionCols}`)
    .order('created_at', { ascending: false });
  for (const row of (receptionRows ?? [])) {
    if (!row.product_id) continue;
    const rec = (row as any).stock_receptions;
    if (rec?.supplier_name && !supplierByProduct.has(row.product_id)) {
      supplierByProduct.set(row.product_id, { supplierId: rec.supplier_id ?? null, rawName: rec.supplier_name });
    }
    if (rec?.received_at) {
      const cur = firstReceptionByProduct.get(row.product_id);
      if (!cur || rec.received_at < cur) firstReceptionByProduct.set(row.product_id, rec.received_at);
      const list = receptionMovementsByProduct.get(row.product_id) ?? [];
      list.push({ date: new Date(rec.received_at), delta: row.quantity ?? 0 });
      receptionMovementsByProduct.set(row.product_id, list);
    }
  }
}

/** Résout le fournisseur d'un produit : identifiant persisté d'abord (fiable,
 *  insensible à un renommage ultérieur du fournisseur) ; sinon rapprochement
 *  en direct par nom normalisé. `status` distingue 'matched' (fiable),
 *  'ambiguous' (plusieurs fournisseurs partagent la même clé normalisée),
 *  'unmatched' (aucun ne correspond) et 'none' (aucune réception du tout). */
function resolveProductSupplier(entry: { supplierId: string | null; rawName: string } | undefined): {
  supplierId: string | null; displayName: string | null; status: SupplierMatchStatus | 'none';
} {
  if (!entry) return { supplierId: null, displayName: null, status: 'none' };
  if (entry.supplierId && suppliersById.has(entry.supplierId)) {
    return { supplierId: entry.supplierId, displayName: suppliersById.get(entry.supplierId)!.name, status: 'matched' };
  }
  const m = matchSupplierName(entry.rawName, suppliersForMatch);
  return {
    supplierId: m.supplierId,
    displayName: m.supplierId ? suppliersById.get(m.supplierId)!.name : entry.rawName,
    status: m.status,
  };
}

// ── Arrivages actifs (commandes fournisseur déjà passées + transit) —
//    CHAQUE ligne conservée séparément, jamais fusionnée sur la date de la
//    première. La quantité déjà partiellement reçue est déduite. Une ETA
//    inconnue reste dans la liste (affichée) mais avec eta=null : elle ne
//    compte pas dans la projection datée — voir classifyReorder/projectStock. ──
const { data: transitRows } = await supabaseAdmin
  .from('shipment_items')
  .select('id, product_id, quantity, received_quantity, shipments!inner(id, supplier_name, status, eta, departure_date)')
  .in('shipments.status', SHIPMENT_ACTIVE_STATUSES as readonly string[]);

const arrivalsByProduct = new Map<string, ArrivalEvent[]>();
const now = new Date();
for (const row of (transitRows ?? [])) {
  if (!row.product_id) continue;
  const shipment = (row as any).shipments;
  const remaining = (row.quantity ?? 0) - (row.received_quantity ?? 0);
  if (remaining <= 0) continue;
  const progress = computeShipmentProgress(shipment?.departure_date ?? null, shipment?.eta ?? null, shipment?.status ?? 'commande', now);
  const list = arrivalsByProduct.get(row.product_id) ?? [];
  list.push({
    shipmentId: shipment?.id ?? row.id,
    quantity: remaining,
    eta: shipment?.eta ? new Date(shipment.eta) : null,
    status: shipment?.status ?? 'commande',
  });
  (list as any).__lateFlags = (list as any).__lateFlags ?? [];
  (list as any).__lateFlags.push(progress.late);
  arrivalsByProduct.set(row.product_id, list);
}

const UNGROUPED_LABEL = 'Fournisseur non renseigné';
const fmtDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
const windowStart = new Date(Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000);

const rows = allProducts.map(p => {
  const receivedSince = firstReceptionByProduct.get(p.id) ?? null;
  const createdAt = (p as any).created_at ?? null;
  // "Vendable depuis" = le plus tardif des deux : un produit créé au
  // catalogue avant sa première réception n'a rien pu vendre entre les deux
  // (sauf stock initial saisi à la main, non tracé — voir le mouvement de
  // stock initial ci-dessous).
  const sellableSince = receivedSince && (!createdAt || receivedSince > createdAt) ? receivedSince : createdAt;
  const sellableSinceDate = sellableSince ? new Date(sellableSince) : windowStart;

  const allSales = salesByProduct.get(p.id) ?? [];
  // Numérateur et dénominateur doivent couvrir EXACTEMENT la même fenêtre :
  // on ne compte que les ventes survenues depuis sellableSince, jamais
  // celles d'avant même si elles tombent dans la fenêtre de 10 semaines.
  const salesInWindow = allSales.filter(s => new Date(s.created_at).getTime() >= sellableSinceDate.getTime());
  const qtySold = salesInWindow.reduce((s, r) => s + r.quantity, 0);
  const orderCount = new Set(salesInWindow.map(s => s.order_id)).size;
  const outlierDetected = detecteVenteExceptionnelle(salesInWindow.map(s => s.quantity));

  const historyWeeks = effectiveHistoryWeeks(sellableSince);

  // ── Reconstruction des périodes de rupture, à partir des mouvements
  //    connus (réceptions + ventes) — voir reconstructSellableDays. Un
  //    produit dont l'historique est déjà plafonné par sellableSince court
  //    sur une fenêtre plus courte ; on reconstruit exactement sur cette
  //    même fenêtre pour rester cohérent. C'est une ESTIMATION (mouvements
  //    de vente datés sur orders.created_at, pas sur l'instant réel de
  //    livraison) : computeAdjustedVitesse écarte la correction si elle
  //    paraît excessive plutôt que de l'appliquer aveuglément — voir son
  //    garde-fou dans constants.ts. ──
  const saleMovements = salesInWindow.map(s => ({ date: new Date(s.created_at), delta: -s.quantity }));
  const receptionMovements = (receptionMovementsByProduct.get(p.id) ?? [])
    .filter(m => m.date.getTime() >= sellableSinceDate.getTime());
  const { sellableDays, stockoutDetected } = reconstructSellableDays(
    p.stock_quantity ?? 0,
    [...saleMovements, ...receptionMovements],
    sellableSinceDate,
    now,
  );
  const vitesseAdjustee = computeAdjustedVitesse(qtySold, historyWeeks, sellableDays, stockoutDetected);
  const vitesseVente = vitesseAdjustee.vitesse;
  const { reconstructionApplied, reconstructionUncertain } = vitesseAdjustee;

  const hasSales = vitesseVente > 0;

  const supplierResolved = resolveProductSupplier(supplierByProduct.get(p.id));
  const supplierRow = supplierResolved.supplierId ? suppliersById.get(supplierResolved.supplierId) ?? null : null;
  const delai = resolveDelaiLivraison(
    (p as any).delai_livraison_jours,
    (p as any).delai_livraison_override,
    supplierResolved.displayName,
    supplierRow?.delai ?? null,
  );
  const aVerifierDelai = delaiAVerifier((p as any).delai_livraison_jours, (p as any).delai_livraison_override);
  const joursSecurite = (supplierRow?.securite ?? 0) + securiteExtraJours;
  const couverture = resolveCouvertureCible(
    supplierRow?.couverture ?? null,
    simulateCouverture,
    couvertureSimulationJours,
  );

  const dispo = availability.get(p.id);
  const stockPhysique = p.stock_quantity ?? 0;
  const stockReserve = dispo?.reserved ?? 0;
  const stockDisponible = dispo?.available ?? stockPhysique;
  const manqueEngage = engagementNonCouvert(stockDisponible);

  const arrivalsRaw = arrivalsByProduct.get(p.id) ?? [];
  const arrivals: ArrivalEvent[] = arrivalsRaw.map(a => ({ ...a }));
  const transitQty = arrivals.reduce((s, a) => s + a.quantity, 0);
  const transitHasUnknownEta = arrivals.some(a => a.eta == null);
  const transitLate = ((arrivalsRaw as any).__lateFlags ?? []).some(Boolean);
  // Le plus proche arrivage daté, pour l'affichage compact — chaque
  // arrivage individuel reste consultable dans le détail dépliable.
  const nextArrivalEta = arrivals
    .filter(a => a.eta != null)
    .sort((a, b) => a.eta!.getTime() - b.eta!.getTime())[0]?.eta ?? null;

  const venteQuotidienne = vitesseVente / 7;
  const trigger = hasSales
    ? classifyReorder(stockDisponible, venteQuotidienne, delai.jours, joursSecurite, arrivals, 365, now)
    : { primary: 'donnees_insuffisantes' as const, margeInsuffisante: false, joursAvantCommande: null, dateCommandeConseillee: null };

  let suggestedQty: number | null = null;
  if (hasSales && (trigger.primary === 'a_prevoir' || trigger.primary === 'commander_maintenant' || trigger.primary === 'rupture_avant_commande_normale')) {
    const rawQty = computeReorderQtyWithBridge(stockDisponible, venteQuotidienne, delai.jours, couverture.jours, joursSecurite, arrivals, now);
    suggestedQty = rawQty == null ? null : applyMoqAndMultiple(rawQty, (p as any).commande_min_cartons, (p as any).commande_multiple_cartons);
  } else if (hasSales) {
    suggestedQty = 0; // couvert_par_arrivage : rien à commander maintenant
  }

  const pump = (p as any).prix_achat_moyen_ht != null ? Number((p as any).prix_achat_moyen_ht) : null;
  const upc = (p as any).units_per_carton ?? null;
  const shortHistory = historyWeeks < VITESSE_SHORT_HISTORY_WEEKS;
  const hasReception = receivedSince != null;

  const confiance: ConfianceVentes = computeConfianceVentes({
    hasReception, historyWeeks, orderCount, qtySold,
    outlierDetected, stockoutDetected, reconstructionUncertain, dataError: salesDataError,
  });

  // ── Fiabilité : conserve l'esprit de l'ancienne page (les données faibles
  //    vont "à vérifier" par défaut), MAIS une urgence réelle — rupture avant
  //    qu'une commande normale n'arrive, ou engagement client déjà non
  //    couvert — n'est JAMAIS reléguée dans cette section repliée, même si
  //    la confiance est faible : l'urgence et l'incertitude s'affichent
  //    ensemble, pas l'une à la place de l'autre. ──
  const urgent = trigger.primary === 'rupture_avant_commande_normale' || manqueEngage > 0;
  const reliable = urgent || (hasReception && !shortHistory && hasSales && confiance !== 'insuffisante');
  let unreliableReason: string | null = null;
  if (!reliable) {
    const delaiClause = aVerifierDelai || delai.source === 'defaut' ? ' · délai non confirmé' : '';
    if (salesDataError) unreliableReason = `lecture des ventes indisponible${delaiClause}`;
    else if (!hasReception) unreliableReason = `aucune réception enregistrée${delaiClause}`;
    else if (shortHistory) unreliableReason = `historique court (${historyWeeks.toFixed(1)} sem.)${delaiClause}`;
    else unreliableReason = `pas de ventes enregistrées sur la période${delaiClause}`;
  }

  const covered = trigger.primary === 'couvert_par_arrivage' || (suggestedQty != null && suggestedQty <= 0 && manqueEngage === 0);

  // ── Refonte visuelle : classification de présentation uniquement, voir
  //    classifyUrgencyState dans constants.ts. Ne change aucune valeur du
  //    moteur — sert au tri, aux compteurs d'en-tête et au sélecteur de vue
  //    "Urgences". ──
  const urgencyState = classifyUrgencyState(trigger.primary, manqueEngage, stockDisponible);

  return {
    id: p.id, name: p.name, category: p.category,
    vitesseVente, historyWeeks, shortHistory, hasReception, hasSales, reliable, unreliableReason, urgent,
    confiance, stockoutDetected, reconstructionApplied, reconstructionUncertain, outlierDetected, orderCount, qtySold,
    suggestedQty, covered, urgencyState,
    delai, aVerifierDelai, joursSecurite, couverture,
    couvertureFournisseurJours: supplierRow?.couverture ?? null,
    trigger, manqueEngage,
    transitQty, transitHasUnknownEta, transitLate,
    nextArrivalLabel: nextArrivalEta ? fmtDate(nextArrivalEta) : null,
    arrivals: arrivals.map(a => ({ quantity: a.quantity, eta: a.eta ? a.eta.toISOString() : null, status: a.status })),
    pump, missingPump: pump == null, missingDelai: delai.source === 'defaut',
    unitsPerCarton: upc != null && upc > 0 ? upc : null,
    supplier: supplierResolved.displayName ?? UNGROUPED_LABEL,
    supplierId: supplierResolved.supplierId,
    supplierMatchStatus: supplierResolved.status,
    stockPhysique, stockReserve, stockDisponible,
    minCartons: (p as any).commande_min_cartons ?? null,
    multipleCartons: (p as any).commande_multiple_cartons ?? null,
  };
});

// ── Tri par urgence : rupture avant commande normale et manque déjà engagé
//    d'abord, puis "commander maintenant", puis "à prévoir" par jours
//    restants croissants, puis couvert/données insuffisantes en dernier. ──
function urgencyRank(r: (typeof rows)[number]): number {
  if (r.trigger.primary === 'rupture_avant_commande_normale' || r.manqueEngage > 0) return 0;
  if (r.trigger.primary === 'commander_maintenant') return 1;
  if (r.trigger.primary === 'a_prevoir') return 2;
  if (r.trigger.primary === 'couvert_par_arrivage') return 3;
  return 4; // donnees_insuffisantes
}
function urgencyCompare(a: (typeof rows)[number], b: (typeof rows)[number]): number {
  const ra = urgencyRank(a), rb = urgencyRank(b);
  if (ra !== rb) return ra - rb;
  const ja = a.trigger.joursAvantCommande ?? Number.POSITIVE_INFINITY;
  const jb = b.trigger.joursAvantCommande ?? Number.POSITIVE_INFINITY;
  if (ja !== jb) return ja - jb;
  return a.name.localeCompare(b.name, 'fr');
}

const orderRows = rows.filter(r => r.reliable);
const reviewRows = rows.filter(r => !r.reliable).sort(urgencyCompare);

type Row = (typeof rows)[number];
function lineCost(r: Row): number {
  return r.pump != null ? r.pump * (r.suggestedQty ?? 0) : 0;
}

// États comptant comme "urgent" pour le sélecteur de vue croisé "Urgences"
// et le compteur d'en-tête — ne recouvre pas les statuts neutres/couverts.
const URGENT_STATES = new Set(['manque_engage', 'rupture_actuelle', 'rupture_avant_livraison', 'commander_aujourdhui']);

const supplierNamesOrder = [...new Set(orderRows.map(r => r.supplier))];
const supplierGroups = supplierNamesOrder.map(name => {
  const items = orderRows.filter(r => r.supplier === name).sort(urgencyCompare);
  const visible = items.filter(r => !r.covered);
  const cartons = visible.reduce((s, r) => s + (r.suggestedQty ?? 0), 0);
  const cost = visible.reduce((s, r) => s + lineCost(r), 0);
  const missingPumpCount = visible.filter(r => r.missingPump).length;
  const urgentCount = visible.filter(r => URGENT_STATES.has(r.urgencyState)).length;
  const groupUrgency = items.length ? Math.min(...items.map(urgencyRank)) : 5;
  // Un seul et même fournisseur (suppliers.name est UNIQUE) ne peut porter
  // qu'un seul supplierId au sein d'un groupe déjà regroupé par nom affiché.
  const supplierId = items.find(r => r.supplierId)?.supplierId ?? null;
  const unresolved = items.some(r => r.supplierMatchStatus === 'ambiguous' || r.supplierMatchStatus === 'unmatched');
  return { name, supplierId, unresolved, items, visibleCount: visible.length, cartons, cost, missingPumpCount, urgentCount, groupUrgency };
}).sort((a, b) => a.groupUrgency - b.groupUrgency || b.cartons - a.cartons || a.name.localeCompare(b.name, 'fr'));

const activeSupplierGroups = supplierGroups.filter(g => g.visibleCount > 0);

const totalCartons = activeSupplierGroups.reduce((s, g) => s + g.cartons, 0);
const totalCost = activeSupplierGroups.reduce((s, g) => s + g.cost, 0);
const totalMissingPump = activeSupplierGroups.reduce((s, g) => s + g.missingPumpCount, 0);
const supplierCount = activeSupplierGroups.length;
const urgentTotal = activeSupplierGroups.reduce((s, g) => s + g.urgentCount, 0);

const urgencyCounts: Record<string, number> = {};
for (const r of orderRows) {
  if (r.covered) continue;
  urgencyCounts[r.urgencyState] = (urgencyCounts[r.urgencyState] ?? 0) + 1;
}

const hiddenCoveredCount = rows.filter(r => r.covered).length;
const reviewVisibleCount = reviewRows.filter(r => !r.covered).length;

function formatPrice(n: number): string {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
}

const summaryCost = totalMissingPump > 0
  ? `Total connu : ${formatPrice(totalCost)} · coût incomplet, ${totalMissingPump} référence${totalMissingPump > 1 ? 's' : ''} sans prix`
  : `Total ${formatPrice(totalCost)} HT`;

// Prochaine échéance, tous fournisseurs confondus — l'info d'accueil de la
// page. Distingue explicitement "aujourd'hui" ("Commander aujourd'hui") de
// toute autre date ("Commander avant le …") — la formulation groupée
// "Commander avant le aujourd'hui" n'est jamais grammaticalement correcte.
const nextDeadline = orderRows
  .filter(r => !r.covered && r.trigger.dateCommandeConseillee != null)
  .sort((a, b) => (a.trigger.joursAvantCommande ?? 0) - (b.trigger.joursAvantCommande ?? 0))[0] ?? null;
const nextDeadlineIsToday = nextDeadline?.trigger.joursAvantCommande != null && nextDeadline.trigger.joursAvantCommande <= 0;
const nextDeadlineLabel = !nextDeadlineIsToday && nextDeadline?.trigger.dateCommandeConseillee
  ? fmtDate(nextDeadline.trigger.dateCommandeConseillee)
  : null;

const ambiguousDelaiCount = rows.filter(r => r.aVerifierDelai).length;
---
<AdminLayout title="Commandes fournisseurs" activeNav="commande-fournisseur">
  {suppliersTableMissing && (
    <div class="alert alert--error" role="alert">
      La table <code>suppliers</code> n'existe pas encore — tous les produits utilisent
      le délai par défaut de {DELAI_LIVRAISON_DEFAUT_JOURS} j. Lancez
      <code>supabase/migrations/suppliers_table.sql</code> puis renseignez les délais dans
      <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}
  {!suppliersTableMissing && securiteColumnMissing && (
    <div class="alert alert--warn" role="status">
      La colonne <code>jours_securite</code> n'existe pas encore — le stock de sécurité par fournisseur est
      traité comme nul. Lancez <code>supabase/migrations/suppliers_jours_securite.sql</code> puis
      renseignez-le dans <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}
  {!suppliersTableMissing && couvertureColumnMissing && (
    <div class="alert alert--warn" role="status">
      La colonne <code>couverture_cible_jours</code> n'existe pas encore — tous les fournisseurs utilisent
      {' '}{COUVERTURE_CIBLE_DEFAUT_JOURS} jours par défaut. Lancez
      <code>supabase/migrations/suppliers_couverture_cible.sql</code> puis réglez-la par fournisseur dans
      <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}
  {productsErr && (
    <div class="alert alert--error" role="alert">Erreur de lecture du catalogue : {productsErr.message}</div>
  )}
  {salesDataError && (
    <div class="alert alert--error" role="alert">
      La lecture des ventes a échoué — aucune vitesse de vente n'a pu être calculée sur cette page tant que
      cette erreur persiste. Rechargez la page ; si l'erreur continue, contactez le support.
    </div>
  )}
  {ambiguousDelaiCount > 0 && (
    <div class="alert alert--warn" role="status">
      {ambiguousDelaiCount} produit{ambiguousDelaiCount > 1 ? 's ont' : ' a'} un délai enregistré sur sa fiche
      mais non confirmé comme exception — il n'est pas utilisé tant qu'il n'est pas validé. Ouvrez la fiche
      produit concernée pour confirmer ou effacer cette valeur (badge « délai à vérifier » sur les lignes
      concernées ci-dessous).
    </div>
  )}

  <div class="cf-header">
    <h1 class="cf-title">Commandes fournisseurs</h1>
    <p class="cf-headline">
      {nextDeadlineIsToday
        ? <>Commander aujourd’hui — {nextDeadline!.name}</>
        : nextDeadlineLabel
          ? <>Commander avant le <strong>{nextDeadlineLabel}</strong> — {nextDeadline!.name}</>
          : 'Rien à commander pour l’instant'}
    </p>
    {urgentTotal > 0 && (
      <p class="cf-priority-line">
        {urgencyCounts.manque_engage ? <span class="cf-priority cf-priority--red">{urgencyCounts.manque_engage} manque engagé</span> : null}
        {urgencyCounts.rupture_actuelle ? <span class="cf-priority cf-priority--red">{urgencyCounts.rupture_actuelle} rupture actuelle</span> : null}
        {urgencyCounts.rupture_avant_livraison ? <span class="cf-priority cf-priority--red">{urgencyCounts.rupture_avant_livraison} rupture avant livraison</span> : null}
        {urgencyCounts.commander_aujourdhui ? <span class="cf-priority cf-priority--amber">{urgencyCounts.commander_aujourdhui} à commander aujourd’hui</span> : null}
      </p>
    )}
    <p class="summary-line" id="cfSummary">
      <span id="cfSupplierCount">{supplierCount}</span> fournisseur{supplierCount === 1 ? '' : 's'} à commander
      · <span id="cfTotalCartons">{totalCartons}</span> carton{totalCartons === 1 ? '' : 's'}
      · <span id="cfTotalCost">{summaryCost}</span>
    </p>
    <div class="summary-actions">
      <button type="button" id="cfCopyAll" class="btn btn-primary" disabled={activeSupplierGroups.length === 0}>
        Copier toutes les commandes
      </button>
      <span class="copy-hint" id="cfCopyAllHint" hidden>✓ copié</span>
    </div>
  </div>

  <nav class="supplier-switcher" aria-label="Choix du fournisseur">
    <select class="supplier-switcher-select" id="cfViewSelect" aria-label="Choisir une vue">
      <option value="tous">Tous les fournisseurs</option>
      {urgentTotal > 0 && <option value="urgences">Urgences ({urgentTotal})</option>}
      {activeSupplierGroups.map(g => (
        <option value={g.name}>
          {g.name} — {g.cartons} carton{g.cartons === 1 ? '' : 's'}{g.urgentCount > 0 ? ` · ${g.urgentCount} urgent${g.urgentCount > 1 ? 's' : ''}` : ''}
        </option>
      ))}
    </select>
    <ul class="supplier-switcher-list" id="cfViewList" role="tablist">
      <li>
        <button type="button" class="switcher-item is-active" data-view="tous" role="tab" aria-selected="true">
          <span class="switcher-name">Tous les fournisseurs</span>
          <span class="switcher-meta">{totalCartons} cartons</span>
        </button>
      </li>
      {urgentTotal > 0 && (
        <li>
          <button type="button" class="switcher-item switcher-item--urgences" data-view="urgences" role="tab" aria-selected="false">
            <span class="switcher-name">Urgences</span>
            <span class="switcher-badge">{urgentTotal}</span>
          </button>
        </li>
      )}
      {activeSupplierGroups.map(g => (
        <li>
          <button type="button" class={`switcher-item ${g.name === UNGROUPED_LABEL ? 'switcher-item--ungrouped' : ''}`} data-view={g.name} role="tab" aria-selected="false">
            <span class="switcher-name">{g.name}</span>
            <span class="switcher-meta">{g.cartons} carton{g.cartons === 1 ? '' : 's'}{g.cost > 0 ? ` · ${formatPrice(g.cost)}` : ''}</span>
            {g.urgentCount > 0 && <span class="switcher-badge">{g.urgentCount}</span>}
          </button>
        </li>
      ))}
    </ul>
  </nav>

  <form method="get" class="advanced">
    <details open={simulateCouverture || securiteExtraJours > 0}>
      <summary>Réglages avancés</summary>
      <div class="advanced-body">
        <label class="advanced-checkbox">
          <input type="checkbox" id="cfSimulateCouverture" name="simulate_couverture" value="1" checked={simulateCouverture} onchange="this.form.submit()" />
          Simuler une couverture identique pour tous les fournisseurs
        </label>
        <input
          type="number"
          id="cfCouverture"
          name="couverture"
          class="advanced-input"
          value={couvertureSimulationJours}
          min="1"
          step="1"
          onchange="this.form.submit()"
          aria-label="Couverture simulée (jours)"
          title={simulateCouverture ? 'Remplace la couverture de tous les fournisseurs' : 'Réglez ce nombre puis cochez la case ci-dessus pour l’activer'}
        />

        <label class="advanced-label" for="cfSecuriteExtra">Sécurité additionnelle (jours)</label>
        <input type="number" id="cfSecuriteExtra" name="securite_extra" class="advanced-input" value={securiteExtraJours} min="0" step="1" onchange="this.form.submit()" />

        <label class="advanced-label" for="cfCoef">Coefficient saisonnier</label>
        <div class="coef-wrap">
          <input type="number" id="cfCoef" class="advanced-input coef-input" value="100" min="0" max="500" step="5" />
          <span class="coef-pct">%</span>
        </div>
        <p class="advanced-note advanced-note--convention">
          <strong>Convention :</strong> stock visé après réception = ventes quotidiennes × (couverture cible +
          sécurité). La couverture cible représente des ventes normales ; la sécurité est une réserve
          <em>additionnelle</em> au-dessus, pas une variante du délai — les deux jours de sécurité (celui du
          fournisseur et celui réglé ici) s'additionnent une seule fois, aussi bien pour décider quand commander
          que pour décider combien.
        </p>
        <p class="advanced-note">
          Chaque produit utilise par défaut la couverture cible réglée pour son fournisseur sur
          <a href="/admin/fournisseurs">/admin/fournisseurs</a> — visible avec son origine dans le détail de
          chaque ligne. La case « simuler » ci-dessus n'écrase jamais ces réglages : elle remplace
          temporairement la valeur affichée pour explorer une hypothèse (ex. tester 90 j partout), le temps de
          cette page. La sécurité additionnelle et la simulation recalculent la page (rechargement). Le
          coefficient saisonnier ajuste la vitesse de vente instantanément dans le navigateur. Le délai et la
          sécurité de base se règlent aussi par fournisseur, les exceptions de délai et les contraintes d'achat
          (minimum, multiple) par produit sur sa fiche.
        </p>
      </div>
    </details>
  </form>

  <div id="cfOrderRoot">
    {activeSupplierGroups.length === 0 && reviewVisibleCount === 0 && hiddenCoveredCount === 0 ? (
      <div class="empty-state">
        <p class="empty-title">Aucun produit au catalogue.</p>
      </div>
    ) : activeSupplierGroups.length === 0 ? (
      <div class="empty-state" id="cfEmptyOrders">
        <p class="empty-title">Rien à commander pour l'instant.</p>
        <p class="empty-body">Tous les produits fiables sont couverts par le stock disponible ou déjà en commande.</p>
      </div>
    ) : null}

    {supplierGroups.map(g => (
      <section class="supplier-block" data-role="supplier-block" data-supplier={g.name} data-supplier-id={g.supplierId ?? ''} hidden={g.visibleCount === 0}>
        <div class="supplier-head">
          <div class="supplier-head-main">
            <h2 class="supplier-name">
              {g.name}
              {g.unresolved && (
                <span class="pr-badge pr-badge--warn supplier-name-badge" title="Aucun fournisseur enregistré ne correspond avec certitude à ce nom — délai, sécurité et couverture par défaut tant qu'il n'est pas rapproché sur /admin/fournisseurs">
                  ⚠ fournisseur non identifié
                </span>
              )}
            </h2>
            <p class="supplier-stats">
              <span data-role="supplier-cartons">{g.cartons} carton{g.cartons === 1 ? '' : 's'}</span>
              · <span data-role="supplier-cost">
                {g.cost === 0 && g.missingPumpCount === g.visibleCount
                  ? '—'
                  : g.missingPumpCount > 0
                    ? `Total connu ${formatPrice(g.cost)} HT · coût incomplet`
                    : `${formatPrice(g.cost)} HT`}
              </span>
            </p>
          </div>
          <div class="supplier-actions">
            <button type="button" class="btn btn-ghost btn-copy-supplier" data-supplier={g.name}>Copier la commande</button>
            <button type="button" class="btn btn-primary btn-prepare-order" data-supplier={g.name}>Préparer la commande</button>
          </div>
        </div>
        <div class="supplier-rows">
          {g.items.map(p => <CommandeFournisseurRow p={p} />)}
        </div>
      </section>
    ))}
  </div>

  <button type="button" id="cfShowCovered" class="show-covered-btn" hidden={hiddenCoveredCount === 0}>
    <span id="cfShowCoveredLabel">Voir les produits couverts</span> (<span id="cfHiddenCount">{hiddenCoveredCount}</span>)
  </button>

  {reviewRows.length > 0 && (
    <details class="review-section">
      <summary class="review-title">À vérifier manuellement ({reviewRows.length})</summary>
      <p class="review-intro">
        Historique trop court, pas encore reçu, jamais vendu, ou lecture des ventes indisponible — la quantité
        affichée (quand elle existe) utilise la même formule, mais sur des données moins sûres. Cochez
        « Valider » pour l'intégrer réellement à la commande de son fournisseur.
      </p>
      <div class="review-rows">
        {reviewRows.map(p => <CommandeFournisseurRow p={p} showSupplierTag reviewMode />)}
      </div>
    </details>
  )}
  <div
    id="cfConfig"
    data-simulate-couverture={simulateCouverture ? '1' : '0'}
    data-couverture-simulation={couvertureSimulationJours}
    hidden
  ></div>

  <dialog id="cfPrepareDialog" class="cf-dialog">
    <h2 class="cf-dialog-title" id="cfDialogTitle">Préparer la commande</h2>
    <div class="cf-dialog-freshness" id="cfDialogFreshness" role="status"></div>
    <div class="cf-dialog-body" id="cfDialogBody"></div>
    <p class="cf-dialog-issues" id="cfDialogIssues" hidden></p>
    <div class="cf-dialog-totals" id="cfDialogTotals"></div>
    <div class="cf-dialog-actions">
      <button type="button" class="btn btn-ghost" id="cfDialogCancel">Annuler</button>
      <button type="button" class="btn btn-ghost" id="cfDialogCopy">Copier</button>
      <button type="button" class="btn btn-primary" id="cfDialogConfirm" disabled>Marquer comme commandé</button>
    </div>
  </dialog>
</AdminLayout>

<script>
  // ── Calculs centralisés : ce script importe EXACTEMENT les mêmes
  //    fonctions pures que la page (constants.ts n'a aucune dépendance
  //    serveur — pas de client Supabase importé), donc plus de "miroir"
  //    dupliqué à la main qui pouvait diverger du premier rendu. ──
  import {
    classifyReorder, computeReorderQtyWithBridge, applyMoqAndMultiple, resolveCouvertureCible,
    classifyUrgencyState, type ArrivalEvent,
  } from '../../lib/constants';

  const root = document;
  const productRows = Array.from(document.querySelectorAll<HTMLElement>('[data-role="product-row"]'));
  const coefEl = document.getElementById('cfCoef') as HTMLInputElement | null;
  const showCoveredBtn = document.getElementById('cfShowCovered');
  const showCoveredLabel = document.getElementById('cfShowCoveredLabel');
  const hiddenCountEl = document.getElementById('cfHiddenCount');
  const cfConfig = document.getElementById('cfConfig');
  const simulateCouverture = cfConfig?.dataset.simulateCouverture === '1';
  const couvertureSimulationJours = Number(cfConfig?.dataset.couvertureSimulation) || 30;

  const eur = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
  const num = new Intl.NumberFormat('fr-FR');
  const COUVERTURE_SOURCE_LABEL: Record<string, string> = {
    simulation: 'simulation globale',
    fournisseur: 'réglage fournisseur',
    defaut: 'défaut global',
  };
  const STATE_LABEL: Record<string, string> = {
    manque_engage: 'Manque engagé',
    rupture_actuelle: 'Rupture actuelle',
    rupture_avant_livraison: 'Rupture avant livraison',
    commander_aujourdhui: 'Commander aujourd’hui',
    a_prevoir: 'À prévoir',
    couvert_par_arrivage: 'Couvert',
    donnees_insuffisantes: 'Données insuffisantes',
  };

  const qtyInputOf = (row: HTMLElement) => row.querySelector<HTMLInputElement>('[data-role="qty-input"]');
  const pumpOf = (row: HTMLElement) => (row.dataset.pump === '' ? null : Number(row.dataset.pump));
  const upcOf = (row: HTMLElement) => (row.dataset.upc === '' ? null : Number(row.dataset.upc));
  const qtyOf = (row: HTMLElement) => {
    const raw = qtyInputOf(row)?.value ?? '0';
    const n = Number(raw);
    const invalid = raw.trim() !== '' && (!Number.isFinite(n) || n < 0 || !Number.isInteger(n));
    const warnEl = row.querySelector<HTMLElement>('[data-role="qty-warn"]');
    if (warnEl) warnEl.hidden = !invalid;
    const clamped = Number.isFinite(n) ? Math.max(0, Math.floor(n)) : 0;
    return clamped;
  };
  const coefPct = () => {
    const n = Number(coefEl?.value ?? 100);
    return Number.isFinite(n) && n >= 0 ? n : 100;
  };

  let showCovered = false;
  let currentView = 'tous';

  function parseArrivals(row: HTMLElement): ArrivalEvent[] {
    const raw = row.dataset.arrivals;
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw) as { shipmentId: string; quantity: number; eta: string | null; status: string }[];
      return parsed.map(a => ({ ...a, eta: a.eta ? new Date(a.eta) : null }));
    } catch { return []; }
  }

  // ── "Proposé : X" + distinction modifié/exclu + bouton de retour — voir
  //    demande "Quantités et budget réunis". Zéro = exclusion explicite de la
  //    commande, jamais confondu avec "non modifié". ──
  function updateQtyPresentation(row: HTMLElement) {
    const input = qtyInputOf(row);
    const suggested = Number(row.dataset.suggested) || 0;
    const current = qtyOf(row);
    const revertBtn = row.querySelector<HTMLButtonElement>('[data-role="revert-btn"]');
    const isEdited = row.dataset.edited === '1';
    const differs = current !== suggested;
    if (input) {
      input.dataset.modified = isEdited && differs && current !== 0 ? '1' : '0';
      input.dataset.excluded = isEdited && differs && current === 0 ? '1' : '0';
    }
    if (revertBtn) revertBtn.hidden = !(isEdited && differs);
  }

  function recomputeRow(row: HTMLElement, coef: number) {
    const vitesseBase = Number(row.dataset.vitesse) || 0;
    const delaiJours = Number(row.dataset.delaiJours) || 0;
    const securiteJours = Number(row.dataset.securiteJours) || 0;
    const stock = Number(row.dataset.stock) || 0;
    const hasSales = row.dataset.hasSales === '1';
    const minCartons = row.dataset.min === '' ? null : Number(row.dataset.min);
    const multipleCartons = row.dataset.multiple === '' ? null : Number(row.dataset.multiple);
    const arrivals = parseArrivals(row);
    const couvertureFournisseurJours = row.dataset.couvertureFournisseur === '' ? null : Number(row.dataset.couvertureFournisseur);
    const couverture = resolveCouvertureCible(couvertureFournisseurJours, simulateCouverture, couvertureSimulationJours);

    const vAdj = vitesseBase * (coef / 100);
    const venteQuotidienne = vAdj / 7;

    const now = new Date();
    const trigger = hasSales
      ? classifyReorder(stock, venteQuotidienne, delaiJours, securiteJours, arrivals, 365, now)
      : { primary: 'donnees_insuffisantes' as const, margeInsuffisante: false, joursAvantCommande: null, dateCommandeConseillee: null };

    let suggested: number | null = null;
    if (hasSales && (trigger.primary === 'a_prevoir' || trigger.primary === 'commander_maintenant' || trigger.primary === 'rupture_avant_commande_normale')) {
      const raw = computeReorderQtyWithBridge(stock, venteQuotidienne, delaiJours, couverture.jours, securiteJours, arrivals, now);
      suggested = raw == null ? null : applyMoqAndMultiple(raw, minCartons, multipleCartons);
    } else if (hasSales) {
      suggested = 0;
    }
    const qty = suggested ?? 0;
    row.dataset.suggested = String(qty);

    if (row.dataset.edited !== '1') {
      const input = qtyInputOf(row);
      if (input) input.value = String(qty);
    }

    const manqueEngage = Number(row.dataset.manque) || 0;
    const covered = trigger.primary === 'couvert_par_arrivage' || (suggested != null && suggested <= 0 && manqueEngage === 0);
    row.dataset.covered = covered ? '1' : '0';

    // ── Étiquette d'état + classe visuelle — recalculées ici pour ne jamais
    //    rester figées quand le coefficient change. ──
    const urgencyState = classifyUrgencyState(trigger.primary, manqueEngage, stock);
    row.dataset.urgency = urgencyState;
    row.className = `pr pr--${urgencyState}${row.classList.contains('pr--review') ? ' pr--review' : ''}`;
    const chipEl = row.querySelector<HTMLElement>('[data-role="state-chip"]');
    if (chipEl) {
      let label = STATE_LABEL[urgencyState] ?? urgencyState;
      if (urgencyState === 'manque_engage') label = `Manque engagé : ${manqueEngage} carton${manqueEngage > 1 ? 's' : ''}`;
      else if (urgencyState === 'a_prevoir') {
        const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        label = trigger.dateCommandeConseillee ? `Avant le ${fmt(trigger.dateCommandeConseillee)}` : 'À prévoir';
      }
      chipEl.textContent = label;
      chipEl.dataset.state = urgencyState;
    }

    // ── Panneau "Détail du calcul" : mêmes valeurs recalculées, pour ne
    //    jamais rester figées après un changement de coefficient. ──
    const cibleText = row.querySelector<HTMLElement>('[data-role="cible-text"]');
    if (cibleText) cibleText.textContent = `${Math.round(venteQuotidienne * (couverture.jours + securiteJours))} cartons`;
    const jacText = row.querySelector<HTMLElement>('[data-role="jac-text"]');
    if (jacText) jacText.textContent = trigger.joursAvantCommande != null ? String(Math.round(trigger.joursAvantCommande)) : '—';
    const couvertureText = row.querySelector<HTMLElement>('[data-role="couverture-text"]');
    if (couvertureText) couvertureText.textContent = `${couverture.jours} j — ${COUVERTURE_SOURCE_LABEL[couverture.source]}`;

    const vitesseText = row.querySelector<HTMLElement>('[data-role="vitesse-text"]');
    if (vitesseText) vitesseText.textContent = hasSales ? `ventes ${vAdj.toFixed(1)}/sem.` : 'pas de ventes enregistrées';

    const pump = pumpOf(row);
    const costText = row.querySelector<HTMLElement>('[data-role="cost-text"]');
    if (costText) costText.textContent = pump == null ? '—' : eur.format(pump * qty);
    const proposedText = row.querySelector<HTMLElement>('[data-role="proposed-text"]');
    if (proposedText) proposedText.textContent = `Proposé : ${qty}`;

    updateQtyPresentation(row);

    return { qty };
  }

  // ── Vue courante (sélecteur fournisseur) : 'tous' | 'urgences' | nom exact
  //    d'un fournisseur — ne retire jamais une ligne du DOM, seulement son
  //    attribut hidden, donc aucune quantité saisie n'est perdue en changeant
  //    de vue. ──
  function applyVisibility() {
    let hiddenCovered = 0;
    for (const row of productRows) {
      // Une ligne modifiée à la main avec une quantité réelle ne disparaît
      // jamais derrière le filtre "couvert", même si la formule la
      // considère couverte — bug corrigé (point 5 de la demande d'origine).
      const manuallyKept = row.dataset.edited === '1' && qtyOf(row) > 0;
      const covered = row.dataset.covered === '1' && !manuallyKept;
      if (covered) hiddenCovered++;
      const coveredHidden = covered && !showCovered;

      const rowSupplier = row.dataset.supplier ?? '';
      const isUrgent = ['manque_engage', 'rupture_actuelle', 'rupture_avant_livraison', 'commander_aujourdhui'].includes(row.dataset.urgency ?? '');
      const viewHidden = currentView === 'urgences'
        ? !isUrgent
        : currentView !== 'tous' && rowSupplier !== currentView;

      row.hidden = coveredHidden || viewHidden;
    }
    if (hiddenCountEl) hiddenCountEl.textContent = String(hiddenCovered);
    if (showCoveredBtn) showCoveredBtn.hidden = hiddenCovered === 0;

    for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))) {
      const anyVisible = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).some(r => !r.hidden);
      block.hidden = !anyVisible;
    }
    const emptyOrders = document.getElementById('cfEmptyOrders');
    if (emptyOrders) {
      const anyBlockVisible = Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]')).some(b => !b.hidden);
      emptyOrders.hidden = anyBlockVisible;
    }
  }

  function recalcTotals() {
    // ── Le total d'en-tête, l'export "toutes les commandes" et le
    //    récapitulatif portent TOUJOURS sur l'ensemble des fournisseurs
    //    actifs, jamais seulement sur la vue actuellement affichée — changer
    //    de vue ne doit pas faire varier ces chiffres. ──
    let supplierCount = 0, totalCartons = 0, totalCost = 0, totalMissingPump = 0;

    for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))) {
      const rowsInBlock = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]'));
      // "Actif" = non couvert (indépendamment du filtre de vue courant) :
      // on relit dataset.covered directement plutôt que .hidden.
      const activeRows = rowsInBlock.filter(r => {
        const manuallyKept = r.dataset.edited === '1' && qtyOf(r) > 0;
        return !(r.dataset.covered === '1' && !manuallyKept);
      });
      let cartons = 0, cost = 0, missingPump = 0;
      for (const row of activeRows) {
        const qty = qtyOf(row), pump = pumpOf(row);
        cartons += qty;
        if (pump != null) cost += pump * qty; else missingPump++;
      }
      // Un fournisseur dont toutes les quantités retenues sont à zéro (mises
      // à 0 à la main) ne compte plus comme "à commander" — bug corrigé.
      const blockActive = activeRows.length > 0 && cartons > 0;
      if (blockActive) supplierCount++;

      const cartonsEl = block.querySelector<HTMLElement>('[data-role="supplier-cartons"]');
      if (cartonsEl) cartonsEl.textContent = `${num.format(cartons)} carton${cartons === 1 ? '' : 's'}`;
      const costEl = block.querySelector<HTMLElement>('[data-role="supplier-cost"]');
      if (costEl) {
        costEl.textContent = cartons === 0
          ? '—'
          : missingPump > 0
            ? `Total connu ${eur.format(cost)} · coût incomplet`
            : `${eur.format(cost)} HT`;
      }

      if (blockActive) { totalCartons += cartons; totalCost += cost; totalMissingPump += missingPump; }
    }

    const setText = (id: string, t: string) => { const n = document.getElementById(id); if (n) n.textContent = t; };
    setText('cfSupplierCount', String(supplierCount));
    setText('cfTotalCartons', String(totalCartons));
    const costEl = document.getElementById('cfTotalCost');
    if (costEl) {
      costEl.textContent = totalCartons === 0
        ? '—'
        : totalMissingPump > 0
          ? `Total connu : ${eur.format(totalCost)} · coût incomplet, ${totalMissingPump} référence${totalMissingPump > 1 ? 's' : ''} sans prix`
          : `Total ${eur.format(totalCost)} HT`;
    }

    const copyAllBtn = document.getElementById('cfCopyAll') as HTMLButtonElement | null;
    if (copyAllBtn) copyAllBtn.disabled = supplierCount === 0;
  }

  function recomputeAll() {
    const coef = coefPct();
    for (const row of productRows) recomputeRow(row, coef);
    applyVisibility();
    recalcTotals();
  }

  coefEl?.addEventListener('input', recomputeAll);

  showCoveredBtn?.addEventListener('click', () => {
    showCovered = !showCovered;
    if (showCoveredLabel) showCoveredLabel.textContent = showCovered ? 'Masquer les produits couverts' : 'Voir les produits couverts';
    applyVisibility();
    recalcTotals();
  });

  // ── Sélecteur de vue (liste compacte desktop / <select> mobile — même
  //    état, deux widgets synchronisés). ──
  function setView(view: string) {
    currentView = view;
    const list = document.getElementById('cfViewList');
    if (list) {
      for (const btn of Array.from(list.querySelectorAll<HTMLButtonElement>('.switcher-item'))) {
        const active = btn.dataset.view === view;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      }
    }
    const select = document.getElementById('cfViewSelect') as HTMLSelectElement | null;
    if (select && select.value !== view) select.value = view;
    applyVisibility();
    recalcTotals();
  }
  document.getElementById('cfViewList')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.switcher-item');
    if (btn?.dataset.view) setView(btn.dataset.view);
  });
  document.getElementById('cfViewSelect')?.addEventListener('change', (e) => {
    setView((e.target as HTMLSelectElement).value);
  });

  root.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t?.dataset?.role === 'qty-input') {
      const row = t.closest<HTMLElement>('[data-role="product-row"]')!;
      row.dataset.edited = '1';
      const qty = qtyOf(row); // met à jour l'avertissement de saisie invalide
      updateQtyPresentation(row);
      // Le montant de LA LIGNE doit refléter la quantité tapée immédiatement,
      // pas seulement les totaux — un prix absent reste "—", jamais 0.
      const pump = pumpOf(row);
      const costText = row.querySelector<HTMLElement>('[data-role="cost-text"]');
      if (costText) costText.textContent = pump == null ? '—' : eur.format(pump * qty);
      applyVisibility();
      recalcTotals();
    }
  });

  // ── Promotion d'une ligne "à vérifier" : la case cochée fait rejoindre la
  //    ligne au bloc fournisseur correspondant (créé si besoin), pour de
  //    vrai — comptée dans les totaux, l'export, et le coût. ──
  root.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t?.dataset?.role !== 'review-validate') return;
    const row = t.closest<HTMLElement>('[data-role="product-row"]');
    if (!row) return;
    const checked = (t as HTMLInputElement).checked;
    row.dataset.validated = checked ? '1' : '0';
    if (checked) {
      const supplierName = row.dataset.supplier ?? '';
      let block = document.querySelector<HTMLElement>(`[data-role="supplier-block"][data-supplier="${CSS.escape(supplierName)}"]`);
      if (!block) {
        block = document.createElement('section');
        block.className = 'supplier-block';
        block.dataset.role = 'supplier-block';
        block.dataset.supplier = supplierName;
        block.dataset.supplierId = row.dataset.supplierId ?? '';
        block.innerHTML = `
          <div class="supplier-head">
            <div class="supplier-head-main">
              <h2 class="supplier-name">${supplierName}</h2>
              <p class="supplier-stats"><span data-role="supplier-cartons">0 carton</span> · <span data-role="supplier-cost">—</span></p>
            </div>
            <div class="supplier-actions">
              <button type="button" class="btn btn-ghost btn-copy-supplier" data-supplier="${supplierName}">Copier la commande</button>
              <button type="button" class="btn btn-primary btn-prepare-order" data-supplier="${supplierName}">Préparer la commande</button>
            </div>
          </div>
          <div class="supplier-rows"></div>
        `;
        document.getElementById('cfOrderRoot')?.appendChild(block);
        wireSupplierBlockButtons(block);
      }
      block.querySelector('.supplier-rows')?.appendChild(row);
      block.hidden = false;
    }
    applyVisibility();
    recalcTotals();
  });

  // ── Ouverture/fermeture du détail au clic sur le nom du produit (clavier :
  //    <button> natif, Entrée/Espace fonctionnent). L'anomalie (badges) reste
  //    visible même le panneau fermé — elle n'est jamais À L'INTÉRIEUR du
  //    <details>. ──
  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-role="toggle-details"]');
    if (!btn) return;
    const row = btn.closest<HTMLElement>('[data-role="product-row"]');
    const details = row?.querySelector<HTMLDetailsElement>('[data-role="details-panel"]');
    if (!details) return;
    details.open = !details.open;
    btn.setAttribute('aria-expanded', details.open ? 'true' : 'false');
  });

  // ── "Revenir à la proposition" : annule la retenue manuelle — y compris
  //    côté brouillon serveur (sinon la valeur manuelle reviendrait au
  //    prochain rechargement malgré ce clic). ──
  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-role="revert-btn"]');
    if (!btn) return;
    const row = btn.closest<HTMLElement>('[data-role="product-row"]');
    if (!row) return;
    row.dataset.edited = '0';
    recomputeRow(row, coefPct());
    applyVisibility();
    recalcTotals();
    saveLocalCache(currentEditedValues());
    const productId = row.dataset.id ?? '';
    const pending = pendingSaves.get(productId);
    if (pending) { clearTimeout(pending); pendingSaves.delete(productId); }
    fetch('/api/admin/commande-fournisseur/draft', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id: productId }),
    }).catch(() => { /* le brouillon serveur restera stale jusqu'au prochain succès ; sans conséquence tant qu'aucune autre retenue ne s'appuie dessus */ });
  });

  // ── Copier / marquer comme commandé ──
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        return true;
      } catch {
        return false;
      }
    }
  }

  function activeRowsOf(block: HTMLElement): HTMLElement[] {
    // "Actif" = non couvert, indépendamment de la vue affichée à l'écran —
    // la copie et le récapitulatif ne dépendent jamais du filtre en cours.
    return Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).filter(row => {
      const manuallyKept = row.dataset.edited === '1' && qtyOf(row) > 0;
      return !(row.dataset.covered === '1' && !manuallyKept);
    });
  }

  function buildBlockExport(supplierName: string, rowsForExport: HTMLElement[]): string {
    const lines = [supplierName, ''];
    let cartons = 0, units = 0, cost = 0, missingPump = 0;
    for (const row of rowsForExport) {
      const qty = qtyOf(row);
      if (qty <= 0) continue;
      const upc = upcOf(row), pump = pumpOf(row);
      cartons += qty;
      const unitsPart = upc != null ? ` (${num.format(qty * upc)} unités)` : '';
      if (upc != null) units += qty * upc;
      if (pump != null) cost += pump * qty; else missingPump++;
      lines.push(`${row.dataset.name} — ${qty} carton${qty === 1 ? '' : 's'}${unitsPart}`);
    }
    lines.push('');
    lines.push(`Total : ${num.format(cartons)} carton${cartons === 1 ? '' : 's'}${units > 0 ? ` (${num.format(units)} unités)` : ''}`);
    lines.push(missingPump > 0
      ? `Coût HT connu : ${eur.format(cost)} · coût incomplet, ${missingPump} référence${missingPump > 1 ? 's' : ''} sans prix`
      : `Coût HT connu : ${eur.format(cost)}`);
    // Cette copie ne marque RIEN comme commandé — voir "Préparer la
    // commande" à côté, action distincte et explicite.
    return lines.join('\n');
  }

  function flashCopied(btn: HTMLElement, hintEl?: HTMLElement | null) {
    const original = btn.textContent;
    btn.textContent = '✓ Copié';
    if (hintEl) hintEl.hidden = false;
    setTimeout(() => {
      btn.textContent = original;
      if (hintEl) hintEl.hidden = true;
    }, 1800);
  }

  // ── Marquer comme commandé : effectue réellement l'enregistrement — code
  //    partagé entre le bouton du récapitulatif et un éventuel appel direct.
  //    Idempotence : clé générée UNE FOIS par bloc fournisseur (pas à chaque
  //    clic) — un double-clic ou une requête réseau rejouée porte la même
  //    clé, et le serveur (index unique partiel sur shipments.idempotency_key)
  //    renvoie l'expédition déjà créée au lieu d'en insérer une seconde. ──
  async function markOrdered(block: HTMLElement, btn: HTMLButtonElement): Promise<boolean> {
    if (btn.disabled) return false;
    const supplierName = block.dataset.supplier ?? '';
    const supplierId = block.dataset.supplierId || null;
    if (!block.dataset.idempotencyKey) block.dataset.idempotencyKey = crypto.randomUUID();
    const rowsForOrder = activeRowsOf(block);
    const items = rowsForOrder.map(row => ({
      product_id: row.dataset.id ?? '',
      quantity: qtyOf(row),
      unit_cost_ht: pumpOf(row),
    })).filter(it => it.product_id && it.quantity > 0);
    if (items.length === 0) return false;
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = 'Enregistrement…';
    try {
      const res = await fetch('/api/admin/commande-fournisseur/marquer-commande', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ supplier_name: supplierName, supplier_id: supplierId, items, idempotency_key: block.dataset.idempotencyKey }),
      });
      if (res.ok) {
        btn.textContent = '✓ Commande enregistrée';
        return true;
      }
      btn.disabled = false;
      btn.textContent = original;
      alert('Échec de l’enregistrement — réessayez, ou passez par /admin/transit directement.');
      return false;
    } catch {
      btn.disabled = false;
      btn.textContent = original;
      alert('Erreur réseau — réessayez.');
      return false;
    }
  }

  function wireSupplierBlockButtons(block: HTMLElement) {
    block.querySelector<HTMLButtonElement>('.btn-copy-supplier')?.addEventListener('click', async () => {
      const supplierName = block.dataset.supplier ?? '';
      const ok = await copyText(buildBlockExport(supplierName, activeRowsOf(block)));
      if (ok) flashCopied(block.querySelector('.btn-copy-supplier')!);
    });

    block.querySelector<HTMLButtonElement>('.btn-prepare-order')?.addEventListener('click', () => {
      openPrepareDialog(block);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]').forEach(wireSupplierBlockButtons);

  document.getElementById('cfCopyAll')?.addEventListener('click', async () => {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))
      .filter(b => activeRowsOf(b).some(r => qtyOf(r) > 0));
    const parts = blocks.map(block => buildBlockExport(block.dataset.supplier ?? '', activeRowsOf(block)));
    const btn = document.getElementById('cfCopyAll') as HTMLElement;
    const hint = document.getElementById('cfCopyAllHint');
    const ok = await copyText(parts.join('\n\n───\n\n'));
    if (ok) flashCopied(btn, hint);
  });

  // ── Récapitulatif "Préparer la commande" — voir demande "Action
  //    principale claire". Avant de laisser confirmer, revérifie stock,
  //    prix et arrivages en cours contre l'état réellement en base : la page
  //    peut être restée ouverte longtemps, un autre poste a pu enregistrer
  //    une réception ou un arrivage entre-temps. ──
  const dialogEl = document.getElementById('cfPrepareDialog') as HTMLDialogElement | null;
  let dialogBlock: HTMLElement | null = null;

  function openPrepareDialog(block: HTMLElement) {
    if (!dialogEl) return;
    dialogBlock = block;
    const supplierName = block.dataset.supplier ?? '';
    const titleEl = document.getElementById('cfDialogTitle');
    if (titleEl) titleEl.textContent = `Préparer la commande — ${supplierName}`;

    const rowsForOrder = activeRowsOf(block).filter(r => qtyOf(r) > 0);
    const bodyEl = document.getElementById('cfDialogBody');
    const totalsEl = document.getElementById('cfDialogTotals');
    const issuesEl = document.getElementById('cfDialogIssues');
    const confirmBtn = document.getElementById('cfDialogConfirm') as HTMLButtonElement | null;
    const freshnessEl = document.getElementById('cfDialogFreshness');

    let cartons = 0, cost = 0, missingPump = 0;
    const issues = new Set<string>();
    const delais = new Set<number>();
    const lineHtml: string[] = [];
    for (const row of rowsForOrder) {
      const qty = qtyOf(row);
      const pump = pumpOf(row);
      cartons += qty;
      if (pump != null) cost += pump * qty; else { missingPump++; issues.add('Au moins une référence sans prix d’achat — exclue du coût'); }
      delais.add(Number(row.dataset.delaiJours) || 0);
      if (row.dataset.urgency === 'rupture_actuelle' || row.dataset.urgency === 'manque_engage') issues.add('Au moins une référence déjà en rupture ou avec un manque engagé');
      if (row.querySelector('[data-role="qty-input"]')?.getAttribute('data-modified') === '1' || row.querySelector('[data-role="qty-input"]')?.getAttribute('data-excluded') === '1') {
        issues.add('Au moins une quantité a été modifiée à la main par rapport à la proposition');
      }
      if (row.querySelectorAll('.pr-badge').length > 0) {
        row.querySelectorAll('.pr-badge').forEach(b => issues.add(b.textContent?.trim() ?? ''));
      }
      lineHtml.push(
        `<div class="cf-dialog-line"><span class="cf-dialog-line-name">${row.dataset.name ?? ''}</span>` +
        `<span class="cf-dialog-line-qty">${qty} carton${qty > 1 ? 's' : ''}</span>` +
        `<span class="cf-dialog-line-cost">${pump != null ? eur.format(pump * qty) : '—'}</span></div>`
      );
    }
    if (bodyEl) bodyEl.innerHTML = lineHtml.join('') || '<p class="cf-dialog-empty">Aucune ligne retenue.</p>';
    const delaiText = delais.size === 1 ? `Délai : ${[...delais][0]} j` : `Délais : ${[...delais].sort((a, b) => a - b).join('–')} j`;
    if (totalsEl) {
      totalsEl.innerHTML = `<strong>${num.format(cartons)} carton${cartons === 1 ? '' : 's'}</strong> · ` +
        (missingPump > 0 ? `Total connu ${eur.format(cost)} HT · coût incomplet` : `${eur.format(cost)} HT`) +
        ` · ${delaiText}`;
    }
    if (issuesEl) {
      if (issues.size > 0) {
        issuesEl.hidden = false;
        issuesEl.innerHTML = `<strong>À vérifier :</strong> ${[...issues].filter(Boolean).join(' · ')}`;
      } else {
        issuesEl.hidden = true;
      }
    }

    if (confirmBtn) confirmBtn.disabled = true;
    if (freshnessEl) { freshnessEl.textContent = 'Vérification des données à jour…'; freshnessEl.className = 'cf-dialog-freshness'; }

    const ids = rowsForOrder.map(r => r.dataset.id).filter(Boolean) as string[];
    if (ids.length === 0) {
      if (freshnessEl) freshnessEl.textContent = 'Aucune ligne à vérifier.';
      if (confirmBtn) confirmBtn.disabled = true;
    } else {
      fetch(`/api/admin/commande-fournisseur/refresh-check?ids=${encodeURIComponent(ids.join(','))}`)
        .then(res => (res.ok ? res.json() : Promise.reject(new Error('http'))))
        .then((data: { products?: Record<string, { stockDisponible: number; pump: number | null; transitQty: number }> }) => {
          let stale = false;
          for (const row of rowsForOrder) {
            const fresh = data.products?.[row.dataset.id ?? ''];
            if (!fresh) continue;
            if (Number(row.dataset.stock) !== fresh.stockDisponible) stale = true;
            if (pumpOf(row) !== fresh.pump) stale = true;
            if (Number(row.dataset.transitQty) !== fresh.transitQty) stale = true;
          }
          if (stale) {
            if (freshnessEl) {
              freshnessEl.textContent = '⚠ Des données ont changé depuis le chargement de la page (stock, prix ou arrivage) — rechargez la page avant de confirmer.';
              freshnessEl.classList.add('is-stale');
            }
            if (confirmBtn) confirmBtn.disabled = true;
          } else {
            if (freshnessEl) freshnessEl.textContent = '✓ Données à jour.';
            if (confirmBtn) confirmBtn.disabled = false;
          }
        })
        .catch(() => {
          if (freshnessEl) freshnessEl.textContent = 'Vérification indisponible — contrôlez manuellement avant de confirmer.';
          if (confirmBtn) confirmBtn.disabled = false;
        });
    }

    dialogEl.showModal();
  }

  document.getElementById('cfDialogCancel')?.addEventListener('click', () => dialogEl?.close());
  document.getElementById('cfDialogCopy')?.addEventListener('click', async () => {
    if (!dialogBlock) return;
    const supplierName = dialogBlock.dataset.supplier ?? '';
    const ok = await copyText(buildBlockExport(supplierName, activeRowsOf(dialogBlock).filter(r => qtyOf(r) > 0)));
    const btn = document.getElementById('cfDialogCopy');
    if (ok && btn) flashCopied(btn);
  });
  document.getElementById('cfDialogConfirm')?.addEventListener('click', async (e) => {
    if (!dialogBlock) return;
    const btn = e.currentTarget as HTMLButtonElement;
    const ok = await markOrdered(dialogBlock, btn);
    if (ok) setTimeout(() => { window.location.href = '/admin/transit'; }, 900);
  });

  // ── Brouillon : les quantités retenues à la main sont sauvegardées côté
  //    serveur, liées à l'admin ET au produit — retrouvées après
  //    reconnexion, depuis un autre ordinateur. localStorage ne sert plus
  //    que de cache de secours pour l'affichage immédiat, le temps que le
  //    brouillon serveur (source de vérité) arrive. ──
  const DRAFT_CACHE_KEY = 'cf_draft_cache_v2';
  function loadLocalCache(): Record<string, number> {
    try { return JSON.parse(localStorage.getItem(DRAFT_CACHE_KEY) ?? '{}'); } catch { return {}; }
  }
  function saveLocalCache(values: Record<string, number>) {
    try { localStorage.setItem(DRAFT_CACHE_KEY, JSON.stringify(values)); } catch { /* stockage indisponible, tant pis */ }
  }
  function applyDraftValues(values: Record<string, number>) {
    for (const row of productRows) {
      const saved = values[row.dataset.id ?? ''];
      if (saved != null) {
        const input = qtyInputOf(row);
        if (input) input.value = String(saved);
        row.dataset.edited = '1';
      }
    }
  }
  function currentEditedValues(): Record<string, number> {
    const values: Record<string, number> = {};
    for (const row of productRows) {
      if (row.dataset.edited === '1') values[row.dataset.id ?? ''] = qtyOf(row);
    }
    return values;
  }

  // 1. Cache local, synchrone : évite un flash de la quantité suggérée avant
  //    que le brouillon serveur ne réponde.
  applyDraftValues(loadLocalCache());
  recomputeAll();

  // 2. Brouillon serveur, autoritatif : écrase le cache local dès qu'il
  //    répond (une valeur enregistrée depuis un autre poste doit gagner).
  fetch('/api/admin/commande-fournisseur/draft')
    .then(res => (res.ok ? res.json() : null))
    .then(data => {
      const rows = (data?.drafts ?? []) as { product_id: string; quantity: number }[];
      if (rows.length === 0) return;
      const values: Record<string, number> = {};
      for (const r of rows) values[r.product_id] = r.quantity;
      applyDraftValues(values);
      saveLocalCache({ ...loadLocalCache(), ...values });
      for (const row of productRows) updateQtyPresentation(row);
      applyVisibility();
      recalcTotals();
    })
    .catch(() => { /* brouillon serveur indisponible : le cache local suffit pour cette session */ });

  // 3. Sauvegarde à la frappe : cache local immédiat + envoi serveur
  //    débattu (une requête par produit modifié, pas par frappe).
  const pendingSaves = new Map<string, ReturnType<typeof setTimeout>>();
  function scheduleServerSave(row: HTMLElement) {
    const productId = row.dataset.id ?? '';
    const supplierName = row.dataset.supplier ?? '';
    if (!productId || !supplierName) return;
    const existing = pendingSaves.get(productId);
    if (existing) clearTimeout(existing);
    pendingSaves.set(productId, setTimeout(() => {
      pendingSaves.delete(productId);
      fetch('/api/admin/commande-fournisseur/draft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, supplier_name: supplierName, quantity: qtyOf(row) }),
      }).catch(() => { /* le cache local garde la valeur en attendant */ });
    }, 600));
  }
  root.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t?.dataset?.role !== 'qty-input') return;
    const row = t.closest<HTMLElement>('[data-role="product-row"]')!;
    saveLocalCache(currentEditedValues());
    scheduleServerSave(row);
  });
</script>

