---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CommandeFournisseurRow from '../../components/admin/CommandeFournisseurRow.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { fetchAvailability } from '../../lib/stock';
import {
  REAPPRO_WEEKS_LOOKBACK, computeVitesseVente,
  effectiveHistoryWeeks, VITESSE_SHORT_HISTORY_WEEKS,
  computeWeeksCovered, computeSecuriteCartons, computeOrderQty,
  SHIPMENT_ACTIVE_STATUSES,
  DELAI_LIVRAISON_DEFAUT_JOURS, resolveDelaiLivraison, resolveCycleCommande,
  estimatedArrivalWithMargin, estimatedRuptureDate,
  type ModeCommande,
} from '../../lib/constants';
import { isAdmin } from '../../lib/roles';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'];

// ── Il n'y a plus de mode à choisir. Tout produit assez fiable (voir la
//    fonction "reliable" plus bas) utilise automatiquement le réassort déjà
//    validé — délai + cycle + sécurité, sur le stock disponible. Le moteur
//    de calcul lui-même (constants.ts) n'a pas changé : cette page appelle
//    exactement les mêmes fonctions qu'avant, avec mode figé sur 'reassort'
//    au lieu de lu depuis un sélecteur. ──
const mode: ModeCommande = 'reassort';

const { data: products } = await supabaseAdmin
  .from('products')
  .select('id, name, sku, category, unit, units_per_carton, stock_quantity, prix_achat_moyen_ht, delai_livraison_jours, created_at')
  .order('name', { ascending: true });

const allProducts = products ?? [];
const productIds = allProducts.map(p => p.id);

// ── Stock disponible (physique − réservé) — inchangé. ──
const availability = await fetchAvailability(allProducts);

// ── Vitesse de vente sur la fenêtre de référence — inchangé. ──
const salesQtyByProduct = new Map<string, number>();
if (productIds.length > 0) {
  const lookbackIso = new Date(Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000).toISOString();
  const { data: salesRows } = await supabaseAdmin
    .from('order_items')
    .select('product_id, quantity, orders!inner(status, created_at)')
    .in('orders.status', REVENUE_STATUSES)
    .gte('orders.created_at', lookbackIso);
  for (const row of (salesRows ?? [])) {
    if (!row.product_id) continue;
    salesQtyByProduct.set(row.product_id, (salesQtyByProduct.get(row.product_id) ?? 0) + row.quantity);
  }
}

// ── Fournisseur + date de première réception — inchangé. ──
const supplierByProduct = new Map<string, string>();
const firstReceptionByProduct = new Map<string, string>();
if (productIds.length > 0) {
  const { data: receptionRows } = await supabaseAdmin
    .from('stock_reception_items')
    .select('product_id, created_at, stock_receptions(supplier_name, received_at)')
    .order('created_at', { ascending: false });
  for (const row of (receptionRows ?? [])) {
    if (!row.product_id) continue;
    const rec = (row as any).stock_receptions;
    if (rec?.supplier_name && !supplierByProduct.has(row.product_id)) {
      supplierByProduct.set(row.product_id, rec.supplier_name);
    }
    if (rec?.received_at) {
      const cur = firstReceptionByProduct.get(row.product_id);
      if (!cur || rec.received_at < cur) firstReceptionByProduct.set(row.product_id, rec.received_at);
    }
  }
}

// ── Délais + sécurité + cycle par fournisseur — inchangé. ──
let delaiBySupplier = new Map<string, number | null>();
let securiteBySupplier = new Map<string, number | null>();
let cycleBySupplier = new Map<string, number | null>();
let suppliersTableMissing = false;
let securiteColumnMissing = false;
let cycleColumnMissing = false;
{
  const probe = await supabaseAdmin.from('suppliers').select('id').limit(1);
  if (probe.error?.code === 'PGRST205' || probe.error?.code === '42P01') {
    suppliersTableMissing = true;
  } else {
    const probeSecurite = await supabaseAdmin.from('suppliers').select('jours_securite').limit(1);
    securiteColumnMissing = probeSecurite.error?.code === '42703';
    const probeCycle = await supabaseAdmin.from('suppliers').select('cycle_commande_jours').limit(1);
    cycleColumnMissing = probeCycle.error?.code === '42703';

    const cols = ['name', 'delai_livraison_jours'];
    if (!securiteColumnMissing) cols.push('jours_securite');
    if (!cycleColumnMissing) cols.push('cycle_commande_jours');
    const res = await supabaseAdmin.from('suppliers').select(cols.join(', '));
    for (const s of (res.data ?? []) as any[]) {
      delaiBySupplier.set(s.name, s.delai_livraison_jours);
      securiteBySupplier.set(s.name, securiteColumnMissing ? null : s.jours_securite);
      cycleBySupplier.set(s.name, cycleColumnMissing ? null : s.cycle_commande_jours);
    }
  }
}

// ── Transit — inchangé. Affiché, jamais déduit du calcul. ──
const { data: transitRows } = await supabaseAdmin
  .from('shipment_items')
  .select('product_id, quantity, shipments!inner(status, eta)')
  .in('shipments.status', SHIPMENT_ACTIVE_STATUSES as readonly string[]);

const transitByProduct = new Map<string, { qty: number; eta: string | null }>();
for (const row of (transitRows ?? [])) {
  if (!row.product_id) continue;
  const eta = (row as any).shipments?.eta ?? null;
  const cur = transitByProduct.get(row.product_id) ?? { qty: 0, eta: null };
  cur.qty += row.quantity ?? 0;
  if (eta && (cur.eta == null || eta < cur.eta)) cur.eta = eta;
  transitByProduct.set(row.product_id, cur);
}

const UNGROUPED_LABEL = 'Fournisseur non renseigné';
const today = new Date();
const fmtDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });

const rows = allProducts.map(p => {
  // ── Début d'historique, vitesse, délai, cycle, sécurité, disponible : le
  //    même calcul qu'avant, formule par formule, aucune n'est modifiée ici. ──
  const receivedSince = firstReceptionByProduct.get(p.id) ?? null;
  const createdAt = (p as any).created_at ?? null;
  const sellableSince = receivedSince && (!createdAt || receivedSince > createdAt) ? receivedSince : createdAt;

  const historyWeeks = effectiveHistoryWeeks(sellableSince);
  const vitesseVente = computeVitesseVente(salesQtyByProduct.get(p.id) ?? 0, sellableSince);
  const vitesseAjustee = vitesseVente; // coefficient 100 % au rendu serveur ; le script recalcule ensuite

  const supplierName = supplierByProduct.get(p.id) ?? null;
  const delai = resolveDelaiLivraison(
    (p as any).delai_livraison_jours,
    supplierName,
    supplierName ? delaiBySupplier.get(supplierName) ?? null : null,
  );
  const joursSecurite = (supplierName ? securiteBySupplier.get(supplierName) : null) ?? 0;
  const cycle = resolveCycleCommande(
    supplierName ? cycleBySupplier.get(supplierName) ?? null : null,
    supplierName ? delaiBySupplier.get(supplierName) ?? null : null,
    delai.jours,
  );

  const dispo = availability.get(p.id);
  const stockPhysique = p.stock_quantity ?? 0;
  const stockReserve = dispo?.reserved ?? 0;
  const stockDisponible = dispo?.available ?? stockPhysique;

  const hasSales = vitesseVente > 0;
  // Q = max(0, ceil(vitesse_ajustée × ((délai + cycle + sécurité) / 7) − disponible)).
  // Toujours la même formule réassort validée pour tout produit ayant déjà
  // vendu quelque chose — le 3ᵉ argument (horizon) ne sert qu'au mode
  // amorçage, plus jamais emprunté sur cette page, d'où le 0 littéral.
  // null (pas 0) quand il n'y a aucune vente à extrapoler : ce n'est pas
  // "rien à commander", c'est "rien à calculer".
  const weeksCovered = computeWeeksCovered(mode, delai.jours / 7, 0, cycle.jours / 7);
  const securiteCartons = computeSecuriteCartons(vitesseAjustee, joursSecurite);
  const suggestedQty = hasSales ? computeOrderQty(vitesseAjustee, weeksCovered, securiteCartons, stockDisponible) : null;

  const arrivalWithMargin = estimatedArrivalWithMargin(delai.jours, joursSecurite, today);
  const rupture = estimatedRuptureDate(stockDisponible, vitesseAjustee, today);
  // hasSales gate : computeJoursAvantRupture (constants.ts, non modifié) renvoie
  // 0 jour dès que le stock est ≤ 0, MÊME sans vitesse — un "0" qui veut dire
  // "déjà à sec" pour un produit qui vend, mais qui n'a aucun sens pour un
  // produit qui n'a jamais vendu. Sans ce filtre d'affichage, chaque produit à
  // stock 0 et sans historique (la moitié de "à vérifier") affichait à tort
  // une alerte de rupture.
  const ruptureBeforeArrival = hasSales && rupture != null && rupture.getTime() < arrivalWithMargin.getTime();

  const pump = (p as any).prix_achat_moyen_ht != null ? Number((p as any).prix_achat_moyen_ht) : null;
  const upc = (p as any).units_per_carton ?? null;
  const shortHistory = historyWeeks < VITESSE_SHORT_HISTORY_WEEKS;
  const hasReception = receivedSince != null;

  const transit = transitByProduct.get(p.id) ?? null;
  const transitQty = transit?.qty ?? 0;
  const transitEtaLabel = transit?.eta ? fmtDate(new Date(transit.eta)) : null;

  const missingDelai = delai.source === 'defaut';

  // ── Fiabilité : exactement les trois conditions demandées. Ne détermine
  //    QUE la section d'affichage (et l'avertissement) — la formule
  //    appliquée est toujours la même, fiable ou non, pour ne jamais
  //    réintroduire un second moteur de calcul sur cette page. ──
  const reliable = hasReception && !shortHistory && hasSales;
  let unreliableReason: string | null = null;
  if (!reliable) {
    // Sans réception, le fournisseur (et donc son délai) n'est jamais connu
    // avec certitude — la mention est explicite pour que la quantité
    // indicative ne soit jamais prise pour une recommandation fiable.
    // Un produit avec réception mais dont le délai est quand même retombé
    // sur le défaut (fournisseur non répertorié dans /admin/fournisseurs,
    // par ex.) reçoit la même mention, ajoutée à sa raison propre.
    const delaiClause = ' · fournisseur/délai non confirmé';
    if (!hasReception) unreliableReason = `aucune réception enregistrée${delaiClause}`;
    else if (shortHistory) unreliableReason = `historique court (${historyWeeks.toFixed(1)} sem.)${missingDelai ? delaiClause : ''}`;
    else unreliableReason = `pas de ventes enregistrées sur la période${missingDelai ? delaiClause : ''}`;
  }

  // "Couvert" : une suggestion a été calculée et vaut 0 — masqué par défaut,
  // rien à faire. Un suggestedQty null (aucune vente à extrapoler) N'EST
  // PAS "couvert" : c'est une vraie inconnue, jamais masquée par défaut.
  const covered = suggestedQty != null && suggestedQty <= 0;

  return {
    id: p.id, name: p.name, category: p.category,
    vitesseVente, historyWeeks, shortHistory, hasReception, hasSales, reliable, unreliableReason,
    suggestedQty, covered,
    delai, cycle, joursSecurite,
    ruptureBeforeArrival, ruptureLabel: rupture ? fmtDate(rupture) : null,
    transitQty, transitEtaLabel,
    pump, missingPump: pump == null, missingDelai,
    unitsPerCarton: upc != null && upc > 0 ? upc : null,
    supplier: supplierName ?? UNGROUPED_LABEL,
    stockPhysique, stockReserve, stockDisponible,
  };
});

// ── Regroupement : "à commander" (fiable) groupé par fournisseur, "à
//    vérifier manuellement" (pas fiable) en liste plate. ──
const orderRows = rows.filter(r => r.reliable);
const reviewRows = rows.filter(r => !r.reliable)
  .sort((a, b) => {
    // Aucune suggestion calculable en tête : c'est l'inconnue la plus
    // complète, celle qui mérite le plus un vrai coup d'œil.
    if (a.suggestedQty == null && b.suggestedQty == null) return a.name.localeCompare(b.name, 'fr');
    if (a.suggestedQty == null) return -1;
    if (b.suggestedQty == null) return 1;
    return b.suggestedQty - a.suggestedQty || a.name.localeCompare(b.name, 'fr');
  });

type Row = (typeof rows)[number];
function lineCost(r: Row): number {
  return r.pump != null ? r.pump * (r.suggestedQty ?? 0) : 0;
}

const supplierNamesOrder = [...new Set(orderRows.map(r => r.supplier))];
const supplierGroups = supplierNamesOrder.map(name => {
  const items = orderRows
    .filter(r => r.supplier === name)
    .sort((a, b) => (b.suggestedQty ?? 0) - (a.suggestedQty ?? 0) || a.name.localeCompare(b.name, 'fr'));
  const visible = items.filter(r => !r.covered);
  const cartons = visible.reduce((s, r) => s + (r.suggestedQty ?? 0), 0);
  const cost = visible.reduce((s, r) => s + lineCost(r), 0);
  const missingPumpCount = visible.filter(r => r.missingPump).length;
  return { name, items, visibleCount: visible.length, cartons, cost, missingPumpCount };
}).sort((a, b) => b.cartons - a.cartons || a.name.localeCompare(b.name, 'fr'));

const activeSupplierGroups = supplierGroups.filter(g => g.visibleCount > 0);

const totalCartons = activeSupplierGroups.reduce((s, g) => s + g.cartons, 0);
const totalCost = activeSupplierGroups.reduce((s, g) => s + g.cost, 0);
const totalMissingPump = activeSupplierGroups.reduce((s, g) => s + g.missingPumpCount, 0);
const supplierCount = activeSupplierGroups.length;

const hiddenCoveredCount = rows.filter(r => r.covered).length;
const reviewVisibleCount = reviewRows.filter(r => !r.covered).length;

function formatPrice(n: number): string {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
}

const summaryCost = totalCartons === 0
  ? null
  : totalMissingPump > 0
    ? `Total connu : ${formatPrice(totalCost)} · coût incomplet, ${totalMissingPump} référence${totalMissingPump > 1 ? 's' : ''} sans prix`
    : `Total ${formatPrice(totalCost)} HT`;
---
<AdminLayout title="Commandes fournisseur" activeNav="commande-fournisseur">
  {suppliersTableMissing && (
    <div class="alert alert--error" role="alert">
      La table <code>suppliers</code> n'existe pas encore — tous les produits utilisent
      le délai par défaut de {DELAI_LIVRAISON_DEFAUT_JOURS} j. Lancez
      <code>supabase/migrations/suppliers_table.sql</code> puis renseignez les délais dans
      <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}
  {!suppliersTableMissing && securiteColumnMissing && (
    <div class="alert alert--warn" role="status">
      La colonne <code>jours_securite</code> n'existe pas encore — le stock de sécurité est traité
      comme nul partout. Lancez <code>supabase/migrations/suppliers_jours_securite.sql</code> puis
      renseignez-le dans <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}
  {!suppliersTableMissing && cycleColumnMissing && (
    <div class="alert alert--warn" role="status">
      La colonne <code>cycle_commande_jours</code> n'existe pas encore — le cycle retombe sur le délai
      pour tous les fournisseurs. Lancez <code>supabase/migrations/suppliers_cycle_commande.sql</code> puis
      renseignez-le dans <a href="/admin/fournisseurs">Fournisseurs</a>.
    </div>
  )}

  <div class="summary-row">
    <p class="summary-line" id="cfSummary">
      <span id="cfSupplierCount">{supplierCount}</span> fournisseur{supplierCount === 1 ? '' : 's'} à commander
      · <span id="cfTotalCartons">{totalCartons}</span> carton{totalCartons === 1 ? '' : 's'}
      {summaryCost && <> · <span id="cfTotalCost">{summaryCost}</span></>}
    </p>
    <div class="summary-actions">
      <button type="button" id="cfCopyAll" class="btn btn-primary" disabled={activeSupplierGroups.length === 0}>
        Copier toutes les commandes
      </button>
      <span class="copy-hint" id="cfCopyAllHint" hidden>✓ copié</span>
    </div>
  </div>

  <details class="advanced">
    <summary>Réglages avancés</summary>
    <div class="advanced-body">
      <label class="advanced-label" for="cfCoef">Coefficient saisonnier</label>
      <div class="coef-wrap">
        <input type="number" id="cfCoef" class="coef-input" value="100" min="0" max="500" step="5" />
        <span class="coef-pct">%</span>
      </div>
      <p class="advanced-note">
        Ajuste la vitesse de vente utilisée dans le calcul (ex. 120 % avant une période chargée). Le délai, le
        cycle de commande et le stock de sécurité se règlent par fournisseur sur <a href="/admin/fournisseurs">/admin/fournisseurs</a>.
      </p>
    </div>
  </details>

  <div id="cfOrderRoot">
    {activeSupplierGroups.length === 0 && reviewVisibleCount === 0 && hiddenCoveredCount === 0 ? (
      <div class="empty-state">
        <p class="empty-title">Aucun produit au catalogue.</p>
      </div>
    ) : activeSupplierGroups.length === 0 ? (
      <div class="empty-state" id="cfEmptyOrders">
        <p class="empty-title">Rien à commander pour l'instant.</p>
        <p class="empty-body">Tous les produits fiables sont couverts par le stock disponible ou déjà en transit.</p>
      </div>
    ) : null}

    {supplierGroups.map(g => (
      <section class="supplier-block" data-role="supplier-block" data-supplier={g.name} hidden={g.visibleCount === 0}>
        <div class="supplier-head">
          <div class="supplier-head-main">
            <h2 class="supplier-name">{g.name}</h2>
            <p class="supplier-stats">
              <span data-role="supplier-cartons">{g.cartons} carton{g.cartons === 1 ? '' : 's'}</span>
              · <span data-role="supplier-cost">
                {g.cost === 0 && g.missingPumpCount === g.visibleCount
                  ? '—'
                  : g.missingPumpCount > 0
                    ? `Total connu ${formatPrice(g.cost)} HT · coût incomplet`
                    : `${formatPrice(g.cost)} HT`}
              </span>
            </p>
          </div>
          <button type="button" class="btn btn-ghost btn-copy-supplier" data-supplier={g.name}>Copier la commande</button>
        </div>
        <div class="supplier-rows">
          {g.items.map(p => <CommandeFournisseurRow p={p} />)}
        </div>
      </section>
    ))}
  </div>

  <button type="button" id="cfShowCovered" class="show-covered-btn" hidden={hiddenCoveredCount === 0}>
    <span id="cfShowCoveredLabel">Voir les produits couverts</span> (<span id="cfHiddenCount">{hiddenCoveredCount}</span>)
  </button>

  {reviewRows.length > 0 && (
    // Replié par défaut : à 31 références, cette section pèse plus lourd que
    // tout le reste de la page réuni. Rien à commander n'y attend — la garder
    // ouverte par défaut alourdirait le premier coup d'œil sans rien apporter
    // tant qu'on ne va pas explicitement la consulter.
    <details class="review-section">
      <summary class="review-title">À vérifier manuellement ({reviewRows.length})</summary>
      <p class="review-intro">
        Historique trop court, pas encore reçu, ou jamais vendu — la quantité affichée (quand elle existe) utilise
        la même formule, mais sur des données moins sûres. À valider vous-même avant de commander.
      </p>
      <div class="review-rows">
        {reviewRows.map(p => <CommandeFournisseurRow p={p} showSupplierTag />)}
      </div>
    </details>
  )}
</AdminLayout>

<script>
  const root = document;
  const productRows = Array.from(document.querySelectorAll<HTMLElement>('[data-role="product-row"]'));
  const coefEl = document.getElementById('cfCoef') as HTMLInputElement | null;
  const showCoveredBtn = document.getElementById('cfShowCovered');
  const showCoveredLabel = document.getElementById('cfShowCoveredLabel');
  const hiddenCountEl = document.getElementById('cfHiddenCount');

  const eur = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
  const num = new Intl.NumberFormat('fr-FR');

  const qtyInputOf = (row: HTMLElement) => row.querySelector<HTMLInputElement>('[data-role="qty-input"]');
  const pumpOf = (row: HTMLElement) => (row.dataset.pump === '' ? null : Number(row.dataset.pump));
  const upcOf = (row: HTMLElement) => (row.dataset.upc === '' ? null : Number(row.dataset.upc));
  const qtyOf = (row: HTMLElement) => {
    const n = Math.max(0, Math.floor(Number(qtyInputOf(row)?.value ?? 0)));
    return Number.isFinite(n) ? n : 0;
  };
  const coefPct = () => {
    const n = Number(coefEl?.value ?? 100);
    return Number.isFinite(n) && n >= 0 ? n : 100;
  };

  let showCovered = false;

  // ── Mirroir JS de constants.ts — computeWeeksCovered (toujours la branche
  //    réassort ici, mode figé), computeSecuriteCartons, computeOrderQty,
  //    computeJoursAvantRupture, estimatedArrivalWithMargin. Au chargement
  //    (coefficient 100 %), doit produire des valeurs identiques au serveur. ──
  function weeksCovered(delaiWeeks: number, cycleWeeks: number) {
    return delaiWeeks + cycleWeeks;
  }
  function securiteCartons(vAdj: number, joursSecurite: number) {
    if (!vAdj || vAdj <= 0) return 0;
    return vAdj * (joursSecurite / 7);
  }
  function orderQty(vAdj: number, wCovered: number, securite: number, stock: number) {
    if (!vAdj || vAdj <= 0) return null;
    const q = Math.ceil(vAdj * wCovered + securite - stock);
    return q > 0 ? q : 0;
  }
  function joursAvantRupture(stock: number, vAdj: number) {
    if (stock == null) return null;
    if (stock <= 0) return 0;
    if (!vAdj || vAdj <= 0) return null;
    return stock / (vAdj / 7);
  }
  function addDays(date: Date, days: number) { return new Date(date.getTime() + days * 86400000); }

  function recomputeRow(row: HTMLElement, coef: number) {
    const vitesse = Number(row.dataset.vitesse) || 0;
    const delaiJours = Number(row.dataset.delaiJours) || 0;
    const cycleJours = Number(row.dataset.cycleJours) || 0;
    const securiteJours = Number(row.dataset.securiteJours) || 0;
    const stock = Number(row.dataset.stock) || 0;
    const hasSales = row.dataset.hasSales === '1';

    const vAdj = vitesse * (coef / 100);
    const wCovered = weeksCovered(delaiJours / 7, cycleJours / 7);
    const sec = securiteCartons(vAdj, securiteJours);
    const suggested = hasSales ? orderQty(vAdj, wCovered, sec, stock) : null;
    const qty = suggested ?? 0;

    if (row.dataset.edited !== '1') {
      const input = qtyInputOf(row);
      if (input) input.value = String(qty);
    }

    const now = new Date();
    const arrivalMargin = addDays(addDays(now, delaiJours), securiteJours);
    const jar = joursAvantRupture(stock, vAdj);
    const rupture = jar == null ? null : addDays(now, jar);
    // Même filtre que côté serveur : un stock à 0 sans aucune vitesse ne
    // déclenche pas l'alerte — voir le commentaire équivalent au chargement.
    const ruptureBeforeArrival = hasSales && rupture != null && rupture.getTime() < arrivalMargin.getTime();
    const ruptureBadge = row.querySelector<HTMLElement>('[data-role="rupture-badge"]');
    if (ruptureBadge) ruptureBadge.hidden = !ruptureBeforeArrival;

    const vitesseText = row.querySelector<HTMLElement>('[data-role="vitesse-text"]');
    if (vitesseText) vitesseText.textContent = hasSales ? `ventes ${vAdj.toFixed(1)}/sem.` : 'pas de ventes enregistrées';

    const pump = pumpOf(row);
    const costText = row.querySelector<HTMLElement>('[data-role="cost-text"]');
    if (costText) costText.textContent = pump == null ? '—' : eur.format(pump * qty);

    // "Couvert" (suggestion calculée et nulle) réagit au coefficient — un
    // produit peut mécaniquement sortir ou entrer dans ce statut quand la
    // vitesse ajustée change. suggested === null (aucune vente à
    // extrapoler) n'est jamais "couvert".
    const covered = suggested != null && suggested <= 0;
    row.dataset.covered = covered ? '1' : '0';

    return { qty };
  }

  function applyVisibility() {
    let hiddenCovered = 0;
    for (const row of productRows) {
      const covered = row.dataset.covered === '1';
      row.hidden = covered && !showCovered;
      if (covered) hiddenCovered++;
    }
    if (hiddenCountEl) hiddenCountEl.textContent = String(hiddenCovered);
    // Compte les produits couverts qu'il y ait ou non lieu de les révéler —
    // le bouton lui-même ne disparaît que s'il n'y en a vraiment aucun.
    if (showCoveredBtn) showCoveredBtn.hidden = hiddenCovered === 0;

    // Un bloc fournisseur sans aucune ligne visible n'a rien à proposer :
    // masqué plutôt que de laisser un en-tête vide en tête de page.
    for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))) {
      const anyVisible = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).some(r => !r.hidden);
      block.hidden = !anyVisible;
    }
    const emptyOrders = document.getElementById('cfEmptyOrders');
    if (emptyOrders) {
      const anyBlockVisible = Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]')).some(b => !b.hidden);
      emptyOrders.hidden = anyBlockVisible;
    }
  }

  function recalcTotals() {
    let supplierCount = 0;

    for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))) {
      const visibleRows = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).filter(r => !r.hidden);
      let cartons = 0, cost = 0, missingPump = 0;
      for (const row of visibleRows) {
        const qty = qtyOf(row), pump = pumpOf(row);
        cartons += qty;
        if (pump != null) cost += pump * qty; else missingPump++;
      }
      if (!block.hidden) supplierCount++;

      const cartonsEl = block.querySelector<HTMLElement>('[data-role="supplier-cartons"]');
      if (cartonsEl) cartonsEl.textContent = `${num.format(cartons)} carton${cartons === 1 ? '' : 's'}`;
      const costEl = block.querySelector<HTMLElement>('[data-role="supplier-cost"]');
      if (costEl) {
        costEl.textContent = cartons === 0
          ? '—'
          : missingPump > 0
            ? `Total connu ${eur.format(cost)} · coût incomplet`
            : `${eur.format(cost)} HT`;
      }
    }

    let totalCartons = 0, totalCost = 0, totalMissingPump = 0;
    for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]'))) {
      if (block.hidden) continue;
      const visibleRows = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).filter(r => !r.hidden);
      for (const row of visibleRows) {
        const qty = qtyOf(row), pump = pumpOf(row);
        totalCartons += qty;
        if (pump != null) totalCost += pump * qty; else totalMissingPump++;
      }
    }

    const setText = (id: string, t: string) => { const n = document.getElementById(id); if (n) n.textContent = t; };
    setText('cfSupplierCount', String(supplierCount));
    setText('cfTotalCartons', String(totalCartons));
    const costEl = document.getElementById('cfTotalCost');
    if (costEl) {
      costEl.textContent = totalCartons === 0
        ? ''
        : totalMissingPump > 0
          ? `Total connu : ${eur.format(totalCost)} · coût incomplet, ${totalMissingPump} référence${totalMissingPump > 1 ? 's' : ''} sans prix`
          : `Total ${eur.format(totalCost)} HT`;
    }

    const copyAllBtn = document.getElementById('cfCopyAll') as HTMLButtonElement | null;
    if (copyAllBtn) copyAllBtn.disabled = supplierCount === 0;
  }

  function recomputeAll() {
    const coef = coefPct();
    for (const row of productRows) recomputeRow(row, coef);
    applyVisibility();
    recalcTotals();
  }

  coefEl?.addEventListener('input', recomputeAll);

  showCoveredBtn?.addEventListener('click', () => {
    showCovered = !showCovered;
    if (showCoveredLabel) showCoveredLabel.textContent = showCovered ? 'Masquer les produits couverts' : 'Voir les produits couverts';
    applyVisibility();
    recalcTotals();
  });

  // Une vraie frappe fige la ligne (le coefficient ne l'écrase plus) ; une
  // affectation programmatique de .value ne déclenche pas 'input'.
  root.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t?.dataset?.role === 'qty-input') {
      t.closest<HTMLElement>('[data-role="product-row"]')!.dataset.edited = '1';
      recalcTotals();
    }
  });

  // ── Copier ──
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        return true;
      } catch {
        return false;
      }
    }
  }

  function buildBlockExport(supplierName: string, visibleRows: HTMLElement[]): string {
    const lines = [supplierName, ''];
    let cartons = 0, units = 0, cost = 0, missingPump = 0;
    for (const row of visibleRows) {
      const qty = qtyOf(row);
      if (qty <= 0) continue;
      const upc = upcOf(row), pump = pumpOf(row);
      cartons += qty;
      const unitsPart = upc != null ? ` (${num.format(qty * upc)} unités)` : '';
      if (upc != null) units += qty * upc;
      if (pump != null) cost += pump * qty; else missingPump++;
      lines.push(`${row.dataset.name} — ${qty} carton${qty === 1 ? '' : 's'}${unitsPart}`);
    }
    lines.push('');
    lines.push(`Total : ${num.format(cartons)} carton${cartons === 1 ? '' : 's'}${units > 0 ? ` (${num.format(units)} unités)` : ''}`);
    lines.push(missingPump > 0
      ? `Coût HT connu : ${eur.format(cost)} · coût incomplet, ${missingPump} référence${missingPump > 1 ? 's' : ''} sans prix`
      : `Coût HT connu : ${eur.format(cost)}`);
    return lines.join('\n');
  }

  function flashCopied(btn: HTMLElement, hintEl?: HTMLElement | null) {
    const original = btn.textContent;
    btn.textContent = '✓ Copié';
    if (hintEl) hintEl.hidden = false;
    setTimeout(() => {
      btn.textContent = original;
      if (hintEl) hintEl.hidden = true;
    }, 1800);
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-copy-supplier').forEach(btn => {
    btn.addEventListener('click', async () => {
      const supplierName = btn.dataset.supplier ?? '';
      const block = btn.closest<HTMLElement>('[data-role="supplier-block"]');
      if (!block) return;
      const visibleRows = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).filter(r => !r.hidden);
      const ok = await copyText(buildBlockExport(supplierName, visibleRows));
      if (ok) flashCopied(btn);
    });
  });

  document.getElementById('cfCopyAll')?.addEventListener('click', async () => {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-role="supplier-block"]')).filter(b => !b.hidden);
    const parts = blocks.map(block => {
      const supplierName = block.dataset.supplier ?? '';
      const visibleRows = Array.from(block.querySelectorAll<HTMLElement>('[data-role="product-row"]')).filter(r => !r.hidden);
      return buildBlockExport(supplierName, visibleRows);
    });
    const btn = document.getElementById('cfCopyAll') as HTMLElement;
    const hint = document.getElementById('cfCopyAllHint');
    const ok = await copyText(parts.join('\n\n───\n\n'));
    if (ok) flashCopied(btn, hint);
  });

  recalcTotals();
</script>

