---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import {
  REAPPRO_WEEKS_LOOKBACK, computeVitesseVente,
  effectiveHistoryWeeks, VITESSE_SHORT_HISTORY_WEEKS,
  COUVERTURE_DEFAULT_WEEKS, COUVERTURE_HORIZON_MONTHS, couvertureHorizonWeeks,
  computeCouvertureWeeks, computeCouvertureOrderQty,
} from '../../lib/constants';

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'];

const CAT_LABEL: Record<string, string> = {
  boissons: 'Boissons',
  snacks: 'Snacks',
  chips: 'Chips',
  confiseries: 'Confiseries',
  divers: 'Divers',
};

// ── Horizon: months from the query string, falling back to the 3-month
//    default. Changing it reloads the page, which also resets manual edits —
//    the previous quantities were sized for a different horizon. ──
const horizonParam = Number(Astro.url.searchParams.get('horizon'));
const horizonMonths = (COUVERTURE_HORIZON_MONTHS as readonly number[]).includes(horizonParam)
  ? horizonParam
  : 3;
const horizonWeeks = couvertureHorizonWeeks(horizonMonths);

const { data: products } = await supabaseAdmin
  .from('products')
  .select('id, name, sku, category, unit, units_per_carton, stock_quantity, prix_achat_moyen_ht, created_at')
  .order('name', { ascending: true });

const allProducts = products ?? [];
const productIds = allProducts.map(p => p.id);

// ── Sales velocity over the shared lookback window ──
const salesQtyByProduct = new Map<string, number>();
if (productIds.length > 0) {
  const lookbackIso = new Date(Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000).toISOString();
  const { data: salesRows } = await supabaseAdmin
    .from('order_items')
    .select('product_id, quantity, orders!inner(status, created_at)')
    .in('orders.status', REVENUE_STATUSES)
    .gte('orders.created_at', lookbackIso);
  for (const row of (salesRows ?? [])) {
    if (!row.product_id) continue;
    salesQtyByProduct.set(row.product_id, (salesQtyByProduct.get(row.product_id) ?? 0) + row.quantity);
  }
}

// ── Supplier inferred from the most recent reception that included the
//    product — same signal /admin/reappro groups by, there being no
//    per-product supplier field. ──
const supplierByProduct = new Map<string, string>();
if (productIds.length > 0) {
  const { data: receptionRows } = await supabaseAdmin
    .from('stock_reception_items')
    .select('product_id, created_at, stock_receptions(supplier_name)')
    .order('created_at', { ascending: false });
  for (const row of (receptionRows ?? [])) {
    if (!row.product_id || supplierByProduct.has(row.product_id)) continue;
    const supplier = (row as any).stock_receptions?.supplier_name;
    if (supplier) supplierByProduct.set(row.product_id, supplier);
  }
}

const UNGROUPED_LABEL = 'Fournisseur non renseigné';

const rows = allProducts.map(p => {
  const createdAt = (p as any).created_at ?? null;
  const historyWeeks = effectiveHistoryWeeks(createdAt);
  const vitesseVente = computeVitesseVente(salesQtyByProduct.get(p.id) ?? 0, createdAt);
  const couvertureWeeks = computeCouvertureWeeks(p.stock_quantity, vitesseVente);
  const suggested = computeCouvertureOrderQty(vitesseVente, horizonWeeks, p.stock_quantity);
  const pump = (p as any).prix_achat_moyen_ht != null ? Number((p as any).prix_achat_moyen_ht) : null;
  const upc = (p as any).units_per_carton ?? null;

  return {
    ...p,
    vitesseVente,
    historyWeeks,
    // Velocity from only a few weeks of data — flagged so a thin sample
    // isn't read with the same confidence as an established product.
    shortHistory: historyWeeks < VITESSE_SHORT_HISTORY_WEEKS,
    couvertureWeeks,
    // null (no history) is surfaced as its own state but still starts at 0,
    // so the input is always a usable number.
    suggestedQty: suggested ?? 0,
    hasHistory: vitesseVente > 0,
    // Already covered past the horizon — a real answer, shown discreetly.
    alreadyCovered: suggested === 0,
    pump,
    unitsPerCarton: upc != null && upc > 0 ? upc : null,
    supplier: supplierByProduct.get(p.id) ?? UNGROUPED_LABEL,
  };
});

// Biggest suggested orders first: the lines that actually need a decision.
// Ties fall back to name so the ordering is stable between loads.
rows.sort((a, b) => b.suggestedQty - a.suggestedQty || a.name.localeCompare(b.name, 'fr'));

const suppliers = [...new Set(rows.map(r => r.supplier))].sort((a, b) => {
  if (a === UNGROUPED_LABEL) return 1;
  if (b === UNGROUPED_LABEL) return -1;
  return a.localeCompare(b, 'fr');
});

function formatPrice(n: number | null): string {
  if (n == null) return '—';
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
}
---
<AdminLayout title="Commande fournisseur" activeNav="commande-fournisseur">
  <p class="intro">
    Simulateur de commande : pour chaque produit, la quantité à commander pour tenir
    <strong>{horizonMonths} mois</strong> sans rupture, au rythme de vente des
    {REAPPRO_WEEKS_LOOKBACK} dernières semaines (commandes confirmées, en préparation, expédiées ou livrées).
    Les quantités sont modifiables — le total se recalcule en direct.
    Pour un produit récent, la vitesse est ramenée à son ancienneté réelle et non aux
    {REAPPRO_WEEKS_LOOKBACK} semaines pleines ; en dessous de {VITESSE_SHORT_HISTORY_WEEKS} semaines
    d'historique, la ligne est marquée « historique court ».
  </p>

  <form method="get" class="controls">
    <div class="control">
      <label class="control-label" for="cfSearch">Rechercher</label>
      <input
        type="search"
        id="cfSearch"
        class="control-input"
        placeholder="Nom de produit ou fournisseur…"
        autocomplete="off"
      />
    </div>

    <div class="control">
      <label class="control-label" for="cfSupplier">Fournisseur</label>
      <select id="cfSupplier" class="control-input">
        <option value="">Tous les fournisseurs</option>
        {suppliers.map(s => <option value={s}>{s}</option>)}
      </select>
    </div>

    <div class="control">
      <label class="control-label" for="cfHorizon">Horizon de couverture</label>
      <select id="cfHorizon" name="horizon" class="control-input" onchange="this.form.submit()">
        {COUVERTURE_HORIZON_MONTHS.map(m => (
          <option value={m} selected={m === horizonMonths}>
            {m} mois ({Math.round(couvertureHorizonWeeks(m) * 10) / 10} sem.)
          </option>
        ))}
      </select>
    </div>

    <div class="control control--action">
      <button type="button" id="cfExport" class="btn btn-primary">Exporter la commande</button>
    </div>
  </form>

  <p class="results-line" id="cfResults" hidden aria-live="polite"></p>

  {rows.length === 0 ? (
    <div class="empty-state">
      <p class="empty-title">Aucun produit au catalogue.</p>
      <p class="empty-body">Ajoutez des produits pour simuler une commande fournisseur.</p>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="data-table" id="cfTable">
        <thead>
          <tr>
            <th>Produit</th>
            <th>Fournisseur</th>
            <th class="th-num">Vitesse de vente</th>
            <th class="th-num">Stock actuel</th>
            <th class="th-num">Couverture actuelle</th>
            <th class="th-num">À commander</th>
            <th class="th-num">Coût estimé HT</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(p => (
            <tr
              data-search={`${p.name} ${p.supplier}`.toLowerCase()}
              data-supplier={p.supplier}
              data-name={p.name}
              data-pump={p.pump ?? ''}
              data-upc={p.unitsPerCarton ?? ''}
              data-suggested={p.suggestedQty}
            >
              <td>
                <span class="td-strong">{p.name}</span>
                <div class="td-sub-row">
                  <span class={`cat-badge cat-badge--${p.category}`}>{CAT_LABEL[p.category] ?? p.category}</span>
                  {p.sku && <span class="td-sub">{p.sku}</span>}
                </div>
              </td>
              <td class="td-supplier">{p.supplier}</td>
              <td class="th-num td-mono">
                {p.hasHistory ? (
                  <>
                    {p.vitesseVente.toFixed(1)} /sem.
                    {p.shortHistory && (
                      <p
                        class="short-history"
                        title={`Vitesse calculée sur ${p.historyWeeks.toFixed(1)} semaine(s) d'historique seulement — produit récent, chiffre moins fiable.`}
                      >Historique court</p>
                    )}
                  </>
                ) : (
                  <span class="td-muted">Pas d'historique</span>
                )}
              </td>
              <td class="th-num td-mono">{p.stock_quantity ?? 0}</td>
              <td class="th-num td-mono">
                {p.couvertureWeeks != null ? (
                  <span class={p.alreadyCovered ? 'covered' : ''}>
                    {p.couvertureWeeks.toFixed(1)} sem.
                  </span>
                ) : (
                  <span class="td-muted">—</span>
                )}
              </td>
              <td class="th-num">
                <div class="qty-cell">
                  <input
                    type="number"
                    class="qty-input"
                    min="0"
                    step="1"
                    value={p.suggestedQty}
                    aria-label={`Quantité à commander pour ${p.name}`}
                  />
                  <span class="qty-unit">{p.unit ?? 'cartons'}</span>
                </div>
                {!p.hasHistory && <p class="qty-note">Pas d'historique</p>}
                {p.hasHistory && p.alreadyCovered && <p class="qty-note qty-note--ok">Déjà couvert</p>}
              </td>
              <td class="th-num td-mono line-cost">
                {p.pump == null ? <span class="td-muted" title="Prix d'achat moyen non renseigné">—</span> : formatPrice(p.pump * p.suggestedQty)}
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="totals-row">
            <td colspan="5" class="totals-label">Total de la commande</td>
            <td class="th-num">
              <span class="totals-cartons" id="cfTotalCartons">0</span>
              <p class="totals-units" id="cfTotalUnits">0 unité</p>
            </td>
            <td class="th-num totals-cost" id="cfTotalCost">—</td>
          </tr>
        </tfoot>
      </table>
      <p class="no-results" id="cfNoResults" hidden>Aucun produit ne correspond à votre recherche.</p>
      <p class="footnote" id="cfFootnote" hidden></p>
    </div>
  )}

  <!-- Export panel — plain text, ready to paste into an email or WhatsApp -->
  <div class="export-panel" id="cfExportPanel" hidden>
    <div class="export-head">
      <h2 class="export-title">Récapitulatif à envoyer</h2>
      <div class="export-actions">
        <button type="button" class="btn btn-primary" id="cfCopy">Copier</button>
        <button type="button" class="btn btn-ghost" id="cfCloseExport">Fermer</button>
      </div>
    </div>
    <textarea class="export-text" id="cfExportText" readonly rows="12" aria-label="Récapitulatif de commande"></textarea>
    <p class="export-hint" id="cfCopyHint" hidden>Copié dans le presse-papier.</p>
  </div>
</AdminLayout>

<script define:vars={{ horizonMonths }}>
  const table      = document.getElementById('cfTable');
  const searchEl   = document.getElementById('cfSearch');
  const supplierEl = document.getElementById('cfSupplier');
  const resultsEl  = document.getElementById('cfResults');
  const noResults  = document.getElementById('cfNoResults');
  const footnote   = document.getElementById('cfFootnote');

  if (table) {
    const bodyRows = Array.from(table.querySelectorAll('tbody tr'));

    const eur = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
    const num = new Intl.NumberFormat('fr-FR');

    const qtyOf = (row) => {
      const input = row.querySelector('.qty-input');
      const n = Math.max(0, Math.floor(Number(input?.value ?? 0)));
      return Number.isFinite(n) ? n : 0;
    };
    const pumpOf = (row) => (row.dataset.pump === '' ? null : Number(row.dataset.pump));
    const upcOf  = (row) => (row.dataset.upc === '' ? null : Number(row.dataset.upc));

    const isVisible = (row) => !row.hidden;

    /** Recomputes each visible line's cost and the footer totals. */
    function recalc() {
      let cartons = 0, units = 0, cost = 0;
      let missingPump = 0, missingUpc = 0;

      for (const row of bodyRows) {
        const qty  = qtyOf(row);
        const pump = pumpOf(row);
        const upc  = upcOf(row);

        // Per-line cost updates even for hidden rows, so revealing a row
        // never shows a stale figure.
        const costCell = row.querySelector('.line-cost');
        if (costCell) {
          costCell.textContent = pump == null ? '—' : eur.format(pump * qty);
          if (pump == null) costCell.classList.add('td-muted');
        }

        if (!isVisible(row) || qty <= 0) continue;

        cartons += qty;
        if (upc != null) units += qty * upc; else missingUpc++;
        if (pump != null) cost += pump * qty; else missingPump++;
      }

      const setText = (id, text) => { const n = document.getElementById(id); if (n) n.textContent = text; };
      setText('cfTotalCartons', `${num.format(cartons)} carton${cartons === 1 ? '' : 's'}`);
      setText('cfTotalUnits', `${num.format(units)} unité${units === 1 ? '' : 's'}`);
      setText('cfTotalCost', cartons === 0 ? '—' : eur.format(cost));

      // Totals that exclude something must say so rather than reading as exact.
      const notes = [];
      if (missingPump) notes.push(`${missingPump} produit${missingPump > 1 ? 's' : ''} sans prix d'achat moyen — exclu${missingPump > 1 ? 's' : ''} du coût total`);
      if (missingUpc)  notes.push(`${missingUpc} produit${missingUpc > 1 ? 's' : ''} sans conditionnement — exclu${missingUpc > 1 ? 's' : ''} du total en unités`);
      if (footnote) {
        footnote.textContent = notes.length ? `* ${notes.join(' · ')}` : '';
        footnote.hidden = notes.length === 0;
      }
    }

    function applyFilters() {
      const query    = (searchEl?.value ?? '').trim().toLowerCase();
      const supplier = supplierEl?.value ?? '';
      let visible = 0;

      for (const row of bodyRows) {
        const matchesQuery    = !query || (row.dataset.search ?? '').includes(query);
        const matchesSupplier = !supplier || row.dataset.supplier === supplier;
        const show = matchesQuery && matchesSupplier;
        row.hidden = !show;
        if (show) visible++;
      }

      if (noResults) noResults.hidden = visible > 0;
      if (resultsEl) {
        const filtering = Boolean(query || supplier);
        resultsEl.textContent = filtering
          ? `${visible} produit${visible !== 1 ? 's' : ''} correspondant${visible !== 1 ? 's' : ''}`
          : '';
        resultsEl.hidden = !filtering;
      }
      recalc();
    }

    searchEl?.addEventListener('input', applyFilters);
    supplierEl?.addEventListener('change', applyFilters);
    table.addEventListener('input', (e) => {
      if ((e.target).classList?.contains('qty-input')) recalc();
    });

    // ── Export ──
    const panel    = document.getElementById('cfExportPanel');
    const textArea = document.getElementById('cfExportText');
    const hint     = document.getElementById('cfCopyHint');

    function buildExport() {
      const picked = bodyRows.filter(r => isVisible(r) && qtyOf(r) > 0);
      const supplier = supplierEl?.value || '';

      const header = supplier
        ? `Commande fournisseur — ${supplier}`
        : 'Commande fournisseur';
      const lines = [header, `Couverture visée : ${horizonMonths} mois`, ''];

      if (picked.length === 0) {
        lines.push('(aucune quantité à commander)');
        return lines.join('\n');
      }

      let cartons = 0, units = 0, cost = 0;
      let anyMissingPump = false;
      for (const row of picked) {
        const qty = qtyOf(row);
        const upc = upcOf(row);
        const pump = pumpOf(row);
        cartons += qty;
        if (upc != null) units += qty * upc;
        if (pump != null) cost += pump * qty; else anyMissingPump = true;
        lines.push(`${row.dataset.name} — ${qty} carton${qty === 1 ? '' : 's'}`);
      }

      lines.push('');
      lines.push(`Total : ${num.format(cartons)} carton${cartons === 1 ? '' : 's'} (${num.format(units)} unité${units === 1 ? '' : 's'})`);
      lines.push(`Coût estimé HT : ${eur.format(cost)}${anyMissingPump ? ' (hors produits sans prix d\'achat connu)' : ''}`);
      return lines.join('\n');
    }

    document.getElementById('cfExport')?.addEventListener('click', () => {
      if (!panel || !textArea) return;
      textArea.value = buildExport();
      panel.hidden = false;
      if (hint) hint.hidden = true;
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    document.getElementById('cfCopy')?.addEventListener('click', async () => {
      if (!textArea) return;
      try {
        await navigator.clipboard.writeText(textArea.value);
      } catch {
        // Clipboard API needs a secure context — fall back to selecting the
        // text so a manual copy still works.
        textArea.select();
      }
      if (hint) hint.hidden = false;
    });

    document.getElementById('cfCloseExport')?.addEventListener('click', () => {
      if (panel) panel.hidden = true;
    });

    recalc();
  }
</script>

<style>
.intro {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin-bottom: var(--space-5);
  max-width: 78ch;
}
.intro strong { color: var(--color-ink); }

.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.control { display: flex; flex-direction: column; gap: 4px; }
.control--action { margin-left: auto; }
.control-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.control-input {
  min-width: 220px;
  padding: 0.5rem 0.75rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  min-height: 40px;
  outline: none;
}
.control-input:focus { border-color: var(--color-primary); }

.results-line {
  margin: 0 0 var(--space-3);
  font-size: var(--text-xs);
  color: var(--color-muted);
}

.table-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow-x: auto;
}

.data-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.data-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.th-num { text-align: right; }
.data-table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.data-table tbody tr:hover td { background: var(--color-surface); }

.td-strong { font-weight: 500; color: var(--color-ink); }
.td-muted  { color: var(--color-muted); }
.td-mono   { font-family: var(--font-mono); color: var(--color-ink); white-space: nowrap; }
.td-sub    { font-size: var(--text-xs); color: var(--color-muted); }
.td-sub-row { display: flex; align-items: center; gap: var(--space-2); margin-top: 2px; }
.td-supplier { color: var(--color-muted); font-size: var(--text-xs); }

.cat-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 500;
  white-space: nowrap;
}
.cat-badge--boissons    { background: oklch(0.93 0.05 220); color: oklch(0.35 0.10 220); }
.cat-badge--snacks      { background: oklch(0.94 0.05 60);  color: oklch(0.40 0.12 60);  }
.cat-badge--chips       { background: oklch(0.93 0.05 180); color: oklch(0.35 0.10 180); }
.cat-badge--confiseries { background: oklch(0.93 0.06 330); color: oklch(0.40 0.12 330); }
.cat-badge--divers      { background: oklch(0.93 0.05 275); color: oklch(0.40 0.12 275); }

/* Comfortably covered past the horizon — present, but visually quiet. */
.covered { color: oklch(0.48 0.13 150); }

.qty-cell {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
}
.qty-input {
  width: 84px;
  padding: 0.375rem 0.5rem;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  text-align: right;
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  outline: none;
}
.qty-input:focus { border-color: var(--color-primary); }
.qty-unit { font-size: var(--text-xs); color: var(--color-muted); }
.qty-note {
  margin: 3px 0 0;
  font-size: var(--text-xs);
  color: var(--color-muted);
  text-align: right;
}
.qty-note--ok { color: oklch(0.48 0.13 150); }

/* Thin sample behind the velocity — present but deliberately quiet. */
.short-history {
  margin: 3px 0 0;
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 500;
  color: oklch(0.52 0.11 60);
  text-align: right;
  cursor: help;
}

.totals-row td {
  padding: var(--space-4);
  border-top: 2px solid var(--color-border-strong);
  background: var(--color-surface);
  font-weight: 700;
}
.totals-label { text-align: right; color: var(--color-muted); text-transform: uppercase; font-size: var(--text-xs); letter-spacing: 0.05em; }
.totals-cartons { font-size: 1rem; color: var(--color-ink); font-variant-numeric: tabular-nums; }
.totals-units { margin: 2px 0 0; font-size: var(--text-xs); font-weight: 500; color: var(--color-muted); }
.totals-cost {
  font-family: var(--font-mono);
  font-size: 1rem;
  color: var(--color-primary-deep);
  white-space: nowrap;
}

.no-results, .footnote {
  padding: var(--space-4);
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.no-results { padding: var(--space-8); text-align: center; font-size: var(--text-sm); }
.footnote { font-style: italic; border-top: 1px solid var(--color-border); }

.export-panel {
  margin-top: var(--space-5);
  padding: var(--space-4);
  background: var(--color-bg);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
}
.export-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
