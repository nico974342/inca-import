---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import {
  marginColorClass, computeGmroi, gmroiColorClass, computeStockRotation, rotationColorClass,
  REAPPRO_WEEKS_LOOKBACK, computeVitesseVente, computeJoursAvantRupture,
  computeSuggestedReorderQty, isApproachingOrBelowSeuil,
} from '../../../../lib/constants';
import { formatDateReunion } from '../../../../lib/datetime';

const REVENUE_STATUSES = ['confirmee', 'en_preparation', 'expediee', 'livree'];

const { id } = Astro.params;

const { data: product } = await supabaseAdmin
  .from('products')
  .select('*')
  .eq('id', id)
  .single();

if (!product) return Astro.redirect('/admin/produits');

const CAT_LABEL: Record<string, string> = {
  boissons: 'Boissons',
  snacks: 'Snacks',
  chips: 'Chips',
  confiseries: 'Confiseries',
  divers: 'Divers',
};

// ── One 12-month order_items pull covers everything: GMROI/rotation
//    (full window), vitesse de vente (last N weeks, a subset of the same
//    rows), the monthly chart, and the per-PDV/client breakdown. ──
const now = new Date();
const twelveMonthsAgoIso = new Date(now.getFullYear(), now.getMonth() - 12, now.getDate()).toISOString();

const { data: salesRows } = await supabaseAdmin
  .from('order_items')
  .select('quantity, price_ht_snapshot, pump_snapshot, orders!inner(nom, societe, email, status, created_at)')
  .eq('product_id', id)
  .in('orders.status', REVENUE_STATUSES)
  .gte('orders.created_at', twelveMonthsAgoIso);

// 12 calendar months, oldest first, for the chart
const MONTHS_BACK = 12;
const monthDefs: { label: string; start: Date; end: Date }[] = [];
for (let i = MONTHS_BACK - 1; i >= 0; i--) {
  const start = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const end   = new Date(now.getFullYear(), now.getMonth() - i + 1, 1);
  const label = start.toLocaleDateString('fr-FR', { month: 'short' }).replace('.', '');
  monthDefs.push({ label: label.charAt(0).toUpperCase() + label.slice(1), start, end });
}
const monthlyQty = monthDefs.map(() => 0);

const reapproCutoffMs = Date.now() - REAPPRO_WEEKS_LOOKBACK * 7 * 24 * 60 * 60 * 1000;

let marge12mo: number | null = null;
let cogs12mo: number | null = null;
let recentQty = 0;

const pdvAgg = new Map<string, { label: string; qty: number; ca: number }>();

for (const row of (salesRows ?? [])) {
  const order = (row as any).orders;
  const qty   = row.quantity;
  const price = row.price_ht_snapshot != null ? Number(row.price_ht_snapshot) : null;
  const pump  = row.pump_snapshot != null ? Number(row.pump_snapshot) : null;

  if (price != null && pump != null) {
    marge12mo = (marge12mo ?? 0) + (price - pump) * qty;
    cogs12mo  = (cogs12mo ?? 0) + pump * qty;
  }

  const ts = new Date(order.created_at).getTime();
  if (ts >= reapproCutoffMs) recentQty += qty;

  const idx = monthDefs.findIndex(m => ts >= m.start.getTime() && ts < m.end.getTime());
  if (idx !== -1) monthlyQty[idx] += qty;

  const pdvLabel = order.societe || order.nom || order.email || 'Client inconnu';
  const cur = pdvAgg.get(pdvLabel) ?? { label: pdvLabel, qty: 0, ca: 0 };
  cur.qty += qty;
  if (price != null) cur.ca += price * qty;
  pdvAgg.set(pdvLabel, cur);
}

const totalQty12mo = monthlyQty.reduce((s, q) => s + q, 0);
const pdvRows = Array.from(pdvAgg.values()).sort((a, b) => b.qty - a.qty);

// ── Key metrics ──────────────────────────────────────────────────────
const pump = (product as any).prix_achat_moyen_ht as number | null;
const prix = product.price_ht as number | null;
const margePct = pump == null || prix == null || prix === 0 ? null : ((prix - pump) / prix) * 100;
const gmroi    = computeGmroi(product.stock_quantity, pump, marge12mo);
const rotation = computeStockRotation(product.stock_quantity, pump, cogs12mo);
const vitesseVente = computeVitesseVente(recentQty, (product as any).created_at);

// ── Réassort ─────────────────────────────────────────────────────────
const joursAvantRupture = computeJoursAvantRupture(product.stock_quantity, vitesseVente);
const seuilReappro = (product as any).seuil_reappro as number | null;
const delaiLivraisonJours = (product as any).delai_livraison_jours as number | null;
const suggestedReorderQty = computeSuggestedReorderQty(vitesseVente, delaiLivraisonJours, product.stock_quantity);
const showSuggestion = isApproachingOrBelowSeuil(product.stock_quantity, seuilReappro, joursAvantRupture, delaiLivraisonJours);

// ── Cost history — same query as the edit page's "Achats & Coût" panel ──
const { data: purchaseHistory } = await supabaseAdmin
  .from('stock_reception_items')
  .select('quantity, unit_cost_ht, stock_receptions(supplier_name, received_at, stock_applied)')
  .eq('product_id', id)
  .order('created_at', { ascending: false })
  .limit(50);

function formatPrice(p: number | null): string {
  if (p == null) return '—';
  return p.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
}
function margeClass(pct: number | null): string {
  return `marge--${marginColorClass(pct)}`;
}

// ── Monthly bar chart geometry (plain SVG, computed server-side) ───────
const CHART_W = 640, CHART_H = 160;
const PAD_L = 34, PAD_R = 8, PAD_T = 10, PAD_B = 22;
const plotW = CHART_W - PAD_L - PAD_R;
const plotH = CHART_H - PAD_T - PAD_B;
const maxQty = Math.max(1, ...monthlyQty);
const bandW = plotW / MONTHS_BACK;
const barW  = bandW * 0.55;

const bars = monthDefs.map((m, i) => {
  const qty = monthlyQty[i];
  const h = (qty / maxQty) * plotH;
  return {
    label: m.label,
    qty,
    x: PAD_L + i * bandW + (bandW - barW) / 2,
    y: PAD_T + plotH - h,
    h,
    w: barW,
  };
});
---
<AdminLayout title={`Performance — ${product.name}`} activeNav="produits">
  <a href="/admin/produits" class="back-link">← Retour aux produits</a>

  <div class="product-header">
    <div>
      <h1 class="product-h1">{product.name}</h1>
      <div class="header-meta">
        <span class={`badge badge--${product.category}`}>{CAT_LABEL[product.category] ?? product.category}</span>
        {(product.stock_quantity ?? 0) === 0 ? (
          <span class="stock-chip stock-chip--out">Rupture</span>
        ) : (product.stock_quantity ?? 0) < 5 ? (
          <span class="stock-chip stock-chip--low">{product.stock_quantity} en stock</span>
        ) : (
          <span class="stock-chip stock-chip--ok">{product.stock_quantity} en stock</span>
        )}
        <span class="price-tag">{formatPrice(product.price_ht)} HT</span>
      </div>
    </div>
    <a href={`/admin/produits/${id}/edit`} class="btn btn-ghost">Modifier le produit</a>
  </div>

  <!-- ── Key metrics — the actionable numbers, front and center ──────── -->
  <div class="card">
    <h2 class="card-title">Indicateurs clés</h2>
    <div class="stats-grid">
      <div class="stat-tile">
        <span class="stat-label">Marge</span>
        <span class={`marge-chip stat-chip ${margeClass(margePct)}`}>{margePct != null ? margePct.toFixed(1) + ' %' : '—'}</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">
          GMROI
          <span class="help-icon" tabindex="0" title="Marge brute générée sur 12 mois ÷ valeur du stock actuel. > 2 = excellent, 1-2 = correct, < 1 = ce produit immobilise plus de capital qu'il ne rapporte.">?</span>
        </span>
        <span class={`marge-chip stat-chip marge--${gmroiColorClass(gmroi)}`}>{gmroi != null ? gmroi.toFixed(1) + '×' : '—'}</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">
          Taux de rotation
          <span class="help-icon" tabindex="0" title="Coût des ventes sur 12 mois ÷ valeur du stock actuel. > 6x/an = excellent, 3-6x/an = correct, < 3x/an = stock qui tourne lentement.">?</span>
        </span>
        <span class={`marge-chip stat-chip marge--${rotationColorClass(rotation)}`}>{rotation != null ? rotation.toFixed(1) + 'x/an' : '—'}</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">Vitesse de vente</span>
        <span class="stat-value">{vitesseVente > 0 ? `${vitesseVente.toFixed(1)} cartons/sem.` : '—'}</span>
      </div>
    </div>
  </div>

  <!-- ── Réassort ─────────────────────────────────────────────────────── -->
  <div class="card card--reappro">
    <div class="card-header-row">
      <h2 class="card-title">Réassort</h2>
      <a href="/admin/commande-fournisseur" class="card-header-link">Simuler une commande →</a>
    </div>
    <div class="stats-grid">
      <div class="stat-tile">
        <span class="stat-label">Seuil de réapprovisionnement</span>
        <span class="stat-value">{seuilReappro != null ? `${seuilReappro} cartons` : 'Non défini'}</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">Jours avant rupture estimés</span>
        <span class="stat-value">{joursAvantRupture != null ? `${Math.round(joursAvantRupture)} j` : 'Non estimable'}</span>
      </div>
      {showSuggestion && suggestedReorderQty != null && (
        <div class="stat-tile">
          <span class="stat-label">Suggestion</span>
          <span class="stat-value stat-value--suggestion">
            {suggestedReorderQty > 0 ? `Commander ${suggestedReorderQty} cartons` : 'Stock suffisant'}
          </span>
        </div>
      )}
    </div>
  </div>

  <!-- ── Sales over time ──────────────────────────────────────────────── -->
  <div class="card">
    <h2 class="card-title">Ventes mensuelles — 12 derniers mois</h2>
    {totalQty12mo > 0 ? (
      <svg
        viewBox={`0 0 ${CHART_W} ${CHART_H}`}
        preserveAspectRatio="xMidYMid meet"
        class="chart-svg"
        role="img"
        aria-label="Quantité vendue par mois sur les 12 derniers mois"
      >
        <line x1={PAD_L} x2={PAD_L + plotW} y1={PAD_T + plotH} y2={PAD_T + plotH} class="chart-axis" />
        <text x={PAD_L - 6} y={PAD_T + plotH + 4} class="chart-axis-label chart-axis-label--y">0</text>
        <text x={PAD_L - 6} y={PAD_T + 4} class="chart-axis-label chart-axis-label--y">{maxQty}</text>
        {bars.map(b => (
          <rect x={b.x} y={b.y} width={b.w} height={Math.max(b.h, b.qty > 0 ? 1.5 : 0)} rx="2" class="chart-bar">
            <title>{`${b.label} — ${b.qty} carton${b.qty !== 1 ? 's' : ''}`}</title>
          </rect>
        ))}
        {bars.map(b => (
          <text x={b.x + b.w / 2} y={CHART_H - 4} class="chart-x-label">{b.label}</text>
        ))}
      </svg>
    ) : (
      <p class="empty-msg">Aucune vente enregistrée sur les 12 derniers mois.</p>
    )}
  </div>

  <!-- ── Sales by PDV / client ────────────────────────────────────────── -->
  <div class="card">
    <h2 class="card-title">Ventes par point de vente / client — 12 derniers mois</h2>
    {pdvRows.length === 0 ? (
      <p class="empty-msg">Aucune vente enregistrée sur les 12 derniers mois.</p>
    ) : (
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Point de vente / Client</th>
              <th class="th-num">Quantité</th>
              <th class="th-num">CA généré</th>
            </tr>
          </thead>
          <tbody>
            {pdvRows.map(r => (
              <tr>
                <td class="td-strong">{r.label}</td>
                <td class="th-num td-mono">{r.qty}</td>
                <td class="th-num td-mono">{formatPrice(r.ca)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- ── Cost history ─────────────────────────────────────────────────── -->
  <div class="card">
    <h2 class="card-title">Historique des achats</h2>
    {(purchaseHistory ?? []).length === 0 ? (
      <p class="empty-msg">Aucun achat enregistré pour ce produit.</p>
    ) : (
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Fournisseur</th>
              <th class="th-num">Qté</th>
              <th class="th-num">Coût unitaire HT</th>
              <th class="th-num">Total HT</th>
              <th>Stock</th>
            </tr>
          </thead>
          <tbody>
            {(purchaseHistory ?? []).map((h: any) => {
              const rec = h.stock_receptions ?? {};
              return (
                <tr>
                  <td class="td-muted">{formatDateReunion(rec.received_at)}</td>
                  <td class="td-strong">{rec.supplier_name ?? '—'}</td>
                  <td class="th-num td-mono">{h.quantity}</td>
                  <td class="th-num td-mono">{formatPrice(Number(h.unit_cost_ht))}</td>
                  <td class="th-num td-mono">{formatPrice(h.quantity * h.unit_cost_ht)}</td>
                  <td>
                    {rec.stock_applied
                      ? <span class="rec-chip rec-chip--live">Stock appliqué</span>
                      : <span class="rec-chip rec-chip--histo">Historique</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<style>
.back-link {
  display: inline-flex;
  align-items: center;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-muted);
  text-decoration: none;
  margin-bottom: var(--space-4);
  transition: color var(--dur-fast);
}
.back-link:hover { color: var(--color-ink); }

.product-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
  flex-wrap: wrap;
}
.product-h1 {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  margin: 0 0 var(--space-2);
}
.header-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.price-tag {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
}

.btn {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-ink);
  cursor: pointer;
  transition: background var(--dur-fast);
  white-space: nowrap;
}
.btn:hover { background: var(--color-surface-2); }
.btn-ghost { background: transparent; }

.card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  margin-bottom: var(--space-4);
}
.card-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 var(--space-4);
}
.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}
.card-header-row .card-title { margin: 0; }
.card-header-link {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-primary-deep);
  text-decoration: none;
}
.card-header-link:hover { text-decoration: underline; }

.card--reappro {
  background: oklch(0.98 0.015 60);
  border-color: oklch(0.88 0.06 60);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: var(--space-4);
}
.stat-tile {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-4);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}
.card--reappro .stat-tile { background: var(--color-bg); }
.stat-label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.stat-value {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: -0.01em;
}
.stat-value--suggestion { color: oklch(0.42 0.14 60); font-size: 1.05rem; }
.stat-chip { align-self: flex-start; font-size: var(--text-base); padding: 3px 10px; }

.help-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 13px;
  height: 13px;
  margin-left: 3px;
  border-radius: 50%;
  background: var(--color-surface-2);
  color: var(--color-muted);
  font-size: 0.5625rem;
  font-weight: 700;
  text-transform: none;
  letter-spacing: normal;
  cursor: help;
  vertical-align: middle;
}

/* ── Badges / chips (shared look with /admin/produits) ────────────── */
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 500;
  white-space: nowrap;
}
.badge--boissons    { background: oklch(0.93 0.05 220); color: oklch(0.35 0.10 220); }
.badge--snacks      { background: oklch(0.94 0.05 60);  color: oklch(0.40 0.12 60);  }
.badge--chips       { background: oklch(0.93 0.05 180); color: oklch(0.35 0.10 180); }
.badge--confiseries { background: oklch(0.93 0.06 330); color: oklch(0.40 0.12 330); }
.badge--divers      { background: oklch(0.93 0.05 275); color: oklch(0.40 0.12 275); }

.stock-chip {
  display: inline-flex;
  align-items: center;
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 2px 9px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}
.stock-chip--ok  { background: oklch(0.92 0.08 145); color: oklch(0.32 0.14 145); }
.stock-chip--low { background: oklch(0.95 0.07 60);  color: oklch(0.38 0.15 55);  }
.stock-chip--out { background: oklch(0.95 0.04 25);  color: oklch(0.46 0.18 25);  }

.marge-chip {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}
.marge--none  { background: var(--color-surface-2); color: var(--color-muted); }
.marge--green { background: oklch(0.92 0.08 145); color: oklch(0.32 0.14 145); }
.marge--amber { background: oklch(0.95 0.07 60);  color: oklch(0.38 0.15 55);  }
.marge--red   { background: oklch(0.95 0.04 25);  color: oklch(0.46 0.18 25);  }

.rec-chip {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: 500;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}
.rec-chip--live  { background: oklch(0.92 0.08 145); color: oklch(0.32 0.14 145); }
.rec-chip--histo { background: oklch(0.95 0.06 75);  color: oklch(0.36 0.12 75);  }

/* ── Monthly bar chart ────────────────────────────────────────────── */
.chart-svg { width: 100%; height: auto; display: block; }
.chart-axis { stroke: var(--color-border); stroke-width: 1; }
.chart-axis-label {
  font-size: 9px;
  font-family: var(--font-mono);
  fill: var(--color-muted);
}
.chart-axis-label--y { text-anchor: end; }
.chart-x-label {
  font-size: 9px;
  font-family: var(--font-body);
  fill: var(--color-muted);
  text-anchor: middle;
}
.chart-bar {
  fill: var(--color-primary);
  transition: fill var(--dur-fast);
}
.chart-bar:hover { fill: var(--color-primary-deep); }

/* ── Tables ───────────────────────────────────────────────────────── */
.table-wrap {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow-x: auto;
}
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}
.data-table thead th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
  background: var(--color-surface);
}
.th-num { text-align: right; }
.data-table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr:hover td { background: var(--color-surface); }

.td-strong { font-weight: 500; color: var(--color-ink); }
.td-muted  { color: var(--color-muted); white-space: nowrap; }
.td-mono   { font-family: var(--font-mono); color: var(--color-ink); white-space: nowrap; }

.empty-msg {
  font-size: var(--text-sm);
  color: var(--color-muted);
  font-style: italic;
  margin: 0;
}

@media (max-width: 560px) {
  .product-header { flex-direction: column; }
}
</style>
