---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import { sanitizeText } from '../../../../lib/sanitize';
import { logAdminAction } from '../../../../lib/audit';
import { SHIPMENT_STATUSES, SHIPMENT_STATUS_LABEL, type ShipmentStatus } from '../../../../lib/constants';

const { id } = Astro.params;

// ── Comme la liste : on n'écrit que sur shipments / shipment_items. Aucun
//    mouvement de stock ni recalcul de PUMP ici. ──
if (Astro.request.method === 'POST' && id) {
  const data = await Astro.request.formData();
  const adminEmail = (Astro.locals as any).user?.email ?? 'inconnu';

  const supplierName = sanitizeText(data.get('supplier_name') as string, 120).trim();
  const reference    = sanitizeText(data.get('reference') as string, 80).trim() || null;
  const departure    = (data.get('departure_date') as string)?.trim() || null;
  const eta          = (data.get('eta') as string)?.trim() || null;
  const notes        = sanitizeText(data.get('notes') as string, 500).trim() || null;
  const statusRaw    = data.get('status') as string;
  const status: ShipmentStatus = (SHIPMENT_STATUSES as readonly string[]).includes(statusRaw)
    ? (statusRaw as ShipmentStatus) : 'en_transit';

  if (!supplierName) return Astro.redirect(`/admin/transit/${id}/edit?err=fournisseur_requis`);
  if (status === 'receptionne') return Astro.redirect(`/admin/transit/${id}/edit?err=receptionner`);

  const { error: updErr } = await supabaseAdmin
    .from('shipments')
    .update({ supplier_name: supplierName, reference, departure_date: departure, eta, status, notes })
    .eq('id', id);
  if (updErr) return Astro.redirect(`/admin/transit/${id}/edit?err=enregistrement`);

  // Les lignes sont remplacées en bloc : c'est le plus simple à raisonner et
  // shipment_items ne porte aucune donnée dérivée qu'on risquerait de perdre.
  const productIds = data.getAll('product_id[]') as string[];
  const quantities = data.getAll('quantity[]') as string[];
  const costs      = data.getAll('unit_cost_ht[]') as string[];

  const items: { shipment_id: string; product_id: string; quantity: number; unit_cost_ht: number | null }[] = [];
  for (let i = 0; i < productIds.length; i++) {
    const pid = productIds[i]?.trim();
    const qty = parseInt(quantities[i] ?? '0', 10);
    const raw = costs[i]?.trim();
    const cost = raw === '' || raw == null ? null : parseFloat(raw);
    if (!pid || !Number.isFinite(qty) || qty <= 0) continue;
    items.push({ shipment_id: id, product_id: pid, quantity: qty, unit_cost_ht: cost != null && Number.isFinite(cost) ? cost : null });
  }

  const { error: delErr } = await supabaseAdmin.from('shipment_items').delete().eq('shipment_id', id);
  if (delErr) return Astro.redirect(`/admin/transit/${id}/edit?err=lignes`);

  if (items.length > 0) {
    const { error: insErr } = await supabaseAdmin.from('shipment_items').insert(items);
    if (insErr) return Astro.redirect(`/admin/transit/${id}/edit?err=lignes`);
  }

  await logAdminAction({
    adminEmail, action: 'transit.modification', targetType: 'shipment',
    targetId: id, targetLabel: supplierName,
    details: { statut: status, eta, lignes: items.length },
  });
  return Astro.redirect('/admin/transit?ok=modifie');
}

const { data: shipment, error: loadErr } = await supabaseAdmin
  .from('shipments')
  .select('id, supplier_name, reference, departure_date, eta, status, notes, shipment_items(id, product_id, quantity, unit_cost_ht)')
  .eq('id', id)
  .single();

const tableMissing = loadErr?.code === 'PGRST205' || loadErr?.code === '42P01';
if (!shipment && !tableMissing) return Astro.redirect('/admin/transit?err=introuvable');

const { data: products } = await supabaseAdmin
  .from('products')
  .select('id, name, sku, prix_achat_moyen_ht')
  .order('name');

const { data: supplierRows } = await supabaseAdmin.from('suppliers').select('name').order('name');
const supplierNames = (supplierRows ?? []).map(s => s.name);

const existingItems = ((shipment as any)?.shipment_items ?? []).map((it: any) => ({
  product_id: it.product_id,
  quantity: it.quantity,
  unit_cost_ht: it.unit_cost_ht != null ? Number(it.unit_cost_ht) : null,
}));

const err = Astro.url.searchParams.get('err');
const ERR_MSG: Record<string, string> = {
  fournisseur_requis: 'Le nom du fournisseur est obligatoire.',
  enregistrement:     "L'enregistrement a échoué.",
  lignes:             "Les lignes produits n'ont pas pu être enregistrées.",
  receptionner:       "Le statut « Réceptionné » se pose en validant une réception, pas ici.",
};
---
<AdminLayout title="Modifier l'expédition" activeNav="transit">
  {tableMissing ? (
    <div class="alert alert--error" role="alert">
      Les tables de transit n'existent pas encore — lancez
      <code>supabase/migrations/shipments_table.sql</code>.
    </div>
  ) : (
    <>
      <div class="page-header">
        <a href="/admin/transit" class="back-link">← Retour au suivi transit</a>
        <h1 class="page-title">Modifier l'expédition</h1>
      </div>

      {err && <div class="alert alert--error" role="alert">{ERR_MSG[err] ?? 'Une erreur est survenue.'}</div>}

      <form method="post" class="edit-form">
        <div class="form-grid">
          <div class="field">
            <label class="label" for="supplier_name">Fournisseur <span class="req">*</span></label>
            <input type="text" id="supplier_name" name="supplier_name" required maxlength="120" value={shipment!.supplier_name} list="supplierList" autocomplete="off" />
            <datalist id="supplierList">{supplierNames.map(n => <option value={n}></option>)}</datalist>
          </div>
          <div class="field">
            <label class="label" for="reference">Référence</label>
            <input type="text" id="reference" name="reference" maxlength="80" value={shipment!.reference ?? ''} autocomplete="off" />
          </div>
          <div class="field">
            <label class="label" for="departure_date">Date de départ</label>
            <input type="date" id="departure_date" name="departure_date" value={shipment!.departure_date ?? ''} />
          </div>
          <div class="field">
            <label class="label" for="eta">Arrivée estimée (ETA)</label>
            <input type="date" id="eta" name="eta" value={shipment!.eta ?? ''} />
          </div>
          <div class="field">
            <label class="label" for="status">Statut</label>
            <select id="status" name="status">
              {SHIPMENT_STATUSES.filter(s => s !== 'receptionne').map(s => (
                <option value={s} selected={s === shipment!.status}>{SHIPMENT_STATUS_LABEL[s]}</option>
              ))}
            </select>
          </div>
          <div class="field field--full">
            <label class="label" for="notes">Notes</label>
            <input type="text" id="notes" name="notes" maxlength="500" value={shipment!.notes ?? ''} />
          </div>
        </div>

        <div class="items-head">
          <h2 class="items-title">Produits expédiés</h2>
          <button type="button" id="addRowBtn" class="btn btn-ghost">+ Ajouter un produit</button>
        </div>
        <div class="items-wrap">
          <table class="items-table">
            <thead>
              <tr>
                <th>Produit</th>
                <th class="num">Quantité</th>
                <th class="num">Coût unitaire HT</th>
                <th class="num">Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="itemsBody"></tbody>
          </table>
        </div>
        <p class="items-hint" id="itemsHint" hidden>Aucune ligne — l'expédition sera enregistrée sans produits.</p>

        <div class="form-actions">
          <a href="/admin/transit" class="btn btn-ghost">Annuler</a>
          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
      </form>

      <form method="post" action="/admin/transit" class="danger-form"
            onsubmit="return confirm('Supprimer définitivement cette expédition ?\nLe suivi sera perdu, mais aucun stock n\'est affecté.')">
        <input type="hidden" name="action" value="delete" />
        <input type="hidden" name="id" value={shipment!.id} />
        <button type="submit" class="delete-link">Supprimer cette expédition</button>
      </form>
    </>
  )}
</AdminLayout>

<script define:vars={{ products, existingItems }}>
  const PRODUCTS = products ?? [];
  const body = document.getElementById('itemsBody');
  const hint = document.getElementById('itemsHint');

  function usedIds() {
    const s = new Set();
    document.querySelectorAll('[data-product-select]').forEach(sel => { if (sel.value) s.add(sel.value); });
    return s;
  }
  function refreshSelects() {
    const used = usedIds();
    document.querySelectorAll('[data-product-select]').forEach(sel => {
      Array.from(sel.options).forEach(o => {
        if (!o.value) return;
        o.disabled = used.has(o.value) && o.value !== sel.value;
      });
    });
  }
  function updateRowTotal(tr) {
    const qty  = parseFloat(tr.querySelector('[name="quantity[]"]')?.value) || 0;
    const cost = parseFloat(tr.querySelector('[name="unit_cost_ht[]"]')?.value) || 0;
    const cell = tr.querySelector('[data-total]');
    if (cell) cell.textContent = qty && cost
      ? (qty * cost).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })
      : '—';
  }
  function toggleHint() { if (hint) hint.hidden = (body?.children.length ?? 0) > 0; }

  function addRow(item) {
    if (!body) return;
    const tr = document.createElement('tr');
    const opts = PRODUCTS.map(p =>
      `<option value="${p.id}"${item && item.product_id === p.id ? ' selected' : ''}>${p.name}${p.sku ? ' (' + p.sku + ')' : ''}</option>`
    ).join('');
    tr.innerHTML = `
      <td><select name="product_id[]" data-product-select required>
        <option value="">— Choisir un produit —</option>${opts}
      </select></td>
      <td class="num"><input type="number" name="quantity[]" min="1" step="1" required value="${item ? item.quantity : ''}" /></td>
      <td class="num"><input type="number" name="unit_cost_ht[]" min="0" step="0.01" placeholder="—" value="${item && item.unit_cost_ht != null ? item.unit_cost_ht : ''}" /></td>
      <td class="num" data-total>—</td>
      <td class="num"><button type="button" class="remove-btn" title="Retirer">×</button></td>
    `;
    body.appendChild(tr);

    tr.querySelector('[data-product-select]').addEventListener('change', () => { refreshSelects(); updateRowTotal(tr); });
    tr.querySelectorAll('input').forEach(i => i.addEventListener('input', () => updateRowTotal(tr)));
    tr.querySelector('.remove-btn').addEventListener('click', () => { tr.remove(); refreshSelects(); toggleHint(); });

    updateRowTotal(tr);
    refreshSelects();
    toggleHint();
  }

  (existingItems ?? []).forEach(it => addRow(it));
  toggleHint();
  document.getElementById('addRowBtn')?.addEventListener('click', () => addRow(null));
</script>

<style>
.page-header { margin-bottom: var(--space-5); }
.back-link { font-size: var(--text-sm); color: var(--color-primary-deep); text-decoration: none; }
.back-link:hover { text-decoration: underline; }
.page-title { margin: var(--space-2) 0 0; font-size: 1.4rem; font-weight: 700; color: var(--color-ink); }

.alert {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid oklch(0.88 0.07 25);
  color: oklch(0.46 0.18 25);
  background: oklch(0.97 0.03 25);
}
.alert code { font-family: var(--font-mono); font-size: 0.9em; }

.edit-form {
  padding: var(--space-5);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}
.field { display: flex; flex-direction: column; gap: 4px; }
.field--full { grid-column: 1 / -1; }
.label { font-size: 0.6875rem; font-weight: 600; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.03em; }
.req { color: oklch(0.55 0.19 25); }
.field input, .field select,
.items-table input, .items-table select {
  padding: 0.45rem 0.6rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  outline: none;
}
.field input:focus, .field select:focus,
.items-table input:focus, .items-table select:focus { border-color: var(--color-primary); }

.items-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
.items-title { font-size: var(--text-sm); font-weight: 600; color: var(--color-ink); margin: 0; }
.items-wrap { overflow-x: auto; }
.items-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.items-table th {
  padding: var(--space-2);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  border-bottom: 1px solid var(--color-border);
}
.items-table td { padding: var(--space-2); border-bottom: 1px solid var(--color-border); }
.items-table .num { text-align: right; }
.items-table input { width: 110px; text-align: right; font-family: var(--font-mono); }
.items-table select { width: 100%; min-width: 200px; }
.remove-btn {
  padding: 0.2rem 0.5rem;
  font-size: var(--text-base);
  line-height: 1;
  color: var(--color-muted);
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.remove-btn:hover { color: oklch(0.46 0.18 25); border-color: oklch(0.80 0.10 25); }
.items-hint { margin: var(--space-2) 0 0; font-size: var(--text-xs); color: var(--color-muted); }

.form-actions { display: flex; justify-content: flex-end; gap: var(--space-3); margin-top: var(--space-5); }

.danger-form { margin-top: var(--space-5); text-align: right; }
.delete-link {
  font-size: var(--text-sm);
  color: oklch(0.50 0.16 25);
  background: none;
  border: none;
  cursor: pointer;
  text-decoration: underline;
}
</style>
