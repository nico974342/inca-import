---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import { sanitizeText } from '../../../../lib/sanitize';
import { logAdminAction } from '../../../../lib/audit';
import { isAdmin } from '../../../../lib/roles';
import {
  IMPORT_COST_LABELS, computeLandedCosts,
  type ShipmentCostLine, type ShipmentCostItem,
} from '../../../../lib/constants';

if (!isAdmin((Astro.locals as any).user)) return Astro.redirect('/admin');

const { id } = Astro.params;

// ── Comme shipments/shipment_items : du suivi pur. On n'écrit que sur
//    shipment_costs, jamais sur products/stock/PUMP. Le coût rendu qui en
//    ressort n'est appliqué qu'à la réception, via /admin/reception/new. ──
if (Astro.request.method === 'POST' && id) {
  const data = await Astro.request.formData();
  const adminEmail = (Astro.locals as any).user?.email ?? 'inconnu';

  const labels     = data.getAll('label[]') as string[];
  const amounts    = data.getAll('amount_ht[]') as string[];
  const statuses   = data.getAll('status[]') as string[];
  const productIds = data.getAll('product_id[]') as string[];

  const rows: { shipment_id: string; product_id: string | null; label: string; amount_ht: number; is_estimated: boolean }[] = [];
  for (let i = 0; i < labels.length; i++) {
    const label = sanitizeText(labels[i], 120).trim();
    const amount = parseFloat((amounts[i] ?? '').replace(',', '.'));
    if (!label || !Number.isFinite(amount) || amount < 0) continue;
    const pid = productIds[i]?.trim() || null;
    rows.push({
      shipment_id: id,
      product_id: pid,
      label,
      amount_ht: amount,
      is_estimated: statuses[i] !== 'definitif',
    });
  }

  // Remplacement en bloc, comme shipment_items : le plus simple à raisonner,
  // et shipment_costs ne porte aucune donnée dérivée qu'on risquerait de perdre.
  const { error: delErr } = await supabaseAdmin.from('shipment_costs').delete().eq('shipment_id', id);
  if (delErr) return Astro.redirect(`/admin/transit/${id}/couts?err=enregistrement`);

  if (rows.length > 0) {
    const { error: insErr } = await supabaseAdmin.from('shipment_costs').insert(rows);
    if (insErr) return Astro.redirect(`/admin/transit/${id}/couts?err=enregistrement`);
  }

  await logAdminAction({
    adminEmail, action: 'transit.frais_import', targetType: 'shipment',
    targetId: id, details: { lignes: rows.length },
  });
  return Astro.redirect(`/admin/transit/${id}/couts?ok=enregistre`);
}

const { data: shipment, error: loadErr } = await supabaseAdmin
  .from('shipments')
  .select(`
    id, supplier_name, reference,
    shipment_items(product_id, quantity, unit_cost_ht, products(name, sku, units_per_carton)),
    shipment_costs(id, product_id, label, amount_ht, is_estimated, products(name))
  `)
  .eq('id', id)
  .single();

const tableMissing = loadErr?.code === 'PGRST205' || loadErr?.code === '42P01';
if (!shipment && !tableMissing) return Astro.redirect('/admin/transit?err=introuvable');

const rawItems  = ((shipment as any)?.shipment_items ?? []) as any[];
const rawCosts  = ((shipment as any)?.shipment_costs ?? []) as any[];

const items: ShipmentCostItem[] = rawItems.map(it => ({
  product_id: it.product_id,
  quantity: it.quantity,
  unit_cost_ht: it.unit_cost_ht != null ? Number(it.unit_cost_ht) : null,
}));
const costLines: ShipmentCostLine[] = rawCosts.map(c => ({
  product_id: c.product_id,
  amount_ht: Number(c.amount_ht),
  is_estimated: c.is_estimated,
}));

const landed = computeLandedCosts(items, costLines);
const itemsByProductId = new Map(rawItems.map(it => [it.product_id, it]));

// Suggestions de libellés pour "+ Ajouter un frais" : les intitulés standards
// pas encore utilisés, "Autres frais" en dernier repli réutilisable.
const usedLabels = new Set(rawCosts.map(c => c.label));
const suggestedLabels = IMPORT_COST_LABELS.filter(l => l === 'Autres frais' || !usedLabels.has(l));

function fmt(n: number): string {
  return n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const ok  = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

const existingCosts = rawCosts.map(c => ({
  product_id: c.product_id as string | null,
  label: c.label as string,
  amount_ht: Number(c.amount_ht),
  is_estimated: c.is_estimated as boolean,
}));
const productsForSelect = rawItems.map(it => ({ id: it.product_id, name: it.products?.name ?? 'Produit supprimé' }));
---
<AdminLayout title="Coût rendu" activeNav="transit">
  {tableMissing ? (
    <div class="alert alert--error" role="alert">
      La table <code>shipment_costs</code> n'existe pas encore — lancez
      <code>supabase/migrations/shipment_costs.sql</code>.
    </div>
  ) : (
    <>
      <div class="page-header">
        <a href="/admin/transit" class="back-link">← Retour au suivi transit</a>
        <h1 class="page-title">Coût rendu — {shipment!.supplier_name}</h1>
        {shipment!.reference && <span class="page-ref">{shipment!.reference}</span>}
      </div>

      {ok  && <div class="alert alert--ok"    role="status">Frais enregistrés.</div>}
      {err && <div class="alert alert--error" role="alert">L'enregistrement a échoué.</div>}

      <form method="post" class="costs-form">
        <div class="items-head">
          <h2 class="items-title">Frais d'import</h2>
          <button type="button" id="addCostBtn" class="btn btn-ghost">+ Ajouter un frais</button>
        </div>
        <p class="hint">
          Montants HT (hors TVA récupérable). Laissez « Frais général » pour une répartition
          au prorata de la valeur fournisseur de chaque produit, ou choisissez un produit pour
          un frais qui ne concerne que lui (taxe boisson, étiquetage…).
        </p>

        <div class="items-wrap">
          <table class="items-table">
            <thead>
              <tr>
                <th>Libellé</th>
                <th>Rattaché à</th>
                <th class="num">Montant HT</th>
                <th>Statut</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="costsBody"></tbody>
          </table>
        </div>
        <p class="items-hint" id="noCostsHint" hidden>Aucun frais saisi — le coût rendu reste égal au prix fournisseur.</p>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Enregistrer les frais</button>
        </div>
      </form>

      <div class="detail-shell">
        <div class="detail-header">
          <h2 class="items-title">Détail coût rendu</h2>
          <span class={`status-badge status-badge--${landed.costsStatus}`}>
            {landed.costsStatus === 'definitif' ? 'Définitif' : landed.costsStatus === 'estime' ? 'Estimé' : 'Aucun frais'}
          </span>
        </div>

        {landed.items.length === 0 ? (
          <p class="pump-empty">Aucun produit sur cette expédition.</p>
        ) : (
          <div class="items-wrap">
            <table class="detail-table">
              <thead>
                <tr>
                  <th>Produit</th>
                  <th class="num">Cartons</th>
                  <th class="num">Prix fournisseur / carton</th>
                  <th class="num">Frais import / carton</th>
                  <th class="num">Coût rendu / carton</th>
                  <th class="num">Coût rendu total</th>
                </tr>
              </thead>
              <tbody>
                {landed.items.map(it => {
                  const p = itemsByProductId.get(it.product_id);
                  return (
                    <tr>
                      <td>{p?.products?.name ?? 'Produit supprimé'}</td>
                      <td class="num">{it.quantity.toLocaleString('fr-FR')}</td>
                      <td class="num">{it.unit_cost_ht != null ? fmt(it.unit_cost_ht) : <span class="muted">—</span>}</td>
                      <td class="num">{fmt(it.importFeeUnit)}</td>
                      <td class="num td-strong">{it.landedUnitCost != null ? fmt(it.landedUnitCost) : <span class="muted">—</span>}</td>
                      <td class="num">{it.landedTotal != null ? fmt(it.landedTotal) : <span class="muted">—</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

        <div class="detail-summary">
          <div class="summary-stat">
            <span class="summary-label">Valeur fournisseur</span>
            <span class="summary-value">{fmt(landed.totalSupplierValue)}</span>
          </div>
          <div class="summary-stat">
            <span class="summary-label">Frais import</span>
            <span class="summary-value">{fmt(landed.totalImportFees)}</span>
          </div>
          <div class="summary-stat summary-stat--total">
            <span class="summary-label">Coût rendu total</span>
            <span class="summary-value">{fmt(landed.totalLanded)}</span>
          </div>
        </div>
      </div>
    </>
  )}
</AdminLayout>

<script define:vars={{ existingCosts, productsForSelect, suggestedLabels }}>
  const PRODUCTS = productsForSelect ?? [];
  const body = document.getElementById('costsBody');
  const hint = document.getElementById('noCostsHint');
  let suggestIdx = 0;

  function nextSuggestedLabel() {
    const list = suggestedLabels ?? [];
    if (list.length === 0) return '';
    const label = list[Math.min(suggestIdx, list.length - 1)];
    suggestIdx++;
    return label;
  }

  function toggleHint() { if (hint) hint.hidden = (body?.children.length ?? 0) > 0; }

  function addRow(cost) {
    if (!body) return;
    const tr = document.createElement('tr');
    const opts = PRODUCTS.map(p =>
      `<option value="${p.id}"${cost && cost.product_id === p.id ? ' selected' : ''}>${p.name}</option>`
    ).join('');
    const label = cost ? cost.label : nextSuggestedLabel();
    tr.innerHTML = `
      <td><input type="text" name="label[]" maxlength="120" required value="${label.replace(/"/g, '&quot;')}" /></td>
      <td>
        <select name="product_id[]">
          <option value="">Frais général (au prorata)</option>
          ${opts}
        </select>
      </td>
      <td class="num"><input type="number" name="amount_ht[]" min="0" step="0.01" required value="${cost ? cost.amount_ht : ''}" /></td>
      <td>
        <select name="status[]">
          <option value="estime"${!cost || cost.is_estimated ? ' selected' : ''}>Estimé</option>
          <option value="definitif"${cost && !cost.is_estimated ? ' selected' : ''}>Définitif</option>
        </select>
      </td>
      <td class="num"><button type="button" class="remove-btn" title="Retirer">×</button></td>
    `;
    body.appendChild(tr);
    tr.querySelector('.remove-btn').addEventListener('click', () => { tr.remove(); toggleHint(); });
    toggleHint();
  }

  (existingCosts ?? []).forEach(c => addRow(c));
  if ((existingCosts ?? []).length === 0) addRow(null);
  toggleHint();

  document.getElementById('addCostBtn')?.addEventListener('click', () => addRow(null));
</script>

<style>
.page-header { margin-bottom: var(--space-5); display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; }
.back-link { font-size: var(--text-sm); color: var(--color-primary-deep); text-decoration: none; flex-basis: 100%; }
.back-link:hover { text-decoration: underline; }
.page-title { margin: var(--space-2) 0 0; font-size: 1.4rem; font-weight: 700; color: var(--color-ink); }
.page-ref { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-muted); }

.alert {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid;
}
.alert code { font-family: var(--font-mono); font-size: 0.9em; }
.alert--ok    { color: oklch(0.40 0.12 150); background: oklch(0.96 0.04 150); border-color: oklch(0.86 0.08 150); }
.alert--error { color: oklch(0.46 0.18 25);  background: oklch(0.97 0.03 25);  border-color: oklch(0.88 0.07 25); }

.costs-form {
  padding: var(--space-5);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-5);
}
.hint { font-size: var(--text-xs); color: var(--color-muted); margin: 0 0 var(--space-3); max-width: 70ch; }

.items-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
.items-title { font-size: var(--text-sm); font-weight: 600; color: var(--color-ink); margin: 0; }
.items-wrap { overflow-x: auto; }
.items-table, .detail-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.items-table th, .detail-table th {
  padding: var(--space-2);
  text-align: left;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  border-bottom: 1px solid var(--color-border);
}
.items-table td, .detail-table td { padding: var(--space-2); border-bottom: 1px solid var(--color-border); }
.items-table .num, .detail-table .num { text-align: right; }
.items-table input, .items-table select {
  padding: 0.45rem 0.6rem;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-ink);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  outline: none;
}
.items-table input:focus, .items-table select:focus { border-color: var(--color-primary); }
.items-table input[name="amount_ht[]"] { width: 100px; text-align: right; font-family: var(--font-mono); }
.items-table input[name="label[]"] { width: 100%; min-width: 180px; }
.items-table select { min-width: 150px; }
.remove-btn {
  padding: 0.2rem 0.5rem;
  font-size: var(--text-base);
  line-height: 1;
  color: var(--color-muted);
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.remove-btn:hover { color: oklch(0.46 0.18 25); border-color: oklch(0.80 0.10 25); }
.items-hint { margin: var(--space-2) 0 0; font-size: var(--text-xs); color: var(--color-muted); }
.form-actions { display: flex; justify-content: flex-end; margin-top: var(--space-4); }

.btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm); font-weight: 600;
  text-decoration: none; border: 1px solid transparent; cursor: pointer;
}
.btn-primary { background: var(--color-primary); color: white; border-color: var(--color-primary); }
.btn-primary:hover { background: var(--color-primary-deep); border-color: var(--color-primary-deep); }
.btn-ghost { background: transparent; color: var(--color-ink); border-color: var(--color-border); padding: var(--space-1) var(--space-3); font-size: var(--text-xs); }
.btn-ghost:hover { background: var(--color-surface); }

.detail-shell {
  padding: var(--space-5);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.detail-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
.status-badge {
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.status-badge--definitif { color: oklch(0.40 0.12 150); background: oklch(0.94 0.05 150); }
.status-badge--estime    { color: oklch(0.50 0.13 70);  background: oklch(0.95 0.06 75); }
.status-badge--aucun     { color: var(--color-muted);   background: var(--color-surface); }

.td-strong { font-weight: 700; color: var(--color-ink); }
.muted { color: var(--color-muted); }
.pump-empty { color: var(--color-muted); font-size: var(--text-sm); }

.detail-summary {
  display: flex;
  gap: var(--space-6);
  justify-content: flex-end;
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border);
}
.summary-stat { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
.summary-label { font-size: var(--text-xs); color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.03em; }
.summary-value { font-family: var(--font-mono); font-size: var(--text-base); font-weight: 600; color: var(--color-ink); }
.summary-stat--total .summary-value { font-size: 1.1rem; font-weight: 700; }

@media (max-width: 640px) {
  .detail-summary { flex-direction: column; align-items: flex-end; gap: var(--space-2); }
}
</style>
