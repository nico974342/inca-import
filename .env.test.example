# Base de TEST dédiée aux tests qui écrivent (tests/ecriture/). Copier en .env.test (ignoré par Git).
# JAMAIS la production : le garde-fou (tests/helpers/garde-ecriture.ts) refuse tout ce qui vise uixmsrrprgvoejsuuaat ou inca-import.re.
TEST_SUPABASE_REF=<référence du projet de test, 20 lettres>
SUPABASE_URL=https://<référence du projet de test>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Compte administrateur créé dans la base de test
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
